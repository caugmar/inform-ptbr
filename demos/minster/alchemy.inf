!--------------------------------------------------------------------------
! 7.1 LIQUIDS
!--------------------------------------------------------------------------
! The liquid model is highly simplified.  A liquid object on its own can be
! manipulated in a limited number of ways; it is happier inside a vessel.
! 
! Liquids are manipulated by overloading the usual library actions for
! transferring objects, and by adding a new action for doing the actual
! work of moving liquids around.

Fake_Action LiquidMove;     ! move a liquid into an open vessel

[ FindOpenEmptyVessel i j;
    if (Handbag in player && Handbag has open)
        objectloop(i in Handbag)
            if (i has is_vessel && child(i) == 0 && i has open) j = i;
    objectloop(i in player)
        if (i has is_vessel && child(i) == 0 && i has open) j = i;
    return j;
];

[ FillWithSub; <<Insert second noun>>; ];

Verb "pour" "derramar" "verter"
    * "out" noun            -> Empty
    * "away" noun           -> Empty
    * noun "away"           -> Empty
    * noun "out"            -> Empty
    * noun "on" noun        -> EmptyT
    * noun "onto" noun      -> EmptyT
    * noun "in" noun        -> EmptyT
    * noun "into" noun      -> EmptyT
    * noun "over" noun      -> EmptyT;

Verb "add" "mix" "adicionar" "misturar"
    * noun "to" noun        -> Insert
    * noun "with" noun      -> Insert;

Verb "esvaziar" "empty"
    * noun "over" noun      -> EmptyT;

Verb "encher" "fill"
    * noun "with" noun      -> FillWith
    * noun "from" noun      -> FillWith;

Class   VesselClass
 has    container is_vessel
 with   capacity 1,
        before [;
         Examine:
            if (location == thedark) return L__M(##Examine,1);
            PrintOrRun(self,description,1);
            if (child(self) ~= 0 && (self has open || self has transparent))
                print " Contém ", (a) child(self), ".";
            new_line;
            rtrue;
         Drink,Taste,Eat:
            if (children(self) == 0) print_ret (The) self, " está vazio.";
            <<Drink (child(self))>>;
         Fill:
            if (location hasnt is_water)
                print_ret "Você não vê nada com que possa encher ",
                    (the) self, ".";
            if (self hasnt open) print_ret (The) self, " está fechado.";
            if (child(self) ~= 0 && child(self) hasnt is_liquid)
                print_ret "Mas ", (the) self, " já contém ",
                    (a) child(self), ".";
            <Invoke WaterStore>;
            if (child(WaterStore) ~= 0)
                <<LiquidMove (child(WaterStore)) self>>;
            rtrue;
         FillWith:
            if (second == River) <<Fill self>>;
         Receive:
            if (noun == River) <<Fill self>>;
            if (noun hasnt is_liquid) {
                if (noun.size ~= 0)
                    "É grande demais para caber.";
                rfalse;
            }
            if (self hasnt open) print_ret (The) self, " está fechado.";
            if (child(self) ~= 0 && child(self) hasnt is_liquid)
                print_ret (The) self, " já contém ",
                    (a) child(self), ".";
            <<LiquidMove noun self>>;
         Empty:
            if (self hasnt open) print_ret (The) self, " está fechado.";
            if (child(self) == 0) print_ret (The) self, " está vazio.";
            if (child(self) hasnt is_water)
                print_ret "Não adianta derramar ",
                    (the) child(self), ".";
            remove child(self);
            print_ret "Você esvazia ", (the) self, ".";
         EmptyT:
            if (second == self) "Você não pode esvaziar algo dentro de si mesmo!";
            if (second has is_liquid) second = parent(second);
            if (second has animate || second == Skeleton or Gargoyle)
                <<Give self second>>;
            if (second hasnt is_vessel) <<Empty self>>;
            if (self hasnt open) print_ret (The) self, " está fechado.";
            if (child(self) == 0) print_ret (The) self, " está vazio.";
            if (second == Fire) {
                remove child(self);
                "Seu esforço patético para apagar o fogo não surte efeito.";
            }
            if (second hasnt open) print_ret (The) second, " está fechado.";
            if (child(second) ~= 0 && child(second) hasnt is_liquid)
                print_ret "Mas ", (the) second, " já contém ",
                    (a) child(second), ".";
            <<LiquidMove (child(self)) second>>;
        ];

Class   LiquidClass
 has    is_liquid
 with   article "some",
        before [ i j;
            i = parent(self);
         Examine: rfalse;
         Give:
            if (i has is_vessel) <<Give i second>>;
         ThrowAt:
            if (i has is_vessel) <<EmptyT i second>>;
         Show:
            if (i has is_vessel) <<Show i second>>;
         Drink,Taste,Eat,SmellThing,Touch:
            if (i has is_vessel && i hasnt open)
                print_ret (The) i, " está fechado.";
            if (AfterRoutines() == 1) rtrue;
         Take,Remove:
            if (i has is_vessel)
                print_ret "Tente ~esvaziar ", (the) i, " em algo~, ou ~derramar \
                    ", (the) self, " sobre algo~.";
            j = FindOpenEmptyVessel();
            if (j == 0) "Você terá de dizer o que quer encher.";
            <<LiquidMove self j>>;
         Insert,PutOn,Transfer,Empty,EmptyT:
            j = parent(second);
            if (i has is_vessel) {
                if (second has is_liquid && j has is_vessel)
                    <<EmptyT i j>>;
                <<EmptyT i second>>;
            }
            if (second hasnt is_vessel) { Futile(); rtrue; }
            if (second hasnt open) print_ret (The) second, " está fechado.";
            <<LiquidMove self second>>;
         Receive:
            if (noun has is_liquid)
                "** Erro: a ação Receive foi chamada com noun e second \
                 both liquids **";
            Futile();
            rtrue;
         LiquidMove:
            if (second hasnt is_vessel || second hasnt open)
                "** Erro: o movimento do líquido falhou em condição(ões) necessária(s) **";
            if (self in second)
                "Você não pode derramar algo dentro de si mesmo!";
            if (self has is_water)
                print "Você enche ", (the) second, " com água";
            else
                print "Você derrama ", (the) self, " em ", (the) second;
            if (child(second) == 0) {
                move self to second;
                ".";
            }
            if (child(second) hasnt is_liquid)
                "** Erro: o movimento do líquido falhou em uma condição necessária **";
            i = MixLiquids(self,child(second));
            if (i has is_liquid_store) {
                <Invoke i>;
                i = child(i);
            }
            if (i == 0) rtrue;
            if (keep_silent == 0) {
                if (i.number~=self.number || i.number~=(child(second)).number)
                    print ", resultando em ", (a) i;
                print ".^";
            }
            keep_silent = 0;
            remove self;
            remove child(second);
            move i to second;
            AfterRoutines();
            rtrue;
         default:
            Futile();
            rtrue;
        ],
        after [;
         Drop:
            remove self;
        ];

Class   LiquidStoreClass
 has    is_liquid_store
 with   before [ i;
         Invoke:
            ! first collect up any objects that have vanished
            for (i = self.other_obj: i ~= 0: i = i.other_obj)
                if (parent(i) == 0)
                    move i to self;
            if (child(self) == 0)
                print "** Erro: um reservatório de líquido está vazio **^";
            rtrue;
        ];
            
Class   WaterClass
 class  LiquidClass
 has    is_water
  with   name "water" "água",
        article "some",
        number 1,
        after [;
          SmellThing: "A água é um líquido inodoro.";
         Taste,Drink,Eat:
            if (WaterStore hasnt general || Hiccups has general) {
                remove self;
                give WaterStore general;
                if (Hiccups has general) {
                    StopDaemon(Hiccups);
                    "Você bebe a água, curando seus soluços.";
                }
                "Você bebe a água, matando a sede.";
            }
            "Você não está com sede no momento.";
        ];

Object  WaterStore "reservatório de água"
 class  LiquidStoreClass
        ! general if you've drunk some water
 with   other_obj WaterA;

Nearby  WaterA "água" class WaterClass with other_obj WaterB;
Nearby  WaterB "água" class WaterClass with other_obj WaterC;
Nearby  WaterC "água" class WaterClass with other_obj WaterD;
Nearby  WaterD "água" class WaterClass with other_obj WaterE;
Nearby  WaterE "água" class WaterClass with other_obj 0;

Class   CWaterClass
 class  LiquidClass
 has    is_water
  with   name "cloudy" "water" "turva" "água",
        article "some",
        number 0,
        after [;
          SmellThing: "Ela não tem cheiro algum.";
         Taste,Drink,Eat:
            "Você toma um gole, mas o sabor é muito desagradável.";
        ];

Object  CWaterStore "reservatório de água turva"
 class  LiquidStoreClass
 with   other_obj CWaterA;

Nearby  CWaterA "água turva" class CWaterClass with other_obj CWaterB;
Nearby  CWaterB "água turva" class CWaterClass with other_obj CWaterC;
Nearby  CWaterC "água turva" class CWaterClass with other_obj CWaterD;
Nearby  CWaterD "água turva" class CWaterClass with other_obj CWaterE;
Nearby  CWaterE "água turva" class CWaterClass with other_obj 0;


