! 5.1 SECOND COURT
!-------------------------------------------------------------------------

Object  SecondCourtArchwayObject "arco baixo" FirstCourt
 has    door scenery open
 with   name "low" "arch" "archway" "second" "court" "another",
         description "Um arco baixo que leva ao leste, para o Segundo Pátio.",
        door_to SecondCourtArchway,
        door_dir e_to;

Object  SecondCourtArchway "Arco entre os Pátios"
 has    light cat_allowed
 with   name "first" "second" "court" "staples" "staple" "stone" "memorial"
            "slate" "tablet" "tablets",
         description "Um arco de pedra longo e baixo, com o Primeiro Pátio a \
             oeste e uma porta para o Segundo Pátio a leste. Na parede norte \
             há um memorial de guerra: uma série de placas simples de ardósia \
             com os nomes dos membros do Biblioll College, graduandos e \
             formados, mortos na Primeira Guerra Mundial de 1914-1918. Você \
             baixa a cabeça por um instante, lembrando esses jovens e tudo o \
             que poderiam ter se tornado.",
        w_to FirstCourt,
        e_to DoorArchway,
         cant_go "Você pode ir para oeste, ao Primeiro Pátio, ou para leste, \
             ao Segundo Pátio.",
        edward_dirs e_obj w_obj;

Nearby  ArchwayNotice "anúncio"
 has    static
 with   name "notice" "announcement",
         initial "Um anúncio está preso à parede sul.",
         description "É um anúncio de um jantar em homenagem a um benfeitor \
             do College falecido há muito tempo, marcado para esta noite, às \
             sete horas, no Grande Salão. Membros que desejarem comparecer \
             devem pedir um convite ao Reitor.",
        before [;
          Take: "Você quebraria as unhas tentando tirar os grampos da madeira. \
             É melhor deixá-los no lugar.";
        ];

Object  DoorArchway "porta velha de madeira"
 has    door static openable
 with   name "old" "wooden" "door" "arch" "archway" "velha" "madeira" "porta" "arco",
        article "an",
        found_in SecondCourtArchway SecondCourt,
        add_to_scope BlackIronBands Planks,
        describe [;
            if (self in SecondCourtArchway && self hasnt open) 
                "^A porta de madeira bloqueia seu caminho para leste.";
            rtrue;
        ],
        description [;
            print "A porta é muito velha, uma estrutura pesada de madeira, feita de \
                tábuas grossas unidas por faixas de ferro preto";
            if (self hasnt open)
                print ". Ela se encaixa firmemente na extremidade do arco, de modo \
                    que você só consegue ver algumas frestas de luz do \
                    Segundo Pátio";
            ".";
        ],
        door_dir [;
            if (self in SecondCourt) return w_to; else return e_to;
        ],
        door_to [;
            if (self in SecondCourt) return SecondCourtArchway;
            else return SecondCourt;
        ],
        before [;
         Search,LookUnder:
            if (self hasnt open)
                "Você consegue distinguir vislumbres de outro pátio, muito \
                parecido com aquele que acabou de deixar.";
         Open, Close, Push, Pull:
             print "Você segura a maçaneta e força a porta com toda a sua \
                 força, mas não consegue movê-la nem um centímetro.^";
            if (Edward in SecondCourtArchway)
                 print "^Edward diz: ~Não, eu também nunca consigo mover essa \
                     porta.~^";
            rtrue;
         Lock, Unlock:
             "A porta não parece ter fechadura.";
        ];

Object  BlackIronBands "faixas de ferro preto"
 has    static concealed
 with   name "black" "iron" "band" "bands" "rust" "rusty" "preto" "ferro" "faixa" "faixas" "ferrugem" "enferrujado",
        article "some",
         description "As faixas de ferro preto mantêm as tábuas da porta \
             unidas. Elas estão muito enferrujadas.",
        before [;
          Rub: "As centenas de anos de ferrugem resistem às suas tentativas \
              de removê-la.";
        ];

Object  Planks "tábuas"
 has    static concealed
 with   name "plank" "planks" "wood" "thick" "tábua" "tábuas" "madeira" "grossa",
         description "Tábuas grossas, envernizadas e muito desgastadas. Elas \
             são mantidas unidas por faixas de ferro preto.";

Object  SecondCourt "Segundo Pátio"
 has    light cat_allowed
 with   name "second" "court" "archway" "college" "buttresses" "buttress"
            "chapel" "antechapel" "great" "hall" "staircase",
        initial [;
            self.initial = -1;
            AdvanceTime(self);
            if (ClockTower.number < 13) {
                move Crowd to self;
                StartDaemon(Crowd);
            }
            else
                self.nw_to = ChapelObject;
        ],
        description [;
            if (ClockTower.number < 20) 
                 print "O Segundo Pátio é uma ampla extensão retangular de \
                     paralelepípedos, cercada pelos quatro lados por \
                     prédios altos. ";
            else
                 print "A luz da lua cintila nos paralelepípedos do Segundo \
                     Pátio, e prédios sombrios espreitam nas sombras dos \
                     quatro lados.";
             "Há muitas saídas: a oeste, uma porta baixa de madeira se abre \
             para um arco; ao norte, os contrafortes imponentes da capela \
             bloqueiam seu caminho, mas você pode entrar numa antessala a \
             noroeste; a nordeste, é possível ver vegetação através das barras \
             de um portão de ferro forjado; a leste, um prédio grandioso \
             abriga a escadaria ~C~; e a sudoeste você pode entrar no Grande \
             Salão.";
        ],
        ne_to GardenGate,
        e_to CStairGround,
        w_to DoorArchway,
        sw_to GreatHall,
         nw_to "Você não consegue abrir caminho pela multidão.",
         cant_go "Oeste, ao Primeiro Pátio; noroeste, à antessala; \
             nordeste, aos jardins; leste, à escadaria ~C~; sudoeste, ao \
             Grande Salão.",
        edward_dirs ne_obj w_obj e_obj sw_obj;

Object  Crowd "multidão de pessoas"
 has    animate
 with   name "crowd" "of" "people" "student" "students" "congregation" "multidão" "pessoas" "estudante" "estudantes" "congregação",
         initial "Uma multidão de pessoas sai da capela.",
         description "A multidão é formada por estudantes, jovens brilhantes \
             conversando animadamente entre si.",
        life [;
            <<Speak self>>;
        ],
        before [;
          Speak: "As pessoas estão ocupadas demais para prestar atenção \
             em você.";
          Follow: "Há tantas pessoas que você não consegue descobrir quem \
              seguir.";
        ],
        state 4,
        daemon [;
            self.state = self.state - 1;
            if (self.state > 0) {
                if (player in SecondCourt && self.state < 3)
                     "^A congregação continua a sair da capela.";
                rtrue;
            }
            remove self;
            StopDaemon(self);
            SecondCourt.nw_to = ChapelObject;
            if (player in SecondCourt)
                 "^Os últimos membros da congregação saem da capela e a \
                 multidão logo se dispersa, cada um cuidando de seus afazeres.";
        ];

Nearby  SecondCourtCobbles "paralelepípedos"
 has    scenery
 with   name "cobbles" "cobblestones" "cobble" "cobblestone" "stone" 
             "stones" "paralelepípedos" "pedra" "pedras",
        article "the",
         description "Ao contrário dos paralelepípedos da Rua da Capela, estes \
             estão em perfeito estado.";

Nearby  ChapelObject "capela"
 has    scenery door open
 with   name "chapel" "church" "antechapel",
        door_to Antechapel,
        door_dir nw_to,
         description "Um magnífico exemplo de arquitetura renascentista.";

Object  ClockTower "torre do relógio"
 has    static
        ! general on the half-hour
 with   name "clock" "tower" "spire" "tall" "elegant" "relógio" "torre" "agulha" "alta" "elegante",
        found_in FirstCourt SecondCourt Gardens EastBank RoofA,
        describe [;
             print "^A elegante torre do relógio acima da capela do College \
                 domina o horizonte a ";
            if (location == FirstCourt) "northeast.";
            if (location == SecondCourt) "northwest.";
            if (location == RoofA) "north.";
            "west.";
        ],
        number 10,
        state 1, ! number of time advances which are pending
         description [;
             print_ret "A torre do relógio é uma espira alta e elegante acima \
                 da capela do College. O relógio só tem um ponteiro de horas, \
                 então não é possível ter certeza completa do horário, mas \
                 parece ser um pouco depois de ", (PrintTime) 1, ".";
        ],
        before [;
         Examine: rfalse;
          default: "A torre do relógio está longe demais.";
        ],
        time_left 0,
        daemon [;
            if (self.time_left > 0) {
                self.time_left = self.time_left - 1;
                rtrue;
            }
            if (self.state == 0) {
                StopDaemon(self);
                rtrue;
            }
            self.time_left = TimeIncrement + random(TimeIncrement+1);
            self.state = self.state - 1;
            if (location == AnteChapel or Chapel)
                print "^Diretamente acima de você, o";
            else {
                if (self in location) print "^O";
                else print "^Em algum lugar distante, o";
            }
            print " relógio do Biblioll College ";
            if (self has general) {
                give self ~general;
                self.number = self.number + 1;
                 print "bate ", (PrintTime) 0, ".^";
                if (Edward in location && Edward.state <= 20)
                     print "^~Ora essa,~ diz Edward. ~Como está tarde! Se eu \
                         não recuperar logo meu papagaio, não terei tempo \
                         de terminar meu ensaio.~^";
                if (self.number == 17 && TelephoneDaemon hasnt general)
                     print "^Você se lembra vagamente de que Bungay dissera \
                         que telefonaria para Jarboe depois das cinco. Quem \
                         dera você tivesse uma maneira de ouvir a conversa \
                         deles!^";
                if (self.number == 18) {
                    give Chapel general ~visited;
                    move Choir to Chapel;
                    move Congregation to Chapel;
                    move Chaplain to Chapel;
                    if (location == Chapel or AnteChapel or SecondCourt)
                        print "^No sooner has the sound of the clock died \
                            away than a crowd of undergraduates, \
                            choristers and choir-boys stream in from ";
                    switch (location) {
                     Chapel:
                         "oeste e tomam seus lugares para a oração vespertina.";
                     AnteChapel: 
                         "sudeste e entram na Capela a leste.";
                     SecondCourt:
                         "todas as direções e entram na Capela a \
                         noroeste.";
                    }
                }
                rtrue;
            }
            give self general;
             print "soa a meia hora.^";
            if (self.number == 18) {
                StartDaemon(GreatHall);
                AdvanceTime(GreatHall);
                if (Wilderspin notin AlchemistsRoom)
                    print "^** Error: Wilderspin isn't in the Secret Room \
                        **^";
                remove Wilderspin;
                if (location == AlchemistsRoom) {
                    print "^Wilderspin looks up at the sound of the \
                        clock. ~It's half past six,~ he says, ~and I have \
                        to get to the Master's dinner by seven. Better \
                        leave this for another day.~ ";
                    if (Hole notin AlchemistsRoom) {
                        move Hole to AlchemistsRoom;
                        print "Ele rasteja sob o banco e puxa a alavanca. Com \
                            um ~clanc~, uma parte da parede sob o banco se \
                            move para o lado, revelando um pequeno buraco que \
                            leva para baixo. ";
                    }
                     print " Wilderspin desce pelo buraco, chamando você: \
                         ~Espero vê-lo no jantar. Às sete horas no Grande \
                         Salão, não se esqueça!~ E então desaparece.";
                }
            }
        ];


!--------------------------------------------------------------------------
! 5.2 TURMERIC THE CAT
!--------------------------------------------------------------------------

Array CatMove table "desliza" "dispara" "espreita" "caminha" "se esgueira";

Object  Turmeric "gato" SecondCourt
 class  FollowClass
 has    animate
        ! proper if you know his name
        ! general if petted by Edward
 with   name "cat" "kitten" "kitty" "moggy" "turmeric" "ginger" "tom" "gato" "gatinho" "macho" "ruivo"
            "old" "fat" "contented" "feline",
        describe [;
            if (self hasnt proper) print "^An old moggy ";
            else print "^Turmeric ";
             if (self in InsideShed) "está sentado sobre um véu de apicultor.";
             "está sentado aqui.";
        ],
        description [;
             print "Este é um gato ruivo gordo e satisfeito. Falta uma parte \
                 de sua orelha esquerda e ele tem uma cicatriz no focinho";
            if (self in InsideShed)
                 print ". Ele está sentado sobre um véu de apicultor";
            ".";
        ],
        orders [;
             print_ret "Pode-se dizer com segurança que ", (the) self,
                 " não pretende obedecer a você.";
        ],
        life [ i j;
         Attack,Kiss:
            self.state = 1;
            print_ret (The) self, " sibila para você, e você decide que \
                não fazer nada é a melhor opção.";
         Give: 
            self.state = 1;
            if (noun has is_vessel && noun has open && 
              children(noun) > 0 && child(noun) has is_liquid) {
                i = child(noun);
                remove i;
                if (self in SecondCourt) j = Gardens;
                else j = SecondCourt;
                MoveNPC(self,j,0);
                 print_ret "Você arremessa ", (the) i, " contra ", (the) self,
                     ", que uiva horrorizado e foge como um raio.";
            }
             print_ret (The) self, " cheira ", (the) noun, " e depois \
                 torce o focinho para sua oferenda.";
        ],
        before [;
         Take: self.state = 1; 
             print_ret (The) self, " se recusa a deixar você pegá-lo.";
         Touch,Pull,Push,PushDir,Rub,Tickle:
            self.state = 1;
             print_ret (The) self, " golpeia você furiosamente com a garra. \
                 Está claro que este gato não gosta de receber atenção.";
        ],
        short_name [;
             if (self has proper) print "Turmeric";
             else print "gato";
            rtrue;
        ],
        state 0,  ! 0 if each_turn can run, 1 if it can't
        daemon [ p dest dir gate;
            if (self in InsideShed || random(6) ~= 1) rfalse;
            self.state = 1;
            p = parent(self);
            switch(p) {
             GreatHall:
                dest = SecondCourt; dir = ne_obj;
             AnteChapel:
                dest = SecondCourt; dir = se_obj;
             SecondCourt:
                switch(random(4)) {
                 1: dest = GreatHall; dir = sw_obj;
                 2: dest = CStairGround; dir = e_obj;
                 3: dest = AnteChapel; dir = nw_obj;
                 4: dest = Gardens; dir = ne_obj; gate = 1;
                }
             CStairGround:
                dest = SecondCourt; dir = w_obj;
             Gardens:
                switch(random(3)) {
                 1,2: dest = SecondCourt; dir = sw_obj; gate = 1;
                 3: dest = Arboretum; dir = ne_obj;
                }
             Arboretum:
                dest = Gardens; dir = sw_obj;
             default:
                "** Error: cat not where it should be **";
            }
            MoveNPC(self, dest, dir);
            if (location ~= p or dest) rfalse;
            print "^", (The) self, " ", (Message) CatMove, " ";
            if (gate == 1 && GardenGate hasnt open)
                 print "pelo portão";
            else {
                 if (p == location) print "para longe";
                 else print "para dentro";
            }
            if (p == location) {
                print " para ";
                PrintDirection(dir);
            } else {
                print " de ";
                PrintDirection(Opposite(dir));
            }
            ".";
        ],
        each_turn [;
            StartDaemon(self);
            if (self.state == 1) {
                self.state = 0;
                rtrue;
            }
            if (LineOfSight(Parrot,self) == 1)
                print_ret "^", (The) self, " sibila para o papagaio, que \
                    grasna alto em resposta, sabendo que está seguro em seu \
                    poleiro.";
            if (random(3) ~= 1) rtrue;
            print "^", (The) self;
            switch (random(7)) {
             1: " mia.";
             2: " se espreguiça preguiçosamente.";
             3: " se lambe.";
             4: " ronrona alto.";
             5: " esfrega a cabeça nas suas pernas.";
             6: " coça as orelhas.";
             7: " rola na poeira.";
            }
        ];


!--------------------------------------------------------------------------
! 5.3 THE CHAPEL
!--------------------------------------------------------------------------

Object  Antechapel "Antessala da Capela"
 has    light cat_allowed
 with   name "chapel" "antechapel" "capela" "antessala",
        description [;
             print "Uma sala octogonal com lajes de mármore sob os pés. Você \
                 pode ir a sudeste para o Segundo Pátio ou a leste, para a \
                 capela propriamente dita";
            if (Chapel has general)
                 print ". Você pode ouvir a oração vespertina a leste";
            ".";
        ],
        se_to SecondCourt,
        e_to [;
            if (EM == 0 && Chapel has general && Hat hasnt worn)
                 "Você não pode entrar na capela com a cabeça descoberta!";
            return Chapel;
        ],
        out_to SecondCourt,
         u_to "A torre do relógio não é acessível daqui.",
         cant_go "Você pode ir a sudeste para o Segundo Pátio ou a leste, \
             para a capela propriamente dita.",
        before [;
         Listen:
            if (Chapel has general)
                 "Você pode ouvir a oração vespertina a leste.";
        ],
        edward_dirs se_obj;

Nearby  MarbleFlagstones "lajes de mármore"
 has    scenery
 with   name "marble" "flagstones" "flag" "flags" "stones",
         description "Cada laje é um memorial a algum antigo membro do \
             College. A passagem de estudantes e professores em suas devoções \
             desgasta um caminho no mármore, apagando lentamente esse registro \
             do passado.";

Object  Chapel "Capela"
 has    light
        ! general if Evensong in progress
 with   name "chapel" "chain" "altar",
        description [;
             print "A capela é uma magnífica obra de arquitetura do século \
                 XVII; suas linhas graciosas lhe dão uma elegância mais \
                 eficaz (na sua opinião, pelo menos) que as complicações \
                 góticas de capelas posteriores e maiores de outros Colleges. \
                 Há uma magnífica janela de vitral na extremidade leste";
            if (self has general)
                 print ". Uma grande congregação ouve o coro da capela cantar \
                     a oração vespertina";
            ".";
        ],
        w_to Antechapel,
        out_to Antechapel,
         u_to "A torre do relógio não parece ser acessível daqui.",
         cant_go "A antessala fica a oeste.",
        before [;
          Smell: "Você sente o forte cheiro de incenso.";
          Pray: "Você se ajoelha e reza. Não há sinal de que sua prece seja \
             atendida.";
 	 Mild,Strong: "Moças não usam esse tipo de linguagem, especialmente \
 	    numa igreja.";
         Sing,Speak,Scream:
            if (self has general)
                 "Psiu! Você não quer perturbar o canto.";
         Disrobe:
            if (self has general && noun == Hat && Hat has worn)
                 "Você não deve tirar o chapéu na capela.";
         Listen:
            if (noun == 0 && Choir in self) <<Listen Choir>>;
        ],
        edward_dirs w_obj;

Nearby  StainedGlassWindow "janela de vitral"
 has    scenery
 with   name "stained" "glass" "window" "figures" "saints" "work" "vitral" "vidro" "janela" "figuras" "santos" "obra"
            "glasswork" "scene" "scenes" "miracle" "madieval" "mediaeval"
            "stained-glass",
        description [;
             print "A janela é um milagre da vidraria medieval. Há muitas \
                 cenas representadas, algumas da Bíblia, outras de santos";
            if (ClockTower.number < 13)
                 print ". O sol da manhã entra pela janela, tornando as cores \
                     radiantes de luz";
            ".";
        ],
        before [;
          Consult: "As cenas da janela de vitral são tão ricas em detalhes \
             que você precisaria passar horas examinando-as com um guia. \
             É melhor deixar isso para outro dia.";
        ];

Nearby  Lectern "lectern"
 has    supporter static
 with   name "dusty" "lectern",
         initial "Um púlpito empoeirado está num canto.",
         description "Ao examiná-lo de perto, o púlpito revela ser uma bela \
             obra de arte, infelizmente negligenciada. É feito de latão maciço \
             e tem a forma de uma águia: asas abertas e garras prontas para \
             atacar.",
        capacity 1,
        before [;
          Take,Remove: "O púlpito é feito de latão maciço e pesado demais \
             para ser movido.";
          Rub: "Remover a poeira e a corrosão exigiria mais tempo e esforço \
             do que você provavelmente está disposto a dedicar à tarefa.";
        ];

Object  LatinBible "Bíblia latina" Lectern
 class  BibleClass
        ! general if Edward's commented
 with   name "latin" "vulgate" "heretical",
         description "A Bíblia é um belo manuscrito iluminado, provavelmente \
             medieval. O texto está em latim.",
        before [;
          Take,Remove: "A Bíblia foi presa ao púlpito com uma corrente curta, \
             para o caso de alguém tentar roubá-la.";
         Invoke:
            if (self.state == 1 && self.number == 'john')
                "John 11:43 reads, ~Et haec cum dixisset, posuit vinum \
		myrrheum labiis Lazari, et voce magna clamavit, \
		Lazare, ite foras.~ Isn't Latin a beautiful language, \
		even if you don't understand a word of it? But what \
		could Malcolm possibly have meant by referring you to \
		this verse?";
            quote = 14;
             "Para você, é tudo latim.";
        ],
        after [;
         Examine:
            if (self hasnt general && Edward in location) {
                give self general;
                 print "^Edward diz: ~Essa Bíblia é francesa, aparentemente do \
                     século XIV. Receio não conseguir ler uma palavra de latim, \
                     exceto `veni, vidi, vici'.~^";
            }
        ];

Object  Congregation "congregação"
 has    animate concealed
 with   name "congregation" "worshipper" "worshiper" "crowd",
         description "Uma multidão solene de fiéis, em sua maioria estudantes \
             usando ternos de jantar e becas.",
         life [; "Você não quer perturbar o serviço religioso."; ],
        before [; 
         Examine: ; 
          default:"Você não quer perturbar o serviço religioso.";
        ];

Object  Chaplain "capelão"
 has    animate concealed
 with   name "chaplain" "nudd" "reverend" "priest" "vicar",
         description "Um homem velho, cujo último fio de cabelo desapareceu \
             há décadas, usando óculos de meia-lua e uma cruz numa corrente.", 
         life [; "Você não quer perturbar o serviço religioso."; ],
        before [; 
         Examine: ; 
          default:"Você não quer perturbar o serviço religioso."; 
        ];

Array TableChoir table [;
    "O coro canta um cantochão.";
    "O coro canta um intróito.";
    "O coro canta algumas respostas.";
    "O coro canta um salmo.";
    "O coro canta um hino.";
    "O capelão lê o Antigo Testamento.";
    "O capelão lê o Novo Testamento.";
    "O coro canta o Nunc Dimittis.";
    "O coro canta um hino solene.";
    "O coro canta o magnificat.";
];

Object  Choir "coro"
 has    animate concealed
 with   name "choir" "chorus" "singer" "choirboy" "choirboys" "choir-boy"
            "singers",
         description "O coro masculino é uma visão pitoresca na penumbra \
             vespertina da capela: jovens coristas vestidos de branco e seus \
             colegas mais velhos do College cantando as partes graves.",
        life [;
             "Você não quer perturbar o canto.";
        ],
        before [;
         Listen: print_ret (Message) TableChoir;
         Examine: ;
          default: "Você não quer perturbar o canto.";
        ],
        each_turn [;
             Achieved("assistindo à oração vespertina na Capela");
            print_ret (Message) TableChoir;
        ];


!--------------------------------------------------------------------------
! 5.4 THE TELEPHONE SWITCHBOARD
!--------------------------------------------------------------------------

Object  BStairBasement "Escadaria ~B~, subsolo"
 has    light
        ! general if two wires have been plugged into one socket, or if
        ! Edward has commented on same.
 with   name "basement" "stair" "stairs",
         description "A parte inferior da escadaria não é iluminada, mas \
             entra luz suficiente de cima para enxergar. É um lugar imundo, \
             com cheiro de fumaça de cigarro e ralos. A escada sobe ao térreo.",
        u_to BStairGround,
        out_to BStairGround,
         cant_go "A única saída é para cima.",
        before [;
          Smell: "O cheiro de fumaça de cigarro é forte. Você imagina que os \
             estudantes se reúnem aqui para fumar e conversar.";
        ],
        edward_dirs u_obj;

Object  Switchboard "armário" BStairBasement
 has    container openable static
        ! general if Edward's commented on it
 with   name "cabinet" "cupboard",
        capacity 8,
         description "O armário parece bastante novo em comparação com o \
             ambiente sujo. Está montado na parede, perto do chão.",
        before [ i j;
         Examine,Search:
            if (self hasnt open) rfalse;
             print (The) self, " contém três pares de fios coloridos e três \
                 pares correspondentes de tomadas coloridas. ";
            for (i = GreenWire: i ~= 0: i = i.other_obj) {
                switch (i) {
                 GreenWire: print "Os ";
                 RedWire: print ", os ";
                 BlueWire: print " e os ";
                }
                 print (address) (i.&name)-->0, " fios ";
                 if (i.number == 0) print "estão soltos";
                 else print "estão ligados às tomadas ", (address)
                     ((i.number).&name)-->0;
            }
            objectloop (i in self) {
                if (i ~= RedWire or GreenWire or BlueWire &&
                    i ~= RedSocket or GreenSocket or BlueSocket) {
                    give i workflag; j++;
                }
                else
                    give i ~workflag;
            }
            if (j > 0) {
                 print ". Além disso, ", (the) self, " contém ";
                WriteListFrom(child(self), ENGLISH_BIT + TERSE_BIT + 
                    WORKFLAG_BIT);
            }
            ".";
        ],
        after [;
         Open:
            if (self hasnt general && Edward in location) {
                give self general;
                 print "~Você tem certeza de que deveria mexer nisso?~ \
                     pergunta Edward. ~Você pode levar um choque elétrico \
                     terrível, e o que eu faria depois?~^^";
            }
             print "Você abre ", (the) self, ". ";
            <<Search self>>;
        ];

Class   SwitchWireClass
 class  ListTogetherClass
 has    is_wire static
 with   name "insulation" "bare" "wire" "pair" "of" "wires",
        list_together "pairs of wires",
        description [;
             print (The) self, " sai da parede e ";
            if (self.number == 0)
                 print "fica solto";
            else
                 print "se liga a ", (the) self.number;
             print ". O par tem isolamento ", (address) (self.&name)-->0,
                 ", mas uma parte da extremidade está desencapada";
            if (self == Voltmeter.number)
                 print ". Há um voltímetro ligado a eles";
            if (self == PowerPack.number)
                 print ". Há uma bateria ligada a eles";
            ".";
        ],
        before [;
         Untie,Remove,Take,Pull,Push:
            if (self.number == 0) {
                 print_ret (The) self, " já está solto.";
            }
            self.number = 0;
             print "Você desliga ", (the) self;
            if (sw__var == ##Take) ", but you are unable to dislodge the \
                wires from the cabinet.";
            ".";
         Insert:
            if (second == GreenSocket or RedSocket or BlueSocket) {
                if (self.number ~= 0)
                 print "(desligando primeiro ", (the) self, " de ", (the)
                         self.number, ")^";
                self.number = 0;
                if (second == GreenWire.number || second == RedWire.number ||
                    second == BlueWire.number)
                    give BStairBasement general;
                self.number = second;
                 print "Você liga ", (the) self, " a ", (the) second, 
                    ".^";
                if (BStairBasement hasnt general && Edward in BStairBasement
                    && random(3) == 1)
                     print "^Edward diz: ~O que será que acontece se você \
                         tentar ligar dois pares de fios à mesma tomada?~^";
                rtrue;
            }
        ];

Class   SwitchSocketClass
 class  ListTogetherClass
 has    static
 with   name "socket" "pair" "of" "sockets",
        list_together "pairs of sockets",
        description [ i j;
            objectloop (i in SwitchBoard) {
                if (i.number == self) { give i workflag; j++; }
                else give i ~workflag;
            }
            if (j == 0)
                 print_ret (The) self, " está vazia.";
             print "Você observa que ";
            WriteListFrom(child(SwitchBoard), WORKFLAG_BIT + ENGLISH_BIT);
             if (j > 1) print " estão ligadas a ";
             else print " está ligada a ";
            print_ret (the) self, ".";
        ],
        before [;
          Push,Pull,Turn: "Elas estão fixas no lugar.";
        ];

