 class  PhoneWireClass;


!--------------------------------------------------------------------------
! 5.5 TELEPHONES
!--------------------------------------------------------------------------
! The telephone numbers are: 212 Master, 213 Jarboe, 214 Bungay.  However,
! you don't need to know this because by moving the wires around you can
! arrange that `212' dials whoever you like.
! 
! The states of the telephone are as follows:
! handset down:   0 = not ringing
!                 1 = ringing
! 
! handset up:     2 = dial tone
!                 3 = ringing
!                 4 = connected to somewhere
!                 5 = engaged
!                 6 = dead
! 
! Maintaining the consistency of the telephone set is helped by the fact
! that you can't mess with the switchboard while the handset is off the
! hook!
!--------------------------------------------------------------------------

Array TableTelephone table [;
    "O telefone não está tocando.";
    "O telefone está tocando.";
    "Você ouve o tom de discagem.";
    "Você ouve o telefone tocar.";
    "Certo.";
    "Você ouve o sinal de ocupado.";
    "O fone está silencioso.";
];

Object  Telephone "telefone" Mantelpiece
 class  TalkableClass
 has    is_telephone
        ! general if ringing last turn
 with   name "telephone" "phone",
         description "É um telefone preto comum com um fone. Uma etiqueta diz: \
             ~Número: 212. Disque 1 para uma linha externa.~",
        state 0,
        number 0,
        before [ i;
            if (HouseKeeper in location)
                 "~Gostou do telefone?~ pergunta a governanta. ~É novinho, \
                 acabaram de instalá-lo esta semana.~";
         Give,Show,Kiss,Attack: Futile();
         Speak:
            if (self.state ~= 4)
                 "Não há ninguém do outro lado da linha telefônica para \
                 conversar.";
            <<Speak TelephoneDaemon>>;
         Take,Remove: <<Take TelephoneHandset>>;
         Drop: <<Drop TelephoneHandset>>;
         PutOn: <<PutOn TelephoneHandset second>>;
         Listen:
            self.number = 1;
            Message(TableTelephone, self.state + 1);
            new_line; rtrue;
         Dial:
            if (self.state ~= 2) "Nothing happens.";
            switch (second) {
                212: i = GreenSocket;
                213: i = RedSocket;
                214: i = BlueSocket;
                default: i = -1;
            }
            if (i ~= GreenWire.number && i ~= RedWire.number && i ~= 
                BlueWire.number) {
                self.state = 6;
                 "O telefone fica mudo.";
            }
            if (GreenWire.number == i) {
                self.state = 5;
                <<Listen self>>;
            }
            self.state = 3;
            TelephoneDaemon.number = 0;
            if (i == RedWire.number)
                TelephoneDaemon.number = TelephoneDaemon.number + 2;
            if (i == BlueWire.number)
                TelephoneDaemon.number = TelephoneDaemon.number + 1;
            StartDaemon(TelephoneDaemon);
            <<Listen self>>;
        ],
        each_turn [;
            if (self.number == 1) {
                self.number = 0;
                return;
            }
            if (self.state == 0 && self has general) {
                give self ~general;
                 "^O telefone parou de tocar.";
            }
            if (self.state == 1) give self general;
            if (self.state == 1 or 3 or 5) {
                new_line;
                <Listen self>;
                self.number = 0;
            }
        ];

Object  TelephoneHandset "fone"
 class  TalkableClass
 has    concealed
 with   name "handset" "receiver" "bungay" "jarboe" "dr" "doctor" "prof"
            "professor",
        number 0,
        before [;
          Insert,Untie: "Você não pode fazer isso; o fone está preso ao \
              telefone.";
         PutOn:
            if (second == Telephone) <<Drop self>>;
            <<Insert self 0>>;
         Speak,Listen: <<(action) Telephone>>;
        ],
        after [;
         Take,Remove:
             print "Você levanta o fone do telefone. ";
            if (Telephone.state == 1) {
                give Telephone ~general;
                Telephone.state = 4;
                 print "O telefone para de tocar. ";
            }
            else Telephone.state = 2;
            <Listen Telephone>;
            rtrue;
         Drop:
            Telephone.state = 0;
             "Você recoloca o fone no telefone.";
        ];

Object  TelephoneDaemon "telephone daemon"
        ! general if Jarboe & Bungay have passed on their message
 with   state 0,
        number 0,   ! 0 = not connected anywhere
                    ! 1 = connected to Bungay
                    ! 2 = connected to Jarboe
                    ! 3 = connected to both
        before [ i;
         Speak:
            i = self.number;
            self.number = 0;
            self.state = 0;
            Telephone.state = 6;
            switch (i) {
              1: "~Não posso falar com você agora,~ diz Bungay. ~Estou muito \
                 ocupado.~ Ele desliga o telefone.";
              2: "~Ah, é você,~ diz Jarboe. ~Bem, não me interessa o que você \
                 tem a dizer. É melhor ir para casa agora.~ Ele desliga o \
                 telefone.";
              3: "~Você ouviu isso?~ diz Jarboe. ~Devemos ter uma \
                 linha cruzada de novo.~^^~Não podemos deixar ninguém nos \
                 escutando,~ diz Bungay. ~Ligo de volta mais tarde.~ Ambos \
                 desligam o telefone.";
             default:
                "** Error: telephone daemon should have number 1-3 **";
            }
        ],
        daemon [;
            if ((self.number & 2) == 2 && Bungay notin BungaysSanctum)
                self.number = self.number & 1;
            if ((self.number & 1) == 1 && Jarboe notin JarboesSanctum)
                    self.number = self.number & 2;
            if (Telephone.state ~= 3 or 4) self.number = 0;
            if (self.number > 0) self.state = self.state + 1;
            switch (self.number) {

             1: switch (self.state) {
                 1,2: return; ! leave it to ring twice
                 3: Telephone.state = 4;
                     "^Alguém atende o telefone do outro lado, e uma voz diz: \
                     ~Bungay falando.~";
                  4: "A voz ao telefone diz: ~É você, Jarboe?~";
                 5: self.number = 0;
                    Telephone.state = 6;
                     print "^A voz ao telefone diz ~Adeus~ e desliga.^";
                }

             2: switch (self.state) {
                 1: return; ! leave it to ring for a turn
                 2: Telephone.state = 4;
                     "^Alguém atende o telefone do outro lado, e uma voz diz: \
                     ~Olá, Jarboe falando, como posso ajudar?~";
                  3: "A voz ao telefone diz: ~Olá, quem fala, por favor?~";
                 4: self.number = 0;
                    Telephone.state = 6;
                     print "^A voz ao telefone resmunga: ~Deve ser uma linha \
                         cruzada. Malditos telefones, por que não conseguem \
                         fazê-los funcionar?~ e desliga.^";
                }

             3: switch (self.state) {
                 1: return; ! leave it to ring for a turn
                 2: Telephone.state = 4;
                     "^Alguém atende o telefone do outro lado e uma voz diz: \
                     ~Olá, Jarboe falando.~";
                  3: "^Há um tilintar, e uma segunda voz diz: ~Bungay \
                     falando.~";
                 4: if (self has general) {
                        self.number = 0;
                        Telephone.state = 6;
                         print "^~Santo Deus,~ diz Jarboe. ~De novo não. Por \
                             que não conseguem fazer esses malditos telefones \
                             funcionar?~^^Ambos desligam o telefone.^";
                    }
                     else "^~Você ia me telefonar sobre os detalhes desta \
                         noite, não?~ diz Jarboe.";
                  5: "^~Eu não liguei para você, você ligou para mim,~ diz Bungay.";
                  6: "^~Veja bem,~ diz Jarboe. ~Esses telefones idiotas estão \
                     falhando de novo. Mas, já que estamos aqui, o que você \
                     ia dizer?~";
                 7: self.number = 0;
                    Telephone.state = 6;
                    give self general;
                     Achieved("escutando uma conversa telefônica");
                    AdvanceTime(self);
                    DoneHint(WhatNextPuzzle,22);
                    print "^~Very well,~ says Bungay. ~After the Master's \
                        dinner tonight we'll meet in ", (PrintOMN) 0, "'s \
                        crypt at half past ten.~^^~But do you really \
                        think he knows the secret?~ asks Jarboe.^^~Of \
                        course he does,~ says Bungay sharply. ~Why else \
                        would he have gone to so much trouble to hide his \
                        researches? But we'll get it from him \
                        tonight.~^^Then they both put the phone down.^";
                }
            }
            if (self.number == 0) {
                self.state = 0;
                StopDaemon(self);
            }
        ];


!--------------------------------------------------------------------------
! 5.6 GREAT HALL AND CELLARS
!--------------------------------------------------------------------------

Object  CloakRoom "Vestiário (sem entrada)";

Object  GreatHall "Grande Salão"
 has    light cat_allowed
 with   name "window" "windows" "great" "hall" "portrait" "portraits"
            "stair" "stairs" "vaulted" "ceiling" "latticed" "doleful"
            "masters" "door" "senior" "common" "room",
        state 0,
        description [;
            print "Uma grande sala ecoante, com um teto abobadado muito acima \
                da cabeça, destinada a acomodar e alimentar mais de cem \
                professores e estudiosos famintos. Pequenas janelas gradeadas \
                no alto do salão deixam entrar estreitos feixes de ";
            if (ClockTower.number < 20) print "luz solar";
            else print "luz lunar";
            print ", que iluminam retratos tristes de antigos Reitores do \
                College.^^O Segundo Pátio fica a nordeste, as cozinhas ao sul \
                e uma escada sobe para a sala comum dos veteranos.^";
            if (ClockTower.number == 19)
                print "^A sala ecoa com a conversa ruidosa de \
                    professores sentados à mesa alta e estudantes à mesa \
                    baixa.^";
            rtrue;
        ],
        ne_to SecondCourt,
        out_to SecondCourt,
        u_to SeniorCommonRoom,
        s_to KitchenLobby,
        before [;
         Go,Enter:
            if (noun == d_obj && parent(player) == Tables or HighTable)
                <<Exit>>;
        ],
        time_left 1,
        daemon [ i;
            if (self.state == 0) {
                self.state = 1;
                move ServingStaff to self;
                 self.s_to = "Os funcionários não deixarão você passar.";
            }
            if (ClockTower.number >= 19 && self.state == 1) {
                self.state = 2;
                remove Jarboe;
                remove Bungay;
                remove Choir;
                remove Congregation;
                remove Choir;
                remove Turmeric;
                StopDaemon(Turmeric);
                give Chapel ~general;
                give DoorMaster ~open locked;
                switch (location) {
                 GreatHall:
                    print "^Os funcionários terminam de arrumar as mesas, e \
                        não foi um minuto cedo demais: mal o eco do último \
                        sino desaparece, as portas se abrem e grupos de \
                        professores e estudantes entram, conversando \
                        animadamente enquanto ocupam seus lugares.^";
                 Chapel:
                    print "^A oração vespertina chega ao fim, e a congregação \
                        e o coro saem para oeste, conversando animadamente.^";
                 AnteChapel:
                    print "^Uma corrente de estudantes, professores e coristas \
                        sai da capela e segue a sudeste para o Segundo Pátio.^";
                 SecondCourt:
                    print "^Uma corrente de estudantes, professores e coristas \
                        sai da capela e segue a sudoeste para o Salão.^";
                }

                if (TelephoneDaemon hasnt general) i = 1;
                if (DoorB5 has locked) i = 2;
                if (Edward notin EdwardsRoom) i = 3;
                if (Edward.state ~= 31) i = 4;
                if (ParrotC notin Edward) i = 5;
                if (DoorC3 hasnt general) i = 6;
                if (BeeLoudGlade hasnt general) i = 7;
                if (Cellars hasnt general) i = 8;
                if (DoorArchway hasnt open) i = 9;
                if (BookLab hasnt moved) i = 10;
                if (BookArkwright hasnt moved) i = 11;
                if (AlchemistsRoom hasnt visited) i = 12;
                if (DinnerTicket hasnt moved) i = 13;
                if (BottleB hasnt open) i = 14;
                if (i ~= 0)
                    print "^** Error: entering the endgame having \
                        failed consistency check #", i, " **^";
            }
            if (self.state == 2 && location == self) {
                if (Inside(DinnerTicket,player) == 0) {
                    print "^Um dos funcionários vem até você e pede para ver \
                        seu convite. Ao descobrir que você não tem um, ele o \
                        conduz para fora do Salão, com educação mas firmeza.^";
                    PlayerTo(SecondCourt,1);
                    LookSub(1);
                    rtrue;
                }
                DumpCarried(CloakRoom,1);
                self.state = 3;
                StopDaemon(self);
                remove ServingStaff;
                print "^Você deixa rapidamente seus pertences no vestiário e \
                    encontra seu lugar. Surpreende-se ao descobrir que foi \
                    colocado à mesa alta com o Reitor e os professores do \
                    College...^";
                PlayerTo(DiningHall);
                rtrue;
            }
            if (self.state == 2) {
                if (self.time_left == 0) {
                    self.time_left = 6;
                    "^O jantar desta noite no Grande Salão começou às sete, e, \
                    se você não se apressar, chegará ainda mais atrasado do \
                    que já está!";
                }
                self.time_left = self.time_left - 1;
            }
        ],
        edward_dirs ne_obj;

Nearby  HighTable "high table"
 has    static supporter enterable
        ! general if found corkscrew
 with   name "high" "table",
         initial "Uma extremidade do salão é ocupada pela mesa alta.",
        article "the",
        before [;
         Search, LookUnder:
            if (self hasnt general) {
                move Corkscrew to GreatHall;
                give self general;
                 "Há um saca-rolhas sob a mesa alta. Os festeiros devem tê-lo \
                 deixado cair na última refeição.";
            }
        ];

Nearby  Tables "low table"
 has    static supporter enterable
 with   name "long" "low" "table",
        article "the",
         initial "Uma mesa comprida atravessa o restante da sala.";

Object  ServingStaff "serving staff"
 has    animate
 with   name "serving" "staff" "waiter" "waiters" "waitress" "waitresses",
        article "the",
         initial "Os funcionários andam de um lado para outro, arrumando os \
             móveis e preparando as mesas.",
        life [;
             "Eles estão ocupados demais para prestar atenção em você.";
        ];

Object  KitchenLobby "Fora das Cozinhas"
 has    light
        ! general if cook routine in progress
 with   name "kitchen" "kitchens" "great" "hall",
         description "Uma pequena área entre as cozinhas movimentadas (ao \
             sul) e o Grande Salão (ao norte), usada para recolher pratos \
             enquanto um banquete acontece no salão.",
        n_to GreatHall,
        out_to GreatHall,
         s_to "Você entra nas cozinhas movimentadas, mas o olhar furioso e o \
             cutelo brandido de um dos cozinheiros deixam claro que você não é \
             bem-vindo, e você sai rapidamente.",
        d_to [;
            if (EM == 1) return Hatch;
            if (Hatch hasnt door || Hatch hasnt open)
                 "A escotilha está fechada.";
            quote = 4;
            AdvanceTime(Cellars);
             print "Você desce silenciosamente pela escada, ansioso para não \
                 revelar sua presença ao cozinheiro.^";
            return Hatch;
        ],
        time_left 0,
        time_out [;
            give LightSwitch on;
            give Cellars light;
            move Cook to self;
            MoveNPC(Cook,Cellars,d_obj);
            StartTimer(Cook,5);
            if (self == location) {
                print "^A cook emerges from the kitchen, ";
                if (player in Hatch) {
                    PlayerTo(self,1);
                    print " and approaches you. ~Get off that hatch!~ he \
                        orders angrily, and you obey. He ";
                }
                 print "destranca a escotilha, abre-a e desce às adegas.^";
            }
            <Invoke Hatch 1>;
        ],
        each_turn [;
            if (self hasnt general && ClockTower.number < 19) {
                give self general;
                StartTimer(self,Cook.state);
                Cook.state = 5;
            }
        ],
        edward_dirs n_obj;

Object  Hatch "hatch"
 has    openable locked static lockable enterable supporter
 with   name "hatch" "trap" "trapdoor" "ladder",
        found_in Cellars KitchenLobby,
	description [;
	    if (self has locked)
            "A escotilha é uma estrutura robusta de madeira; parece que \
		nenhum golpe que você seja capaz de desferir nela a moveria um \
		centímetro.";
	],
        describe [;
            print "^Há ";
            if (self has open) print "uma escotilha aberta";
            else print "uma escotilha fechada";
            print " no ";
            if (self in KitchenLobby) "meio do chão.";
            else "teto, acessível por uma escada.";
        ],
        door_to [;
            if (self in Cellars) return KitchenLobby; else return Cellars;
        ],
        door_dir [;
            if (self in Cellars) return u_to; else return d_to;
        ],
        before [;
         Knock,Attack:
            if (self in Cellars) {
                if (Cook in Cellars) {
                    RunLife(Cook,0);
                    rtrue;
                }
                StartTimer(self,3);
            }
         Receive:
            if (self has open && self in KitchenLobby)
                 "Isso cairia nas adegas.";
         Open:
            if (player in self)
                 "Não enquanto você estiver sobre ela!";
         Invoke:
            switch (second) {
             0: give self locked ~open enterable supporter ~door;
             1: give self ~locked open ~enterable ~supporter door;
             2: give self locked ~open ~enterable ~supporter door;
            }
            if (second > 0) {
                while (child(self) ~= 0)
                    move child(self) to KitchenLobby;
            }
            rtrue;
        ],
        after [;
         Open: <Invoke self 1>;
         Close: <Invoke self 0>;
        ],
        time_left 0,
        time_out [;
            <Invoke self 0>;
            give KitchenLobby ~general;
            give Cellars ~light;
            give LightSwitch ~on;
             print "^A escotilha se abre e uma mulher espreita. ~Saia daí, sua \
                 menina boba! Que tolice ficar presa aí embaixo. Você deveria \
                 tomar mais cuidado ao andar por aí, sabe, e eu tenho trabalho \
                 a fazer...~ Você sai das adegas bastante envergonhada, e ela \
                 fecha e tranca a escotilha antes de voltar às cozinhas.^";
            PlayerTo(KitchenLobby,1);
             Achieved("escondendo-se do cozinheiro");
            LookSub(1);
            if (Edward in KitchenLobby) {
                print "^Edward says, ~Lucky for you that I was here to \
                    run and get someone, or else you might have been \
                    stuck down there for days.~^";
                ! This time_out might run after Edward's daemon
                RunRoutines(Edward,daemon);
            }
        ];

Array TableWine table [;
    "a nice sauvignon blanc";
    "the Moet grand cru";
    "the 1931 Haut Medoc";
    "the 1936 Cotes de Brouillard de Plessy-Frais";
    "Quero o Orvieto Classico Secco";
    "a ruby port. No, vintage. No, ruby";
    "a Veuve Cliquot champagne";
    "a subtle Loire white";
    "the dryest Gewurztrauminer I can find";
    "the 1940 is ready to drink";
    "an occasion such as this merits the Chateau Nimes St Jacques 1914";
];

Object  Cook "cook"
 class  FollowClass CarryingClass TalkableClass
        ! general if you stood on the hatch
 with   name "cook",
        article "the",
         initial "O cozinheiro está diante dos tonéis, pensando em qual \
             garrafa deve pegar.",
         description "Ele parece bastante sinistro aqui embaixo, na penumbra.",
        before [;
         Examine: rfalse;
         default:
             print "~O que você está fazendo aqui?~ grita o cozinheiro. ~Saia! \
                 Saia da minha adega! Como ousa!~ Ele vem até você, conduzindo-o \
                 à frente, e fecha e tranca rapidamente a escotilha antes de \
                 seguir para o sul, rumo à cozinha.^";
            PlayerTo(KitchenLobby,1);
            <Invoke Hatch 0>;
            LookSub(1);
            if (Edward in KitchenLobby) {
                print "^~I wouldn't cross the cook if I were you,~ says \
                    Edward. ~He has a vicious temper and he's prone to \
                    waving his cleaver around without concern for life or \
                    limb when he gets angry.~^";
                RunRoutines(Edward,daemon);
            }
            move self to KitchenLobby;
            MoveNPC(self,0,s_obj);
            StopTimer(self);
            give KitchenLobby ~general;
            give Cellars ~light;
            give LightSwitch ~on;
            rtrue;
        ],
        state 2,
        time_left 0,
        time_out [;
            if (player in Hatch) {
                give self general;
                 print "^Há uma batida furiosa na parte inferior da escotilha. \
                     ~Deixe-me sair, seu idiota!~ grita o cozinheiro.^";
                if (Edward in KitchenLobby)
                     print "^~Acho mesmo que você deveria deixá-lo sair,~ diz \
                         Edward com urgência.^";
                StartTimer(self,0);
                rtrue;
            }
            give Cellars ~light;
            give LightSwitch ~on;
            give KitchenLobby ~general;
            if (location == Cellars) {
                 print "^O cozinheiro finalmente toma sua decisão, resmungando \
                     consigo mesmo. ~Talvez ", (Message) TableWine,
                     "...~ Ele escolhe uma garrafa das prateleiras e volta à \
                     escada, olhando ao redor com desconfiança.^";
                if (player notin Alcove) {
                    print "^Suddenly he catches sight of you. ";
                    <<Invoke self>>;
                }
                <Invoke Hatch 2>;
                MoveNPC(self,0,u_obj);
                DoneHint(WhatNextPuzzle,11);
                 "^Você recua para as sombras, e ele não percebe você. Ele \
                 apaga a luz, sobe a escada, e você o ouve fechando e trancando \
                 a escotilha. Em vez de suspirar aliviada, você de repente fica \
                 muito assustada. E se ele não voltar? E se você ficar presa \
                 aqui?";
            }
            if (location == KitchenLobby) {
                if (Hatch hasnt open)
                     print "^A escotilha se abre e o cozinheiro surge";
                 else print "^O cozinheiro surge das adegas";
                 print " carregando uma garrafa empoeirada. Ele fecha e \
                     tranca rapidamente a escotilha antes de seguir para a \
                     cozinha";
                if (self has general) {
                    give self ~general;
                     print ", olhando para você e praguejando entre dentes";
                }
                print ".^";
            }
            MoveNPC(self,0,s_obj);
            <Invoke Hatch 0>;
        ];

Object  Cellars "Adegas"
 has    light no_edward
        ! general if climbed down ladder
 with   name "cellar" "cellars" "spider" "spiders" "cobweb" "web" "webs"
            "cobwebs",
         description "A adega é um refúgio fresco do calor do dia de verão lá \
             fora. Há sete tonéis de armazenamento junto às paredes, com as \
             prateleiras de cada um cheias de garrafas empoeiradas do chão ao \
             teto; um conjunto de sombras escuras num canto indica uma alcova.",
        u_to [;
             if (Hatch hasnt open) "A escotilha está fechada.";
            return Hatch;
        ],
         cant_go "A única saída é voltar para cima.",
        before [;
          Smell: "As adegas exalam um cheiro mofado, não desagradável, \
              composto de vinho azedo e cortiça velha.";
          Listen: "Ocasionalmente há um ruído, como de camundongos.";
         Exit:
            if (player in Alcove) {
                keep_silent = 1; ExitSub(); keep_silent = 0;
                 "Você sai da alcova.";
            }
        ];

Nearby  Alcove "alcove"
 has    scenery enterable container open
 with   name "alcove" "shadowy" "shadow" "shadows",
        article "an",
