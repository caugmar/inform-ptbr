!--------------------------------------------------------------------------
! 3.1 FIRST COURT AND THE PORTER
!--------------------------------------------------------------------------

Object  FirstCourt "Primeiro Pátio"
 has    light
  with   name "alto" "prédio" "prédios" "gárgula" "gárgulas" "tall" "building" "buildings" "gargoyle" "gargoyles"
             "quadrilátero" "primeiro" "pátio" "sombrio" "quadrangle" "first" "court" "gloomy" "gingham" "pinafore"
             "avental" "secular" "cantaria" "séculos" "antigo" "capela" "rua" "apron" "centuries-old" "stonework" "centuries" "old",
        description [;
             print "Um gramado impecável ocupa o centro de um pátio sombrio \
                 cercado por prédios altos nos quatro lados. ";
            if (ClockTower.number > 19)
                 print "A glicínia cobre os prédios do college e, sob o luar \
                     branco, os galhos nodosos parecem agarrar-se \
                     ciumentamente à velha cantaria.";
            else
                 print "A glicínia de flores roxas cobre a cantaria secular, \
                     e gárgulas observam lá de cima.";
             "^^Você pode sair do pátio em várias direções:^^    \
             Oeste: um grande portão de madeira leva à Chapel Street^    \
             Noroeste: o alojamento do porteiro^    \
             Norte: escadaria ~A~^    \
             Nordeste: a porta dos Alojamentos do Reitor^    \
             Leste: um arco baixo leva a outro pátio^    \
             Sudeste: escadaria ~B~^    \
             Sul: um arco leva à biblioteca";
        ],
        w_to GreatGate,
        nw_to PortersLodgeObject,
        n_to AStairGround,
        ne_to DoorMaster,
        e_to SecondCourtArchwayObject,
        se_to BStairGround,
        s_to LibraryArchwayObject,
        in_to [;
            if (HouseKeeper in self && DoorMaster has open)
                return DoorMaster;
            if (EM == 1) rtrue;
             "Há muitos lugares onde você poderia entrar daqui. Tente uma \
             direção da bússola.";
        ],
        out_to GreatGate,
        u_to [;
            if (EM == 1) return Wistaria;
            if (ClockTower.number < 20)
                 "A glicínia é resistente e certamente suportaria seu peso, \
                 mas, antes que você suba mais de meio metro, o porteiro sai \
                 de seu alojamento e grita: ~Desça daí!~ Você obedece a \
                 contragosto, e o porteiro volta para dentro.";
            Achieved("climbing the wistaria");
             print "Sob a proteção da escuridão, talvez você consiga evitar o \
                 olhar atento do porteiro.^";
            return Wistaria;
        ],
        before [;
          Smell: "As flores da glicínia têm um perfume intenso.";
        ],
        each_turn [;
            Achieved("getting into Biblioll college");
            PuzzleSolved(EnterCollegePuzzle);
            PuzzleSeen(MalcolmsRoomPuzzle);
            DoneHint(WhatNextPuzzle,1);
            AdvanceTime(self);
            if (DoorMaster has open && Telephone.state == 1)
                 "^Você ouve um telefone tocando a nordeste.";
        ],
        edward_dirs e_obj w_obj nw_obj;

Nearby  Lawn "gramado impecável"
 has    scenery enterable container open
         with   name "impecável" "gramado" "recém-aparado" "immaculate" "lawn" "freshly-mown",
         article "um",
         description "O resultado de centenas de anos de cuidado por várias \
             gerações de jardineiros.",
        before [;
          SmellThing: "Recém-aparado.";
         Enter:
            if (ClockTower.number < 20)
                 "O porteiro sai de seu alojamento e grita: ~Saia do gramado! \
                 Somente membros do college!~ Você obedece a contragosto, e \
                 o porteiro volta para dentro.";
          Receive: "O porteiro sai do alojamento e grita para você: \
             ~Deixe o gramado em paz! Somente membros do college!~ \
             A contragosto, você obedece, e o porteiro volta para dentro.";
        ];

Nearby  Wisteria "glicínia"
 has    scenery
  with   name "glicinia" "glicínia" "wisteria",
        before [;
            remove self;
             "A glicínia recebeu seu nome do anatomista americano Caspar \
             Wistar (1761-1818). A grafia ~wisteria~, embora usada por \
             Thomas Nuttall, que nomeou o gênero, está errada.";
        ];

Nearby  PortersLodgeObject "Alojamento do Porteiro"
 has    door scenery open
 with   name "porters" "porters^" "lodge" "porter" "porter^s",
        door_to PortersLodge,
        door_dir nw_to;

Object  Wistaria "glicínia"
 has    door scenery open
  with   name "glicinia" "glicínia" "roxa" "florida" "purple" "flowering" "wistaria" "raiz" "raízes" "galho" "root" "roots" "branch"
             "nodosos" "galhos" "gnarled" "branches",
         description "A glicínia fincou suas raízes na estrutura do college \
             há décadas, e seus galhos nodosos são mais grossos que seus \
             braços.",
        found_in FirstCourt RoofA,
        door_to [;
            if (self in RoofA) return FirstCourt;
            return RoofA;
        ],
        door_dir [;
            if (self in RoofA) return d_to;
            return u_to;
        ],
        article "some",
         before [;
         Climb: <<Enter self>>;
          SmellThing: "As flores têm um perfume intenso.";
        ];

Object  PortersLodge "Alojamento do Porteiro"
 has    light
 with   name "paper" "papers" "chapel" "newsletter" "door" "doorway" 
            "courtyard" "court" "yard",
         description "Centenas de escaninhos cobrem as paredes desta grande \
             sala. Uma porta a sudeste leva a um pátio.",
        se_to FirstCourt,
        out_to FirstCourt,
         cant_go "O porteiro sorri para você. ~Está com problemas, querida?~ \
             pergunta. ~A única saída é por onde você entrou.~",
        edward_dirs se_obj,
        before [;
         Smell: <<SmellThing Pigeonholes>>;
        ];

Nearby  Porter "porteiro"
 class  CarryingClass TalkableClass
        ! general if you've shown him the telegram
 with   name "porter" "ancient" "wrinkled" "gnarled" "chap" "hand" "deaf" 
            "man",
         description "O porteiro é um homem muito velho, de rosto enrugado e \
             mãos nodosas.",
         initial "Um porteiro está aqui, separando alguns papéis sem pressa.",
        life [;
         Show,Give:
            switch(noun) {
             Telegram:
                if (self hasnt general) {
                    DoneHint(MalcolmsRoomPuzzle,6);
                    give self general;
                     "O porteiro olha seu telegrama. ~Você é irmã do Malcolm, \
                     não é?~ ele pergunta. ~Não vejo seu irmão há alguns dias; \
                     ele deve estar muito ocupado com aqueles experimentos.~";
                }
                 "~Sim, você já me mostrou isso,~ ele diz.";
             KeyToA5:
                give KeyToA5 ~general;
                move KeyToA5 to GivenAway;
                 "~Muito obrigado,~ diz o porteiro, devolvendo a chave ao \
                 chaveiro.";
             Map:
                 "~Está perdido?~ diz o porteiro. ~Você está aqui, onde está \
                 escrito Alojamento do Porteiro.~ Ele aponta o local para você.";
            }
        ],
        before [;
          Speak:
             DoneHint(MalcolmsRoomPuzzle,4);
             "~Hã?~ pergunta o porteiro, levando a mão ao ouvido.";
          SmellThing: "Ele cheira levemente a fumo de cachimbo.";
        ],
        after [;
         Examine: DoneHint(MalcolmsRoomPuzzle,3);
        ];

Nearby  Pigeonholes "escaninhos"
 has    proper static concealed
 with   parse_name [ w i j ok flag;
            do {
                ok = 0;
                w = NextWord();
                if (w == 'pigeon' or 'hole' or 'pigeonhole' ||
                    w == 'holes' or 'pigeonholes' or 'mr' ||
                    w == 'professor' or 'doctor' or 'mister' ||
                    w == 'prof' or 'dr' or 'rev' ||
                    w == 'reverend') {
                    j ++; ok = 1;
                }
                if (w == 'johnson' or 'johnson^s') {
                    j ++; ok = 1; flag = 1; self.number = -1;
                }
                if (w == 'malcolm' or 'malcolm^s') {
                    j ++; ok = 1; flag = 1; self.number = -2;
                }
                for (i=player+1: ok==0 && flag==0 && i<=top_object: i++) {
                    if (i has is_door && (w == ((i.&name)-->1) ||
                        w == ((i.&name)-->2))) {
                        flag = 1;
                        ok = 1;
                        j ++;
                        self.number = i;
                    }
                }
            } until (ok == 0);
            return j;
        ],
         description "Há centenas de escaninhos, um para cada membro e \
             estudante do college, identificados apenas pelo sobrenome. Você \
             terá de especificar qual quer. Para se referir ao escaninho de \
             alguém, use o sobrenome; por exemplo, ~escaninho de Johnson~.",
        short_name [;
            switch (self.number) {
             -1: print "Johnson";
             -2: print "Malcolm";
              0: print "os escaninhos"; rtrue;
             default: RoomOccupant(self.number);
            }
             print " de ";
            rtrue;
        ],
        capacity 2,
        number 0,
        before [ i;
            if (self.number == -2)
             "Infelizmente, os escaninhos trazem apenas sobrenomes.";
            if (self.number == -1)
             "Johnson era apenas um exemplo. Não existe tal pessoa.";
            if (self.number == 0) rfalse;
         Examine, Search:
                if (Edward in location) {
                 if (self.number == DoorB5)
                     print "Edward diz: ~Não acho que você encontre algo no \
                         meu escaninho. Ninguém jamais me envia cartas.~^^";
                else
                     print "Edward sussurra: ~Você tem certeza? Vasculhar os \
                         escaninhos dos outros sem permissão?~^^";
            }
            else
                 print "Você verifica se o porteiro não está olhando para você \
                     e vasculha rapidamente ",
                    (name) self, ". ";
            if (child(self.number) == nothing)
                "Você só encontra o boletim da capela e outros papéis inúteis. \
                 Você os deixa onde estão.";
            print "Você retira ";
            WriteListFrom(child(self.number), PARTINV_BIT + ENGLISH_BIT);
            while (child(self.number) ~= nothing) {
                i = child(self.number);
                ResetVagueWords(i);
                move i to player;
            }
            ".";
         Receive:
            if (children(self.number) >= self.capacity)
                 print_ret (name) self, " está cheio.";
            move noun to self.number;
            print_ret "Você coloca ", (the) noun, " em ", (the) self, ".";
         SmellThing: "Os escaninhos cheiram a madeira envernizada e papel úmido.";
        ],
        each_turn [; self.number = 0; ];

Nearby  GateList "lista do portão"
 has    static
 with   name "college" "gate" "list",
         description "É uma lista dos membros e estudantes do college \
             Biblioll, com os números de seus quartos. Você pode procurar \
             sobrenomes ou números de quarto.",
         initial "A lista do portão do college está pregada na parede.",
        before [ i w n;
         Consult:
            DoneHint(MalcolmsRoomPuzzle,1);
            wn = consult_from;
            if (consult_words == 2) {
                w = NextWord();
                if (w == 'professor' or 'prof' or 'mister' ||
                    w == 'mr' or 'doctor' or 'dr' ||
                    w == 'reverend' or 'rev') {
                    n = 1;
                    consult_words --;
                }
            }
            if (consult_words == 1) {
                w = NextWord();
                if (w == 'malcolm')
                    "Infelizmente, a lista do portão contém apenas sobrenomes.";
                for (i = player + 1: i <= top_object: i++) {
                    if (i has is_door) {
                        if (n == 0 && w == (i.&name)-->0)
                            print_ret "Segundo a lista do portão, o quarto ",
                                (string) i.room, " é ocupado por ",
                                (RoomOccupant) i, ".";
                        if (w == (i.&name)-->1)
                            print_ret "Segundo a lista do portão, ",
                                (RoomOccupant) i, " mora no quarto ",
                                (string) i.room, ".";
                    }
                }
            }
             "Você não encontra o que procura na lista do portão.";
        ];

Object  KeyToA5 "chave de ferro"
 class  KeyClass
        ! general if given to player
         with   name "ferro" "chave" "iron",
        article [;
            if (listing_together.list_together == self.list_together)
                print "uma";
            else print "uma";
        ];

Object  KeyRing "chaveiro" Porter
         with   name "anel" "de" "chaves" "reserva" "chave" "ring" "of" "keys" "spare" "key",
        description [;
            print "Um grande anel de metal, com talvez trinta chaves penduradas \
                 nele";
            if (KeyToA5 hasnt general) 
                print ". Sem dúvida há entre elas uma chave reserva do quarto \
                     de seu irmão. Se ao menos você soubesse como convencer o \
                     porteiro a entregá-la";
            ".";
        ],
        before [;
         Take, Remove, Point:
            DoneHint(MalcolmsRoomPuzzle,3,4,5);
            if (Porter has general) {
                if (KeyToA5 has general)
                    "~Eu não acabei de lhe dar a chave do quarto de Malcolm?~ \
                     pergunta o porteiro.";
                give KeyToA5 general;
                move KeyToA5 to player;
                ResetVagueWords(KeyToA5);
                Achieved("acquiring the key to Malcolm's room");
                "~Ah, Malcolm está por aí?~ diz o porteiro. ~Aqui, pegue a \
                chave dele e espere por ele.~ O porteiro tira uma chave do \
                molho e a entrega a você.";
            }
            "O porteiro protege as chaves com a mão. ~Afaste-se delas!~ rosna. \
             ~Quem você pensa que é?~";
        ];


!--------------------------------------------------------------------------
! 3.2 "A" STAIRCASE
!--------------------------------------------------------------------------

Object  AStairGround "Escadaria ~A~, Térreo"
 has    light
 with   name "stair" "stairs" "first" "court" "doorway",
         description "Este corredor cheira a verniz antigo e sabão carbólico. \
             A leste fica a porta de A1; a oeste, a porta de A2; escadas \
             levam para cima, e uma porta leva ao sul, ao Primeiro Pátio.",
        u_to AStairFirst,
        n_to AStairFirst,
        s_to FirstCourt,
        out_to FirstCourt,
        e_to DoorA1,
        w_to DoorA2,
        edward_dirs s_obj;
Nearby  DoorA1 "x" class DoorClass
 with   name "A1" "Nudd" "Nudd^s", honorific reverend,
        room "A1", occupant "Nudd", door_dir e_to;
Nearby  DoorA2 "x" class DoorClass
 with   name "A2" "Pidduck" "Pidduck^s",
        room "A2", occupant "Pidduck", door_dir w_to;

Object  AStairFirst "Escadaria ~A~, Primeiro Andar"
 has    light
 with   name "stair" "stairs" "placard",
         description "Um cartaz na parede deste patamar estreito diz: \
             ~É estritamente proibido receber mulheres em quartos de \
             estudantes, sob pena de expulsão. Por ordem do tesoureiro.~ \
             Você se sente claramente indesejada. A leste fica A3; a oeste, \
             A4; escadas rangentes levam ao segundo andar e descem ao térreo.",
        u_to AStairSecond,
        d_to AStairGround,
        e_to DoorA3,
        w_to DoorA4,
        edward_dirs d_obj;
Nearby  DoorA3 "x" class DoorClass
 with   name "A3" "Kisbee" "Kisbee^s", honorific doctor,
        room "A3", occupant "Kisbee", door_dir e_to;
Nearby  DoorA4 "x" class DoorClass
 with   name "A4" "Trembath" "Trembath^s",
        room "A4", occupant "Trembath", door_dir w_to;

Object  AStairSecond "Escadaria ~A~, Segundo Andar"
 has    light
 with   name "stair" "stairs" "skylight",
         description "Uma claraboia suja deixa entrar um pouco de luz neste \
             patamar do segundo andar. A leste fica A5; a oeste, A6; e escadas \
             rangentes descem ao primeiro andar.",
        d_to AStairFirst,
        e_to DoorA5,
        w_to DoorA6,
        edward_dirs d_obj;

Nearby  DoorA6 "x" class DoorClass
 with   name "A6" "Guzewich" "Guzewich^s", honorific doctor,
        room "A6", occupant "Guzewich", door_dir w_to;

Object  DoorA5 "x"
 class  DoorClass
 with   name "A5" "Spencer" "Spencer^s",
        room "A5",
        occupant "Spencer",
        honorific doctor,
        with_key KeyToA5,
        found_in AStairSecond MalcolmsRoom,
        door_dir [;
            if (self in AStairSecond) return e_to;
            return w_to;
        ],
        door_to [;
            if (self in AStairSecond) return MalcolmsRoom;
            return AStairSecond;
        ],
        before [;
         Open,Knock:
            DoneHint(MalcolmsRoomPuzzle,1,2);
        ];


!------------------------------------------------------------------------------
! 3.3 MALCOLM'S ROOMS
!------------------------------------------------------------------------------

Object  MalcolmsRoom "Escritório de Malcolm"
 has    light no_edward proper
        ! general if player heard about Malcolm in Edinburgh
  with   description "Seu coração afunda quando você olha ao redor. O quarto \
             foi completamente revirado: os móveis foram virados de cabeça \
             para baixo e os papéis de Malcolm estão rasgados e espalhados \
             pelo chão. Você pode voltar ao patamar do segundo andar, a oeste, \
             ou passar para outro quarto ao sul.",
        initial [;
            if (self has visited) rfalse;
            Achieved("entering Malcolm's room");
            PuzzleSolved(MalcolmsRoomPuzzle);
            DoneHint(WhatNextPuzzle,2);
            if (self has general)
                 "Você atravessa a porta, esperando que Malcolm tenha deixado \
                 um bilhete explicando sua ausência, ou talvez um caderno \
                 descrevendo suas pesquisas misteriosas, mas nada prepara \
                 você para o que vê lá dentro.";
             "Você atravessa a porta, esperando encontrar seu irmão \
             trabalhando e pronta para impressioná-lo com a história de como \
             foi difícil encontrá-lo, mas ele não está aqui.";
        ],
        w_to AStairSecond,
        out_to AStairSecond,
        s_to DoorwayA5,
        in_to DoorwayA5;

Object  MalcolmsBedroom "Quarto de Malcolm"
 has    light no_edward
         with   name "quarto" "escritório" "ladrão" "ladrões" "bedroom" "study" "burglar" "burglars",
         description "Assim como o escritório, o quarto de Malcolm foi \
             completamente revistado. A cama foi desmontada como lenha, o \
             colchão e os travesseiros foram rasgados, e há penas por toda \
             parte. Fosse o que fosse que os ladrões procuravam, queriam muito. \
             Uma porta leva de volta ao escritório, ao norte.",
        n_to [;
            if (Jarboe in MalcolmsRoom && Jarboe hasnt general) {
              Jarboe.state = 7;
                  "Você espia pela esquina, esperando observar Jarboe e \
                 Bungay sem ser vista, mas, assim que põe a cabeça pela porta, \
                  Bungay olha para cima. ~O que é isso?~ \
                 ele grita. ~Uma espiã!~^^Você recua para o quarto enquanto os \
                 dois homens caminham até você.";
            }
            if (Jarboe in self) {
                if (Jarboe.state < 10)
                    "Você tenta passar pelos dois homens, mas Bungay bloqueia \
                     seu caminho com seu corpanzil. ~Devagar,~ ele diz. ~Ainda \
                     não terminamos com você.~";
                "Jarboe empurra você para trás quando tenta passar pelos dois \
                 homens. ~Lembre-se do que dissemos,~ ele rosna.";
            }
            return DoorwayA5;
        ],
        s_to [;
            if (WindowA5 has open)
             "Não faça isso! Seria suicídio!";
            return WindowA5;
        ],
        before [;
         Sing:
            if (Jarboe in MalcolmsRoom)
                 "Não é hora de cantar: os homens no quarto ao lado vão ouvir você!";
        ];

! Hide one or two useful things in the junk?
! name doesn't include "lab" or "laboratory" because of the lab book
Object  Junk "entulho"
 has    scenery
 with   name "junk" "furniture" "paper" "papers" "feathers" "bed" 
            "mattress" "pillow" "firewood" "wood" "rubbish",
         description "Você vasculha cuidadosamente os entulhos, mas quem \
             revirou o quarto os destruiu por completo.",
        article "some",
        before [;
         Search: <<Examine self>>;
         Enter:
             "Todos os móveis foram quebrados em pedaços, e não há como você \
             se esconder neles.";
         Examine: rfalse;
         default:
             "Não adianta. Tudo foi destruído.";
        ],
        found_in MalcolmsRoom MalcolmsBedroom;

Object  DoorwayA5 "porta"
 has    scenery door open
 with   name "doorway",
         description "Uma porta comum, posicionada de modo que não seja fácil \
             enxergar de um quarto para o outro.",
        found_in MalcolmsRoom MalcolmsBedroom,
        door_to [;
            if (self in MalcolmsRoom) return MalcolmsBedroom;
            else return MalcolmsRoom;
        ],
        door_dir [;
            if (self in MalcolmsRoom) return s_to; else return n_to;
        ],
        before [;
         Search: <<Enter self>>;
        ];          

Object  WindowA5 "janela" MalcolmsBedroom
 has    openable static door
 with   name "window" "sash",
         description "Uma janela comum de guilhotina. Ela lembra a janela do \
             quarto de seu irmão em casa.",
         when_closed "Uma janela fechada dá para o sul, para o Primeiro Pátio.",
         when_open "Uma janela aberta dá para o sul, para o Primeiro Pátio.",
        before [;
         Examine:
            print (string) self.description, " ";
            <<Search self>>;
         Search:
             print "Olhando pela janela, você vê o pátio abaixo";
            if (self has open)
                 print ". Você se inclina pela janela e nota hera agrupada \
                     ao redor da moldura";
            ".";
         ThrownAt,Receive:
             if (self hasnt open) "Você já quebrou janelas o bastante por um \
                 dia.";
            move noun to FirstCourt;
             print_ret (The) noun, " voa pela janela aberta.";
        ],
        after [;
         Open: move Ivy to MalcolmsBedroom;
         Close: remove Ivy;
        ],
        door_dir s_to,
        door_to FirstCourt;

Object  Ivy "hera"
 has    static concealed
        ! general if you've found the concealed book
  with   name "hera" "trepadeira" "ivy" "creeper" "vine",
        article "some",
        before [;
         Climb: <<Enter WindowA5>>;
         Receive:
            move noun to FirstCourt;
             print_ret "Você não é tão boa nesse tipo de coisa quanto seu irmão. \
                 Inclinada para fora da janela, dois andares acima do Primeiro \
                 Pátio, você fica tonta e solta ", (the) noun, ", que cai no chão.";
         Examine, Search:
            if (self hasnt general) {
                give self general;
                move BookLab to player;
                ResetVagueWords(BookLab);
                Achieved("finding Malcolm's lab book");
                DoneHint(WhatNextPuzzle,3);
                AdvanceTime(self);
                StartDaemon(Jarboe);
                 "Quando eram crianças, Malcolm nunca conseguia esconder os \
                 brinquedos de você por muito tempo... Inclinada perigosamente \
                 pela janela, você procura na hera e, como esperava, sua mão \
                 encontra um livro escondido entre as folhas!";
            }
        ];

! Code for lab book:
! ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz
! CHRISTABELDFGJKMNOPQUVWXYZchristabeldfgjkmnopquvwxyz

Object  BookLab "livro de laboratório"
 class  BookClass
         with   name "laboratório" "livro" "molhado" "danificado" "lab" "laboratory" "wet" "damaged",
         description "O livro de laboratório está bastante deteriorado, pois \
             ficou exposto à chuva, e a caligrafia de Malcolm era péssima mesmo \
             nas melhores condições. Na verdade, a única página minimamente \
             legível parece cheia de palavras e números sem sentido:^\
            ^    Fuffy 364^\
            ^Qbs teopq qwk cos rfsco:^\
            ^    Codwoeabq 143 (bkjsy kt Saymq?)\
            ^    Lkbj 11:43 (hcqb kt Deja?)^\
            ^Msobcmp Pegkj Jkhfs'p fejsp kj Bsfekachcfup,^\
            ^    Tko E bcvs wsmq gkos qscop qbcj s'so\
            ^    Qbs cjresjq pcas iei wssm cq gcj'p\
            ^    aoscq tkffy...^\
            ^cos c rfus qk qbs qbeoi?",
        before [;
         Take, Remove, Examine:
            if (self in Jarboe)
                 "Jarboe segura o livro de laboratório fora do seu alcance. \
                 ~Você queria alguma coisa?~ ele zomba.";
          SmellThing: "Está muito úmido e mofado.";
        ];

Object  CodeBookNote "bilhete" DoorA5
 class  FlimsyClass
 with   name "note",
        size 0,
         description "O bilhete diz: ~Caro Malcolm, obrigado por devolver \
             Zinovic, fico muito grato, Sr. Baskeyfield.~";


!--------------------------------------------------------------------------
! 3.4 DOCTOR JARBOE AND PROFESSOR BUNGAY
!--------------------------------------------------------------------------

Object  Jarboe "Doutor Jarboe"
 class  FollowClass CarryingClass TalkableClass
 has    proper
  with   name "doutor" "doctor" "dr" "jarboe" "fellow",
         description "Jarboe é um homem alto e esquálido, com membros finos e \
             desajeitados e um nariz longo e pontudo. Seu terno pende dos \
             ombros estreitos.",
        state 0,
        life [;
          Kiss: "Eca! Que sugestão horrível.";
         Attack:
             print "Jarboe dá um tapa no seu rosto, e você cambaleia para trás. \
                 ~Pare com isso, menina patética!~ ele grita. Você começa a \
                 chorar, e as lágrimas escorrem pelo seu rosto.^";
            move TearsA to player;
            StartTimer(TearsA,3);
            if (Edward in location)
                 "^Edward corre para o seu lado, com ar ameaçador, mas Jarboe rosna \
                 para ele. ~Não se meta nisso, Forbes, não é da sua conta.~^";
            rtrue;
          Show, Give: "Jarboe afasta sua oferta com desprezo.";
        ],
        orders [;
         Give: 
            if (noun == BookLab && BookLab in self)
                <<Take BookLab>>;
        ],
        before [;
          Speak: "~Cale a boca!~ rosna Jarboe.";
         Invoke:
            if (BookLab notin self && LineOfSight(self, BookLab) == 1) {
                move BookLab to self;
                if (self in location || (self in FirstCourt &&
                    location == AStairGround)) {
                 print "^~Ahá! O que temos aqui?~ grita Jarboe, exultante";
                     if (self in location)
                         print ", pegando o livro de laboratório";
                     print ". ~Parece o livro de laboratório de Spencer! É \
                         exatamente o que procurávamos! Excelente!~^";
                }
            }
            rtrue;
        ],
        daemon [ dest dir;
            self.state = self.state + 1;

            ! Jarboe will steal the lab book if he sees it
            <Invoke self>;

            ! Move Jarboe and Bungay around
            switch (self.state) {
              7: dest = MalcolmsBedroom; dir = s_obj;
             12: dest = MalcolmsRoom; dir = n_obj;
             13: dest = AStairSecond; dir = w_obj;
             14: dest = AStairFirst; dir = d_obj;
             15: dest = AStairGround; dir = d_obj;
             16: dest = FirstCourt; dir = s_obj;
            }
            
            ! Actually move them
            if (dest ~= 0) {
                if (self in location) {
                     print "^Jarboe e Bungay seguem ";
                     if (dir ~= u_obj or d_obj) print "para o ";
                    PrintDirection(dir);
                    print ".^";
                }
                MoveNPC(Jarboe, dest, dir);
                MoveNPC(Bungay, dest, dir);

                ! Look for the lab book in the new location
                <Invoke self>;
            }

            ! Now go through what they say to each other
            switch (self.state) {
             1:
                move Jarboe to MalcolmsRoom;
                move Bungay to MalcolmsRoom;
                new_line;
                if (DoorA5 has locked)
                     print "Você ouve uma chave girar na porta do quarto de \
                         Malcolm, e depois a porta se abrir.^^";
                if (DoorA5 hasnt locked && DoorA5 hasnt open)
                     print "Você ouve a porta do quarto de Malcolm se abrir.^^";
                give DoorA5 open ~locked;
                 "Pela porta, você ouve vozes vindas do escritório de Malcolm. \
                 ~Bem, Jarboe, acho que devemos olhar mais uma vez,~ diz uma \
                 voz grave. ~Tenho certeza de que ele o escondeu em algum \
                 lugar por aqui.~^^~Depois de você, Bungay,~ responde uma voz \
                 fina e estridente, que você supõe ser a de Jarboe.";
             2:
                 "^Pela porta, você ouve vozes vindas do escritório de Malcolm. \
                 ~O que não entendo,~ diz Bungay, ~é como aquele homem danado \
                 conseguiu descobrir a fórmula. Ele é químico, deveria estar \
                 brincando com seus tubos de ensaio e coisas do tipo. Não \
                 deveria saber nada de pesquisa histórica.~^^Você ouve os dois \
                 remexendo nos escombros.";
             3:
                 "^Pela porta, você ouve vozes vindas do escritório de Malcolm. \
                 ~Ele é um tremendo incômodo,~ diz Jarboe, ~você tem razão. \
                 Mas não cometa o erro de subestimar os cientistas.~";
             4:
                 "^Pela porta, você ouve vozes vindas do escritório de Malcolm. \
                 ~Só porque os cientistas lidam com o físico e o concreto,~ \
                 continua Jarboe, ~isso não significa que sejam estúpidos.~";
             5:
                 "^Pela porta, você ouve vozes vindas do escritório de Malcolm. \
                 ~Hmm, não pela minha experiência,~ murmura Bungay.";
             6:
                 "^Pela porta, você ouve vozes vindas do escritório de Malcolm. \
                 ~Nada aqui,~ diz Jarboe. ~O sujeito foi esperto demais para \
                 nós. Vamos tentar o quarto.~^^Você ouve passos se aproximando \
                 da porta.";
             7,8:
                self.state = 8;
                if (self notin MalcolmsBedroom) {
                    MoveNPC(self, MalcolmsBedroom, s_obj);
                    MoveNPC(Bungay, MalcolmsBedroom, s_obj);
                }
                give self general;
                 "^~Veja, veja, veja,~ diz Jarboe a Bungay. ~O que temos aqui? \
                 Uma garotinha se esgueirando pelo quarto de Malcolm Spencer. \
                 Quem é ela? A namoradinha de Spencer, veio procurá-lo? É isso? \
                 Ela parece exatamente o tipo dele.~";
             9:
                 "^~Não, acho que ela é irmã dele,~ diz Bungay. ~Veja a semelhança \
                 familiar. Acho que veio esperando passar um dia agradável no rio. \
                 Bem,~ continua, dirigindo-se a você, ~ele não está aqui. Foi \
                 embora, escapou.~";
             10:
                 "^Jarboe agita o dedo e aponta para você. ~Vá para casa e esqueça \
                 esse seu passeio. Ouviu?~ pergunta. ~Isso entrou nessa sua cabecinha \
                 estúpida? Vá para casa e não se meta nisso.~";
             11:
                 print "^Bungay se vira para o colega. ~Já perdemos tempo demais \
                     aqui, e há muito a fazer antes desta noite. Telefonarei depois \
                     das cinco com os detalhes.";
                if (BookLab in self)
                     print " Avise-me o que descobrir no livro de laboratório.";
                "~";
             18:
                if (self in location) {
                    if (BookLab in self)
                         print "^Jarboe folheia o livro de laboratório. ~Que \
                             pena,~ diz ele. ~Alguém foi descuidado o bastante para \
                             deixá-lo na chuva. Ainda assim, temos outros caminhos \
                             a seguir.~^";
                     "^~Olhe, ela está nos seguindo,~ diz Bungay ao notar você.^^Jarboe \
                     se vira. ~Você não entendeu o recado? Deixe em paz aquilo que \
                     não consegue compreender.~";
                }
             19:
                MovePrintNPC(self, BStairGround, se_obj);
                MovePrintNPC(Bungay, SecondCourtArchway, e_obj);
             21:
                MovePrintNPC(self, BStairFirst, u_obj);
                if (Bungay in location)
                     print "^Bungay segura a grande porta de madeira na extremidade \
                         leste do arco e empurra. Ela se abre com um rangido alto.^";
                give DoorArchway open;
                MovePrintNPC(Bungay, SecondCourt, e_obj);
             22:
                if (self in location)
                     print "^Jarboe destranca a porta de B4, atravessa-a e a fecha. \
                         Você o ouve trancá-la.^";
                if (BookLab notin self)
                    Achieved("hiding Malcolm's lab book from Doctor \
                        Jarboe");
                MoveNPC(self, JarboesSanctum, w_obj);
                MovePrintNPC(Bungay, CStairGround, e_obj);
             23:
                MovePrintNPC(Bungay, CStairFirst, u_obj);
             24:
                if (Bungay in location)
                     print "^Bungay destranca a porta de C3, atravessa-a e a fecha. \
                         Você o ouve trancá-la.^";
                MoveNPC(Bungay, BungaysSanctum, w_obj);
                StopDaemon(self);
            }
            if (self.state <= 24) rtrue;
            print_ret "** Error: bad line in Jarboe's script: ", self.state,
                " **";
        ];

Object  Bungay "Professor Bungay"
 class  FollowClass CarryingClass TalkableClass
 has    proper
        ! general if spoken to Edward Forbes
 with   name "professor" "prof" "bungay" "fellow",
         description "Bungay é um homem baixo, pouco mais de um metro e meio, \
             um pouco mais baixo que você, mas seu enorme corpanzil compensa \
             de sobra a falta de altura. Suas roupas quase arrebentam nas \
             costuras.",
        life [;
          Kiss: "Eca! Que sugestão horrível.";
         Show,Give:
             "~Não tenho interesse nisso, seja lá o que for,~ diz Bungay sem \
             olhar para sua oferta. ~Sou um homem ocupado e não tenho tempo \
             para ninharias.~";
          Attack: "Bungay provavelmente pesa quatro ou cinco vezes mais que \
              você. Seria loucura atacá-lo.";
        ],
        before [;
          Speak: "~Fique quieta, menina,~ diz Bungay com algum desgosto.";
        ];

Object  JarboesSanctum "Escritório de Jarboe";
Object  BungaysSanctum "Sala de estar de Bungay";

!--------------------------------------------------------------------------
! 3.5 THE MASTER'S LODGE
!--------------------------------------------------------------------------

Object  DoorMaster "porta dos Alojamentos do Reitor"
 has    door lockable openable locked scenery autoopen
 with   description [;
             print "A porta dos Alojamentos do Reitor é feita de madeira \
                 espessa e pesada";
            if (location == FirstCourt)
                 print ". Há um cordão de campainha de um lado";
            ".";
        ],
        name "porta" "reitor" "alojamentos" "door" "master^s" "lodge" "lodgings" "lodging" "masters",
        found_in FirstCourt MastersLodge,
        article "the",
        door_dir [;
            if (self in FirstCourt) return ne_to; else return sw_to;
        ],
        door_to [;
            if (self in FirstCourt) return MastersLodge;
            else return FirstCourt;
        ],
        with_key 0,
        before [;
          LookUnder: "A fresta é estreita demais para você enxergar algo.";
         Knock,Attack:
            if (Edward in FirstCourt && self in FirstCourt)
                 "Edward diz: ~Não bata, use o cordão da campainha.~";
            if (self in FirstCourt)
                 "Ninguém responde. Talvez você deva tentar o cordão da campainha.";
            else
                 "Não há motivo para bater para sair!";
         Close:
            if (HouseKeeper in FirstCourt)
                 "Não com a governanta bloqueando a passagem.";
        ];

Object  BellPull "cordão da campainha" FirstCourt
 has    static concealed
        ! general if rung before
         with   name "campainha" "cordão" "bell" "pull" "bell-pull" "doorbell" "door-bell",
        before [;
          Push: "Talvez você devesse tentar puxá-lo.";
         Ring, Pull:
            if (HouseKeeper in location)
                 "~O Reitor não vai descer, não importa quantas vezes você toque \
                 a campainha,~ diz a governanta. ~Você terá de entrar sozinha.~";
             print "Você puxa o cordão e ouve uma campainha distante";
            if (ClockTower.number > 19)
                 ", mas ninguém vem atender à porta.";
             print ". Então você ouve passos descendo uma escada, ";
            if (DoorMaster hasnt open)
                 print "e o ruído de uma chave na fechadura. ";
            if (self hasnt general) {
                give DoorMaster ~locked open;
                give self general;
                MoveNPC(HouseKeeper, FirstCourt, 0);
                StartTimer(HouseKeeper, 3);
                 "A porta se abre, e você se vê diante de uma jovem usando o avental \
                 e o vestido xadrez de uma governanta. ~Entre, por favor,~ diz ela.";
            } else {
                if (DoorMaster has open)
                     print "e a governanta vem até a porta. ~Que cabeça a minha,~ \
                         diz ela. ~Devo tê-la deixado aberta. ";
                else
                     print "e a porta se abre, revelando novamente a governanta. ~";
                give DoorMaster ~open;
                 "Receio que o Reitor esteja ocupado e não possa receber ninguém \
                 agora. Talvez algum dia na próxima semana.~ Ela fecha a porta e \
                 você ouve seus passos se afastando.";
            }
        ];

Object  HouseKeeper "governanta"
 class  FollowClass CarryingClass TalkableClass
 has    female
        ! general if told you about dinner
  with   name "casa" "governanta" "house" "keeper" "housekeeper" "bonita" "jovem" "mulher" "pretty" "young" "woman",
        description [;
             print "A governanta é uma jovem bonita, talvez cinco anos mais velha \
                 que você (mas é indelicado investigar demais a idade de uma mulher, \
                 então você não segue essa linha de pensamento). Ela usa um vestido \
                 xadrez e um avental";
            if (self in MastersLodge)
                 print ". Ela está ocupada polindo uma taça de prata";
            print ".";
        ],
        describe [;
             print "^A governanta está ";
             if (self in FirstCourt) "junto à porta dos Alojamentos do Reitor.";
             "aqui, polindo uma taça de prata.";
        ],
        life [;
            <<Question self>>;
        ],
        before [;
         Question: 
            if (second == QHello)
                 "~Bom dia para você também,~ diz ela.";
            if (self hasnt general || random(2) == 1) {
                give self general;
                 print "~Não tenho tempo para isso,~ diz a governanta. ~Estou muito \
                     ocupada hoje: toda a prataria precisa ser polida para o jantar \
                     desta noite. ";
            }
            else
                 print "~Não sei nada sobre isso,~ diz a governanta. ~Mas tenho \
                     certeza de que o Reitor poderá ajudá-la; ele é muito inteligente. ";
             if (self in FirstCourt) "Entre, por favor.~";
             "Suba, por favor.~";
        ],
        time_left 0,
        time_out [;
            give DoorMaster ~open locked;
            MoveNPC(self, 0, ne_obj);
            if (player in FirstCourt)
                 "^~Não posso ficar aqui tagarelando o dia todo,~ diz a governanta. \
                 ~Tenho prataria para polir.~ Ela fecha a porta, e você a ouve \
                 trancar.";
        ];

Object  MastersLodge "Alojamentos do Reitor"
 has    light no_edward
        ! general if visited
 with   name "gingham" "pinafore" "apron" "thick" "carpet" "wooden"
            "stairs",
         description "Um saguão de entrada ricamente decorado, com um tapete espesso \
             que abafa seus passos e uma lareira coberta de prataria antiga. O \
             Biblioll College deve ter acumulado muito dinheiro em seus quase \
             setecentos anos de história para permitir que o Reitor viva com tanto \
             luxo. Uma escada sobe, e uma grande porta leva ao sudoeste.",
        initial [;
            if (self has general) rfalse;
            give self general;
            give DoorMaster ~open;
            MoveNPC(HouseKeeper, self, ne_obj);
            StopTimer(HouseKeeper);
             "A governanta entra atrás de você e fecha a porta. ~O Reitor está em \
             seu escritório no andar de cima, suba.~ Ela pega uma grande taça de \
             prata e começa a poli-la.";
        ],
        sw_to DoorMaster,
        out_to DoorMaster,
        u_to MastersStudy,
        in_to MastersStudy,
        before [;
         Go,Enter:
            if (parent(TelephoneHandset) ~= nothing or location) {
                move TelephoneHandset to location;
                Telephone.state = 0;
                 print "(colocando primeiro o fone do telefone no lugar)^";
            }
        ],
        each_turn [;
            if (HouseKeeper notin self) {
                self.each_turn = NULL;
                DoneHint(WhatNextPuzzle,21);
            }
        ];

Object  Mantelpiece "lareira" MastersLodge
 has    scenery supporter
 with   name "mantel" "piece" "mantelpiece",
        capacity 5;

Nearby  SilverPlate "prataria"
 has    scenery
 with   name "goblet" "goblets" "silver" "plate" "plates" "silverware" 
            "ware" "antique" "old" "ancient",
         description "As taças, pratos e outras peças de prata são muito \
             antigas e, você tem certeza, imensamente valiosas.",
        before [;
          Take,Remove: "Lembre-se do escândalo quando sua mãe acusou a criada de \
             roubar uma faca da gaveta de prata e, somente depois de a pobre moça \
             ser demitida, ela foi encontrada no galpão de jardinagem. Você não \
             quer causar esse tipo de problema para a governanta.";
        ];

Object  MastersStudy "Estudo do Reitor"
 has    light no_edward
        ! general if just visisted
 with   name "leather" "armchair" "stairs" "goatee" "beard" "chair" 
            "bindings",
         description "Como a sala de recepção abaixo, o estudo do Reitor é \
             luxuoso. Você já viu salas mais caras, mas nenhuma com tamanha \
             sensação de permanência. As paredes estão cobertas por centenas \
             de livros, e no centro há uma grande poltrona de couro. Escadas \
             levam para baixo.",
        initial [;
            StartTimer(Master,0);
            Achieved("visiting the Master of Biblioll College");
            DoneHint(WhatNextPuzzle,5);
            AdvanceTime(self);
            give self general;
        ],
        d_to MastersLodge,
        out_to MastersLodge,
        before [;
         Go:
            if (noun ~= d_obj or out_obj) rfalse;
            StopTimer(Master);
            give DoorMaster ~open ~locked;
            if (HouseKeeper in MastersLodge)
                 print "~Adeus, então. Foi um prazer conhecê-la";
            else
                 print "~Adeus, então. É sempre bom vê-la";
             print ",~ diz o Reitor quando você parte. ~A governanta a \
                 acompanhará até a saída.~^^Ela a conduz rapidamente ao pátio e \
                 fecha a porta. Você ouve seus passos se afastando.^";
            PlayerTo(FirstCourt,1);
            LookSub(1);
            move HouseKeeper to FirstCourt;
            MoveNPC(HouseKeeper, 0, ne_obj);
            move TelephoneHandset to MastersLodge;
            rtrue;
         Smell: <<SmellThing MastersBooks>>;
        ];

Nearby  MastersBooks "biblioteca do Reitor"
 has    scenery
        ! general if given you a book
 with   name "book" "books" "hundreds" "of" "master^s" "library",
         description "Há centenas deles, com as encadernações de couro \
             rachadas pela idade. Evidentemente, uma coleção acumulada ao longo \
             dos séculos. Os nomes nas lombadas não significam muito para você.",
        article "the",
        state 0,
        before [;
          SmellThing: "Mmmm... você respira o glorioso aroma de papel se \
             desfazendo e couro rachado, e se lembra das longas tardes de verão \
             na biblioteca de casa, lendo preguiçosamente o último Evelyn Waugh.";
         Take:
            Master.time_left = Master.time_left + 1;
            if (Master.state <= 4)
                 "~Desista!~ ordena o Reitor. ~Não sei quem você é; por que \
                 deveria deixá-la olhar meus livros?~ Você desiste.";
            if (self has general)
                 "O Reitor já lhe emprestou um livro. Você decide não abusar da \
                 sorte.";
            if (Master.state == 6 or 7 or 8)
            "~Sim, eu sei,~ diz o Reitor, ~mas qual?~";
            Master.state = 6;
             "~Você quer um dos meus livros?~ pergunta o Reitor. ~Bem, suponho que \
             possa lhe emprestar um enquanto estiver no college. Qual você gostaria?~";
        ];

Nearby  Master "Reitor do college Biblioll"
 class  FollowClass CarryingClass TalkableClass
        ! general if he's told you to wander around
 with   name "Master" "of" "biblioll" "college" "man",
        article "the",
        state 0,
         description "O Reitor é um homem velho, mas vivaz e ainda bonito. Sua \
             barba cavanhaque é preta.",
         initial "O Reitor do college Biblioll está sentado na poltrona, lendo \
             um jornal.",
        life [;
         Kiss:
             "Você dá um beijo na bochecha do Reitor. Ele o aceita como se fosse \
             seu privilégio, enquanto Reitor do college, ser beijado por toda jovem \
             visitante.";
         Show,Give:
            self.time_left = self.time_left + 1;
            if (noun == BookArkwright or BookBarker) {
                give MastersBooks ~general;
                remove noun;
                 "~Espero que tenha gostado,~ diz o Reitor, devolvendo o livro às \
                 prateleiras.";
            }
            if (self.state > 4)
                 "~Muito interessante,~ diz o Reitor.";
            if (noun == Telegram) {
                self.state = 5;
            "O Reitor examina o telegrama atentamente. ~Ah,~ diz ele. ~Você é \
                 irmã de Spencer! Bem-vinda ao Biblioll College. Em que posso \
                 ajudá-la?~";
            }
            print_ret "O Reitor examina ", (the) noun, ". ~Muito bem,~ diz ele, \
                 ~mas isso não me ajuda a saber quem você é.~";
        ],
        before [;
         Examine: quote = 19;
         Question:
            Master.time_left = Master.time_left + 1;
            if (self.state <= 4)
                 "~Por mais que eu gostasse de conversar com você,~ diz o Reitor, \
                 ~não posso fazê-lo sem saber quem você é. Não poderia mostrar \
                 alguma prova de identidade?~";
            if (second == QBooks)
                <<Take MastersBooks>>;
            if (self.state == 6 or 7 or 8) {
                self.state = 5;
                if (MastersBooks.state > 1)
                     print "~Não tenho certeza de que quero que minha coleção \
                         particular seja tratada como uma biblioteca pública,~ diz o \
                         Reitor, ~mas, só para você...~ ";
                MastersBooks.state = MastersBooks.state + 1;
                give MastersBooks general;
                 print "O Reitor procura nas prateleiras. ";
                if (second == QArkwright or QEgypt or QAkhenaten) {
                    move BookArkwright to player;
                    ResetVagueWords(BookArkwright);
                    Achieved("borrowing a copy of Arkwright from the \
                        Master");
                    DoneHint(WhatNextPuzzle,6);
                     "~Aqui está,~ diz ele. ~O período de Amarna. Uma escolha \
                     estranha para uma mulher.~ Ele entrega o livro a você. \
                     ~Wilderspin sempre se interessou por história egípcia; talvez \
                     você queira procurá-lo.~";
                }
                move BookBarker to player;
                ResetVagueWords(BookBarker);
                 "~Não consigo encontrar isso aqui,~ diz ele, ~mas talvez prefira \
                 este.~ Ele busca um volume fino e o entrega a você.";
            }
            switch(second) {
             QDinner:
                if (DinnerTicket has general)
                     "~Espero que venha ao jantar e nos honre com sua presença na \
                     Mesa Principal,~ diz o Reitor.";
                give DinnerTicket general;
                move DinnerTicket to player;
                ResetVagueWords(DinnerTicket);
                Achieved("getting invited to a dinner");
                DoneHint(WhatNextPuzzle,23);
                 "~Ah, sim, o banquete desta noite em comemoração aos benfeitores,~ \
                 diz o Reitor. ~Deve ser uma festa espetacular. Talvez queira vir \
                 sentar-se à Mesa Principal conosco.~ Ele enfia a mão no paletó, \
                 tira um convite e o entrega a você.";
             QHello:
                 "~Olá,~ diz o Reitor. ~Bem-vinda ao Biblioll College!~ Ele sorri \
                 radiante para você.";
             QMalcolm:
                give MalcolmsRoom general;
                 "~Posso ajudá-la com isso,~ diz o Reitor. ~É um pouco \
                 infeliz que tenha vindo hoje, pois seu irmão foi chamado às pressas \
                 para dar um seminário em Edimburgo. Jarboe me contou ontem. Mas \
                 espero que aproveite sua estadia mesmo assim.~";
             QCollege:
                 "~É um belo college, não acha? Fundado em 1275 por John de \
                 Biblioll, Lorde do Castelo de Branham, após uma disputa com o \
                 Bispo de Durham...~ Ele divaga por vários minutos e termina \
                 dizendo que todo tipo de material fascinante sobre o College pode \
                 ser encontrado no tratado definitivo de MacLane sobre o assunto.";
             QHistory:
                 "Você decide não fazer o Reitor começar a falar sobre seu assunto \
                 favorito, pois não está com disposição para uma palestra de dez \
                 minutos.";
             QArkwright, QEgypt, QAkhenaten:
                if (MastersBooks hasnt general) {
                    self.state = 6;
                    self.time_left = self.time_left - 1;
                    <<Question self QArkwright>>;
                }
                 "~Wilderspin sempre se interessou por história egípcia,~ diz o \
                 Reitor. ~Talvez queira procurá-lo sobre isso.~";
             QEdward:
                 "~Nunca ouvi falar desse homem,~ diz o Reitor.";
             QWilderspin:
                DoneHint(WhatNextPuzzle,7);
                 "~Ele é um velho rabugento,~ diz o Reitor. ~Se quiser vê-lo, tente \
                 mostrar algo de seu interesse, como, por exemplo, um livro de \
                 egiptologia.~";
             QJarboe:
                 "~Você conheceu Jarboe?~ pergunta o Reitor. ~Ele é nosso professor \
                 de matemática, um sujeito assustadoramente inteligente, que sabe \
                 tudo sobre variedades riemannianas e coisas desse tipo. Um orgulho \
                 do college.~";
             QBungay:
                 "~Você conheceu Bungay?~ pergunta o Reitor. ~A aparência é um pouco \
                 assustadora, mas ele conhece história. Acho que se especializou no \
                 reinado do rei Filipe IV da França.~";
             QMaths,QFrance:
                 "~Não saberia nada sobre isso,~ diz o Reitor. ~Está muito além da \
                 minha compreensão.~";
             QBaskeyfield:
                 "O Reitor ri da sua pergunta. ~Os bibliotecários do Biblioll College \
                 sempre foram um grupo peculiar,~ diz ele. ~Sempre insistiram que \
                 sabem melhor quais livros devem ir para a biblioteca, não importa o \
                 que o Reitor ou os professores do College tenham a dizer.~";
             QThanks:
                 "~O prazer é meu,~ diz o Reitor.";
             QChapel:
                 "~É um prédio lindo, não acha?~ diz o Reitor. ~Um dos tesouros do \
                 college.~";
             default:
                 "~Hmm, isso é muito interessante,~ diz o Reitor.";
            }
        ],
        orders [;
         Give:
            if (second == player && noun == MastersBooks)
                <<Take MastersBooks>>;
        ],
        time_left 0,
        time_out [;
            if (self notin location) return;
            StartTimer(self,1);
            if (MastersStudy has general) {
                give MastersStudy ~general;
                if (self.state <= 4)
                     "^O Reitor olha para cima quando você entra. ~Olá,~ diz ele. \
                     ~Quem é você e por que quer me ver?~";
                 "^O Reitor olha para cima. ~Você de novo?~ diz ele. ~Estou muito \
                 ocupado no momento, mas talvez possa lhe conceder cinco minutos. \
                 O que você queria?~";
            }
            self.state = self.state + 1;
            switch (self.state) {
              1: "^~Ainda não sei quem você é,~ resmunga o Reitor.";
              2: "^~Seria apenas educado apresentar-se adequadamente,~ diz o Reitor.";
              3: "^~Talvez tenha uma carteira de identidade para me mostrar?~ diz o Reitor.";
              4: "^~Suponho que não tenha uma carta de apresentação?~ diz o Reitor.";
             5: self.state = 0;
                 "^~Sei que é indelicado da minha parte, mas sou exigente com essas \
                 coisas,~ diz o Reitor.";
             6: self.state = 5;
                if (self hasnt general) {
                    give self general;
                     "^~Bem, fique à vontade, passeie e dê uma olhada nos livros,~ \
                     diz o Reitor. ~Eu lhe ofereceria chá, mas a governanta está \
                     ocupada polindo a prataria hoje. Se quiser saber sobre a \
                     história do college, vá à biblioteca e dê uma olhada em \
                     MacLane.~ Ele ergue o jornal e continua lendo as páginas de \
                     negócios.";
                }
                return;
              7: "^~Qual livro você quer?~ pergunta o Reitor.";
              8: "^~Pensei que quisesse olhar um dos meus livros,~ diz o Reitor. \
                 ~Qual era mesmo?~";
             9: self.state = 5;
                MastersBooks.state = MastersBooks.state + 1;
                give MastersBooks general;
                move BookBarker to player;
                ResetVagueWords(BookBarker);
                 "^~Bem, se não tem certeza do que quer,~ diz o Reitor, ~talvez \
                 goste deste.~ Ele busca um volume fino e o entrega a você.";
             default:
                print_ret "** Error: the Master is in the incorrect \
                    state ", self.state, " **";
            }
        ];

Object  Newspaper "jornal" Master
 with   name "newspaper" "paper" "news" "financial" "page" "pages"
            "headline",
         description "O Reitor o dobrou nas páginas financeiras. Você consegue \
             ler a manchete: ~Número de desempregados, 230.000, choca a City!~";

Object  DinnerTicket "convite para jantar"
 class  FlimsyClass
 with   name "dinner" "ticket" "invitation",
        size 0,
        description [;
             print "Você está convidada para jantar na Mesa Principal com o Reitor \
                 e os professores do Biblioll College às 19h em ponto. O traje será \
                 formal";
            if (location == MastersStudy)
                 print ".^^~Mas tenho certeza de que pode vir como está,~ diz o \
                     Reitor";
            ".";
        ];
