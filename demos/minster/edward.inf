! 6.1 EDWARD FORBES
!------------------------------------------------------------------------------

Object  DoorB5 "x"
 class  DoorClass
  with   name "B5" "Forbes" "Forbes^s" "porta" "quarto",
        room "B5",
        occupant "Forbes",
        found_in BStairSecond EdwardsRoom,
        door_dir [;
            if (self in BStairSecond) return e_to;
            return w_to;
        ],
        door_to [;
            if (self in BStairSecond) return EdwardsRoom;
            return BStairSecond;
        ],
        before [;
         Knock:
            if (Edward in BStairSecond)
                "~Não acho que isso vá ajudar muito,~ diz Edward. ~Esse é o meu quarto, e estou aqui fora.~";
            if (Edward in EdwardsRoom) {
                if (location == BStairSecond)
                 "~Entre,~ diz Edward lá de dentro.";
                 "~Entre,~ diz Edward, sem levantar os olhos.";
            }
         Close:
            if (self has open && Edward in EdwardsRoom)
                 "~Não feche a porta,~ chama Edward. ~É falta de educação não \
                 deixar a porta externa aberta, mesmo que eu tenha dois \
                 ensaios para terminar até amanhã de manhã.~^^Você não tem \
                 certeza de ter entendido, mas deixa a porta aberta mesmo assim.";
        ],
        each_turn [;
            move Edward to BStairSecond;
            self.each_turn = $ffff;
            StartDaemon(Edward);
            DoneHint(WhatNextPuzzle,12);
             "^A porta de B5 se abre, e um rapaz surge bastante consternado (deve ser o Sr. Forbes que mora nesse quarto). ~Você viu meu papagaio?~ ele pergunta. ~Acabei de voltar, e a janela estava quebrada e Polly sumiu. Diga-me onde devo ir para encontrá-la.~ Ele fecha a porta e então hesita, parecendo notar você pela primeira vez. ~Sou Edward,~ diz, como se isso fosse uma explicação.";
        ];

Object  EdwardsRoom "Quarto de Edward Forbes"
 has    light
        ! general if Edward's commented on entertaining women
 with   name "table" "bed" "unstable" "unmade" "window" "broken" "tiny" 
            "desk" "vapour" "vapours",
         description "Um sótão apertado e sem beleza, que não melhora com os cacos de vidro espalhados pelo chão, vindos da janela quebrada. Há uma cama desfeita encostada a uma escrivaninha minúscula, e uma porta leva para oeste.",
        w_to DoorB5,
        out_to DoorB5,
        each_turn [;
            self.each_turn = -1;
            Achieved("visiting Edward Forbes");
            AdvanceTime(self);
            DoneHint(WhatNextPuzzle,19);
        ];

Nearby  GasRing "fogareiro a gás"
 has    static switchable supporter
 with   name "gas" "ring" "burner" "flame" "tap",
         when_on "O fogareiro a gás está aceso e produz uma chama azul irregular.",
         when_off "Uma mesa instável sustenta um fogareiro a gás que deve ser um terrível risco de incêndio.",
        capacity 1,
        before [;
         Burn: <<Switchon self>>;
         Switchon:
            if (self hasnt on && FlameAvailable() == 0)
                    "Você abre o gás, mas percebe que não tem como acendê-lo, então o fecha novamente.";
         Receive:
            if (self has on) {
                if (noun hasnt is_vessel)
                    "Se quer pôr fogo nisso, então diga.";
                if (noun ~= Retort)
                     print_ret (The) noun, " não tem uma base adequada para ficar sobre o fogareiro aceso.";
            }
        ],
        each_turn [;
            if (Retort in self && PaleLiquid in retort && self has on) {
                self.each_turn = NULL;
                quote = 15;
            }
        ];

Nearby  Essay "ensaio"
 has    scenery
  with   name "essay" "ensaio",
         description "A letra de Edward é horrível demais para decifrar mais que o tema, que parece ser o impacto cultural da Quarta Cruzada, e o parágrafo inicial:^^~A destruição de Constantinopla pelos soldados da Quarta Cruzada (1200-1204) foi fundamental para levar a arte bizantina às casas da Europa Ocidental, um legado que certamente inspirou os maiores artistas do Renascimento. Quem não se maravilhou com os magníficos cavalos de bronze na praça de São Marcos, em Veneza, ou com as grandes colunas de mármore do palácio ducal veneziano? Mas estes são apenas uma pequena fração do tesouro trazido de Constantinopla.~",
	before [;
	 Take,Remove: "Não acho que Edward apreciaria isso.";
	];

Object  Edward "Edward Forbes"
 class  FollowClass CarryingClass TalkableClass
 has    proper
        ! general if doesn't talk rubbish this turn
 with   name "edward" "forbes" "tall" "slender" "young" "man" "mr"
            "mister" "student" "undergraduate" "ed" "ned",
         description "Edward Forbes é um jovem alto e esguio, carregando consigo um ar de introspecção distante, como se visse o mundo concreto através de um véu de pensamentos profundos sobre algum assunto complexo.",
        describe [;
            if (self.state >= 31)
                "^Edward Forbes está sentado à escrivaninha, escrevendo furiosamente.";
            if (self in Punt)
                "^Edward está aqui na bateira.";
             print "^Edward Forbes está aqui";
            if (self.state >= 20) ".";
            if (TearsA in Edward) " chorando.";
            switch (random(3)) {
              1: " desanimado.";
              2: " desolado.";
              3: " infeliz.";
            }
        ],
        time_left 0,
        state 0,
        number 0, ! 0 not following you (time_left gives turns before he moves)
                  ! 1 hot on your heels
                  ! >2 lost you (records where you disappeared to), but
                  ! 2 he ran away from Prof Wilderspin
                  ! 3 he's waiting outside C3 after you knocked.
                  ! 4 he went in for his supervision
        life [;
            give self general;
         ShakeHands:
            if (self.state >= 31)
                "Ele está concentrado no ensaio e não nota você.";
            "~Olá,~ diz Edward. ~Prazer em conhecê-la.~";
         Kiss: "Eu não faria isso se fosse você. O choque pode ser demais para ele.";
         Give,Show:
            if (noun == BookCollege)
                 "~Será que meu pai está aí dentro?~ diz Edward, olhando as páginas. ~Não, não há menção a ele. Talvez devesse se chamar `Homens Ricos e Bem-relacionados de Biblioll'.~";
            if (noun == DinnerTicket) <<Question self QDinner>>;
            if (noun == Feather) {
                move Feather to self;
                if (self.state < 20) {
                    move TearsA to self;
                    StartTimer(TearsA,4);
                    "Edward pega a pena de você e olha para ela horrorizado. ~Oh, minha pobre Polly, o que fizeram com você?~ diz ele, começando a chorar, com grandes lágrimas escorrendo dos olhos.";
                }
                if (self.state == 20) 
                     "Edward pega a pena. ~Esta é uma das penas da cauda de Polly. Espero que ela não esteja muito machucada,~ diz ele.";
                 "Edward pega a pena. ~Sim, esta é uma das penas da cauda de Polly. Mas não acho que ela tenha se machucado muito. Está mais assustada que ferida.~";
            }
            if ((noun.&plural_name)-->0 == 'books' or 'bibles')
                 "~Muito interessante, tenho certeza,~ diz Edward, ~mas se não tiver relação com o impacto cultural da Quarta Cruzada ou com a conquista moura da Espanha, não acho que deva lê-lo. Minha mente só comporta tantos fatos, e se aprendo um novo esqueço um antigo.~";
            if (noun.plural == Peanut1.plural) {
                if (self.state > 20) {
                    remove noun;
                     "~Obrigado,~ diz Edward, pegando o amendoim e passando-o ao papagaio, que o abocanha avidamente.";
                }
                if (ParrotB notin location)
                     "~Excelente ideia,~ diz Edward. ~Amendoins são a comida favorita de Polly! Mas espere até encontrarmos Polly novamente e então me dê.~";
                if (Edward in Punt)
                     "~Espere,~ diz Edward. ~Deixe-me sair da bateira primeiro.~";
                if (location == EastBank) {
                    ParrotB.state = 9;
                    StartDaemon(ParrotB);
                    move ParrotB to Arboretum;
                     "~Excelente ideia,~ diz Edward, estendendo a mão para o amendoim. Mas nesse instante algo parece perturbar o papagaio, que alça voo para noroeste.";
                }
                remove noun;
                remove ParrotB;
                StopDaemon(ParrotB);
                move ParrotC to Edward;
                self.state = 21;
                StartDaemon(self);
                Achieved("recapturing the parrot");
                AdvanceTime(self);
                DoneHint(WhatNextPuzzle,18);
                 "Edward pega o amendoim da sua mão e o acena para o papagaio, que observa o petisco com desconfiança. ~Venha aqui, Polly,~ chama, e o papagaio pula para cima e para baixo no poleiro, como se a escolha entre liberdade e comida fosse difícil. Então abre as asas e plana até pousar no ombro de Edward, onde bica avidamente o amendoim.^^Edward sorri triunfante.";
            }
        ],
        orders [;
         SwitchOn,Burn:
            if (noun == GasRing) {
                if (GasRing has on)
                    "~Já fiz isso por você,~ diz Edward. Ele não se move do ensaio.";
                give GasRing on;
                Achieved("lighting the gas ring");
                 print "~Não sei quanto a isso,~ diz Edward distraidamente, ~mas certamente posso acender o fogareiro para você. Porém, receio que não tenha mais chá, nem mesmo restos de varrição.~ Ele ";
                if (child(GasRing) ~= 0) {
                    print "move ", (the) child(GasRing), " para o chão e então ";
                    move child(GasRing) to EdwardsRoom;
                }
                 "tira um fósforo do bolso traseiro e acende o fogareiro. ~Pronto,~ diz ele, e volta ao ensaio.";
            }
         Stop,Wait:
            if (self.number~=0 && self.state<20) {
                self.number = 0;
                self.time_left = 4;
                 "~Está bem, vou parar de seguir você,~ diz Edward, ~mas não consigo ver meu papagaio em lugar algum por aqui.~";
            }
         Knock,Attack:
            switch(noun) {
             DoorA5:
                 "~Não, faça você,~ diz Edward. ~Ele é seu irmão.~";
             DoorC3:
                 "Edward empalidece. ~Não tenho certeza disso,~ diz numa voz muito baixa. ~Bungay é sempre cruel comigo.~";
             DoorB2:
                 "~Não, obrigado,~ diz Edward. ~Se ele me vir, vai querer saber como está meu ensaio.~";
             DoorB5:
                if (self in BStairSecond)
                     "~Você está me pedindo para bater na minha própria porta,~ diz Edward. ~Enlouqueceu de vez?~";
             DoorMaster:
                 "~Ninguém ouvirá se eu bater na porta,~ diz Edward. ~É para isso que serve a cordinha da campainha.~";
            }
            if (noun has animate)
                "~Não farei uma coisa dessas,~ diz Edward. ~Sou um homem de paz.~";
            if (noun.describe == DoorA1.describe)
                 "~Não acho que seja uma boa ideia,~ diz Edward. ~Os professores não gostam de ser incomodados aos domingos.~";
         Follow:
            if (noun == player && self.state <= 20) {
                if (self.state == 20)
                    "~Psiu!~ diz Edward. ~Estou quase pegando Polly, não me distraia agora!~";
                if (self.number ~= 0)
                    "~Estou seguindo o mais rápido que posso,~ diz Edward.";
                self.number = 1;
                "~Farei isso,~ diz Edward. ~Apenas me leve até Polly, é tudo o que peço.~";
            }
         Pull:
            if (noun == BellPull)
                "~Não quero incomodar o Reitor,~ diz Edward. ~Nem mesmo por algo tão importante quanto meu papagaio.~";
         Go,Enter:
            if (self.state <= 20) {
                if (self.state == 20) 
                     "~Psiu!~ diz Edward. ~Estou quase pegando Polly, não me distraia agora!~";
                if (noun notin compass)
                     "~Não tenho certeza de que entendi você,~ diz Edward. ~Talvez possa indicar uma direção da bússola?~";
                <<Invoke self noun>>;
            }
        ],
        before [ d i p z n o po;
         Question:
            if (self.state == 20) 
                 "~Psiu!~ diz Edward. ~Estou quase pegando Polly, não me distraia agora!~";
            switch (second) {
              QHello:
                 "~Olá,~ diz Edward.";
             QTime:
                 "~Seja que horas forem,~ diz Edward, ~provavelmente já é tarde demais para terminar meu ensaio.~";
             QMalcolm:
                 "~Não posso dizer que conheço o doutor Spencer,~ diz Edward. ~Ele ensina química e eu estudo história.~";
             QDinner:
                 "~O jantar desta noite?~ diz Edward amargamente. ~Ah, você quer dizer a homenagem aos benfeitores. Não fui convidado. Só estudiosos são convidados; o Reitor e os professores não querem gente comum como eu participando de suas festas.~";
             QWilderspin:
                 "~Tenho que escrever para ele um ensaio sobre a conquista islâmica da Espanha para amanhã,~ diz Edward, ~e ainda nem comecei. É tão entediante que não consigo abrir meus livros.~";
             QMaster:
                 "~Não posso dizer que conheço o Reitor,~ diz Edward. ~Ele se mantém muito distante, nunca fala com universitários, apenas com os professores.~";
             QBungay:
                 "~Não mencione esse nome,~ diz Edward horrorizado. ~Ele é o tormento de todo estudante de história desta faculdade, e estou encrencado com ele novamente.~";
             QEssay:
                if (DoorC3 hasnt general)
                     "~Não fale dos meus ensaios,~ diz Edward miseravelmente. ~Tenho que ver o professor Bungay esta tarde para uma orientação, e ainda não escrevi meu ensaio. Ele vai me matar, eu sei.~";
                 "~Não pergunte, não pergunte,~ diz Edward.";
             QFrance:
                 "~Eu não perguntaria isso a mim,~ diz Edward. ~O professor Bungay me deu um gama menos no meu último ensaio sobre o assunto.~";
             QAkhenaten,QEgypt:
                 "~Não posso ajudar você,~ diz Edward. ~Se ao menos eu tivesse prestado mais atenção às aulas.~";
             QParrot:
                if (ParrotC in self)
                     "~Uma criatura magnífica, não acha?~ diz Edward, afofando as penas da ave.";
                 "~Preciso encontrar meu papagaio, preciso mesmo,~ diz Edward, ~e você vai me ajudar a encontrá-lo.~";
             QPunting:
                if (self.state < 20)
                     "~Adoro andar de bateira,~ diz Edward, ~mas não creio que terei alguma chance de fazer isso hoje.~";
             QMe:
                if (self.state == 1)
                     "~Ha ha!~ diz Edward, divertido com sua piada. ~É claro que não foi você: minha janela fica a pelo menos doze metros do chão, e você não conseguiria jogar nada tão alto.~";
             QSupervision:
                if (DoorC3 has general)
                     "~Não pergunte,~ diz Edward. ~Foi horrível. Pior do que você pode imaginar.~ Ele estremece.";
                 "~Estou apavorado,~ diz Edward, ~o professor Bungay é sempre mais desagradável do que se pode imaginar.~";
             QGasRing:
                if (self in EdwardsRoom) {
                    if (GasRing hasnt on) {
                        DoOrder(self,##Burn,GasRing);
                        rtrue;
                    }
                    "~Eu sei que parece inseguro,~ diz Edward, ~mas está tudo bem, de verdade. Não precisa se preocupar, ainda não pus fogo no quarto.~ Ele não parece muito convincente.";
                }
             default:
                if (self.state < 20)
                     "Edward parece não notar você. Está evidentemente muito angustiado com a perda do papagaio.";
                if (self.state < 31)
                     "Edward parece não ouvir você. Está evidentemente dominado pela recuperação do papagaio.";
                 "Edward está tão absorto escrevendo o ensaio que não ouve você.";
            }

        ! This code is so complicated because it can be called in two
        ! circumstances: either when the player types "edward, go west", or
        ! else when Edward decides to go on his own.
         Invoke:
            d = second.door_dir;
            p = parent(self);
            i = p.d;
            z = ZRegion(i);
            if (z == 2) {
                EM = 1; i = indirect(i); EM = 0;
                z = ZRegion(i);
            }
            if (z ~= 1 || i == 0 or 1) {
                if (self has is_moving) rtrue;
                 "~Não acho muito provável encontrar meu papagaio ali,~ diz Edward.";
            }
            if (i == Wistaria)
                 "~Você pode ter razão,~ diz Edward melancolicamente. ~Meu papagaio pode ter voado para lá. Mas subir na glicínia é contra as regras.~";
            if (i == Punt)
                 "~Não acho que seja melhor fazer isso,~ diz Edward. ~O professor Bungay pode me ver da janela e então eu teria sérios problemas, pois disse que faria meu ensaio esta tarde.~";
            if (i == DoorB5)
                 "~Acabei de olhar ali,~ diz Edward tristemente, ~e Polly não está lá. De qualquer modo, não tenho permissão para receber mulheres no meu quarto.~";
            if (i has door || i == Hatch) {
                switch(i) {
                 DoorMaster:
                     "~Se estiver tudo bem para você, não acho melhor entrar na casa do Reitor,~ diz Edward. ~Sempre o achei um pouco assustador. De qualquer modo, duvido que ele esteja com meu papagaio.~";
                 DoorA5:
                     "~Não acho que o doutor Spencer aprovaria minha entrada em seu quarto particular,~ diz Edward. ~Mas talvez você pudesse entrar e procurar por mim.~";
                 DoorB2:
                     "~Se o professor Wilderspin estivesse com meu papagaio, tenho certeza de que me avisaria,~ diz Edward, ~e de qualquer forma ele certamente perguntará quando entregarei meu ensaio de História Antiga.~";
                 DoorC3:
                     "Edward empalidece. ~Não tenho certeza disso,~ diz numa voz muito baixa. ~Bungay é sempre cruel comigo.~";
                 Hatch:
                     "~Acho que minha Polly teria juízo suficiente para não descer ali,~ diz Edward.";
                }
                if (i has locked || (i == DoorArchway && i hasnt open)) {
                    if (self notin location) rtrue;
                    if (self has is_moving) { n = 1; new_line; }
                    print "Edward tenta abrir ", (the) i;
                    if (i == DoorArchway)
                        ", mas é totalmente incapaz de mover a porta um centímetro e desiste. ~A porta emperrou de novo,~ diz ele. ~Acho que teremos de esperar alguém abri-la para nós.~";
                    if (i == GardenGate)
                        ", mas ela está trancada. ~O portão está sempre trancado aos domingos,~ diz ele.";
                    if (self has is_moving)
                        ", mas ela está trancada.";
                    else
                        ", mas ela está trancada. ~Você realmente acha que meu papagaio poderia ter passado por uma porta trancada?~ pergunta Edward.";
                }
                if (i hasnt open) {
                    if (self in location) {
                        if (self has is_moving) { n = 1; new_line; }
                        print "Edward abre ", (the) i, ". ";
                    }
                    give i open;
                }
                if (ZRegion(i.door_to) == 2) {
                    o = i;
                    po = parent(o);
                    move o to parent(self);
                    i = RunRoutines(i,door_to);
                    move o to po;
                }
                else i = i.door_to;
                if (i == 0)
                     "~Não acho muito provável encontrar meu papagaio ali,~ diz Edward.";
            }
            if (self hasnt is_moving || n == 1)
                no_new_line_flag = 1;
            MovePrintNPC(self, i, second);
            no_new_line_flag = 0;
            if (self has is_moving) {
                if (n == 1) new_line;
                rtrue;
            }
             print " Você o segue.^";
            <<Enter second>>;
        ],
        ! this is getting too complex!
        daemon [ i j;
            if (self.state >= 21) {
                self.state = self.state + 1;
                switch (self.state) {
                 22: ! he waits for a turn
                 23:
                     if (location == Arboretum)
                         print "^~Meu Deus, que horas são,~ diz Edward agitado. ~Preciso, preciso voltar e escrever meu ensaio, senão minha vida não valerá um vintém.~ Ele parte o mais rápido que consegue andar, com o papagaio cambaleando em seu ombro.^";
                    MovePrintNPC(self,Gardens,sw_obj);
                 24:
                    if (GardenGate hasnt open) {
                        give GardenGate open;
                        if (location == Gardens)
                             print "^Edward abre o portão do jardim.^";
                    }
                    MovePrintNPC(self,SecondCourt,sw_obj);
                 25: MovePrintNPC(self,SecondCourtArchway,w_obj);
                 26: MovePrintNPC(self,FirstCourt,w_obj);
                 27: MovePrintNPC(self,BStairGround,se_obj);
                 28: MovePrintNPC(self,BStairFirst,u_obj);
                 29: MovePrintNPC(self,BStairSecond,u_obj);
                 30:
                    give DoorB5 ~locked open;
                    if (location == BStairSecond)
                         print "^Edward destranca e abre a porta de B5.^";
                    MovePrintNPC(self,EdwardsRoom,e_obj);
                 default:
                    StopDaemon(self);
                    if (location == EdwardsRoom)
                         print "^Edward senta-se à escrivaninha e começa a trabalhar no ensaio.^";
                }
                rtrue;
            }
            if (parent(self) == BungaysSanctum or BungaysHallway)
                rtrue;
            if (parent(self) has no_edward)
                 "** Erro: Edward está em um lugar onde não deveria estar **";
            if (self.number == 3) rtrue;
            if (self.state >= 20) {
                StopDaemon(self);
                rtrue;
            }
            if (self.number == 0) {
                 ! Não mover se o cronômetro estiver ativo.
                if (self.time_left > 0) {
                    self.time_left = self.time_left - 1;
                    rtrue;
                }
                 ! Mover apenas um terço dos turnos de qualquer modo.
                if (random(3) > 1) rtrue;
                i = ((parent(self)).#edward_dirs)/2;
                if (i == 0)
                     "** Erro: Edward está em um local onde não pode se mover **";
                j = ((parent(self)).&edward_dirs)-->(random(i) - 1);
                give self is_moving;
                <Invoke self j>;
                give self ~is_moving;
                rtrue;
            }
            if (self in location) {
                if (self.number <= 1) rtrue;
                i = self.number;
                self.number = 1;
                give self general;
                if (i == Cellars or thedark) rtrue;
                 print "^~Ah, aí está você,~ diz Edward ao avistá-lo. ~Estou esperando você aqui desde ";
                if (i == 2)
                     "você encontrou o professor Wilderspin.~";
                if (i == 4)
                     "saí da minha orientação. Que pesadelo foi aquilo.~";
                if (i == Well or AlchemistsRoom)
                     "você desapareceu nas estantes da biblioteca.~";
                 print_ret "você entrou em ", (the) i, ".~";
            }
            if (self.number > 1) rtrue;
            if (location has no_edward) {
                self.number = location;
                rtrue;
            }
            MovePrintNPC(self,location,0);
        ],
        each_turn [;
            if (self.state == 31 && ClockTower.number > 19) {
                self.state = 32;
                 "^~Então, teve um bom jantar?~ diz Edward sem levantar os olhos. ~Ainda não terminei meu ensaio e provavelmente passarei a noite inteira nele.~ Ele suspira profundamente e volta a escrever.";
            }
            if (LineOfSight(ParrotB,self) == 1 && self.state < 20) {
                self.state = 20;
                Achieved("leading Edward Forbes to his parrot");
                 "^Edward avista o papagaio na árvore. ~Polly, minha Polly,~ chama. ~Como posso expressar minha gratidão por vê-la novamente?~ Ele parece radiante com o reencontro, mas o papagaio permanece impassível e imóvel na árvore.";
            }
            if (LineOfSight(Wilderspin,self) == 1) {
                print "^~Olá, Forbes,~ diz Wilderspin ao notar Edward parado por perto. ~Que bom vê-lo! Como está indo seu ensaio sobre a conquista moura da Espanha? Espero encontrá-lo no meu escaninho amanhã de manhã, sim?~^^Edward resmunga algo evasivo e diz que não pode parar agora, precisa continuar.^";
                if (self.state < 20) {
                    if (self.number == 1) self.number = 2;
                    MovePrintNPC(self, FirstCourt, nw_obj);
                }
                rtrue;
            }
            if (LineOfSight(Bungay,self) == 1 && Bungay hasnt general) {
                give Bungay general;
                "^~Ora, que surpresa,~ diz Bungay. ~Se não é Edward Forbes! Um homem que deveria ter escrito até a última sexta-feira um ensaio sobre o impacto cultural da Quarta Cruzada, se minha memória não falha.~ Sua voz fica azeda ao dizer: ~Se bem se lembra, combinamos que você me procuraria esta tarde em meu quarto para conversarmos um pouco sobre isso.~^^~Sim, senhor,~ diz Edward, que de repente fica muito pálido.";
            }
            if (LineOfSight(Turmeric,self) == 1 && Turmeric hasnt general) {
                give Turmeric general proper;
                "^Edward se abaixa para acariciar o gato, que obedientemente rola de costas e ronrona. ~Olá, Turmeric,~ diz ele.";
            }
            if (LineOfSight(BrokenWindow,self) == 1 && BrokenWindow hasnt
              general) {
                give BrokenWindow general;
                "^~Veja só!~ diz Edward furioso, apontando para a janela quebrada. ~Veja o que algum cretino fez com minha janela! Vidros quebrados por todo o chão, e meu papagaio sumiu. Não viu por acaso o canalha que fez isso, viu? Não, imagino que não, ou você teria dito.~";
            }
            if (self in EdwardsRoom && EdwardsRoom hasnt general) {
                give EdwardsRoom general;
                "^~Ei!~ diz Edward ao vê-lo entrar. ~Você não pode entrar aqui, não devo receber mulheres aqui de jeito nenhum.~ Ao ver que você não pretende sair, continua: ~Bem, então pode entrar, mas fique quieta e não conte a ninguém, senão terei problemas terríveis.~";
            }
            if (self in EdwardsRoom && LineOfSight(self,ElixirC) == 1 &&
              parent(ElixirC) has open && ElixirC.state < 2) {
                ElixirC.state = ElixirC.state + 1;
                print "^~Por favor, tire esse perfume daqui,~ implora Edward.";
                switch (ElixirC.state) {
                  1: print " ~Minha patroa tem faro de cão de caça, digo a você, ela sente cheiro de álcool ou perfume a um quilômetro de distância.~";
                  2: print "^^~Eu não me preocuparia,~ você responde. ~Pelo menos sua janela ficará aberta a noite toda.~";
                }
                new_line; rtrue;
            }
            if (self.state >= 20) rtrue;
            if (self has general) { give self ~general; rtrue; }
            if (random(3) == 1) {
                self.state = self.state + 1;
                switch (self.state) {
                  1: "^~Foi terrível,~ diz Edward. ~Voltei do café da manhã e havia vidro por todo o chão, e meu papagaio tinha desaparecido. Não consigo imaginar quem poderia ter feito uma coisa tão terrível.~";
                  2: "^~Você precisa me ajudar a encontrar meu papagaio,~ implora Edward. ~Apenas me diga para que lado devo ir.~";
                  3: "^~Esta é a pior coisa que poderia ter acontecido,~ diz Edward, ~pois tenho de fazer um ensaio para o professor Wilderspin para amanhã e outro para o professor Bungay, que está atrasado, e não comecei nenhum dos dois.~";
                  4: "^Edward diz: ~O professor Bungay disse que preciso vê-lo esta tarde, e ele me aterroriza.~";
                  5: "^Edward diz: ~O professor Bungay é sempre cruel comigo. Ele nunca me dá um alfa em nenhum dos meus ensaios e sempre faz relatórios ruins, para que eu me meta em problemas com meu tutor.~";
                  6: "^Edward diz: ~Eu ia fazer meu ensaio esta tarde e depois andar de bateira no rio, mas agora preciso encontrar meu papagaio.~";
                  7: if (random(3) == 1)
                     "^Edward olha ao redor em busca de sinais do papagaio, mas não encontra nada.";
                 default: self.state = 6;
                }
            }
        ];

Object  ParrotC "papagaio"
 has    animate
  with   name "grey" "cinzento" "parrot" "papagaio" "bird" "ave" "polly",
         description "Uma ave cinzenta, pousada contente no ombro de Edward Forbes.",
         initial "Um papagaio cinzento pousa no ombro de Edward Forbes.",
        life [;
         Give,ThrowAt:
            if (noun.plural == Peanut1.plural) {
                remove noun;
             "O papagaio engole o amendoim.";
            }
        ],
        before [;
          Question: "O papagaio não dá atenção a você.";
          Take,Remove: "O papagaio bica sua mão ferozmente, e você desiste depressa.";
        ],
        each_turn [;
            switch (random(10)) {
              1: "^~Auc!~ grasna o papagaio.";
              2: "^~Arque!~ guincha o papagaio.";
            }
        ];


!------------------------------------------------------------------------------
! 6.2 "C" STAIRCASE
!------------------------------------------------------------------------------

Object  CStairGround "Escadaria ~C~, térreo"
 has    light cat_allowed
 with   name "stairs" "stair" "second" "court",
         description "A escadaria ~C~ é mais grandiosa que as escadarias do Primeiro Pátio, com salas maiores e tetos mais altos; você imagina que os membros mais antigos e eminentes disputam quem ocupará essas salas. Ao norte fica a porta de C1; ao sul, a porta de C2; uma larga escada de madeira sobe; e uma porta leva para oeste, ao Segundo Pátio.",
        u_to CStairFirst,
        e_to CStairFirst,
        w_to SecondCourt,
        out_to SecondCourt,
        n_to DoorC1,
        s_to DoorC2,
        edward_dirs u_obj w_obj;

Nearby  DoorC1 "x" class DoorClass
 with   name "C1" "Baskeyfield" "Baskeyfield's",
        room "C1", occupant "Baskeyfield", door_dir n_to,
        state 0,
        before [;
         Knock:
            if (ClockTower.number < 19) {
                self.state = self.state + 1;
                switch (self.state) {
                  1: "A porta se abre uma fresta e um cavalheiro de cabelos grisalhos consegue encarar você enquanto ajusta os óculos. ~Você não sabe quando são os horários de atendimento?~ diz Baskeyfield, evidentemente confundindo você com um universitário. ~Venha me ver na segunda-feira de manhã, às oito e meia.~ Ele fecha a porta.";
                  2: "Baskeyfield abre a porta novamente. ~Não farei uma exceção para você, não importa quantas vezes bata,~ diz ele. ~Se eu me deixasse convencer a atender um universitário num domingo só uma vez, logo todos estariam aqui e eu não teria paz. Adeus.~ Ele bate a porta.";
                  3: "Baskeyfield escancara a porta e lança um olhar furioso para você. ~Como ousa continuar perturbando meu descanso?~ troveja. ~A chave da biblioteca está no meu escaninho. Agora vá embora e não arrisque minha ira novamente!~";
                 default: 
                    self.state = 3;
                     "Você decide não arriscar novamente a ira de Baskeyfield.";
                }
            }
        ];

Nearby  DoorC2 "x" class DoorClass
 with   name "C2" "Middlemann" "Middlemann's", honorific doctor,
        room "C2", occupant "Middlemann", door_dir s_to;

Object  KeyLibrary "chave de cobre" DoorC1
 class  KeyClass
 with   name "copper";

Object  CStairFirst "Escadaria ~C~, primeiro andar"
 has    light cat_allowed
        ! general if a knock is in progress
 with   name "stair" "stairs" "river" "trees" "grass" "tree",
         description "Ao norte fica a porta de C3; ao sul, a porta de C4 e uma larga escada de madeira desce ao térreo. Uma janela a leste dá para um rio que passa pela base do edifício, com árvores e grama além dele.",
        d_to CStairGround,
        out_to CStairGround,
        n_to DoorC3,
        s_to DoorC4,
        edward_dirs d_obj;

Nearby  CStairFirstWindow "janela"
 has    scenery
 with   name "window",
         description "A janela dá para um rio que passa pela base do edifício, com árvores e grama além dele.",
        before [;
         Search: <<Examine self>>;
          Open: "Parece não haver como abrir a janela.";
        ];

Nearby  DoorC4 "x" class DoorClass
 with   name "C4" "Yeglitt" "Yeglitt^s", honorific professor,
        room "C4", occupant "Yeglitt", door_dir n_to;

Object  DoorC3 "x"
 class  DoorClass
        ! general if Bungay no longer answers the door
 with   name "C3" "Bungay" "Bungay^s",
        honorific professor,
        room "C3",
        occupant "Bungay",
        door_dir [;
            if (self in BungaysHallway) return s_to;
            return n_to;
        ],
        door_to [;
            if (self in BungaysHallway) return CStairFirst;
            return BungaysHallway;
        ],
        with_key SilverKey,
        found_in BungaysHallway CStairFirst,
        time_left 0,
        before [;
         Knock:
            if (ClockTower.number > 18) rfalse;
            if (Edward in BungaysSanctum || self has open)
                 "~Vá embora, estou dando orientação!~ grita uma voz zangada lá de dentro.";
            if (self has general)
                 "~Vá embora!~ grita uma voz zangada lá de dentro.";
            if (CStairFirst has general)
                 "Você bate novamente. É possível ouvir passos se aproximando da porta por dentro.";
            give CStairFirst general;
            StartTimer(self, 1);
             print "Você bate com força na porta e ouve um mal-humorado ~Já vou!~ distante.^";
            if (LineOfSight(Edward,self) == 1) {
                if (Edward.number == 1) Edward.number = 3;
                 print "^~Oh, céus, oh, céus,~ murmura Edward.^";
            }
            rtrue;
        ],
        time_out [;
            give CStairFirst ~general;
            if (location == CStairFirst) {
                 print "^A porta de C3 se abre uma fresta e Bungay espia para fora. ";
                if (LineOfSight(Edward,self) == 1) {
                    if (Edward.number == 3) Edward.number = 1;
                     "Ele olha para Edward e então avista você. ~Edward Forbes, na companhia de uma mulher! Quem diria? Enfim, não tenho tempo para falar com vocês, pombinhos.~ Ele bate a porta.^^~Veja só o que você fez,~ diz Edward.";
                }
                "~Você de novo!~ rosna ele. ~Já não lhe disse para não se intrometer em assuntos que não lhe dizem respeito?~ Ele bate a porta na sua cara.";
            }
            if (LineOfSight(Edward,self) == 1) {
                give self ~locked;
                give Bungay general;
                move Edward to BungaysSanctum;
                DoneHint(WhatNextPuzzle,13);
                if (Edward.number == 3) Edward.number = 4;
                else Edward.number = 0;
                if (player in CStairGround)
                     "^Lá de cima, você ouve Edward resmungar alguma coisa e a resposta alta de Bungay: ~Sim, suponho que possa reservar um ou dois minutos do meu precioso tempo para falar sobre seu ensaio.~^^Então você ouve passos e uma porta se fechando.";
            }
        ];


!------------------------------------------------------------------------------
! 6.3 PROFESSOR BUNGAY'S ROOMS
!------------------------------------------------------------------------------

Object  BungaysHallway "Corredor do professor Bungay"
 has    light
 with   name "study" "gown" "gowns" "hall" "hallway" "stairs" "study"
            "doorway",
         description "Um corredor estreito onde os visitantes de Bungay penduram suas vestes e seus alunos ficam nervosos enquanto aguardam suas orientações. A porta de C3 leva às escadas ao sul, há uma porta pintada de branco a leste, e uma passagem aberta leva ao norte, para um escritório. Um brasão está pendurado na parede.",
        e_to WhiteDoor,
        s_to DoorC3,
        n_to BungaysStudy,
        before [;
         Speak,Sing,Scream,Mild,Strong:
             "Psiu! Bungay certamente notaria!";
        ],
        state 0,
        each_turn [;
            Achieved("sneaking into Professor Bungay's rooms");
            AdvanceTime(self);
            if (Bungay in self) {
                deadflag = 3;
                "^Você tenta atravessar o corredor silenciosamente, mas Bungay olha em sua direção e não há como evitá-lo.^^~Meu Deus!~ ele berra. ~Seu pequeno espião!~^^Você corre para a porta, e ele avança atrás de você com velocidade surpreendente. Quando você chega ao patamar, ele acerta sua cabeça com um golpe do punho, fazendo-o rolar escada abaixo.^^Você ouve, como se viesse de muito longe, um estalo que só percebe tarde demais ser sua cabeça batendo no chão de madeira polida, e então tudo fica escuro.^^Você acorda no hospital, com a cabeça enfaixada e Edward sentado solícito ao lado da cama.^^Mais tarde, ao saber que seu irmão Malcolm desapareceu da faculdade de Biblioll para nunca mais ser visto, você deseja não ter sido expulso da cena de modo tão abrupto, mas então já é tarde demais.";
            }
             print "^Por trás da porta pintada de branco, você ouve ";
            self.state = self.state + 1;
            if (self.state == 20) self.state = 0;
            switch (self.state) {
             0,19: "Edward soluçando baixinho.";
             4,17: "Edward resmungando contrito.";
             6,14: "sons nervosos de passos arrastados.";
             8,10,12: "Edward resmungando algo indistinto.";
            }
             print "Bungay dizendo: ~";
            switch (self.state) {
              1: "Não entregar um ensaio uma vez pode ser considerado descuido.~";
              2: "Não entregar um ensaio duas vezes talvez possa ser perdoado.~";
              3: "Você deixou de entregar este ensaio pela terceira vez, e devo considerar sua reincidência uma prova de preguiça e fracasso.~";
              5: "Desculpe, não ouvi muito bem.~";
              7: "Quais exatamente das referências que pedi que consultasse você leu?~";
              9: "Quantos foram mesmo?~";
              11: "E o que exatamente aprendeu sobre a Quarta Cruzada? Talvez possa me esclarecer.~";
              13: "Desculpe, não ouvi muito bem.~";
              15: "Uma prorrogação, foi isso que ouvi você dizer?~";
              16: "E por que exatamente eu deveria fazer isso, diga-me?~";
              18: "Já considerou mudar para Economia Agrária?~";
            }
        ];

Nearby  WhiteDoor "porta pintada de branco"
 has    door lockable openable scenery autoopen
 with   name "door" "doors" "white" "painted" "white-painted",
        door_dir e_to,
        door_to BungaysSanctum,
        before [;
         Open,Knock,Attack: 
             "Bungay certamente notaria e não ficaria nada feliz ao encontrá-lo aqui. Talvez seja mais seguro deixá-lo sem ser incomodado por enquanto.";
        ];

Nearby  TemplarArms "brasão"
 has    scenery
 with   name "coat" "of" "arms",
         description "Uma cruz maltesa vermelha sobre um escudo branco, com algum tipo de edifício, talvez uma igreja, acima dela.";

Object  BungaysStudy "Escritório do professor Bungay"
 has    light no_edward
        ! general once entering it becomes a trap!
 with   name "furnishing" "garden" "gardens" "college" "decoration"
            "alcove" "ostentation" "globe" "trapdoor",
        description [;
             print "Que sala ostentosa! Móveis ricos de todos os cantos do globo: um tapete de seda da Pérsia, uma escrivaninha de mogno do Sião, ";
            if (LacquerBox hasnt moved)
                 print "sobre a qual repousa uma caixa laqueada da China, ";
             "e assim por diante. Mas você provavelmente tem pouco tempo para observar essas decorações antes que Bungay termine de lidar com Edward e você precise fugir depressa. Há uma saída ao sul e uma janela dá para alguns jardins ao norte.";
        ],
        out_to [;
            if (WindowC3 has open) <<Go n_obj>>;
        ],
        d_to [;
            if (WindowC3 has open) <<Go n_obj>>;
        ],
        n_to [;
            if (WindowC3 hasnt open) return WindowC3;
            if (Bungay in BungaysHallway)
                 print "Você sobe o mais silenciosamente possível até o parapeito da janela e por alguns segundos contempla a perspectiva terrível. Mas precisa pular, e não resta tempo para hesitar.";
            else
                 print "Enquanto você sobe até o parapeito da janela, ouve vozes e percebe que Bungay e Edward estão saindo da conversa, e que você parte bem a tempo!";
            StopDaemon(BungaysStudy);
            move Edward to SecondCourt;
            move Turmeric to InsideShed;
            if (Edward.state < 6) Edward.state = 6;
            move Bungay to BungaysSanctum;
            give DoorC3 ~open locked general;
             print "^^Cuidadosamente, você se deixa descer até ficar pendurado pelas pontas dos dedos no parapeito da janela. Abafando um grito, solta-se. O gramado vem rapidamente ao seu encontro e, com um baque repentino que faz seus ossos tremerem, você se vê, machucado mas, graças a Deus, não quebrado, no...^";
            Achieved("escaping from Professor Bungay");
            AdvanceTime(self);
            DoneHint(WhatNextPuzzle,14);
            return Gardens;
        ],
        s_to BungaysHallway,
        state 0,
         cant_go "A única saída é ao sul, de volta ao corredor de entrada.",
        before [;
         Speak,Sing,Scream,Mild,Strong:
             "Psiu! Bungay certamente notaria!";
        ],
        each_turn [;
            if (self has general) {
                give self ~general;
                move Bungay to BungaysHallway;
                move Edward to BungaysHallway;
                StartDaemon(self);
                 "^Você ouve vozes ao sul e uma porta se abrindo e fechando, e percebe que demorou demais aqui e que Bungay terminou de lidar com Edward. Agora você está preso aqui!";
            }
        ],
        daemon [;
            self.state = self.state + 1;
            if (location ~= BungaysStudy) rtrue;
            if (self.state < 7)
                 print "^Você ouve ";
            if (self.state == 1 or 3 or 4 || self.state == 6)
                 print "Bungay ao sul, dizendo: ~";
            switch (self.state) {
              1: "Espero ter deixado isso claro?~";
              2: "Edward resmungando em concordância.";
              3: "Espero ver o ensaio no meu escaninho às nove de segunda-feira de manhã.~^^Por quanto tempo esse homem horrível continuará falando? Você precisa sair daqui!";
              4: "Nem um minuto depois, ou não terei escolha senão iniciar um processo de expulsão.~^^Ele obviamente está chegando ao fim de sua reprimenda, e você não conseguirá evitar ser descoberto por muito mais tempo.";
              5: "Edward suspira chocado.^^Você está ficando desesperado! Precisa escapar!";
              6: "Alguns diriam que estou sendo excepcionalmente indulgente neste assunto, portanto deveria estar agradecido. Agora suma, saia da minha frente!~^^A qualquer momento ele encontrará você!";
            }
            deadflag = 3;
            print "^Bungay chega à porta de seu escritório e ";
            if (player in NarrowGap)
                print "olha ao redor desconfiado, seus olhos pousando sobre a escrivaninha deslocada. Tremendo de medo, você se agacha o máximo possível enquanto seus passos pesados se aproximam da escrivaninha e ele espia por cima dela. ~Peguei você no ato!~ grita. ~Seu pequeno espião!~ E";
            else
                print "seus olhos pousam em você. ~Peguei você no ato!~ grita. ~Seu pequeno espião!~ e";
            "le avança com velocidade surpreendente e acerta sua cabeça com um golpe pesado de seu grande punho.^^Você ouve, como se viesse de muito longe, um estalo que só percebe tarde demais ser sua cabeça batendo na parede, e então tudo fica escuro.^^Você acorda no hospital, com a cabeça enfaixada e Edward sentado solícito ao lado da cama.^^Mais tarde, ao saber que seu irmão Malcolm desapareceu da faculdade de Biblioll para nunca mais ser visto, você deseja não ter sido expulso da cena de modo tão abrupto, mas então já é tarde demais.";
        ];

Nearby  WindowC3 "janela"
 has    openable scenery door
 with   name "window" "windows",
         description "Pela janela, você pode ver uma vista encantadora dos jardins da faculdade.",
         when_closed "Uma janela ao norte dá para os jardins da faculdade.",
         when_open "Uma janela aberta ao norte dá para os jardins da faculdade.",
        door_dir n_to,
        door_to Gardens,
        before [;
         Search,Examine:
            PrintOrRun(self,description,1);
             if (self has open) " É uma queda muito alta.";
            new_line; rtrue;
         ThrownAt,Receive:
             if (self hasnt open) "Você já quebrou janelas o bastante por um dia.";
            move noun to Gardens;
             print_ret (The) noun, " voa pela janela aberta.";
        ];

Nearby  SilkRug "tapete de seda"
 has    concealed static enterable supporter
 with   name "persian" "silk" "silken" "rug" "carpet" "thread" "threads"
            "threadbare",
         description "Antes uma bela obra de arte, mas hoje uma pessoa cruel poderia descrevê-lo como um tanto gasto.",
        before [;
          Pull,Push,LookUnder: "Não há nada sob o tapete. Por alguma razão inexplicável, você esperava encontrar um alçapão ali.";
        ];

Nearby  DeskDrawer "gaveta"
 has    lockable container static concealed locked openable
 with   name "drawer",
        capacity 5,
        description [;
            if (self hasnt open)
                 "A gaveta da escrivaninha está fechada.";
             "Deste lado, você percebe que a gaveta não se encaixa perfeitamente na escrivaninha e que há espaço suficiente no alto para alcançar o conteúdo.";
        ],
        each_turn [;
            if (player in NarrowGap) give self open;
            else give self ~open;
        ];

Nearby  MahoganyDesk "escrivaninha de mogno"
 has    concealed static supporter
        ! general if pulled away from the wall
 with   name "mahogany" "desk" "siamese" "antique" "queen" "anne" "solid"
            "asian",
        description [;
             print "Você não é especialista em móveis antigos, mas diria que esta é uma Queen Anne, em excelente estado, feita de mogno maciço importado de navio do sudeste da Ásia. Há uma única gaveta. ";
            if (self has general)
                 "A escrivaninha foi puxada cerca de trinta centímetros para fora do nicho, deixando uma fresta estreita entre ela e a parede do fundo.";
             "A escrivaninha se encaixa perfeitamente em um nicho na lateral da sala.";
        ],
        capacity 5,
        before [;
          LookUnder: "Não há nada escondido sob a escrivaninha.";
         Climb,Enter:
            if (self has general) {
                 print "Você sobe pela escrivaninha e pula na fresta estreita atrás dela.^";
                 <<Enter NarrowGap>>;
            }
         Pull,Push:
            if (self hasnt general) {
                give self general;
                move NarrowGap to BungaysStudy;
                "Você mal ousa mover a escrivaninha, temendo que ela range no chão polido e alerte Bungay sobre sua presença, mas ela é mais leve do que parece e você consegue movê-la cerca de trinta centímetros antes de perder a coragem. Ainda assim, criou uma fresta estreita entre a escrivaninha e a parede do fundo do nicho.";
            }
            if (player in NarrowGap)
                "Você não pode devolver a escrivaninha ao lugar, pois está no caminho.";
            give self ~general;
            remove NarrowGap;
            "Ansioso para não deixar vestígios de sua busca, você devolve lenta e cuidadosamente a escrivaninha à posição original.";
        ];

Object  NarrowGap "fresta estreita"
 has    scenery enterable container open
 with   name "narrow" "gap" "space" "alcove",
         description "Você criou cerca de trinta centímetros de espaço atrás da escrivaninha, apenas o suficiente para ficar de pé.";

Object  LacquerBox "caixa laqueada" MahoganyDesk
 class  VesselClass DelicateClass
 has    openable
        ! general once it's started the timer
 with   name "lacquer" "box" "chinese" "black",
        describe [;
            if (self hasnt moved) rtrue;
        ],
         description "Uma bela obra artesanal, esta caixa chinesa de laca tem cerca de cinco centímetros cúbicos e é decorada com imagens de homens e mulheres chineses caminhando por jardins ornamentais.",
        before [;
          SmellThing: "A caixa exala um aroma oleoso e amargo.";
         Take,Remove:
