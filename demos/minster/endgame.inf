! 8.1 DINNER
!--------------------------------------------------------------------------

Object  DiningHall "Grande Salão"
 has    light
 with   name "great" "hall" "high" "table" "low" "fellow" "fellows"
            "student" "students",
         description "Uma sala grandiosa, com um teto abobadado muito acima \
             da cabeça, ecoando a conversa ruidosa de vinte membros sentados \
             à mesa principal e talvez sessenta estudantes à mesa baixa.^^Ao \
             seu lado, à mesa principal, estão Wilderspin (à esquerda), o \
             Reitor (à direita), Jarboe, Bungay e Halfhide.",
         cant_go "Seria indelicado sair antes de o jantar terminar.",
        state 0,
	before [;
	 PutOn,ThrowAt:
	    if (second == d_obj)
        "Não se espera que convidados de banquetes universitários joguem \
		coisas no chão.";
	],
        each_turn [ i;
            self.state = self.state + 1;

            ! First course
            switch (self.state) {
             1:
                DoneHint(WhatNextPuzzle,24);
                "^~Que bom que você pôde se juntar a nós~, diz o Reitor. \
                ~Wilderspin me disse que vocês já se conheceram, mas aqui \
                estão Jarboe e Halfhide, e aquele é Bungay. Será uma boa \
                festa, hein? Depois haverá uma pequena reunião na sala comum \
                dos professores, e ficaremos encantados se você nos acompanhar.~";
             2:
                move Lobster to self;
                move Widget to self;
                "^Garçons passam pela mesa principal, depositando pratos em \
                alta velocidade diante de todos. Você fica com uma grande \
                lagosta e um dispositivo estranho.";
             3:
                "^Por algum tempo há silêncio enquanto todos comem, e então o \
                tom da conversa volta a subir.";
             4:
                "^~Tive a experiência mais horrível esta manhã~, diz Halfhide. \
                ~Eu pensava num problema particularmente difícil enquanto \
                tomava sol no Green, e suponho que devo ter cochilado.~";
             5:
                "^Halfhide continua: ~Acordei e descobri que uma jovem havia \
                roubado minha chave do portão principal, mas, quando a \
                confrontei, ela negou tudo e pediu ajuda a um policial, que, \
                naturalmente, acreditou em cada palavra da história dela.~";
             6:
                "^Halfhide bufa e continua: ~O policial insistiu em me levar à \
                delegacia e me interrogar por uma hora. A que ponto o mundo \
                chegou, quando um membro do College não pode tirar uma sesta \
                decente e tranquila numa manhã de domingo?~";
             7:
                "^Há murmúrios gerais de solidariedade dos membros reunidos \
                sobre o excesso de zelo da polícia local e sobre como os \
                estudiosos não são tratados com respeito suficiente.";
             8:
                "^~Você!~ diz Halfhide, virando-se de repente e olhando para \
                você atentamente pela primeira vez. ~Foi você quem pegou minha \
                chave esta manhã. Como pôde?~";
             9:
                "^~Mas não fui eu~, você insiste, feliz por não estar mais \
                carregando a chave de latão. Você sorri doce e inocentemente \
                para Halfhide, que aos poucos se acalma e finalmente admite \
                que pode ter se enganado e perdido a chave na grama alta. \
                Você suspira silenciosamente, aliviada.";
             10:
                if (Lobster in self) {
                    self.state = 9;
                    if (random(3) == 1)
                        "^Todos educadamente evitam olhar para você, mas dá \
                        para perceber que esperam que termine sua lagosta \
                        antes de começar o próximo prato.";
                } else {
                    remove Lobster;
                    remove Widget;
                    move Plate to self;
                    move WineGlass to self;
                    move Knife to self;
                    move Fork to self;
                    "^Um garçom chega e retira os restos do primeiro prato, e \
                    outros garçons chegam e depositam o segundo diante de você.";
                }
             11:
                "^~Espero que goste~, confidencia o Reitor. ~Nosso novo chef \
                francês é muito entusiasmado com a culinária francesa tradicional.~";
             12:
                "^Wilderspin diz: ~Deixe-me contar sobre uma descoberta que fiz \
                hoje. Ou melhor, uma descoberta que a Srta. Spencer fez hoje, \
                pois foi ela quem descobriu a entrada do meu gabinete para a \
                passagem secreta.~";
             13:
                "^~É isso mesmo~, continua Wilderspin. ~Os velhos rumores são \
                verdadeiros: Henry Garton colocou passagens secretas na \
                escadaria B e na biblioteca quando as construiu. É um milagre \
                que ninguém tenha examinado os edifícios e notado os três ou \
                quatro pés extras de largura.~";
             14:
                 "^Wilderspin diz: ~Acho que a câmara secreta provavelmente foi \
                 planejada como esconderijo de um padre; naquela época, o \
                 Biblioll College era firmemente católico, apesar do sentimento \
                 religioso predominante na Inglaterra.~";
             15:
                 "^~Não sei se chegou a cumprir sua finalidade~, pondera \
                 Wilderspin, ~pois o corpo que encontramos ali, que tenho certeza \
                 de que data do fim do século XVII, embora só possa confirmar ao \
                 voltar com especialistas para uma datação adequada, não é de um \
                 padre católico escondido da perseguição religiosa puritana, mas \
                 de um alquimista!~";
             16:
                 "^Wilderspin diz: ~Talvez ele temesse ser denunciado como \
                 bruxo, ou talvez quisesse apenas manter suas pesquisas em segredo \
                 dos rivais. Provavelmente morreu envenenado por mercúrio, sem \
                 dúvida agravado pela falta de ventilação naquele minúsculo \
                 laboratório.~";
             17:
                 "^~Isso é incrível~, diz o Reitor. ~Preso ali entre a escadaria B \
                 e a biblioteca durante centenas de anos, e ninguém percebeu. \
                 Gostaria de saber que outras passagens secretas podem estar \
                 escondidas naqueles prédios antigos.~";
             18:
                 print_ret "^~Posso perguntar se alguém aqui leu a última edição do \
                     Jornal da Universidade?~ interrompe Bungay, mas o Reitor não se \
                     distrai tão facilmente de sua linha de pensamento.^^~Passagens \
                     secretas, ha!~, ele ri. ~Isso parece algo em que aquele cujo nome \
                     me escapa, o Reitor do século XVII, primo de Lancaster, poderia \
                     facilmente estar envolvido.~";
             19:
                 "^~Agora, o Jornal...~, tenta Bungay novamente, mas o Reitor continua \
                 como se não tivesse ouvido. ~Conspirar contra os próprios membros, \
                 rumores persistentes de ser bruxo e herege: passagens secretas seriam \
                 coisa corriqueira para ele!~";
             20:
                 "^~O que você ia dizer sobre o Jornal?~, pergunta o Reitor a Bungay, \
                 mas este resmunga que não era importante e que provavelmente todos os \
                 presentes já o tinham lido.";
             21:
                if (DeadSnail notin Plate) {
                    self.state = 20;
                    if (random(3) == 1)
                         "^Todos evitam educadamente olhar para você, mas dá para perceber \
                         que estão esperando você terminar a comida antes de começar o \
                         próximo prato.";
                } else {
                    remove Snail;
                    remove Wine;
                    remove DeadSnail;
                    remove Plate;
                    remove Knife;
                    remove Fork;
                    remove WineGlass;
                    move PortGlass to self;
                    move PortDecanter to self;
                    move PortA to PortDecanter;
                    DoneHint(WhatNextPuzzle,25);
                     "^Um garçom chega e retira os restos do segundo prato (felizmente). \
                     Outro garçom aparece com uma bandeja de copos pequenos e um \
                     decantador. Ele coloca o último diante de você.";
                }
             22:
                 "^~Então, o que Malcolm tem feito?~, pergunta Wilderspin. ~Não vejo o \
                 rapaz há alguns dias e pensei que ele estaria no jantar.~^^Você responde \
                 que não sabe onde ele está e que está muito preocupada com o que pode ter \
                 acontecido com ele.";
             23:
                 "^~Falei com Spencer na sexta-feira~, diz Jarboe, ~e ele me disse que \
                 fora convocado em cima da hora para uma conferência em Edimburgo, para \
                 falar sobre seu trabalho, e que lamentava muito ter de sair às pressas \
                 antes de conseguir falar com a senhorita Spencer.~";
             24:
                 "^~Mas o que você fazia nos quartos dele hoje?~, você pergunta, ~E quem \
                 os revirou?~^^~Meu Deus, que horror!~, exclama o Reitor. ~O que houve?~^^
                 ~Não tive oportunidade de contar isto a você~, diz Bungay. ~Parece que os \
                 quartos de Spencer foram arrombados. Só descobrimos isso esta manhã e, é \
                 claro, telefonamos para a polícia.~";
             25:
                 "^Você está prestes a protestar contra a mentira descarada de Bungay \
                 quando cruza o olhar de Jarboe e se encolhe sob sua expressão hostil e \
                 ameaçadora. Parece que nada do que você diga conseguirá abalar a \
                 credibilidade dessa dupla de mentirosos.";
             26:
                 "^~Quando Spencer volta, Jarboe?~, pergunta o Reitor. ~Não acho que ele \
                 ficará muito feliz com a notícia.~^^~Não sei~, diz Jarboe. ~Ele não disse \
                 quanto duraria a conferência.~";
             27:
                if (PortDecanter notin GivenAway) {
                    self.state = 26;
                    switch (random(4)) {
                      1: "^~Ahem~, diz o Reitor, olhando para você significativamente. \
                         Você entende que esperam algo de você.";
                      2: "^~Diga-me, senhorita Spencer~, diz Halfhide, ~você conhece o \
                         Bispo de Bath e Wells?~";
                    }
                } else {
                    remove PortGlass;
                    remove PortA;
                    remove PortB;
                    while (child(CloakRoom) ~= 0)
                        move child(CloakRoom) to player;
                    move Candles to SeniorCommonRoom;
                     SeniorCommonRoom.description = "Esta sala luxuosa está cheia \
                         de professores da faculdade, falando alto e bêbados. \
                         Nenhum deles demonstra interesse em você.";
                    SeniorCommonRoom.each_turn = SCREachTurn;
                     GreatHall.s_to = "A porta para as cozinhas agora está fechada.";
                    StopDaemon(self);
                    ClockTower.number = 21;
                    give ClockTower general;
                    ClockTower.time_left = 0;
                    AdvanceTime(self);
                    DoneHint(WhatNextPuzzle,26);
                    if (Intoxicated > 5)
                        StartDaemon(Hiccups);
                     print "^O Reitor se levanta, o que parece ser o sinal para o fim do \
                         jantar, pois todos os outros também se levantam e vão para as \
                         várias saídas. Você busca seus pertences no vestiário e volta a \
                         tempo de ver os últimos membros subindo as escadas para a sala \
                         comum dos professores.^^~Vamos subir para tomar alguns drinques~, \
                         diz o Reitor antes de partir. ~Espero que você se junte a nós.~^";
                    PlayerTo(GreatHall);
                    for (i = MasterD: i ~= 0: i = i.other_obj) {
                        move i to GreatHall;
                        MoveNPC(i,SeniorCommonRoom,u_obj);
                    }
                    rtrue;
                }
            }
            switch (random(17)) {
              1: "^Jarboe sussurra algo para Bungay, mas você não consegue entender suas \
                 palavras.";
              2: "^Bungay resmunga algo para Jarboe, mas você não consegue entender o que \
                 ele diz.";
              3: "^Halfhide e o Reitor especulam sobre os candidatos a reitor da Faculdade \
                 de Saint Stephen.";
              4: "^O Reitor reclama da queda no nível dos calouros que entram na \
                 faculdade.";
              5: "^Wilderspin especula sobre a possibilidade de a Faculdade Biblioll \
                 algum dia se tornar mista. Halfhide é cético, e o Reitor diz que isso \
                 nunca acontecerá enquanto ele for Reitor. ~Sem contar as presentes, é \
                 claro~, diz ele, ~as mulheres não são capazes da carga acadêmica que \
                 Christminster exige.~";
              6: "^Wilderspin e Bungay discutem os candidatos mais recentes às bolsas da \
                 Academia Britânica e suas chances de sucesso.";
              7: "^O Reitor medita sobre a longa história desses jantares comemorativos.";
              8: "^Jarboe fala sobre os planos de ampliar o currículo de matemática.";
              9: "^Halfhide elogia o Reitor pela excelente qualidade da comida.";
             10: "^O Reitor fala da necessidade de atrair mais alunos para a Faculdade \
                 Biblioll. Jarboe acha que isso deve ser feito melhorando os padrões \
                 acadêmicos, mas Halfhide sugere que um bom resultado da equipe de remo \
                 seria mais eficaz.";
             11: "^Halfhide recorda suas aventuras no norte da África com Monty.";
             12: "^Wilderspin fala de seus planos para obter financiamento para uma \
                 expedição a Assuã. O Reitor se pergunta se isso não seria um pouco \
                 perigoso no momento, dada a situação internacional.";
            }
        ];

Nearby  CollegePlate "coleção de prataria"
 has    static
 with   name "collection" "gold" "silver" "plate" "of" "treasure"
            "treasures",
         initial "A coleção de prataria do College está exposta com destaque \
             na mesa principal.",
         description "Esta coleção de utensílios serve para ser admirada, não \
             para comer: aqui estão a taça dourada de batismo de Henrique II, \
             o corno de hidromel de Carlos I, a taça de prata do bispo de \
             Gloucester e muitos outros tesouros.",
        before [;
          Take,Remove: "Você é uma convidada, e não é educado roubar os \
             objetos de valor do anfitrião.";
        ];

Class   DinerClass
 class  TalkableClass
 has    proper concealed animate
 with   before [;
         Speak: 
             print "Suas palavras se perdem no tumulto do ";
             if (location == DiningHall) print "jantar";
             else print "salão comum";
             ", e ele parece não ouvir você.";
        ];

Nearby  MasterD "Reitor do Biblioll College"
 class  DinerClass
 has    ~proper
 with   name "Master" "of" "biblioll" "college" "man",
        article "the",
        other_obj JarboeD,
         description "O Reitor é um homem velho, mas vivaz e ainda \
             elegante. Sua barba cavanhaque é preta.";

Nearby  JarboeD "Doutor Jarboe"
 class  DinerClass
 with   name "doctor" "dr" "jarboe" "fellow",
        other_obj BungayD,
         description "Jarboe é um homem alto e esquelético, de membros finos \
             e desajeitados e nariz longo e pontudo. Seu terno pende dos \
             ombros estreitos.";

Nearby  BungayD "Professor Bungay"
 class  DinerClass
 with   name "professor" "prof" "bungay" "fellow",
        other_obj WilderspinD,
         description "Bungay é um homem baixo, com pouco mais de um metro e \
             meio, um pouco mais baixo que você, mas sua enorme corpulência \
             compensa a falta de altura. Suas roupas quase estouram nas costuras.";

Nearby  WilderspinD "Professor Wilderspin"
 class  DinerClass
 with   name "professor" "wilderspin" "prof" "fellow",
        other_obj HalfhideD,
         description "Wilderspin é alto e barbudo, e você estimaria sua idade \
             em cerca de cinquenta anos.";

Nearby  HalfhideD "Doutor Halfhide"
 class  DinerClass
 with   name "doctor" "dr" "halfhide" "don" "donnish" "fellow",
        other_obj 0,
          description "Ele é um sujeito com jeito de professor, com entradas no \
              cabelo e bigode de guidão.";

Class   FoodClass
 with   before [;
          Take,Remove: "É rude pegar a própria comida.";
        ];

Object  Lobster "lagosta"
 class  FoodClass
 has    edible
        ! general once you've opened it
 with   name "lobster" "fish" "crayfish" "shellfish",
         description "Você olha para a lagosta. Ela retribui o olhar de modo \
             inquietante. Parece que será uma batalha difícil, e você não está \
             nada confiante no resultado.",
        before [;
         Open,AttackWith,Cut:
             "Você terá de dizer precisamente como pretende fazer isso.";
         SmellThing:
            if (self has general)
                 "Um forte cheiro de peixe vem das entranhas da lagosta.";
         Insert:
            if (second == Widget) <<Tie Widget self>>;
         Eat:
            if (self hasnt general)
                 "A espessa casca da lagosta é perfeitamente capaz de protegê-la \
                 de suas débeis tentativas de comê-la.";
            remove self;
            if (Widget.state > 1) Widget.state = Widget.state - 2;
            Achieved("eating the lobster");
             "Para sua surpresa, a lagosta está excelente.";
        ];

Object  Widget "dispositivo"
 with   name "widget" "implement" "screw" "metal" "u-shaped" "piece",
         description "É uma peça de metal em forma de U. Um parafuso atravessa \
             furos nas pontas, unindo-as.",
        state 0, ! 0 open
                 ! 1 closed, not attached to lobster
                 ! 2 attached to lobster, open
                 ! 3 attached to lobster, closed
        before [;
         Take,Remove:
            if (self.state == 3)
                 "Você terá de girar o parafuso antes de remover o dispositivo \
                 da lagosta.";
         Turn:
            if (self.state == 1 or 3) {
                self.state = self.state - 1;
                 "Você gira o parafuso, e as pontas do dispositivo se separam.";
            }
            if (self.state == 2 && Lobster hasnt general) {
                self.state = 3;
                give Lobster general;
                 "Você gira o parafuso, e o dispositivo se prende à lagosta. \
                 Sem parar, você continua girando até a casca da lagosta se \
                 partir com um estalo. Um cheiro intenso sai das entranhas. \
                 Sucesso!";
            }
            self.state = self.state + 1;
             "Você gira o parafuso, aproximando as pontas do dispositivo.";
         Tie,PutOn:
            if (self.state > 1)
                 "O dispositivo já está preso à lagosta.";
            if (second ~= Lobster) rfalse;
            if (self.state == 1)
                 "O dispositivo não cabe ao redor da lagosta.";
            self.state = 2;
             "Você desliza o dispositivo até ele envolver a lagosta.";
        ],
        after [;
         Take,Remove:
            if (self.state == 2) self.state = 0;
        ];

Object  WineGlass "taça"
 class  VesselClass
 has    open
 with   name "glass" "cup",
         description "Uma taça de vinho comum.",
        before [;
          Attack,Knock: "Você não quer espalhar cacos de vidro por toda parte.";
         EmptyT:
            if (second == Plate or Snail && Snail in plate && 
              Snail.state < 2) {
                Snail.state = 1;
                 "Você derrama um pouco do vinho no prato, no caminho do \
                 caracol. É difícil dizer, mas você juraria que ele avançou e \
                 lambeu tudo!";
            }
        ];

Nearby  Wine "vinho"
 class  LiquidClass
 with   name "wine" "white",
        number 10,
        after [;
          SmellThing: "Um aroma agradável.";
         Drink,Eat:
            if (Intoxicated > 10)
                "Você já bebeu vinho demais e tem a nítida sensação de que, \
                se beber mais, ficará doente.";
            Intoxicated ++;
            "Você bebe um pouco do vinho branco, que é muito agradável. Mas, \
            assim que pousa a taça, ela é novamente preenchida.";
         Insert,PutOn,Transfer,Empty,EmptyT:
            <<EmptyT WineGlass second>>;
        ];

Object  Plate "prato de porcelana"
 has    supporter
 with   name "plate" "china",
        capacity 3,
        before [;
          Take,Remove: "É rude pegar seu prato.";
        ];

Nearby  Snail "caracol"
 class  FoodClass
 with   name "snail" "mollusk" "mollusc" "shell",
        description [;
            print "É um molusco grande e pouco apetitoso, com uma concha de \
                cerca de cinco centímetros de diâmetro. ";
            switch (self.state) {
              0: "O modo como ele se arrasta pelo prato indica que ainda não \
                está morto.";
              1: "Ele se arrasta pelo prato de maneira desajeitada e ébria.";
              2: "Ele jaz indefeso de costas, com as entranhas macias expostas.";
            }
        ],
        state 0,
        before [;
         Take,Remove:
            if (self.state == 0)
                "O caracol se prende firmemente ao prato e você não consegue \
                movê-lo.";
            "É rude pegar a própria comida.";
         Eat,Taste:
             if (self.state < 2)
                 "O caracol se recolhe na concha e se agarra firmemente ao prato, \
                 e você não consegue alcançá-lo. Se pudesse virá-lo para expor \
                 as partes moles, talvez tivesse mais chance.";
             "De algum modo, a ideia de comer um animal vivo não lhe agrada.";
         Attack,Cut: 
            if (self.state < 2)
                 "A concha do caracol é resistente demais para seu ataque débil. \
                 Se pudesse virá-lo para expor as partes moles, talvez tivesse \
                 mais chance.";
             "Uma arma melhor talvez ajudasse.";
         AttackWith:
            if (second == Knife or Fork && self.state == 2) {
                remove self;
                move DeadSnail to Plate;
                Achieved("killing the snail");
                 print_ret "Você enfia ", (the) second,
                     " no caracol, que morre de modo repulsivo.";
            }
         Turn,Push,Pull:
            if (self.state == 0)
                 "O caracol se agarra firmemente ao prato, e você não consegue \
                 movê-lo.";
            if (self.state == 1) self.state = 2;
            else self.state = 1;
             "Usando a faca e o garfo, você vira o caracol indefeso de costas.";
        ];

Object  DeadSnail "caracol morto"
 class  FoodClass
 with   name "dead" "snail" "mollusk" "mollusc" "shell",
         description "O caracol jaz morto em seu prato. Parece que você fez uma \
             grande bagunça com suas entranhas, e o resultado não é bonito de ver.",
        before [;
          Taste,Eat: "A perspectiva é repugnante demais para você prosseguir.";
        ];

Object  Knife "faca"
 with   name "knife";

Object  Fork "garfo"
 with   name "fork";

Object  PortGlass "taça"
 class  VesselClass
 has    open
 with   name "glass" "cup",
         description "Um copo pequeno, para vinho de sobremesa ou bebidas fortes.";

Object  PortDecanter "decantador"
 class  VesselClass DelicateClass
 has    open
 with   name "decanter",
         description "Um belo decantador de vidro.",
        before [;
         Give:
            if (second == WilderspinD) {
                move self to GivenAway;
                Achieved("passing the port");
                "Wilderspin aceita o decantador de você, serve-se um pouco e o passa pela \
                mesa.";
            }
            if (second has animate)
                print_ret "~Ahem~, diz ", (the) second,
                    " incisivamente, recusando o vinho do Porto. Você entende que não fez \
                    exatamente a coisa certa.";
        ],
        each_turn [;
            if (children(self) == 0) {
                <Invoke PortStore>;
                move child(PortStore) to self;
            }
        ];

Object  PortStore "port store"
 class  LiquidStoreClass
 with   other_obj PortA;

Class   PortClass
 class  LiquidClass
 with   name "port" "wine" "red",
        article "some",
        number 11,
        after [;
          SmellThing: "O vinho do Porto tem um cheiro muito doce e muito forte.";
         Eat,Drink,Taste:
            if (Intoxicated > 10)
                 "Você já bebeu demais e tem a nítida sensação de que, se beber \
                 mais, ficará doente.";
            if (children(PortGlass) == 0)
                 "É de uma falta de educação terrível beber diretamente do \
                 decantador!";
            Intoxicated ++;
            remove child(PortGlass);
             "Você bebe o líquido xaroposo. Ele é doce e enjoativo demais para \
             que você tome mais que um pouco.";
        ];

Nearby  PortA "port" class PortClass with other_obj PortB;
Nearby  PortB "port" class PortClass with other_obj PortC;
Nearby  PortC "port" class PortClass with other_obj 0;


!--------------------------------------------------------------------------
! 8.2 AFTER THE DINNER
!--------------------------------------------------------------------------

Object  SeniorCommonRoom "Sala Comum dos Professores"
 has    light
        ! general once Jarboe, Bungay gone
 with   name "senior" "common" "room" "fellow" "fellows" "furnishing" 
            "furnishings",
         description "Aqui os membros da faculdade se reúnem depois do jantar para \
             beber e conversar. Na ausência deles, os móveis caros parecem opacos e \
             sem brilho, e não há nada a fazer além de voltar ao salão.",
        d_to GreatHall,
        each_turn NULL,
	edward_dirs d_obj;

[ SCREachTurn;
    MoveNPC(JarboeD,0,d_obj);
    MoveNPC(BungayD,0,d_obj);
    self.each_turn = NULL;
     "^Você nota Jarboe e Bungay afastando-se silenciosamente da recepção.";
];

Object  Candles "velas"
 has    light static
        ! general if taken the candle
 with   name "candles" "candle" "wax",
         initial "Velas de cera fornecem uma luz trêmula.",
        before [;
         Take:
            if (self has general)
                 "Você já roubou tantas velas quanto seria prudente roubar.";
            give self general;
            move Candle to player;
            ResetVagueWords(Candle);
            StartDaemon(Candle);
             "Você pega uma das velas.";
        ];

Object  Candle "vela"
 has    light
 with   name "candle",
        before [;
         SwitchOn,Burn:
             if (self has light) "A vela já está acesa.";
            if (FlameAvailable() == 1) {
                give self light;
                StartDaemon(self);
                 "Você acende a vela.";
            }
             "Você não tem uma fonte de fogo.";
         SwitchOff:
             if (self hasnt light) "A vela não está acesa.";
            give self ~light;
             "Você apaga a chama da vela.";
        ],
        daemon [;
            ! It goes out if put into a container.
            if (parent(self) ~= 0 && parent(self) has container) {
                give self ~light;
                StopDaemon(self);
                if (LineOfSight(self,player) == 1)
                     "^A vela se apaga.";
            }
        ];

Object  Hiccups "soluços"
        ! general if told you about drinking too much
 with   time_left 2,
        number 1,
        daemon [;
            self.time_left = self.time_left - 1;
            if (self.time_left > 0) rfalse;
            if (self hasnt general) {
                give self general;
                 print "^Hic! Você deve ter bebido vinho demais no jantar.^";
            }
            else print "^Hic!^";
            self.time_left = self.number;
            if (random(self.number) == 1)
                self.number = self.number + 1;
            if (location == Crypt && Crypt.state < 8)
                <<Take JarboeD>>;
        ];


!--------------------------------------------------------------------------
! 8.3 ENTERING THE ENDGAME
!--------------------------------------------------------------------------

Object  RoofA "Telhado da Casa do Reitor"
 has    light no_edward
 with   name "roof" "gutter" "tile" "tiles" "first" "court" "narrow"
            "ledge" "great" "gate" "initials",
         description "Aqui em cima, nas telhas da faculdade, está fresco e venta, e \
             você tem uma vista excelente, embora um tanto alarmante, do Primeiro Pátio \
             e da bandeira da faculdade tremulando sobre o Grande Portão. Você pode \
             tentar descer pela glicínia ou seguir uma saliência estreita para o sul.",
        d_to Wistaria,
        s_to RoofB,
         n_to "Uma queda vertiginosa impede que você se aproxime mais da torre do relógio.",
         cant_go "A única saída segura é seguir a saliência para o sul, mas você também \
             poderia tentar descer pela glicínia.",
        before [;
          Jump: "Certamente você ainda tem motivos para viver?";
        ];

Nearby  Gargoyle "gárgula"
 has    static
 with   name "gargoyle" "ugly",
         initial "Uma gárgula de pedra assustadora agacha-se junto à calha.",
         description "É uma criatura feia, cujo rosto talvez seja uma caricatura de um \
             antigo membro da faculdade. As iniciais ~JF~ foram gravadas cuidadosamente \
             em seus quartos traseiros.",
        life [ i;
         Give:
            if (noun has is_vessel && noun has open && 
              children(noun) > 0 && child(noun) has is_liquid) {
                i = child(noun);
                 print "A boca escancarada da gárgula aponta para baixo, então é difícil \
                     ver como despejar ", (the) i, " nela.";
                if (i == ElixirC)
                     print " Talvez seja melhor assim; a gárgula não parece muito \
                         amigável.";
                new_line; rtrue;
            }
        ],
        before [;
          Attack,Tickle: "A gárgula suporta seu ataque estoicamente.";
        ];

Nearby  Flag "bandeira"
 has    scenery
 with   name "flag" "flagpole" "pole" "banner" "coat" "of" "arms",
         description "A bandeira tremula ao vento, e você consegue distinguir o brasão \
             da faculdade: três leões rampantes e uma taça de prata.",
        before [;
         Examine: rfalse;
          default: "Você não consegue alcançar a bandeira daqui.";
        ];

Object  RoofB "Telhado da Escadaria ~B~"
 has    light no_edward
 with   name "roof" "staircase" "stair" "b" "tile" "tiles" "tiled" "roofs",
         description "Você está numa saliência estreita no telhado da Faculdade \
             Biblioll. Telhados de telha sobem para leste e oeste, e a saliência segue \
             para o norte. Ao sul, uma escada de metal desce até um espaço fechado entre \
             os prédios da faculdade.",
         cant_go "Os telhados são íngremes demais para subir.",
        n_to RoofA,
        s_to [;
             print "Você desce pela escada.^";
            return Ladder;
        ],
        d_to Ladder;

Object  Ladder "escada"
 has    scenery door open
 with   name "ladder",
        found_in RoofB Well,
        door_dir [;
            if (self in Well) return u_to;
            return d_to;
        ],
        door_to [;
            if (self in Well) return RoofB;
            return Well;
        ],
        before [;
         Climb: <<Enter self>>;
        ];

Object  Well "Pátio Pequeno"
 has    light proper no_edward
 with   name "weed" "weeds" "stair" "staircase" "library" "college" "ugly"
            "kitchen" "kitchens",
         description "Um pequeno espaço fechado por todos os lados: uma escadaria da \
             faculdade ao norte, as cozinhas a leste, a biblioteca a oeste e um alto muro \
             de tijolos ao sul. Uma escada metálica precária sobe pelo prédio ao norte, e \
             ervas daninhas feias crescem por toda parte.",
        u_to Ladder,
        n_to Ladder,
        d_to [;
            if (Manhole has open) return Manhole;
             "O bueiro está fechado.";
        ],
        w_to [;
            if (HoleB notin self) rfalse;
             print "Você volta de mãos e joelhos para a biblioteca e fecha a entrada \
                 secreta atrás de si.^";
            return Library;
        ],
        before [;
         Go,Enter,Climb:
            if (noun == s_obj)
                <<Climb BrickWall>>;
        ];

Nearby  Manhole "bueiro"
 has    locked openable lockable static enterable supporter
 with   name "manhole" "hole" "rust" "keyhole",
         description "A tampa é de metal e tão velha que sua superfície descasca com a \
             ferrugem. Há uma fechadura de um lado.",
        describe [;
            if (self has open)
                 "^Um bueiro aberto leva para baixo, à escuridão.";
             "^Há um bueiro fechado no centro do pátio.";
        ],
        door_to TunnelA,
        door_dir d_to,
        with_key RustyKey,
        before [;
         Receive:
            if (self has open)
                "Isso cairia no túnel.";
         Open:
            if (player in self)
                "Não enquanto você estiver sobre ele!";
         Invoke:
            switch (second) {
             0: give self ~open enterable supporter ~door;
             1: give self ~locked open ~enterable ~supporter door;
            }
            if (second > 0) {
                while (child(self) ~= 0)
                    move child(self) to KitchenLobby;
            }
            rtrue;
        ],
        after [;
         Open: <Invoke self 1>;
         Close: <Invoke self 0>;
        ];

Object  RustyKey "chave enferrujada"
 class  KeyClass
 with   name "rusty";

Object  HoleB "entrada secreta da biblioteca"
 has    door static open
 with   name "secret" "library" "entrance",
        article "the",
         initial "Uma entrada secreta para a biblioteca leva para oeste.",
         description "A entrada secreta é muito baixa, talvez com meio metro de altura, \
             mas você rastejou por ela numa direção, então tem certeza de que pode voltar \
             rastejando.",
        door_dir w_to,
        door_to Library;

Object  TunnelA "Túnel"
 has    light no_edward
 with   name "tunnel" "uneven" "wood" "wooden" "board" "floorboard"
            "boards" "hole",
         description "Você está sobre tábuas de madeira irregulares num túnel escuro. Um \
             pouco de luz entra por um buraco no teto, e o túnel leva para leste, à \
             escuridão.",
        each_turn [;
            self.each_turn = NULL;
            DoneHint(WhatNextPuzzle,27);
        ],
        e_to [;
             print "O túnel continua por uma longa distância, talvez cinquenta metros, e \
                 você tateia cuidadosamente pela escuridão.^";
            return TunnelB;
        ],
        u_to Well; ! can't have manhole closed while in tunnel

Object  TunnelB "Túnel"
 has    no_edward
 with   name "tunnel" "moisture" "drip" "rotting" "rot" "mould" "rotten"
            "flakes" "flake",
         description "As paredes de madeira apodrecida deste túnel sombrio gotejam \
             umidade. Ele continua para oeste, mas há uma porta a leste.",
        w_to [;
            print "Você tateia de volta pelo longo túnel.^";
            return TunnelA;
        ],
        e_to [;
            if (TunnelDoor has open) {
                give TunnelDoor ~open locked;
                 print "A porta se fecha atrás de você. Você tateia por uma passagem \
                     escura até encontrar o caminho bloqueado por uma cortina; do outro \
                     lado, ouve vozes.^";
                PlayerTo(Tapestries,-1);
                StartDaemon(Crypt);
                AdvanceTime(Crypt);
                DoneHint(WhatNextPuzzle,28);
                <<Look>>;
            }
            if (OffersLight(self) == 0)
                 "Você encontra algum tipo de barreira bloqueando sua passagem para leste.";
            return TunnelDoor;
        ],
        before [;
         Tie: 
            if (noun == Corkscrew && second == TunnelDoor)
                <<Insert noun second>>;
        ];

Nearby  TunnelDoor "porta"
 has    door openable lockable locked scenery autoopen
        ! general if the handle has broken
 with   name "door" "wooden" "wood",
         description "A porta é feita da mesma madeira que as paredes do túnel e vem \
             apodrecendo lentamente há muito tempo.",
        door_dir e_to,
        door_to Crypt,
        with_key RustyKey,
        before [;
         Receive:
            if (noun == Corkscrew) {
                give Corkscrew general;
                move Corkscrew to TunnelB;
                 "A madeira podre é macia o bastante para você conseguir enfiar o \
                 saca-rolhas profundamente na porta.";
            }
         Open:
            if (self has general)
                "Não há maçaneta.";
            give self general;
            "A maçaneta se solta em sua mão e se desfaz em lascas de madeira.";
        ];

Object  Corkscrew "saca-rolhas"
        ! general if its in the door
 with   name "corkscrew" "cork" "screw",
        describe [;
            if (self has general) {
                if (location ~= TunnelB)
                    "^** Erro: saca-rolhas no lugar errado **";
                "^Um saca-rolhas está cravado na porta de madeira.";
            }
        ],
        before [;
         Pull:
            if (self has general) {
                if (TunnelDoor has locked)
                    "A porta está trancada.";
                if (TunnelDoor has open)
                    "A porta já está aberta.";
                give TunnelDoor open;
                Achieved("opening the door in the tunnel");
                "Você puxa o saca-rolhas com todo o seu peso e, como uma garrafa de vinho \
                relutante, a porta se abre.";
            }
        ],
        after [;
         Take,Remove:
            if (self has general) {
                give self ~general;
                "Você remove o saca-rolhas da porta.";
            }
        ];


!--------------------------------------------------------------------------
! 8.4 THE CRYPT
!--------------------------------------------------------------------------

Object  Crypt "Cripta"
 has    light no_edward
 with   name "crypt" "white" "robe" "robes" "hood" "hoods" "chair" "noose"
            "rope" "rafter" "rafters",
         description "Atrás de uma cortina espessa, você vê uma sala subterrânea escura, \
             iluminada fracamente por fileiras de velas trêmulas. Tapeçarias espessas \
             cobrem as quatro paredes, exceto por uma porta aberta a leste.^^No centro \
             da sala, seu irmão Malcolm está sobre uma cadeira, com mãos e pés amarrados, \
             e uma corda apertada em seu pescoço presa ao teto. Jarboe e Bungay estão aqui, \
             vestidos com longos mantos brancos. A cena a enche de horror, mas você não ousa \
             mover-se ou protestar, para não ser ouvida.^^Um buraco escuro leva para oeste.",
        state 0,
        e_to [;
            if (self.state < 8) <<Take DoorCryptC>>;
            return DoorCrypt;
        ],
        before [;
         Go,Enter:
            if (noun ~= w_obj) rfalse;
            if (self.state >= 8)
                "As tapeçarias estão queimando com tanta força que você não pode sair por \
                 ali. Deve usar a porta a leste ou morrerá!";
            "Ansiosa para escapar da cena terrível, você volta pela passagem, mas, para seu \
             horror, a porta podre está trancada! Não há saída por ali.";
         Speak,Sing,Scream,Mild,Strong:
            if (self.state < 8)
                "Psiu! Jarboe e Bungay certamente ouviriam você!";
        ],
        daemon [ i;
            if (self.state < 8 && location ~= Crypt)
                print "^** Erro: a jogadora escapou da cripta **^";
            if (self.state < 8 && location == Crypt &&
              player notin Tapestries) {
                new_line;
                <<Take JarboeC>>;
            }
            self.state = self.state + 1;
            switch (self.state) {
             1:
                "^Jarboe tira uma adaga do manto e a agita diante do rosto de Malcolm. \
                 ~Conte-nos a verdade~, sibila.";
             2:
                "^~Já contei~, diz Malcolm roucamente. ~Não sei o que querem dizer. Era \
                 apenas um jogo... uma ideia boba... não existe elixir.~ Ele claramente \
                 tem dificuldade para falar.";
             3:
                "^~Você está mentindo~, grita Bungay. ~Está tentando guardar o segredo para \
                 si! Tentamos sua suposta receita e ela não funcionou. Esta é sua última \
                 chance de nos contar a verdade.~";
             4:
                "^~Meu Deus!~, grasna Malcolm. ~Vocês realmente acreditam nisso... estão \
                 loucos, os dois... que farsa é essa? Quem são vocês?~";
             5:
                "^~Somos Cavaleiros do Templo Sagrado~, entoa Bungay solenemente. ~Os \
                 guardiões da Cabala e da sabedoria de Jerusalém!~";
             6:
                "^Malcolm ri fracamente. ~Cavaleiros Templários! Elixir da vida! Ha ha! \
                 Que dupla de palhaços vocês são!~";
             7:
                ! Just in case the player types 'examine malcolm' on the
                ! next turn (only!). What we do for realism!
                MalcolmC.description = MalcolmsBody.description;
                 "^~Como ousa?~, grita Jarboe e, com um chute violento, derruba a cadeira \
                 debaixo de Malcolm, que solta um grito sufocado e depois fica em silêncio, \
                 balançando lentamente no teto.";
             8:
                MoveNPC(JarboeC,0,e_obj);
                remove BungayC;
                remove CandlesC;
                remove MalcolmC;
                remove DoorCryptC;
                give DoorCrypt ~absent;
                move DoorCrypt to self;
                move MalcolmsBody to self;
                move Noose to self;
                move DeadBungay to self;
                move Dagger to self;
                give Fire ~absent;
                move Fire to self;
                PlayerTo(self,1);
                give Tapestries ~enterable ~container ~open;
                 Tapestries.description = "Ressecadas por anos nesta sala subterrânea, as \
                     tapeçarias pegaram fogo como palha seca.";
                 self.description = "Esta câmara subterrânea é revestida de tapeçarias \
                     espessas, agora em chamas. O fogo sobe pelas paredes e atravessa o \
                     teto. O calor é opressivo e a fumaça sufocante. Se você não escapar \
                     logo, certamente morrerá!";
                "^Jarboe olha horrorizado para o que fez. ~Eu não quis...~, começa.^^~Seu \
                 idiota~, grita Bungay. ~Seu completo idiota! O que você fez?~ Furioso, ele \
                 avança contra Jarboe com os punhos cerrados. Os dois caem desajeitados no \
                 chão, derrubando as velas sobre a tapeçaria, que rapidamente pega fogo.^^De \
                  repente, ouve-se um grito terrível e agudo dos homens em luta, e então Jarboe se \
                 levanta, com sangue pingando da adaga. Ele olha para ela, como se não \
                 acreditasse ter acabado de matar dois homens, depois a joga de lado e \
                 corre pela porta para leste.";
            }
            if (location == Crypt) {
                switch (self.state) {
                  9: "^O fogo rapidamente toma as tapeçarias ressecadas e se espalha pela sala.";
                  10: "^O fogo continua a se espalhar.";
                  11: "^As vigas pegaram fogo, e as chamas avançam pelo teto.";
                  12: "^O calor é opressivo.";
                  13: "^As chamas continuam a avançar pelo teto.";
                  14: "^O rugido do fogo está muito alto agora, enquanto as chamas atacam as \
                     vigas acima de sua cabeça.";
                  15: "^O calor agora é uma agonia. Você precisa escapar!";
                  16: "^Há um estalo! Uma viga em chamas cai do teto, por pouco não atingindo você.";
                 default:
                    deadflag = 1;
                     "^Há um estalo! Uma viga em chamas cai do teto e atinge sua cabeça. Você \
                     cai inconsciente nas chamas...";
                }
            }
            if (location == CryptStairGround or CryptStairTop) {
                i = self.state;
                if (location == CryptStairTop) i = i - 4;
                if (i < 14) rfalse;
                switch(i) {
                  14: "^As chamas estão se espalhando pela cripta.";
                  15: "^Os degraus de madeira sob seus pés começam a soltar fumaça.";
                  16: "^O calor é opressivo.";
                  17: "^Por mais rápido que você pise em cada nova língua de fogo, o fogo é \
                      mais rápido. Logo toda a escadaria estará em chamas.";
                  18: "^O rugido do fogo está muito alto agora, enquanto as chamas atacam os \
                     degraus sob seus pés e as vigas acima de sua cabeça.";
                  19: "^O calor agora é uma agonia. Você precisa escapar!";
                 default: 
                    deadflag = 1;
                     "^Há um estalo! Os degraus cedem sob seus pés, lançando você no inferno.";
                }
            }
        ];

Class   DangerClass
 with   life [; <<Take self>>; ],
        before [;
         Examine: rfalse;
         default:
            if (Crypt.state < 8) {
                deadflag = 1;
                "~O que foi isso?~, diz Bungay, ouvindo o movimento. Antes que você possa \
                reagir, ele afasta a tapeçaria e a agarra com brutalidade. ~Meu Deus!~, \
                grita. ~O que temos aqui? Uma espiã!~ Seu rosto enlouquecido é a última \
                coisa que você vê antes de desmaiar misericordiosamente, para nunca mais \
                acordar...";
            }
        ];

Class   CultistClass
 class  DangerClass
 has    proper animate concealed
 with   name "cultist",
        description [;
             print_ret (The) self, " veste um longo manto branco, e um capuz esconde a \
                 maior parte de seu rosto, mas, por seu porte e comportamento, você tem \
                 certeza de sua identidade.";
        ];

Nearby  Tapestries "tapestries"
 has    static enterable open container concealed
 with   name "curtain" "tapestry" "drape" "curtains" "tapestries" "drapes"
            "wall-hanging" "arras",
         description "São muito antigas e ressecadas. Parecem prestes a desmoronar.",
        before [;
         Burn:
            if (Crypt.state >= 8)
                "As tapeçarias já estão queimando muito bem.";
            print "Você incendeia as tapeçarias, que rapidamente explodem em chamas. ";
            <<Take BungayC>>;
        ];

Nearby  CandlesC "candles"
 class  DangerClass
 has    light static concealed
 with   name "candles" "array" "flickering" "arrays" "of";

Nearby  JarboeC "Doctor Jarboe"
 class  CultistClass FollowClass
 with   name "doctor" "jarboe" "dr" "fellow";

Nearby  BungayC "Professor Bungay"
 class  CultistClass
 with   name "professor" "prof" "bungay" "fellow";

Nearby  MalcolmC "Malcolm"
 class  DangerClass
 has    animate proper concealed
 with   name "malcolm" "spencer" "brother" "fellow",
         description "Ele está na ponta dos pés sobre a cadeira, com mãos e pés \
             amarrados, a corda apertando seu pescoço e puxando-o para cima. \
             Está claramente sofrendo muito e com dificuldade para respirar. \
             Se ao menos você pudesse resgatá-lo!";

Nearby  DoorCryptC "doorway"
 class  DangerClass
 has    door openable lockable scenery
 with   name "door" "doorway",
        door_dir e_to,
        door_to 0;

Object  DoorCrypt "doorway"
 has    door absent scenery open autoopen
 with   name "door" "doorway",
        found_in Crypt CryptStairGround,
        door_dir [; 
            if (self in Crypt) return e_to;
            else return d_to;
        ],
        door_to [;
            if (self in Crypt) return CryptStairGround;
            else return Crypt;
        ];

Object  Noose "noose"
 has    static concealed
 with   name "noose" "rope",
        before [;
          Attack,Cut,Untie: "A corda está apertada demais para ser desfeita com as mãos.";
         AttackWith:
            if (second ~= Dagger)
                 "Seus esforços são inúteis.";
            remove self;
            remove MalcolmsBody;
            move MalcolmsBodyB to Crypt;
            Achieved("cutting the noose");
             "Sustentando o corpo inerte de Malcolm da melhor maneira possível, você corta \
             a corda e o abaixa até o chão.";
        ];

Object  Dagger "dagger"
 with   name "dagger" "knife" "sword" "blood" "bloody",
         description "É uma visão horrível, coberta pelo sangue de Bungay.";

Object  MalcolmsBody "Malcolm's body"
 has    animate static proper
 with   name "malcolm" "spencer" "brother" "body" "malcolm^s" "brother^s",
         initial "O corpo de Malcolm pende do teto por uma corda.",
         description "Ele pende imóvel do teto, a corda apertando cruelmente seu \
             pescoço. Seus olhos estão sem vida e seu rosto está azul.",
        life [;
            if (action == ##Give && noun has is_liquid)
                 "A corda está tão apertada em seu pescoço que você não consegue \
             abrir sua boca.";
             "Ele não se move.";
        ],
        before [;
          Search: "Você não encontra nada de interessante nos bolsos dele.";
          Attack,Resuscitate,Kiss: "Não há esperança de ressuscitá-lo enquanto ele \
             continuar sendo estrangulado pela corda.";
          Take,Remove: "Seria melhor cortar a corda e baixá-lo.";
          PushDir,Push,Pull,Touch: "Ele balança inerte na corda.";
        ];

Object  MalcolmsBodyB "Malcolm's body"
 has    animate static proper
 with   name "malcolm" "spencer" "brother" "body" "malcolm^s" "brother^s",
         initial "Malcolm jaz imóvel no chão.",
         description "Ele jaz imóvel no chão. Você não ouve batimentos nem sente sua \
             respiração. Seus olhos estão sem vida e seu rosto está azul.",
        life [ i;
            if (action == ##Give && noun has is_vessel && noun has open &&
              children(noun) > 0 && child(noun) has is_liquid) {
                i = child(noun);
                 print "Você abre a boca de Malcolm e derrama ", (the) i,
                     " nela. ";
                remove i;
                if (i == ElixirC) {
                    move Malcolm to parent(self);
                    remove self;
                    Achieved("giving Malcolm the elixir");
                    "Ele faz um movimento convulsivo repentino, e então seu peito \
                    começa a subir e descer. Está vivo!";
                }
            }
            "Ele não se move.";
        ],
        before [;
	 Search: "Você não encontra nada de interessante nos bolsos dele.";
          Attack,Resuscitate,Kiss: "Você golpeia o peito de Malcolm e sopra ar \
             nele até ficar tonta, mas em vão. Não há qualquer sinal de vida.";
          Take,Remove: "Ele é pesado demais para você levantá-lo, mas talvez \
             possa puxá-lo.";
          Push,Pull: "Você terá de dizer em que direção quer puxar o corpo de \
              Malcolm.";
         PushDir: AllowPushDir(); rtrue;
        ];

Object  Malcolm "Malcolm"
 has    animate static proper
 with   name "malcolm" "spencer" "brother",
         initial "Malcolm jaz inconsciente no chão.",
         description "Ele jaz inconsciente no chão, com hematomas terríveis ao \
             redor do pescoço, mas pelo menos está vivo!",
        life [;
             "Ele não responde.";
        ],
        before [;
	 Search: "Você não encontra nada de interessante nos bolsos dele.";
          Take,Remove: "Ele é pesado demais para você levantá-lo, mas talvez \
             possa puxá-lo.";
          Push,Pull: "Você terá de dizer em que direção quer puxar Malcolm.";
         PushDir: AllowPushDir(); rtrue;
        ];

Object  DeadBungay "Professor Bungay's body"
 has    animate static
        ! general if found the key
 with   name "prof" "professor" "bungay" "bungay^s" "body",
         initial "Bungay jaz morto no chão.",
         description "Ele jaz morto no chão, com sangue escorrendo de um ferimento \
             na garganta e chamas lambendo suas vestes.",
        life [;
          Give: "Por que você está perdendo tempo com ele?";
          default: "Ele está morto e não responde.";
        ],
        before [;
          Push,Pull: "Ele não pode ser movido.";
          Resuscitate: "Aquele ferimento enorme na garganta precisa de mais \
             cuidados do que você pode oferecer. Pode ser cruel dizer isso, mas \
             você está contente que o homem horrível esteja morto.";
         Search:
            if (self hasnt general) {
                give self general;
                move SilverKey to player;
                ResetVagueWords(SilverKey);
                 "Você golpeia as vestes em chamas de Bungay e consegue apagar o \
                 fogo tempo suficiente para revistar seu bolso. Encontra uma chave \
                 de prata quase quente demais para segurar. Por um instante, você \
                 se pergunta se Jarboe sabe dessa chave.";
            }
             "Não há mais nada para encontrar nos bolsos de Bungay.";
        ];

Object  SilverKey "chave de prata"
 class  KeyClass
 with   name "silver";

Object  Fire "fire"
 has    scenery light absent
 with   name "fire" "flame" "flames" "burning" "smoke",
         description "Está fora de controle. Se você não sair daqui logo, \
             certamente morrerá!",
        found_in [;
            if (location == Crypt && Crypt.state >= 8 ||
                location == CryptStairGround && Crypt.state >= 14 ||
                location == CryptStairTop && Crypt.State >= 18)
                rtrue;
        ],
        before [;
         Examine: rfalse;
         ThrownAt:
            if (noun has is_liquid) {
                remove noun;
                 "Seu esforço para apagar o fogo não surte efeito.";
            }
         SwitchOff:
             "Você não tem esperança de apagar o fogo. Seria melhor escapar \
             enquanto pode.";
         default:
             "O fogo está quente demais para você se aproximar.";
        ];


!--------------------------------------------------------------------------
! 8.5 THE LAST BATTLE
!--------------------------------------------------------------------------

Object  CryptStairGround "Parte inferior da Escadaria Secreta"
 has    no_edward light
 with   name "stair" "staircase" "wood" "wooden" "tread" "treads",
        description [;
             print "A parte inferior de uma escadaria antiga e apertada. Os degraus de \
                 madeira rangem sob seus pés. A escadaria sobe para o norte, e uma grande \
                 sala a oeste está em chamas.";
            if (Jarboe in CryptStairTop)
                 print " Você ouve pancadas acima, como se alguém tentasse arrombar uma porta.";
            if (Crypt.state >= 14 && Crypt.state < 17)
                 print " O fogo está se espalhando, e os degraus sob seus pés começam a \
                     soltar fumaça. Você precisa escapar!";
            if (Crypt.state >= 17)
                 print " As chamas estão ao seu redor, e o calor é intolerável. Você \
                     certamente morrerá em breve se ficar!";
            new_line; rtrue;
        ],
        w_to DoorCrypt,
        n_to CryptStairTop,
        u_to CryptStairTop,
        before [;
         Listen:
            if (JarboeE in CryptStairTop)
                 print "Você ouve batidas acima. ";
             "O rugido das chamas é muito alto.";
        ];

Object  CryptStairTop "Parte superior da Escadaria Secreta"
 has    no_edward light
 with   name "stair" "staircase" "white" "robe" "hood",
        initial [;
            if (Crypt.state < 17) Crypt.state = 17;
        ],
        description [;
             print "A parte superior de uma escadaria antiga, que desce para o sul. Há uma \
                 porta ao norte.";
            if (Crypt.state >= 18)
                 print " O fogo está se espalhando, e os degraus sob seus pés começam a \
                    soltar fumaça. Você precisa escapar!";
            if (Crypt.state >= 21)
                 print " As chamas estão ao seu redor, e o calor é intolerável. Você \
                    certamente morrerá em breve se ficar!";
            new_line; rtrue;
        ],
        d_to CryptStairGround,
        s_to CryptStairGround,
        n_to [ i j;
             if (Jarboe in self) "Jarboe bloqueia seu caminho.";
            if (DoorSecret hasnt open) return DoorSecret;
            if (pushed_object == Malcolm) i = 1;
            if (pushed_object == MalcolmsBodyB) j = 1;
             print "Você atravessa a porta com dificuldade e entra numa sala escura cheia de \
                 móveis caros. Suas forças estão acabando, seus pulmões estão cheios de \
                 fumaça e você está tão tonta que duvida conseguir andar mais. Está prestes \
                 a desmaiar quando duas figuras de capacete escuro se erguem diante de você. \
                 É o policial e um bombeiro! Nunca uma visão foi tão bem-vinda!";
            if (1 == i or j)
                 print " Você consegue manter a consciência tempo suficiente para dizer: \
                     ~Meu irmão! Ajudem-no!~";
             print " Então o fogo, a fumaça e o choque se tornam demais para você, e você \
                 desmaia...^^Muito tempo depois, acorda no hospital, recuperando-se de \
                 queimaduras de terceiro grau";
            if (i == 1) {
                deadflag = 2;
                Achieved("saving Malcolm from the fire");
                 print ". Malcolm está sentado ao lado da sua cama. ~Christabel!~, diz ele. \
                     ~Que alegria ver você! Eu a abraçaria de felicidade, mas o médico diz \
                     que ainda não posso tocá-la.~^";
            } else {
                deadflag = 3;
                 print ", com Edward sentado solícito ao lado da sua cama. Você pergunta \
                     o que aconteceu a Malcolm, e ele reluta muito em responder. Por fim, \
                     você o força a admitir que ";
                if (j == 1)
                     print "embora tudo tenha sido tentado para ressuscitá-lo, Malcolm está \
                         morto.^";
                else
                     print "o corpo de Malcolm foi recuperado dos destroços da faculdade, \
                         quase queimado demais para ser identificado.^";
            }
             print "^Mais tarde, você descobre que Edward fora ao quarto de Bungay naquela \
                 noite para entregar sua redação. Sentindo cheiro de fumaça, ele deu o \
                 alarme, e o porteiro chamou os bombeiros, que arrombaram a porta do quarto \
                 de Bungay a tempo de salvar você.^^O fogo destruiu quase toda a escadaria \
                 ~C~ antes que conseguissem apagá-lo. Os ossos carbonizados de Jarboe foram \
                 encontrados nos destroços da escadaria secreta, e nada foi encontrado de \
                 Bungay";
            if (i == 0)
                 ", mas isso não é consolo para você.";
             ". Ninguém tem explicação para o comportamento bizarro de Jarboe e Bungay; se \
             tal explicação algum dia existiu, certamente virou fumaça nas chamas.";
        ],
        before [;
          Listen: "O rugido das chamas é muito alto.";
        ];

Nearby  JarboeE "Doctor Jarboe"
 class  FollowClass CarryingClass TalkableClass
 has    proper
        ! general if no new-line at start of each_turn routine
 with   name "doctor" "dr" "jarboe" "fellow",
         initial "O Doutor Jarboe está aqui.",
         description "Jarboe é um homem alto e esquelético, com membros finos e \
             desajeitados e nariz longo e pontudo. Veste um longo manto branco, e seus \
             olhos encaram você com loucura.",
        life [;
         Give:
            if (noun == SilverKey or Dagger) {
                move noun to CryptStairTop;
                give self general;
                rtrue;
            }
         Show:
            if (noun == SilverKey or Dagger)
                 "~Dê-me isso~, diz Jarboe.";
        ],
        before [;
         Speak:
             "Jarboe ignora você. Ele parece tão louco agora que você nem tem certeza de \
             que a ouve.";
         Attack,AttackWith:
            if (Dagger notin player) {
                deadflag = 1;
                 "^Jarboe avança contra você e a derruba de cabeça escada abaixo. A última \
                 coisa que vê é a bota dele descendo sobre seu rosto.";
	    }
             print "Jarboe tenta tomar sua adaga para desarmá-la, mas você o golpeia. Ele \
                grita e segura o pulso ferido";
            if (self.state == 2) ".";
            MoveNPC(self, Crypt, d_obj);
             ". ~Deixe-me passar~, grita. ~Deixe-me passar, preciso buscar a chave ou \
             morreremos aqui.~ Você se afasta, ainda apontando a faca para ele, e ele passa \
             correndo por você escada abaixo, para a cripta em chamas.";
        ],
        state 0,
        each_turn [ i;
            if (self has general) i = 1;
            give self ~general;
            if (Dagger in location) {
                deadflag = 1;
                if (i == 0) new_line;
                "Jarboe agarra a adaga. ~Tola!~, grita exultante, e a crava no seu peito. A \
                última coisa que você ouve é sua risada insana.";
            }
            if (SilverKey in location) {
                remove SilverKey;
                MoveNPC(self, 0, n_obj);
                if (i == 0) new_line;
                "~Aha, a chave!~, grita Jarboe exultante, agarrando-a. Ele destranca a porta \
                e passa por ela. Você vai atrás, mas ele a empurra e começa a fechar a porta. \
                Você emprega toda a energia restante para mantê-la aberta, mas Jarboe é forte \
                demais e, com uma gargalhada horrível, fecha e tranca a porta. Você ouve sua \
                risada desaparecer do outro lado, até ficar sozinha com as chamas crepitantes.";
            }
            if (self.state == 0)
                print "^Jarboe joga o peso contra a porta numa tentativa de arrombá-la, mas sem \
                    sucesso. ~O cretino!~, grita. ~Ele me trancou aqui!~ Então ouve seus \
                    passos e se vira. ~Você de novo!~, berra. ~Tudo isso é culpa sua!~^";
            if (Dagger notin player) {
                deadflag = 1;
                "^Jarboe avança contra você e a derruba de cabeça escada abaixo. A última \
                coisa que vê é a bota dele descendo sobre seu rosto.";
            }
            if (self.state == 0) {
                if (LineOfSight(self,SilverKey) == 1) {
                    self.state = 2;
                    "^Ele parece prestes a atacá-la, mas para. ~Vejo que você tem a chave da \
                    porta~, diz ele. ~Dê-a para mim!~";
                }
                self.state = 1;
                "^Ele parece prestes a atacá-la, mas para. ~Dê-me a faca, menina~, diz \
                suavemente. ~Você não deveria carregar uma coisa tão perigosa.~";
            }
            if (self.state == 2) {
                if (LineOfSight(self,SilverKey) == 0)
                    "^Você não me engana~, diz Jarboe. ~Sei que você tem a chave. Dê-a para \
                    que eu possa destrancar a porta. Não seria bom nós dois morrermos aqui.~";
                "^~Dê-me a chave~, repete Jarboe. ~Não vou machucá-la.~";
            }
            "^~Dê-me a faca, menina~, repete Jarboe. ~Não vou machucá-la.~";
        ];

Nearby  DoorSecret "door"
 has    door openable lockable locked scenery
 with   name "door",
        with_key SilverKey,
        door_dir n_to,
        door_to 0,
        before [;
         Examine: rfalse;
         default:
            if (JarboeE in CryptStairTop)
                "Jarboe bloqueia seu caminho.";
        ];
