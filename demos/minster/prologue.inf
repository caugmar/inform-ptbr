!--------------------------------------------------------------------------
! 2.1 CHAPEL STREET
!--------------------------------------------------------------------------
! Christabel starts here to present her with obvious first objective - to
! get into the College. Knocking on the gate proves fruitless, but one of
! the cobbles in the street is loose.
!--------------------------------------------------------------------------

Class   KeepBritainTidyClass
 with   before [;
         Drop:
            if (Constable notin location || noun notin player) rfalse;
            Constable.state = Constable.state + 1;
             print_ret "O policial pega ", (the) noun, " e o devolve à sua \
                 mão. ~Parece que você deixou isto cair, madame,~ diz ele.";
        ];

Object  ChapelStreet "Rua da Capela"
 class  KeepBritainTidyClass
 has    light
        ! general if you've tripped on the cobbles.
 with   name "biblioll" "college" "early" "morning" "sun" "sunlight" "arch"
            "archway",
        description [;
            if (ClockTower.number < 20) {
                 print "É um dia quente de verão em Christminster, o tipo de \
                     dia que faz pensar em morangos com creme e em passeios \
                     de barco no rio. A ";
                 if (ClockTower.number < 13) print "manhã";
                else print "tarde";
                print " luz do sol";
            }
            else
                 print "É uma noite fresca de verão em Christminster. O \
                     luar";
            " ilumina as pedras da rua e o grande portão de madeira do \
             Biblioll College, a leste.";
        ],
        e_to GreatGate,
        in_to GreatGate,
        n_to [;
             if (EM == 0) print "Você vira à direita na Rua da Ponte.^";
            return BridgeStreet;
        ],
        s_to [;
             if (EM == 0) print "Você vira à esquerda na Rua Biblioll.^";
            return BibliollStreet;
        ],
        before [;
         Think:
            switch(noun) {
             QStrawberries: "Sua boca se enche de água só de pensar nessa delícia.";
             QPunting: "Sim, você adoraria passar a tarde flutuando \
                tranquilamente rio abaixo numa chalana.";
            }
        ],
        after [;
         Go:
            if (self hasnt general || random(4) == 1) {
                give self general;
                print "^Você tropeça, mas consegue se segurar antes de cair. É \
                    difícil manter o equilíbrio nas pedras, que são irregulares \
                    e estão malconservadas.^";
            }
        ],
          cant_go "Você pode seguir ao norte para a Rua da Ponte, ao sul para \
              a Rua Biblioll, ou tentar entrar no college a leste.",
        edward_dirs e_obj n_obj;

Object  GreatGate "portão"
 has    door static openable lockable locked autoopen
        ! general if you've tried knocking at the gate
         with   name "grande" "madeira" "portão" "gate" "postigo" "wicket" "carvalho" "oak" "vigas" "timbers",
        found_in ChapelStreet FirstCourt,
         description "O portão é enorme e resistente. Feito de carvalho maciço \
             e castigado pelos séculos, testemunhou a passagem de muitas \
             gerações de estudiosos. O brasão do Biblioll College está acima \
             dele, e um postigo foi instalado em sua parte inferior.",
         when_closed "O portão está fechado.",
         when_open "O portão está fechado, mas um pequeno postigo está aberto.",
        add_to_scope CoatOfArms,
        door_to [;
            if (self in FirstCourt) return ChapelStreet;
            else return FirstCourt;
        ],
        door_dir [;
            if (self in FirstCourt) return w_to;
            else return e_to;
        ],
        with_key BrassKey,
        before [;
          LookUnder: "A fresta é estreita demais para você enxergar algo.";
         Knock,Attack:
            if (location == FirstCourt) rfalse;
             print "O portão é tão grande que você não sabe se suas batidas \
                 podem ser ouvidas lá dentro, mas, após uma breve espera, ";
            if (self has open)
                 print "um velho aparece no postigo e ";
            else
                 print "o postigo se abre um pouco e um velho ";
             print "espreita você. ";
            if (Porter has general) {
                give self open ~locked;
                 "~Ah, entre, entre,~ diz ele. Deixa o portão aberto \
                 e se afasta.";
            }
            if (self has general)
                 print "~Você de novo, não!~ diz ele, batendo o portão na \
                     sua cara";
            else
                 print "~Desculpe, querida,~ diz ele, ~mas fechamos aos \
                     domingos.~ Ele fecha o portão";
            give self ~open locked general;
            ".";
         Climb:
             "O portão se encaixa perfeitamente no arco. Mesmo que você \
                 conseguisse escalá-lo, ainda não conseguiria passar.";
        ],
        after [;
         Unlock: quote = 3;
        ];

Object  CoatOfArms "brasão"
 has    scenery
         with   name "brasão" "coat" "of" "arms",
         description "Três leões dourados rampantes sobre campo branco, uma \
             faixa vermelha e uma taça de prata sobre campo verde.";

Object  Cobbles "pedras da rua" ChapelStreet
 has    static concealed
  with   name "pedras" "rua" "cobbles" "street" "paralelepípedos" "cobblestones" "stones",
        article "the",
        before [;
         Examine, Search:
            if (Cobblestone hasnt general) {
                move Cobblestone to ChapelStreet;
                give Cobblestone general;
                ResetVagueWords(Cobblestone);
                DoneHint(EnterCollegePuzzle,1);
                 "Ao examinar de perto, você nota que uma das pedras está solta.";
            }
             "Por mais que tente, você não consegue soltar nenhuma outra \
              pedra.";
        ];

Object  Cobblestone "pedra"
        ! general if it's out in the world;
        ! ~general if you can find it in the street
  with   name "pedra" "paralelepípedo" "cobble" "stone" "cobblestone",
         description "A pedra tem cerca de dois centímetros e meio de largura. \
             Sua superfície superior é muito lisa e a inferior é áspera.";


!--------------------------------------------------------------------------
! 2.2 BRIDGE STREET
!--------------------------------------------------------------------------
! The busker just cycles through his script line by line. Interaction with
! the cups and so on is controlled by the current line in the script. At
! one point, he asks for an object with which to perform a trick; he'll do
! a trick with almost any object from the Prologue; different tricks take
! him into different sub-scripts.
! 
! Busker.state: the current line in the script
! 
! Busker.time_left: if this is non-zero, then he waits that many turns
! before continuing with his script; this allows interaction with him to
! cause him to pause for a turn or two.
! 
! Busker.trickobject: the object with which the busker is doing his trick.
! 
! Busker.trickcup: the cup under which the busker put the trick object.
! 
! Busker.trickcount: a count of the number of different cups Christabel has
! looked under (the object is always under the third one she looks under).
!--------------------------------------------------------------------------

Object  BridgeStreet "Rua da Ponte"
 class  KeepBritainTidyClass
 has    light
 with   name "square" "street" "bridge",
        initial [;
            ! You left in the middle of the trick; Busker is sarcastic.
            if (Busker.state == 13 or 14 or 15) Busker.state = 17;
        ],
         description "A Rua da Ponte vai de leste a oeste e é limitada ao sul \
             pelo muro de tijolos do Biblioll College. Aqui a rua se alarga \
             formando uma praça.",
        s_to [;
            if (EM == 0) rfalse;
            <<Climb BrickWall>>;
        ],
        w_to [;
             if (EM == 0) print "Você vira à esquerda na Rua da Capela.^";
            return ChapelStreet;
        ],
        e_to [;
            if (EM == 0) 
                 print "Você atravessa uma ponte sobre um rio calmo que corre \
                     para o norte e vira à direita para o Campo de Lady \
                     Margaret.^";
            return MargaretGreen;
        ],
        before [;
         Go,Enter:
             if (Busker.state == 13 or 14 or 15 && noun == w_obj or e_obj)
                 print "O artista de rua grita enquanto você sai: ~Ei! \
                     Você não quer ver o resto do truque?~ ";
        ],
         cant_go "Você pode seguir a oeste para a Rua da Capela ou a leste \
             para o Campo de Lady Margaret.",
        edward_dirs e_obj;

Object  TrestleTable "mesa" BridgeStreet
 has    static supporter concealed
 with   name "trestle" "table",
        capacity 3,
        before [;
         Receive: <<Give noun Busker>>;
        ];

Class   CupClass
 class  PluralClass ListTogetherClass
        ! general if you've looked under it during trick
 with   name "cup",
        plural_name 'cups',
        list_together "cups",
        describe [; rtrue;],
        before [;
          Receive: "~Deixe o truque comigo,~ diz o artista de rua.";
         Take, Remove:
            switch (busker.state) {
             0,1,2,3,4,5,6,7,100,101,102,103,104,105,14,15:
                Busker.time_left = Busker.time_left + 1;
                 "~Não me incomoda que olhe sob as xícaras,~ diz o artista de \
                 rua, ~mas eu agradeceria se você não saísse com elas.~";
             default: <<Search self>>;
            }
         LookUnder, Search:
            switch (busker.state) {
             0 to 7:
                give self general;
                 "Não há nada sob a xícara.";
             100 to 105:
                if (self == Busker.trickcup) {
                    move Busker.trickobject to player;
                    ResetVagueWords(Busker.trickobject);
                    Busker.state = 105;
                     print_ret "Sob ", (the) self, " há um pedaço de papel \
                         dobrado. Você o pega e desdobra. É seu ", (name)
                         Busker.trickobject, "!";
                }
                Busker.time_left = Busker.time_left + 1;
                 print_ret "Não há nada sob ", (the) noun, ". ~Não,~ diz o \
                     artista de rua. ~Olhe sob ", (the) Busker.trickcup, "!~";
             14,15:
                if (self has general)
                     "Está vazia. ~Você já olhou sob essa,~ diz o artista de rua.";
                give self general;
                Busker.trickcount = Busker.trickcount + 1;
                 print "Você levanta ", (the) noun;
                if (Busker.trickcount == 3) {
                    Busker.state = 16;
                     print " e descobre ", (the) Busker.trickobject;
                    if (Busker.trickobject  == Marble)
                         print ", que o artista de rua recupera. ";
                    else {
                        move Busker.trickobject to player;
                        ResetVagueWords(Busker.trickobject);
                         print ", que você pega. ";
                    }
                    if (self == Busker.trickcup) {
                         print "~Viu? Estava sob ", (the) noun, " o tempo \
                             todo,~ diz o artista de rua.";
                    }
                     else print "~Finalmente!~ diz o artista de rua. ~Pensei \
                         que você nunca encontraria.~";
                    if (Busker.trickobject  == BrassKey) {
                         print " Ele pisca para você. ~Tenha cuidado.~";
                        Achieved("successfully hiding the key from the \
                            don");
                        Busker.state = 300;
                        Busker.time_left = 2;
                    }
                    new_line; rtrue;
                }
                 " mas está vazia. ~Não, não está aí,~ diz o artista de rua. \
                 ~Talvez você possa tentar olhar sob outra xícara.~";
             22,23,24:
                 "~Deixe que eu faça,~ diz o policial.";
             default:
                Busker.time_left = Busker.time_left + 1;
                 "Quando você alcança a xícara, o artista de rua bate no dorso \
                 de sua mão. ~Ora, ora,~ diz ele. ~Você vai estragar o truque.~";
            }
        ];

Nearby  RedCup "xícara vermelha"
 class  CupClass
 with   name "vermelha" "red", next_cup GreenCup;

Nearby  GreenCup "xícara verde"
 class  CupClass
 with   name "verde" "green", next_cup BlueCup;

Nearby  BlueCup "xícara azul"
 class  CupClass
 with   name "azul" "blue", next_cup RedCup;

Object  Busker "artista de rua" BridgeStreet
 class  FollowClass CarryingClass TalkableClass
        ! general if he's been arrested
  with   name "artista" "rua" "busker" "mágico" "magician" "wizard" "homem" "man" "roxo" "purple" "dedo" "finger"
            "fingers",
         description "Ele é um homem alto e desengonçado, de dedos longos e \
             ágeis.",
         initial "Um mágico de rua está atrás de uma mesa dobrável, convidando \
             os transeuntes a assistir a seus truques. Sobre a mesa há três \
             xícaras viradas (uma vermelha, uma verde e uma azul).",
        state 0,
        time_left 0,
        trickobject 0,
        trickcount 0,
        trickcup 0,
        before [;
         Question:
            self.time_left = self.time_left + 1;
            switch(second) {
             QZork:
                if (BlackRod hasnt general) {
                    give BlackRod general;
                     "O artista de rua olha para você surpreso, mas logo se \
                     recompõe e transforma o rosto num sorriso.";
                }
             QHello: 
                 "~Olá,~ diz o artista de rua. ~Que prazer ter uma moça tão \
                 bonita quanto você na plateia.~";
             QMalcolm:
                 "~Nunca o conheci,~ diz o artista de rua, ~mas me disseram que \
                 ele tem uma irmã muito bonita.~";
              QCollege:
                 "~Quer saber como entrar no Biblioll College num domingo? \
                 Acho que terá de pedir, tomar emprestada ou roubar uma \
                 chave de alguém.~";
              QConstable:
                 "~Sempre que ele tenta me expulsar,~ confidencia o artista \
                 de rua, ~eu mostro um truque e ele me deixa em paz.~";
              QNo:
                 "~Vamos,~ diz o artista de rua. ~Seja travessa!~";
              QMagic:
                 "~Um mágico nunca revela seus segredos,~ diz o artista \
                 de rua, misteriosamente.";
             QCups:
                switch (self.state) {
                  0 to 7, 100 to 105, 14, 15:
                     "~Tente olhar embaixo dela,~ diz o artista de rua.";
                  default: "~Um mágico nunca revela seus segredos,~ diz \
                     o artista de rua.";
                }
            }
             "O artista de rua não entende bem o que você quer.";
        ],
        life [;
         Give:
            if (self.state < 8 || self.state > 12)
                 "~Calma,~ diz o artista de rua. ~Espere eu perguntar!~";
            DoneHint(EnterCollegePuzzle,3);
            if (noun == Telegram or Map) {
                if (noun has general)
                    "~Já fiz um truque com isso!~ diz o artista de rua.";
                give noun general;
                self.state = 100;
                self.time_left = 1;
                self.trickobject = noun;
                remove noun;
                switch (random(3)) {
                 1: self.trickcup = RedCup;
                 2: self.trickcup = GreenCup;
                 3: self.trickcup = BlueCup;
                }
                print_ret "O artista de rua aceita ", (the) noun,
                    ". ~Hmm,~ diz ele, ~isso não é muito apropriado para este \
                    truque, mas talvez...~ Ele rasga metodicamente seu ",
                    (name) noun, " em tiras pequenas e depois as come uma a \
                    uma. Percebendo seu desconforto, ele bate em ",
                    (the) self.trickcup, " e diz: ~Veja aqui.~";
            }
            if (noun == Handbag) {
                DoneHint(EnterCollegePuzzle,4);
                self.time_left = 1;
                if (parent(Toffee) == nothing or Handbag or GivenAway) {
                    self.state = 200;
                    move Toffee to Busker;
                    give Handbag open;
                    "O artista de rua examina sua bolsa. ~Hmm,~ diz ele, \
                    ~é grande demais para este truque, mas talvez...~ Ele \
                    enfia a mão na bolsa e tira um toffee, que oferece a você. \
                    ~É uma cortesia minha,~ diz ele, fazendo uma ligeira \
                    reverência.";
                }
                "O artista de rua olha dentro da sua bolsa. ~Sinto muito,~ diz \
                ele, ~mas não consigo encontrar mais doces aqui.~";
            }
            self.trickobject = noun;
            move noun to GivenAway;
            self.state = 12;
            switch (noun) {
             Cobblestone:
                 "O artista de rua pega a pedra e tira um pouco da sujeira. \
                 ~Não é bonita, mas serve,~ diz ele.";
             Toffee:
                 "~Ora,~ diz o artista de rua, ~que toffee apetitoso! É uma \
                 escolha perfeita.~ Ele aceita o doce.";
             BrassKey:
                DoneHint(EnterCollegePuzzle,10);
                if (Constable notin BridgeStreet)
                    "~Ahá!~ diz o artista de rua, pegando a chave. ~Uma escolha \
                    excelente.~";
                "Você está prestes a oferecer a chave ao artista de rua quando ele \
                 gesticula freneticamente e grita: ~Olhe, um gavião careca!~^^O \
                 policial olha para o céu. ~Onde, onde?~ grita, empolgado. Na \
                 confusão, o artista de rua tira sorrateiramente a chave de latão \
                 da sua mão.";
             Feather:
                 "~Hmm, uma escolha estranha,~ diz o artista de rua. Ele pega \
                 a pena e rapidamente faz cócegas em seu queixo com ela.";
             default:
                print_ret "** Error: no trick for ", (the) noun, " **";
            }
        ],
        daemon [ j;
            if (self.time_left > 0) {
                self.time_left = self.time_left - 1;
                rfalse;
            }
            if (location ~= BridgeStreet && (ClockTower.number < 13 ||
                self.state ~= 300)) rtrue;
            self.state = self.state + 1;

            switch(self.state) {
             1: "^~Aproximem-se! Aproximem-se!~ chama o artista de rua.";
             2: "^~Quem quer ver minha mágica?~ chama o artista de rua.";
             3: "^~Três xícaras perfeitamente comuns,~ diz o artista de rua. \
                 Ele levanta cada uma para mostrar que está vazia. ~Não há nada \
                 sob nenhuma delas,~ diz ele.";
             4: self.trickcup = RedCup;
                 "^~Não há truques, bolsos escondidos ou fundos falsos,~ diz o \
                 artista de rua. ~Por favor, examine as xícaras, olhe embaixo \
                 delas e confirme que são perfeitamente comuns.~";
             5,6,7:
                j = self.trickcup;
                self.trickcup = j.next_cup;
                if (j hasnt general)
                         print_ret "^~Nada sob ", (the) j, ",~ diz o artista de \
                         rua, levantando-a para mostrar a você.";
                rtrue;
              8: "^~Agora,~ diz o artista de rua, ~para mostrar que não estou \
                 usando equipamento preparado, gostaria de fazer este truque \
                 com um objeto da plateia.~";
              9: "^~Um objeto pequeno seria melhor, mas vou considerar \
                 qualquer coisa,~ diz o artista de rua.";
              10: "^~Vejo que está preocupada,~ diz o artista de rua. ~Este \
                 não é um daqueles truques em que quebro seu relógio com um \
                 martelo!~";
              11: "^~Que tal você, mocinha?~ pergunta o artista de rua.";
             12:
                 print "^~Ninguém se oferece?~ pergunta o artista de rua";
                if (Constable in BridgeStreet) {
                     print ". ~E você?~ ele pergunta ao policial";
                    if (children(Constable) == 1)
                         print ", mas o policial apenas dá de ombros para \
                             indicar que não tem nada adequado";
                    else
                         print ", que faz menção de se aproximar, mas hesita";
                }
                ".";
             13,20:
                if (self.trickobject == 0) {
                    self.trickobject = Marble;
                     print "^O artista de rua suspira. ~Bem, se ninguém quer \
                         me dar nada, usarei esta bolinha de gude.~ Ele a ergue, \
                         e ela cintila ao sol. ~Você terá de confiar que é \
                         verdadeira.~^";
                }
                switch (random(3)) {
                 1: self.trickcup = RedCup;
                 2: self.trickcup = GreenCup;
                 default: self.trickcup = BlueCup;
                }
                give RedCup ~general;
                give BlueCup ~general;
                give GreenCup ~general;
                 print_ret "^O artista de rua levanta ", (the) self.trickcup,
                     " e coloca ", (the) self.trickobject, " embaixo dela. \
                     ~Agora você vê, agora não vê,~ diz ele.";
              14,21: print_ret "^O artista de rua bate nas três xícaras, uma por \
                 vez, com a vara preta. ~Enquanto bato nas xícaras,~ diz ele, \
                 ~", (the) self.trickobject, " passa de uma para outra. Sob qual \
                 delas vai acabar?~";
             15,22: 
                if (self.state == 15 && (RedCup has general || GreenCup has
                  general || BlueCup has general))
                    rtrue;
                 print_ret "^~Vamos,~ diz o artista de rua. ~Adivinhe sob qual \
                     xícara ", (the) self.trickobject, " está.~";

            ! Now wait until Christabel discovers the trick object
             16: self.state = 15; rtrue;

            ! The trick is over; take a short break and reset
             17: self.state = 0;
                self.trickobject = 0;
                self.trickcount = 0;
                self.time_left = 1;
                give RedCup ~general;
                give BlueCup ~general;
                give GreenCup ~general;
                rtrue;

            ! When Christabel returns after leaving Bridge Street during
            ! the trick
             18: self.state = 14;
                 "^~Bem-vinda de volta,~ diz o artista de rua. ~Talvez tenha a \
                 gentileza de me ajudar a terminar o truque?~";

            ! The policeman helps with the trick
              23: print_ret "^O policial se aproxima da mesa. ~Acho que está sob ",
                 (the) self.trickcup, " onde você o colocou,~ diz ele. ~Você não \
                 me engana com essa conversa.~ Ele olha sob a xícara. Não há nada \
                 ali. ~Oh!~ diz ele.";
             24: j = (self.trickcup).next_cup;
                 print_ret "^O policial examina as duas xícaras restantes. \
                     ~Talvez esteja sob ", (the) j, " então.~ Mas ", (the) j,
                     " também está vazia.";
             25: j = ((self.trickcup).next_cup).next_cup;
                self.state = 16;
                if (self.trickobject == Cobblestone)
                    give Cobblestone ~general; ! another one can be found
                give Constable ~general;
                 print_ret "^O policial diz: ~Você é esperta. ", (The)
                     self.trickobject, " deve estar sob ", (the) j, "!~ Ele olha \
                     sob ", (the) j, " e tira um toffee embrulhado em papel \
                     brilhante, que desembrulha habilmente e põe na boca.";

            ! The trick with the telegram or the map
              101: print_ret "^~Vamos, olhe sob ", (the) self.trickcup,
                 ",~ diz o artista de rua.";
             102: return;
              103: "^~Vamos, não vai morder,~ diz o artista de rua.";
             104: return;
             105: move self.trickobject to player;
                ResetVagueWords(self.trickobject);
                 print_ret "^~Você não quer olhar sob a xícara?~ diz o artista \
                     de rua. ~Bem, veja só.~ Ele levanta ", (the)
                     self.trickcup, " e revela um pedaço de papel dobrado, que \
                     desdobra. É seu ", (name) self.trickobject,
                     "! O artista de rua o coloca em sua mão.";
             106: self.state = 9;
                self.trickcup = 0;
                self.trickobject = 0;
                 "^~Agora,~ diz o artista de rua, ~preciso de um objeto pequeno \
                 da plateia para meu próximo truque.~";

            ! The trick with the handbag
              201: "^~Vamos, pegue o toffee,~ diz o artista de rua.";
             202: return;
             203: remove Toffee;
                self.state = 105;
                 "^~Tudo bem, você não quer, não faz diferença para mim,~ diz o \
                 artista de rua. Ele o joga para o alto, e ele desaparece.";

            ! The busker packs up and leaves
             301: StopDaemon(self);
                remove TrestleTable;
                MoveNPC(self, 0, e_obj);
                if (location == BridgeStreet)
                     print "^O artista de rua guarda as xícaras, dobra a mesa e \
                         vai embora, desaparecendo na esquina a leste.^";
                rtrue;
            }
            print_ret "^** Error: bad line in busker script: ", 
                self.state, " **";
        ];

Nearby  BlackRod "vara preta"
        ! general if busker's been asked the zork magic words
 with   name "black" "rod" "star" "silver",
         description "Ela tem uma estrela prateada na ponta. Você nunca a viu \
             antes, mas ela traz uma estranha sensação de déjà vu.",
        before [;
         Take, Remove:
                 "O artista de rua tira rapidamente a vara preta do seu alcance.";
        ];

Nearby  PurpleCape "capa roxa"
 has    clothing worn
 with   name "purple" "cape";

Object  Marble "bolinha de gude"
 with   name "marble";

Object  Toffee "toffee"
 with   name "candy" "sweet" "toffee" "sticky",
         description "É muito pegajoso.",
        before [;
         Remove, Take:
            if (self in Busker) {
                Busker.state = 105;
                move self to location;
            }
          Eat: "Você precisa cuidar da silhueta, então é melhor não. Além disso, \
             pode ser útil para alguma coisa, nunca se sabe.";
          SmellThing: "Tem um leve cheiro de menta.";
        ];

Object  BrickWall "muro de tijolos"
 has    static concealed
        ! general if you've tried climbing it
 with   name "wall" "brick" "brickwork" "bricks" "biblioll" "college",
         description "O muro de tijolos tem cerca de quatro metros de altura, mas \
             as irregularidades na alvenaria fazem parecer possível escalá-lo.",
        found_in BridgeStreet MargaretGreen EarthenPath Well,
        before [;
         Climb, Enter:
            if (self has general)
                 "Você se lembra dos cacos de vidro no alto do muro e decide não \
                 tentar escalá-lo novamente.";
            give self general;
             "Você escala o muro sem elegância, mas com sucesso, e descobre que \
             o alto está cheio de cacos de vidro. Você desce às pressas.";
        ];


!--------------------------------------------------------------------------
! 2.3 LADY MARGARET GREEN
!--------------------------------------------------------------------------

Object  MargaretGreen "Campo de Lady Margaret"
 class  KeepBritainTidyClass
 has    light
 with   name "meadow" "hairline" "moustache" "nose" "handlebar" "grass"
            "breeze" "street" "streets" "grassy" "receding" "waist"
            "cord",
         description "Este campo gramado e úmido desce suavemente em direção ao \
             muro do Biblioll College, a oeste. Ao norte e ao sul você pode \
             voltar às ruas de Christminster.",
        w_to [;
            if (EM == 0) rfalse;
            <<Climb BrickWall>>;
        ],
        n_to [;
            if (EM == 0) 
                print "Você vira à esquerda para a Rua da Ponte e atravessa uma \
                    ponte sobre um rio calmo que corre para o norte.^";
            return BridgeStreet;
        ],
        s_to [;
            if (EM == 0) 
                print "Você vira à direita para a Rua Biblioll e atravessa uma \
                    ponte arqueada.^";
            return BibliollStreet;
        ],
        before [;
         Listen:
            if (SleepingDon in self)
                 "Você ouve um ronco suave.";
            "O campo está silencioso, exceto pela brisa suave que agita a \
            grama.";
        ],
        cant_go "Você pode seguir ao norte para a Rua da Ponte ou ao sul para a \
             Rua Biblioll.",
        edward_dirs s_obj;

Nearby  SleepingDon "don"
 class  FollowClass
 has    animate transparent
        ! general if tickled with feather
 with   name "don" "sleeping" "man" "chap" "donnish" "doctor" "halfhide",
        description [;
            print "Ele é um sujeito com jeito de professor, com entradas no \
                cabelo e bigode de guidão. Ronca alto, e de vez em quando seu \
                nariz se contorce como se fosse espirrar";
            if (child(self) == BrassKey) {
                if (self has general)
                    print ". Há uma chave de latão pendurada em sua cintura";
                else print ". Ele parece estar deitado sobre uma chave de latão";
            }
            ".";
        ],
        initial "Há um homem deitado na grama, profundamente adormecido.",
        life [;
         Attack:
            if (Constable in location) <<Attack Constable>>;
            "Você dá no homem adormecido o golpe mais forte que consegue no \
             estômago, mas ele apenas grunhe e continua roncando.";
         Kiss: "Isto não é ~A Bela Adormecida~.";
        ],
        before [;
         Speak, Show, Give:
             "Ele está profundamente adormecido e não nota você.";
         Tickle:
            if (second == Feather) {
                give self general;
                DoneHint(EnterCollegePuzzle,9);
                "O nariz do professor se contorce vigorosamente, e ele espirra! \
                Seu sono não é interrompido, mas ele grunhe e se vira.";
            }
             "Suas cócegas não produzem efeito algum.";
         Enter: Futile(); rtrue;
         Push,Pull,Turn,PushDir:
             "O professor é um homem pesado e, por mais que você tente, não \
             consegue movê-lo.";
         WakeOther:
            print "Você sacode o homem adormecido, mas não consegue \
                acordá-lo";
            if (constable in location)
                 print ". ~Deixe o pobre homem dormir,~ diz o policial";
            ".";
         Listen:
             "Seu ronco tem a qualidade profunda e sonora de um vizinho que pratica tuba nas primeiras horas da manhã.";
        ],
        time_left 0,
        time_out [ i j k l;
            ! i is the location containing the key (or else nothing)
            ! j is 1 iff the player has the key
            ! k is 1 iff the key is in the handbag
            ! l is 1 iff the constable has the key
            StopDaemon(BrassKey);
            for (j=0,k=0,l=0,i=BrassKey: parent(i) ~= nothing: i = parent(i))
                if (i == player) { j = 1; }
                switch(i) {
                 Handbag: k = 1;
                 Constable: l = 1;
                }
            if (i == GivenAway) i = BrassKey;

            ! If you're in Margaret Green, you see the don wake up.
            if (location == MargaretGreen) {
                 print "^O professor se contorce durante o sono, claramente \
                     perturbado. De repente, senta-se bruscamente. ~Quem pegou \
                     minha chave?~ berra.^";
                if (i ~= BrassKey or MargaretGreen)
                     print "^O professor sai pisando duro em busca da chave.^";
            }

            ! If the key is missing or it's somewhere in the same location
            ! as you, then in either case you get to see what happens.
            if (i == BrassKey or location) {
                if (location ~= MargaretGreen)
                     print "^O professor dá a volta na esquina furioso. ~Quem pegou \
                         minha chave?~ berra, olhando ao redor com desconfiança.^";
                if (l == 1)
                     print "^~Esta é a sua chave, senhor?~ pergunta o policial, \
                         erguendo o objeto.^^O professor a toma. ~Obrigado, \
                         oficial,~ diz ele.";
                if (j == 0 && k == 1)
                     print "^O professor pega a bolsa e olha dentro dela. ~Ahá!~ \
                         exclama, tirando sua chave das profundezas escuras da \
                         bolsa. Ele a joga de lado.";
                if (j == 0 && k == 0 && l == 0 && i ~= BrassKey)
                     print "^O professor avista a chave. ~Ahá!~ exclama, pegando-a.";
                if (i ~= BrassKey && j == 0 && location ~= MargaretGreen)
                     print " Ele olha fixamente para você e vai embora.^";
            }

            ! Otherwise you have to hear what's happening.
            else
                 print "^Em algum lugar distante, você ouve uma voz dizer em alto \
                     e bom som: ~Ahá! Minha chave!~^";

            ! In these cases, the don can walk away with the key without
            ! having to make a fuss and go back to sleep again. Make sure
            ! we reset all the flags associated with the puzzle.
            if (k == 1) give Handbag open;
            if (j == 0 && i ~= BrassKey) {
                move BrassKey to SleepingDon;
                BrassKey.state = 0;
                give BrassKey ~general;
                give SleepingDon ~general;
                if (location == MargaretGreen) {
                    if (i ~= MargaretGreen)
                         print "^O professor volta pela esquina, agarrado à chave.";
                     print " Ele se deita novamente na grama e, em alguns segundos, \
                         volta a roncar tranquilamente.^";
                }
                return;
            }

            ! Now, the don can't find the key, so he accuses you of
            ! stealing it. We'd better bring the constable to the scene.
            ! It's safe to cancel the constable's general flag, because if
            ! he was involved in the trick then you can't have solved the
            ! puzzle with the key and so the game will be ending soon...

            if (Constable notin location) {
                give Constable ~general;
                <Invoke Constable>;
            }
             print "^~Você aí!~ grita o professor. ~Você roubou minha chave! Policial, \
                 prenda essa mulher!~^^O policial caminha na direção de ";
            if (j == 1) {
                 print "você. ~O que temos aqui, então?~ diz ele, tirando a chave da sua ";
                if (k == 1) print "handbag"; else print "trembling hands";
                 print ". ~Uma pequena ladra astuta.~ Ele agarra seu braço e a conduz \
                     à força até a delegacia.^^";
                ArrestString();
                rtrue;
            }
            MoveNPC(Constable,0,0);
            MoveNPC(SleepingDon,0,0);
            StopDaemon(Constable);
             print "o professor. ~Com licença, senhor, mas está incomodando esta jovem?~ \
                 diz ele.^^~Diga a esta ladra que me devolva minha chave,~ grita o \
                 professor.^^~Eu não estou com sua chave,~ você diz, ";
            if (Handbag in player) {
                give Handbag open;
                 print "abrindo sua bolsa";
            }
             else print "mostrando suas mãos";
             " para demonstrar a verdade de sua afirmação.^^~Uma acusação falsa é \
                 assunto muito sério,~ diz o policial ao professor. ~Acho melhor o \
                 senhor vir comigo à delegacia para conversarmos sobre isso.~ Ele \
                 conduz o professor, que protesta, para longe.";
        ];

[ ArrestString;
    deadflag = 3;
    "Felizmente, um telegrama para seu pai, outro dele para seus \
    advogados (Grousetwistle, Bentham e Portnoy) e um telegrama deles \
    para a delegacia de Christminster bastam para convencer seu captor a \
    libertá-la, mas, a essa altura, você já está farta de toda a aventura \
    e, contrariada, pega o próximo trem de volta para Londres.^^Quando \
    finalmente fica sabendo que seu irmão Malcolm desapareceu dos aposentos \
    dele na faculdade, para nunca mais ser visto, você se arrepende de ter \
    fugido tão depressa, mas então já é tarde demais.";
];

Object  BrassKey "brass key" SleepingDon
 class  KeyClass
        ! general if you've worried about stealing it
 with   name "brass",
        before [;
         Take, Remove:
            if (self in SleepingDon) {
                if (Constable in location)
                    "Você não ousa tentar roubar a chave com o policial \
                    observando-a.";
                if (SleepingDon hasnt general)
                    "A chave parece presa ao professor por algum tipo de cordão, \
                    que você não consegue desatar, pois o professor, um homem \
                    muito pesado, está deitado sobre ele.";
                StartDaemon(self);
                StartTimer(SleepingDon, 3);
                move self to player;
                Achieved("stealing a key from the sleeping don");
             "Pegou.";
            }
        ],
        state 0,
        daemon [;
            self.state = self.state + 1;
            if (location == MargaretGreen) {
                if (self.state == 1 or 2 or 3)
                    print "^O professor se contorce durante o sono";
                if (self.state == 2 or 3)
                    print ", claramente perturbado";
                if (self.state == 3)
                    print ". Parece que está prestes a acordar";
                if (self.state == 1 or 2 or 3)
                    ".";
                return;
            }
            if (Inside(self,player) == 1 && self hasnt general) {
                give self general;
                "^Você fica um pouco nervosa carregando a chave roubada. E se \
                o professor acordasse? E se o policial percebesse?";
            }
        ];


!--------------------------------------------------------------------------
! 2.4 BIBLIOLL STREET
!--------------------------------------------------------------------------

Object  BibliollStreet "Rua Biblioll"
 class  KeepBritainTidyClass
 has    light
 with   name "street" "looming" "bulk" "biblioll" "college" "sill"
            "windowsill",
        description [;
             print "Durante a semana, esta deve ser uma via movimentada, mas \
                 agora está vazia de carros e multidões. A rua é limitada ao \
                 norte pela imponente massa do Biblioll College, ";
            if (ClockTower.number > 19)
                 print "escura e ameaçadora ao luar, ";
             "e há uma única janela bem acima de você.";
        ],
        w_to [;
             if (EM == 0) print "Você vira à direita na Rua da Capela.^";
            return ChapelStreet;
        ],
        e_to [;
            if (EM == 0) 
                 print "Você atravessa uma ponte baixa e arqueada e vira à esquerda \
                     para o Campo de Lady Margaret.^";
            return MargaretGreen;
        ],
        after [;
         Go: <Invoke Constable>;
        ],
         cant_go "Você pode seguir para leste, ao Campo de Lady Margaret, ou para \
             oeste, à Rua da Capela.",
        edward_dirs w_obj;

Class   WindowClass
 has    static concealed
 with   state 0,
        before [;
         Examine: rfalse;
         default:
            self.state = self.state + 1;
            switch (self.state) {
              2: "Fica uns nove metros acima de você.";
              3: "Mesmo que ficasse na ponta dos pés, ainda estaria oito metros e \
                 oitenta centímetros acima da sua cabeça.";
              4: "Persistir nessa estupidez não vai ajudar.";
             default: 
                self.state = 4;
                 "Está alto demais.";
            }
        ];

Nearby  Window "janela"
 class  WindowClass
 with   name "window" "pane",
         description "É uma janela comum, muito alta. Você vê um papagaio cinzento \
             pousado no peitoril.",
        before [;
         ThrownAt,Receive:
            if (Constable in location) {
                DoneHint(EnterCollegePuzzle,2);
                 "Você não tem coragem, especialmente com o policial \
                 observando.";
            }
            if (noun ~= Cobblestone) {
                move noun to BibliollStreet;
                 print "Você arremessa ", (the) noun;
                if (random(2)==1)
                     " contra a janela, mas erra por uns três metros.";
                 " diretamente contra a janela, mas ele ricocheteia e cai aos seus \
                 pés.";
            }
            remove self;
            remove Cobblestone;
            move BrokenWindow to BibliollStreet;
            MoveNPC(Parrot,0,0);
            StartTimer(BrokenWindow, 1);
            AdvanceTime(self);
            Achieved("breaking a window");
            DoneHint(EnterCollegePuzzle,8);
             "Todo aquele treino de críquete no Westminster Ladies' College enfim \
             vale a pena. A pedra acerta o alvo, e a janela se estilhaça para \
             dentro numa bela chuva de chumbo e vidro quebrados. Um grasnido alto \
             acompanha o som do vidro caindo no chão.";
        ];

Nearby  Parrot "papagaio"
 class  WindowClass FollowClass
 has    animate
 with   name "grey" "parrot" "polly" "bird",
         description "Um pássaro cinzento pousado no peitoril, olhando para você. \
             De vez em quando, ele dá um ou dois pulos para a esquerda ou para a \
             direita.",
        before [;
          Follow: "Agora você vai me dizer que sabe voar!";
         ThrownAt: <<ThrowAt noun Window>>;
        ],
        life [;
             "O papagaio está a nove metros acima de sua cabeça, atrás de uma \
             vidraça. Fora isso, uma boa tentativa.";
        ];

Object  Feather "pena"
 class  FlimsyClass
 with   name "grey" "feather",
        size 1,
         description "Uma longa pena cinzenta. Ela faz muitas cócegas.";

Object  BrokenWindow "janela quebrada"
 class  WindowClass
        ! general if Edward's commented on it
 with   name "broken" "window" "pane",
         description "Ela fica uns nove metros acima de sua cabeça, e a vidraça \
             foi quebrada.",
        before [;
         Receive,ThrownAt:
             "Se você jogar isso pela janela quebrada, talvez nunca consiga \
             recuperá-lo.";
        ],
        time_left 0,
        time_out [;
            move Feather to BibliollStreet;
            if (location == BibliollStreet)
                 "^Um papagaio cinzento aparece na janela quebrada. Ele olha ao \
                 redor com cautela, abre as asas e voa para o norte. Deve ter se \
                 ferido com o vidro quebrado, pois uma pena de sua cauda flutua até \
                 cair aos seus pés.";
        ];


!--------------------------------------------------------------------------
! 2.5 THE POLICE CONSTABLE
!--------------------------------------------------------------------------
! He's basically friendly, and is here to provide a bit of atmosphere and
! randomness to the opening sections. He arrives after turn 3 and
! thereafter wakes up every 6-10 turns and strolls up to Christabel (if not
! already present). A count is kept of how many times Christabel interacts
! with him and he's removed after 2 interactions so as not to get too
! monotonous. He stops Christabel dropping litter and throwing things at
! the window. We make sure he's always at Biblioll Street when Christabel
! is (unless he gets engrossed in the magic trick and can't come).
! 
! Constable.state: a count of the number of times Christabel has
! interacted with the constable.
! 
! Constable.time_left: a count of the number of times the Constable has
! arrested Christabel.
!--------------------------------------------------------------------------

Object  Constable "police constable"
 class  FollowClass CarryingClass TalkableClass
        ! general if he's engrossed in the magic trick
 with   name "police" "constable" "policeman" "pc" "bobby" "officer"
            "copper" "peeler" "cop",
        description [;
             print "Um homem alto e de ombros largos, o policial empurrou o \
                 capacete para sombrear os olhos e aproveita o sol da manhã. \
                 Parece levar uma vida feliz.";
            if (self in BridgeStreet) {
                DoneHint(EnterCollegePuzzle,5);
                 print " Ele observa o artista de rua";
                if (self has general)
                     print " atentamente";
                print ".";
            }
        ],
        describe [;
             print "^Um policial está aqui";
            if (self in BridgeStreet) {
                 print ", observando o artista de rua";
                if (self has general)
                     print " atentamente";
            }
            ".";
        ],
        state 0,
        number 0,
        life [;
            self.state = self.state + 1;
         Attack:
            self.time_left = self.time_left + 1;
            self.number = self.number + 1;
             print "O policial agarra seu braço e o prende atrás das suas costas até \
                 você parar de resistir. ";
            if (self.number < 3)
                 "~Chega disso, mocinha,~ diz ele, soltando você.";
             print "~Muito bem, mocinha, você pediu,~ diz ele, conduzindo você à \
                 força até a delegacia.^^";
            ArrestString();
            rtrue;
         Kiss:
             "O policial cora. ~Chega disso, mocinha,~ diz severamente, mas você \
             percebe que ele não fala sério.";
         Show:
            if (noun == Feather or Map) <<Give noun Constable>>;
         Give:
            if (noun == Feather)
                "~Looks like the tail feather of a Psittacus,~ says the \
                constable.";
            if (noun == Telegram or Handbag)
                "~I couldn't possibly accept that,~ says the constable.";
            if (noun == Map) {
                 print "~Quer indicações para o Biblioll College?~ diz o policial. \
                     ~Você precisa seguir ";
                switch (location) {
                 ChapelStreet:
                    "through that gate, to the east.~";
                 BridgeStreet,BibliollStreet:
                     print "a oeste até a Rua da Capela";
                 MargaretGreen:
                     print "ao sul até a Rua Biblioll e depois a oeste até a Rua da \
                         Capela";
                 default:
                    "** Error: Constable escaped from Prologue somehow **";
                }
                 ", e depois pelo portão que verá a leste.~";
            }
            DoneHint(EnterCollegePuzzle,5,6);
            move noun to self;
             print "O policial aceita ", (the) noun;
            switch(noun) {
             Cobblestone, Toffee:
                ". ~And what do you expect me to do with this, young \
                lady?~ he asks you.";
             BrassKey:
                ", and looks at it closely. ~Ah, a college key,~ he says. \
                ~I'll give it back next time I'm passing.~";
             default: 
                print_ret "** Error: object out of place: ", (the) noun, 
                    " **";
            }
        ],
        orders [;
            self.state = self.state + 1;
         Eat:
            if (noun==Toffee && Toffee in self) {
                move Toffee to GivenAway;
                 "O policial põe o toffee na boca e abre um grande sorriso. ~Muito \
                 obrigado, madame,~ diz ele.";
            }
         Give:
            if (noun notin Constable)
                 print_ret (The) self," não está carregando ",(the) noun,".";
             if (noun == Helmet) "~Tire as mãos do meu capacete!~";
            if (noun == BrassKey)
                 "~Não, vou ficar com a chave e devolvê-la pessoalmente, se não se \
                  importa,~ diz o policial.";
            if (second == player) {
                move noun to player;
             "O policial entrega isso a você.";
            }
            if (second == Busker) {
                if (Busker.state >=8 && Busker.state <=12) {
                    Busker.trickobject= noun;
                    move noun to GivenAway;
                    give self general;
                    Busker.state = 19;
                    Achieved("getting the police constable involved \
                        in a magic trick");
                    DoneHint(EnterCollegePuzzle,7);
                     print "O policial diz: ~Sim, é uma boa ideia!~ e entrega ",
                         (the) noun, " ao artista de rua. ";
                    switch(noun) {
                     Cobblestone:
                         "~Não é bonito, mas serve,~ diz o artista de rua.";
                     Toffee:
                         "~Ora,~ diz o artista de rua, ~que toffee maravilhoso! É \
                         uma escolha perfeita.~";
                     default:
                        print_ret "** Error: Constable's gift to \
                            busker not recognised: ", (the) noun, " **";
                    }
                }
                 "~Agora não,~ sussurra o policial. ~Não queremos incomodá-lo \
                 enquanto faz o truque.~";
            }
         LookUnder, Take, Search:
            if (noun == RedCup or GreenCup or BlueCup)
                switch (Busker.state) {
                 4,5,6,7:
                     "~Se insiste,~ diz o policial. Ele pega a xícara e a examina \
                     cuidadosamente. Não há nada dentro. Ele a põe de volta.";
                 15:
                     "~Não,~ diz o policial. ~É você quem deveria estar ajudando \
                     com este truque.~";
                 22,23,24:
                     "~Dê-me uma chance,~ diz o policial. ~Estou chegando lá.~";
                 default:
                     "~Agora não,~ sussurra o policial. ~Não queremos incomodá-lo \
                     enquanto faz o truque.~";
                }
          Go: "~Estou muito bem onde estou, muito obrigado,~ diz o policial.";
         Arrest:
            if (noun == Busker && Busker hasnt general) {
                give Busker general;
                 "O policial considera seu pedido. ~Hmm, bloquear uma via pública e \
                 trabalhar como artista de rua sem licença,~ murmura. Ele decide e \
                 se aproxima do artista. ~Com licença,~ diz, ~poderia seguir em \
                 frente?~^^~Cuidado!~ grita o artista de rua de repente. ~Seu \
                 capacete! Fique aí e não se mexa, vou resolver isso!~ O policial \
                 fica imóvel enquanto o artista enfia a mão sob o capacete e tira \
                 um pombo, que solta e voa para longe.^^~Ora essa!~ diz o policial. \
                 ~Uma Columba livia! Obrigado, muito obrigado.~^^~Não há de quê,~ \
                 diz o artista de rua.";
            }
            if (noun == player)
                 "~Não acho que haja necessidade disso,~ diz o policial.";
         WakeOther:
            if (noun == SleepingDon)
                 "~Acho melhor deixá-lo dormir,~ diz o policial.";
         Open,Knock,Enter:
            if (noun == GreatGate)
                 "O policial balança a cabeça. ~Meus poderes terminam aqui,~ diz. \
                 ~Se não deixarem você entrar, não posso ajudá-la.~";
        ],
        before [;
         Question:
            self.state = self.state + 1;
            switch(second) {
             QTime:
                 print_ret "O policial tira um relógio de bolso do uniforme e olha \
                     para ele. ~São um pouco mais de ", (PrintTime) 0,
                     ", madame,~ diz ele, guardando o relógio no bolso.";
             QHello:
                 "~Bom dia, madame,~ diz o policial. ~Que dia bonito!~";
             QCollege:
                 "~Ah, esse é um dos colleges mais antigos,~ diz o policial. \
                 ~Fundado por John de Biblioll, se bem me lembro.~";
             QMalcolm:
                 "O policial coça a cabeça por um momento. ~Ah, você quer dizer o \
                 doutor Spencer! Um sujeito simpático, quieto, mas amigável, sim.~";
             QBusker,QMagic,QCups:
                 "~Adoro um pouco de mágica de palco,~ diz o policial.";
             QDon:
                 "~Ele é professor do Biblioll College,~ diz o policial. ~Um certo \
                 Halfhide, creio eu.~";
             QMe:
                if (self.number > 0)
                     "~Estou de olho em você,~ diz o policial. ~Não arrume mais \
                     problemas, ou então...~";
                 "~Prazer em conhecê-la,~ diz o policial.";
              QYes: "O policial acena com a cabeça em concordância.";
              QNo: "O policial balança a cabeça em concordância.";
             default:
                switch (random(3)) {
                  1: "O policial não entende bem o que você quer.";
                  2: "~Tenho certeza de que não sei nada sobre isso,~ diz o policial.";
                  3: "O policial acena sabiamente.";
                }
            }
         Invoke:
            if (parser_trace >= 1) print "[ Called PC Invoke ]^";
            if (self in location || self has general || SleepingDon in nothing)
                rtrue;
            self.state = 0;
            MoveNPC(self,location,0);
             print "^Um policial caminha ";
             if (location == MargaretGreen) print "pelo campo";
             else print "pela rua";
             print " na sua direção";
            if (location == ChapelStreet)
                 print ", suas botas pesadas retinindo ruidosamente nas pedras";
            ".";
         default:
            if (ClockTower.number >= 12)
                "** Error: the constable should have vanished by now **";
        ],
        time_left 0,
        daemon [ i d;
            if (ClockTower.number >= 12)
                "** Error: the constable should have vanished by now **";
            if (self notin location) {
                self.state = 0;
                self.time_left = self.time_left + 1;
                if (self.time_left >= 5) {
                    if (parser_trace >= 1) print "[ Calling PC Invoke ]^";
                    <<Invoke self>>;
                }
            }
            else self.time_left = 0;
            if (self.state >= 4 && location ~= BibliollStreet && self
                hasnt general) {
                new_line;
                if (location == BridgeStreet) {
                    if (random(2) == 1) { 
                        i = ChapelStreet; d = w_obj; 
                    } else {
                        i = MargaretGreen; d = e_obj;
                    }
                }
                else {
                    if (random(2) == 1) { 
                        i = BibliollStreet; d = s_obj; 
                    } else {
                        i = BridgeStreet; d = n_obj;
                    }
                }
                MoveNPC(self, i, d);
                self.state = 0;
             print_ret (The) self, " se afasta para o ",
                    (PrintDirection) d, ".";
            }
        ];

Object  Helmet "helmet" Constable
 has    concealed clothing worn
 with   name "helmet" "hat",
        before [; 
