! 4.1 THE LIBRARY
!--------------------------------------------------------------------------

Object  LibraryArchwayObject "arco da biblioteca" FirstCourt
 has    door scenery open
         with   name "library" "arch" "archway" "biblioteca" "arco",
         description "Um arco que leva ao sul, para a biblioteca.",
        door_to LibraryArchway,
        door_dir s_to;

Object  LibraryArchway "Arco da Biblioteca"
 has    light
 with   name "archway" "first" "court" "mortar" "bricks" "dust" "wood"
            "brick" "brickwork" "crumbling" "sagging",
         description "Um arco mal iluminado logo ao sul do Primeiro Pátio. \
             Deve ser uma das partes mais antigas do college; os tijolos estão \
             desmoronando e cedendo, e talvez daqui a cem anos seja preciso \
             derrubá-lo e reconstruí-lo. A porta da biblioteca fica ao sul.",
        n_to FirstCourt,
        out_to FirstCourt,
        s_to DoorLibrary,
        in_to DoorLibrary,
         cant_go "O Primeiro Pátio fica ao norte, e a biblioteca fica ao sul.",
        edward_dirs n_obj;

Nearby  DoorLibrary "porta da biblioteca"
 has    door openable lockable locked scenery autoopen
  with   name "door" "library" "wooden" "porta" "biblioteca" "madeira",
        description [;
             print "Uma porta comum de madeira";
            if (location == LibraryArchway && Notice hasnt moved)
                 print ". Alguém pregou um aviso nela";
            ".";
        ],
        article "the",
        found_in LibraryArchway Library,
        with_key KeyLibrary,
        door_to [;
            if (self in LibraryArchway) return Library;
            else return LibraryArchway;
        ],
        door_dir [;
            if (self in LibraryArchway) return s_to;
            else return n_to;
        ],
        before [;
          LookUnder: "A fresta é estreita demais para você enxergar alguma coisa.";
        ];

Nearby  Notice "aviso"
 class  FlimsyClass
  with   name "notice" "aviso",
         initial "Um aviso está pregado na porta.",
         description "O aviso é do bibliotecário, o senhor Baskeyfield, e contém \
             detalhes enfadonhos como os horários de abertura: fechado aos \
             domingos, naturalmente. Há um adendo manuscrito: ~Se alguém precisar \
             entrar fora desses horários, procure-me durante o expediente e direi \
             onde escondo a chave reserva.~",
        before [;
          Take,Remove:
             if (self hasnt moved)
                 "Você terá de remover o alfinete primeiro.";
        ];

Nearby  Pin "alfinete"
 has    concealed
        ! general if just moved
  with   name "pin" "alfinete",
        size 0,
        before [;
         Take,Remove:
            if (self hasnt moved) {
                give self moved ~concealed general;
                give Notice moved;
            }
        ],
        after [;
         Take,Remove:
            if (self has general) {
                give self ~general;
                 "Pegou. O aviso cai no chão.";
            }
        ];

Object  Library "Biblioteca"
 has    light
         with   name "row" "rows" "fileira" "fileiras",
         description "Uma sala vasta, cheia de estantes de livros do chão ao \
             teto: fileiras e mais fileiras de prateleiras estreitas e escuras \
             que se estendem ao longe. Há um fichário ao lado da porta, que leva \
             ao norte.",
        n_to DoorLibrary,
        out_to DoorLibrary,
         cant_go "A única saída é a porta ao norte.",
        each_turn [;
            Achieved("visiting the library");
            DoneHint(WhatNextPuzzle,4);
        ],
        edward_dirs n_obj;

Nearby  LibraryBooks "livros"
 has    scenery
 with   name "books" "bookshelves" "shelves" "shelf" "stack" "stacks"
             "bookstack" "book-stack" "livros" "estantes" "prateleiras"
             "estante" "prateleira" "pilha" "pilhas",
         description "Deve haver cem mil livros na biblioteca, e o sistema de \
             catalogação é centenas de anos anterior à classificação decimal \
             de Dewey. É melhor procurar o que deseja no fichário.",
        before [;
         Take: <<Examine self>>;
        ];

Object  CardIndex "fichário" Library
 has    static concealed
  with   name "card" "index" "catalogue" "stack" "of" "drawers" "cards"
             "fichário" "cartão" "índice" "catálogo" "gavetas" "cartões",
         description "O fichário é um conjunto de gavetas cheias de cartões de \
             7 por 12 centímetros. Os mais antigos estão amarelados pelo tempo \
             e escritos em bela caligrafia; os novos foram datilografados. \
             Irritantemente, só é possível consultar sobrenomes de autores.",
        before [ w i;
         Consult:
            if (consult_words ~= 1)
                 "Tente consultar um sobrenome no fichário.";
            wn = consult_from;
            w = NextWord();
            switch (w) {
             'garton':
                if (Hole in AlchemistsRoom) {
                     print "Você vai até a estante correspondente e, embora o \
                         exemplar de ~Os Princípios da Forma~ da biblioteca tenha \
                         sido emprestado, descobre a abertura na parede que leva \
                         à sala do alquimista. Com a ajuda de uma escada próxima, \
                         você sobe até ela e entra novamente no laboratório secreto.^";
                    PlayerTo(AlchemistsRoom);
                    rtrue;
                }
                 "Você vai até a estante correspondente, mas o exemplar de ~Os \
                 Princípios da Forma~ da biblioteca parece ter sido emprestado.";
             'hawksmoor':
                 print "Você encontra o lugar correspondente na biblioteca: \
                     escondido nos recessos mais distantes das estantes, junto \
                     à parede leste, na prateleira mais baixa. Você puxa a \
                     ~Physiponomachia~, de William Hawksmoor, e ela avança como \
                     uma alavanca. Com um rangido desagradável, uma seção da \
                     parede gira para o lado, revelando uma abertura que sai da \
                     biblioteca para leste. Sem hesitar, você rasteja pela abertura, \
                     chegando a...^";
                move HoleB to Well;
                PlayerTo(Well);
                Achieved("finding a secret way into the hidden courtyard");
                rtrue;
             'arkwright':
                 "Você encontra um cartão para ~O Reinado de Akhenaten~, de \
                 Arkwright, mas parece ter sido emprestado há alguns anos pelo \
                 Reitor da faculdade.";
             'noble':
                 "Você encontra um cartão para os ~Poemas Completos~ de Simon Noble \
                 (1631-1676), mas o livro foi emprestado.";
             'bible':
                 "Infelizmente, o fichário é organizado por autor, não por título. \
                 Você se pergunta como (ou se) a Bíblia foi catalogada, já que foi \
                 escrita por muitos autores, cuja identidade em sua maioria é \
                 desconhecida ou duvidosa.";
             'rees':
                 "Não há menção no fichário a ninguém chamado ~Rees~. Provavelmente \
                 não é uma grande perda.";
             'god':         i = BookBible;
             'zinovic':     i = BookCode;
             'maclane':     i = BookCollege;
             'philalethes': i = BookPhilalethes;
             'lully':       i = BookLully;
             'meldrew':     i = BookMeldrew;
            }
            if (w == OMN()) i = BookKey;
            if (i == 0)
                 "Você não encontra o que procura no fichário. Os bibliotecários da \
                 faculdade parecem ter feito escolhas peculiares ao formar a \
                 biblioteca ao longo dos séculos.";
            if (i notin self)
                 print_ret "Você já pegou emprestado o exemplar da biblioteca de ",
                    (the) i, ".";
            if (i == BookBible)
                 print "Ah! Algum engraçadinho catalogou a Bíblia sob o \
                     autor ~Deus~! ";
            move i to player;
            ResetVagueWords(i);
                 print_ret "Você encontra a prateleira e retira o exemplar de ",
                (the) i, ".";
        ];

Nearby  BookBible "Bíblia Sagrada"
 class  BibleClass
         with   name "king" "james" "version" "holy" "cloth" "gilt" "edges"
             "bíblia" "sagrada" "rei" "versão" "tecido" "dourada" "bordas",
         description "É um exemplar muito antigo da versão King James da Bíblia \
             Sagrada, encadernado em tecido com as bordas das páginas douradas.",
        before [;
         Invoke:
            if (self.state == 1) {
                switch (self.number) {
                 'john':
                    "João 11 é o capítulo que descreve como Jesus ressuscitou \
                     Lázaro. O versículo 43 diz, \
                     ~E, depois de dizer isso, clamou com grande voz~. Nada há de \
                      incomum nessas palavras. Você se pergunta por que o diário de \
                      laboratório de Malcolm mencionou justamente essa passagem.";
                 'ruth','joel','jude','ezra','amos':
                     "Esse livro não tem o capítulo 11.";
                 'acts':
                     "Atos 11 não tem o versículo 43.";
                 'mark':
                     "Marcos 11 não tem o versículo 43.";
                 'luke':
                     "Lucas 11 é o capítulo em que Jesus ensina a Oração do Senhor \
                     aos discípulos e depois prega para eles. O versículo 43 diz, \
                     ~Fariseus! pois amais os primeiros assentos nas \
                     sinagogas e as saudações nas praças.~ Nada há de incomum nessas \
                     palavras. Você se pergunta por que o diário de laboratório de \
                     Malcolm mencionou justamente essa passagem.";
                }
            }
             "Você folheia o exemplar da Bíblia, mas não encontra nada de estranho \
             ou desconhecido. Tudo está exatamente como você se lembra da escola \
             dominical.";
        ];

Nearby  BookCode "~Cifras de Substituição de Letras~"
 class  BookClass
 has    proper
          with   name "dmitri" "zinovic" "code" "letter" "substitution" "ciphers"
             "pamphlet" "código" "letras" "substituição" "cifras" "panfleto",
         description "~Cifras de Substituição de Letras~ é um livro fino, pouco \
             maior que um panfleto, de Dmitri Zinovic. Um aviso na contracapa diz: \
             ~A posse deste livro pode ser ilegal em alguns países~. O conteúdo \
             parece descrever três tipos de cifra de substituição de letras: \
             cíclica, por palavra-chave e aleatória.",
        before [;
         Consult:
            if (CheckUnReadable(self) == 1) rtrue;
            wn = consult_from;
            switch (NextWord()) {
             'cyclic','caesar':
                 print "Uma cifra de substituição cíclica é obtida escolhendo \
                     um deslocamento, n, entre 1 e 25 e substituindo cada \
                     letra do texto claro pela letra n posições adiante no \
                     alfabeto, voltando de Z para A. Assim, a cifra para n=5 \
                     é esta:^^";
                font off;
                print " Plaintext: ABCDEFGHIJKLMNOPQRSTUVWXYZ^Ciphertext: \
                    FGHIJKLMNOPQRSTUVWXYZABCDE^";
                font on;
                 "^Para decodificar uma cifra cíclica com deslocamento n, basta \
                 codificar com deslocamento (26-n); é fácil testar todas as \
                 possibilidades.^^Uma cifra cíclica às vezes é chamada de \
                 ~cifra de César~, porque Júlio César usou um código cíclico \
                 (com n=3) durante a conquista da Gália.";
             'keyword':
                 print "Uma cifra de substituição por palavra-chave é obtida \
                     escolhendo uma palavra ou nome longo, sem letras repetidas, \
                     por exemplo ~Gwyneth~, e usando G para codificar A, W para B \
                     e assim por diante. Quando as letras do nome acabam, use as \
                     letras restantes em ordem alfabética. A cifra obtida usando \
                     ~Gwyneth~ é esta:^^";
                font off;
                print " Plaintext: ABCDEFGHIJKLMNOPQRSTUVWXYZ^Ciphertext: \
                    GWYNETHABCDFIJKLMOPQRSUVXZ^";
                font on;
                 "^Para decodificar uma cifra por palavra-chave, você terá de \
                 adivinhar a palavra escolhida pelo codificador ou usar os \
                 métodos para decifrar cifras aleatórias.";
             'random':
                 "Para obter uma cifra de substituição aleatória, escolha \
                 qualquer permutação aleatória do alfabeto. Uma cifra aleatória \
                 é a mais difícil de quebrar, mas é difícil de memorizar e precisa \
                 ser anotada. Para decodificá-la, sua melhor estratégia é descobrir \
                 onde o código foi escondido. Também há métodos mais sofisticados \
                 baseados na análise da frequência de letras e palavras...^^O livro \
                 passa então a tratar de uma matemática complicada demais para você \
                 acompanhar.";
             default:
                <<Examine self>>;
            }
        ];

Nearby  BookCollege "~Homens de Biblioll~"
 class  BookClass
 has    proper
         with   name "men" "of" "biblioll" "encyclopaedia" "encyclopedia" "maclane"
             "homens" "enciclopédia",
         description "Escrito por William MacLane, ~Homens de Biblioll: \
             1240-1939~ é uma enciclopédia de homens famosos na história da \
             Faculdade Biblioll. São tantos que você terá de procurá-los pelo \
             sobrenome.",
        state 0,
        before [ w i flag;
         Examine: quote = 20;
         Consult:
            if (CheckUnReadable(self) == 1) rtrue;
            if (consult_words > 1)
                 "Tente procurar apenas o sobrenome.";
            wn = consult_from;
            w = NextWord();
            for (i=player+1: flag==0 && i<=top_object: i++) {
                if (i has is_door && w == ((i.&name)-->1))
                    print_ret (RoomOccupant) i, " é recente demais para ser \
                 incluído.";
            }
            switch (w) {
             'arkwright':
                "Professor Sir Joseph Arkwright, O.M. (b. 1882) became \
                uma das maiores autoridades mundiais na Décima Quarta Dinastia \
                do Egito antigo após liderar a bem-sucedida expedição de 1931-33 \
                a Akhetaten e ao Vale dos \
                 Reis. Ensinou arqueologia em Christminster até 1937, quando saiu \
                 para chefiar o novo departamento de egiptologia da Universidade de \
                 Chicago.";
             'biblioll':
                "John de Biblioll (1240-1279) foi senhor do Castelo de Branham \
                e figura menor nas intrigas pela ascensão de Eduardo III. Brigou \
                com o bispo de Durham e, sob ameaça de excomunhão, foi obrigado a \
                se desculpar publicamente. Como penitência, concordou em sustentar \
                perpetuamente vários estudiosos pobres. Assim fundou a Faculdade \
                Biblioll em 1275.";
             'canynges':
                "William Canynges (1435-1481) foi adegueiro da faculdade \
                desde 1472. Construiu as adegas sob o Grande Salão e iniciou o \
                costume de inscrever o nome do adegueiro sobre cada novo nicho \
                acrescentado durante seu mandato, prática que continua até hoje.";
             'farber':
                "Edward Farber (1646-1695), tesoureiro desde 1682, era um bom \
                administrador financeiro e péssimo arquiteto. Conseguiu arrecadar \
                mais de cinco mil libras para reconstruir a capela e teve o bom \
                senso de contratar Sir William Hawksmoor, mas acredita-se que foi \
                responsável pelo feio minarete no topo da torre da capela.";
             'fawley':
                "Jude Fawley (m. 1898), talentoso canteiro, foi um dos \
                da equipe responsável pelas gárgulas do Primeiro Pátio.";
             'garton':
                "Henry Garton (1567-1641) foi o arquiteto responsável \
                por construir grande parte do Primeiro Pátio moderno, incluindo a \
                escadaria ~B~ (que inicialmente abrigava a sala comum dos alunos \
                mais novos e só no século XVIII foi convertida em quartos para \
                professores) e a antiga biblioteca. Diz a lenda que os edifícios \
                tinham passagens secretas para que ele espionasse os quartos, mas \
                isso parece muito improvável.";
             'hawksmoor':
                "Sir William Hawksmoor (1654-1702) foi um dos mais \
                arquitetos mais influentes do fim do século XVII e provavelmente \
                foi responsável, de algum modo, por quase todos os edifícios da \
                faculdade construídos em Christminster naquele período. Foi \
                 contratado para projetar a nova capela da Faculdade Biblioll, \
                 uma obra-prima que incorporava os vitrais da antiga capela.";
             'heydon':
                "Thomas Heydon (m. 1512) ajudou a colocar a Faculdade Biblioll \
                em bases sólidas após a má administração do século XV. Aumentou o \
                número de professores para quatorze arrendando pequenas propriedades \
                das terras da faculdade cedidas pelo conde de Essex. Foi o primeiro \
                a combinar os cargos de tesoureiro e adegueiro, que assumiu em 1502, \
                um cargo conjunto que durou três séculos.";
             'lilly':
                "Edmund Lilly (c. 1300) foi um dos primeiros capelães da \
                primeiros capelães da Faculdade Biblioll. Ao morrer, deixou sua \
                Bíblia iluminada para a Faculdade.";
             'maclane':
                 "Modestamente, o autor deixou a si mesmo de fora.";
             'master':
                "Houve muitos Mestres da Faculdade desde sua fundação em 1275. \
                 Você deve procurar cada um pelo sobrenome.";
             'mayow':
                "Robert Mayow (1715-1770), tesoureiro desde 1752, conseguiu \
                fazer a faculdade perder duas mil libras, justamente quando ela \
                precisava muito de recursos, em uma série de negócios de terras \
                desastrosos em Suffolk. Em seu favor, a beleza dos jardins se deve \
                principalmente a ele.";
             'meldrew':
                "Tobias Meldrew (1801-1870) foi professor de teologia \
                de 1850 a 1866. Propôs-se a provar a existência de Deus a partir de \
                primeiros princípios, tarefa que anunciou ter concluído em 1860 com \
                a ajuda de dez mil lemas intermediários. O escárnio que recebeu ao \
                tentar publicar a obra gigantesca acabou levando-o à loucura, e ele \
                passou os últimos quatro anos de vida no hospício.";
             'noble':
                "Simon Noble (1631-1676), poeta metafísico menor, foi \
                aluno da Faculdade Biblioll e mais tarde professor do Lady Margaret \
                Hall. Embora respeitado em vida, seu trabalho foi justamente \
                esquecido após sua morte, e ele continua famoso sobretudo por sua \
                longa e feroz disputa com Andrew Marvell.";
             'philalethes':
                "~Eugenius Philalethes~ era o pseudônimo de Thomas Vaughan (ver \
                 referência), usado em seus escritos sobre alquimia.";
             'rees':
                 "Não, não há ninguém com esse nome.";
             'starkey':
                "Bernard Starkey (1681-1757), tesoureiro de 1737 a 1752 e \
                Mestre desde 1752 até sua morte, fez muito para restaurar a reputação \
                acadêmica decadente da Faculdade Biblioll ao instituir uma bolsa \
                baseada no mérito, decidida por competição aberta entre candidatos.";
             'tausend':
                "Francis Tausend (1722-1801), tesoureiro de 1770 a \
                1782. Responsável pela ampliação do Grande Salão e da Sala Comum \
                dos Veteranos. Filiou-se aos Whigs e serviu quatro anos como membro \
                do Parlamento pela Universidade de Christminster, antes de morrer \
                tragicamente na Câmara dos Comuns durante um debate sobre política \
                externa.";
             'tymme':
                "Elias Tymme (1598-1670), tesoureiro desde 1640, guiou a \
                faculdade pelo difícil período da Guerra Civil, durante o qual ela \
                ~emprestou~ mil libras de prata ao rei para sustentar a guerra e foi \
                taxada em cem libras por mês para manter as tropas aquarteladas ali, \
                enquanto Christminster era o quartel-general do rei.";
             'vaughan':
                "Thomas Vaughan (1622-66) lutou pelos realistas na \
                Guerra Civil e voltou à Faculdade Biblioll para estudar alquimia. \
                Escreveu livros sob o nome ~Eugenius Philalethes~ e traduziu outros \
                textos alquímicos e cabalísticos para o inglês, incluindo o manifesto \
                manifesto ~Fama Fraternitatis~.";
             'vauhan':
                 "Thomas Vauhan: outra grafia de Thomas Vaughan (ver referência).";
            }
            if (w == OMN()) print_ret (PrintOMN) 0, " (1625-1701), o \
                 primo do Conde de Lancaster, foi um influente teólogo puritano e \
                 autor prolífico de panfletos que defendiam reformas na Igreja da \
                 Inglaterra. Apoiou o Parlamento na Guerra Civil e foi brevemente \
                 ministro do governo de Cromwell, mas isso não impediu sua promoção \
                 após a Restauração. Foi Reitor da Faculdade Biblioll de 1686 até sua \
                 morte, mas não era querido pelos membros, e persistia a calúnia de \
                 que usava bruxaria para ficar um passo à frente dos rivais.";
             "Você não encontra ninguém com esse sobrenome no livro.";
        ];

Nearby  BookKey "~De Gloriae Coelestis~"
 class  BookClass
 has    proper
        ! general if found key in it
         with   name "master" "de" "gloriae" "coelestis" "mestre",
        description [;
            print_ret "~De Gloriae Coelestis~, by ", (PrintOMN) 0,
                " parece um tratado teológico enfadonho, escrito em latim. \
                Você não entende uma palavra e suspeita que isso seja bom.";
        ],
        number 0,
        before [;
         Receive:
            if (noun == RustyKey) {
                remove RustyKey;
                give self ~general;
                 "Você devolve a chave enferrujada ao esconderijo original.";
            }
        ],
        after [;
         Examine:
            if (self hasnt general) {
                move RustyKey to player;
                ResetVagueWords(RustyKey);
                give self general;
                Achieved("finding the rusty key");
                "^Ao folhear as páginas, você descobre que parte de algumas foi \
                recortada, deixando um pequeno vão onde uma chave enferrujada foi \
                escondida.";
            }
        ];

Array TableMastersName table
    'skery' 'field' 'hoskins' 'pocock' 'walthamstowe' 'plumb'
    'shepherd' 'winkler' 'arnott' 'quinn';

Array TableMastersFullName table [;
    "Robert Skery";
    "Peter Field";
    "Nicholas Hoskins";
    "Daniel Pocock";
    "Charles Walthamstowe";
    "Michael Plumb";
    "George Shepherd";
    "Frederic Winkler";
    "Benjamin Arnott";
    "Graham Quinn";
];

[ OMN i;
    if (i == 0) i = BookKey.number;
    return TableMastersName-->i;
];

[ PrintOMN x; x = 0; Message(TableMastersFullName,BookKey.number); ];

Nearby  BookPhilalethes "~Introitus Apertus~"
 class  BookClass
 has    proper
         with   name "introitus" "apertus" "philalethes" "entrada" "aberta",
         description "O livro, de Eugenius Philalethes e datado de 1662, é um longo \
             tratado de alquimia (a arte de transformar metais inferiores em ouro e \
             prata pela ação de uma substância misteriosa chamada ~Pedra Filosofal~) \
             e sobre como o autor pretende produzir enormes quantidades de ouro e \
             destruir o sistema maligno do dinheiro, para que ~este esteio do \
             Anticristo seja reduzido a nada~.^^A maior parte do texto é uma longa \
             série de receitas, nas quais nomes alegóricos estranhos como ~Mercúrio \
             Filosófico~, ~Orvalho de Hermes~ e outros substituem os produtos químicos \
             reais.^^Perto do fim do livro, você encontra a seguinte passagem:^^~Ao \
             fim de três anos de trabalho, realizados com diligência, paciência e boa \
             vontade, tereis uma pequena quantidade de pó avermelhado, de esplêndido \
             vermelhão, mais profundo e intenso que o cinábrio. Glorificai a Deus e \
             dai graças!^^~Para formar o Leite da Virgem, causa de sonhos proféticos \
             e visões místicas, dissolva o pó numa garrafa de bom vinho, que poderá \
             entregar ao despenseiro para guardar e amadurecer no escuro por pelo menos \
             cinco anos.^^~Depois, destampe cuidadosamente a garrafa e trate o Leite \
             conforme a receita descrita em outro lugar, para obter o Elixir da Vida. \
             É possível transformar ainda o Elixir no Pó de Projeção, mas nada mais \
             direi a respeito.~^^Que enorme bobagem!";

Nearby  BookLully "~The Clavicula~"
 class  BookClass
 has    proper
         with   name "clavicula" "lully" "chavezinha",
         description "Raymond Lully (1235-1315) foi um alquimista medieval que tentou \
             converter os muçulmanos e morreu nessa tentativa. A ~Clavicula~ (Chave \
             Pequena) é uma descrição da Arte da Alquimia. Nela, ele escreve: ~Este \
             livro contém toda a Arte, mas as palavras que uso não podem ser entendidas \
             pelos ignorantes, pois os tratados são divididos em seções e são obscuros \
             quanto à linguagem.~ Ele tem razão; não se entende coisa alguma do livro, \
             que parece ser uma completa bobagem do começo ao fim.",
        before [ w n;
         Consult:
            if (CheckUnReadable(self) == 1) rtrue;
            if (consult_words <= 2) {
                n = TryNumber(consult_from);
                wn = consult_from;
                w = NextWord();
                if (w == 'page') {
                    n = TryNumber(wn);
                    if (n == -1000) "Eu esperava um número de página.";
                }
                if (n > 0) {
                    if (n > 422) "O livro não tem tantas páginas.";
                    if (n == 364)
                        "Na página 364, você encontra uma descrição de como \
                        make the ~Elixir of Life~ (assuming that one \
                        starts out with a quantity of the ~Spittle of \
                        Lune~, whatever that might be). It reads:^^~Be of \
                        good heart, and pray to God for guidance in the \
                        Work. Take thou the Spittle, and in a glass \
                        retort heat it continually. First, make it sweet \
                        with the Sap of the Wood of Hermes, that is named \
                        also the Honey of the Egyptians. Second, make it \
                        bitter with the Bath of the King. Third, make it \
                        salt with the Water of the Sages, for thou \
                        desirest the spiritual elements to rise and the \
                        terrestrial elements to sink.~^^You wonder if \
                        this nonsense was what Malcolm's lab book was \
                        referring to.";
                    quote = 6;
                     "Você não consegue entender o material daquela página, nem, ao que \
                     parece, de nenhuma outra. O livro parece ser uma completa bobagem \
                     do começo ao fim.";
                }
            }
            "Infelizmente, o livro não tem índice e você não encontra o que quer.";
        ];

Nearby  BookMeldrew "~The History of the Meldrews (vol. I)~"
 class  BookClass
 has    proper ~scored
         with   name "meldrew" "meldrews" "history" "of" "história",
         description "Os Meldrew são uma família da pequena nobreza, e esta obra em \
             três volumes, do Honorável Peter Meldrew, é sua história definitiva. O \
             livro é uma cópia manuscrita encadernada às pressas, e a dedicatória a \
             lápis do autor sugere que nunca foi publicada.^^Ao folhear as páginas, \
             você encontra um verbete sobre Abner Meldrew (1612-1670), que dissipou \
             uma grande fortuna numa crença insana no poder da alquimia de transformar \
             chumbo em ouro, poder com o qual insistia que recuperaria o dinheiro gasto. \
             Consultou muitos alquimistas, inclusive o famoso Thomas Vaughan, e pagou \
             muito a eles, mas nunca lhe trouxeram benefício algum.",
        before [;
         Consult:
            if (CheckUnReadable(self) == 1) rtrue;
             "Você não consegue descobrir nada mais de interessante sobre os Meldrew.";
        ];

Object  BookArkwright "~The Reign of Akhenaten~"
 class  BookClass
 has    proper
  with   name "arkwright" "reign" "of" "akhenaten" "reinado",
         description "Uma obra volumosa de egiptologia, o livro de Arkwright cobre o \
             período de Amarna na história do Egito antigo, quando o faraó Akhenaten, \
             que governou o Egito de 1358 a 1340 a.C., tentou reformar o sacerdócio de \
             Amon-Rá e substituí-lo por uma religião monoteísta que adorava Áton, o \
             disco solar. Desnecessário dizer que fracassou e foi deposto pelo próprio \
             sacerdócio que tentou desmantelar.^^Você nota que o livro foi emprestado \
             da biblioteca da faculdade e está atrasado há vários anos.",
        before [ w n;
         Consult:
            if (CheckUnReadable(self) == 1) rtrue;
            if (consult_words <= 2) {
                n = TryNumber(consult_from);
                wn = consult_from;
                w = NextWord();
                if (w == 'page') {
                    n = TryNumber(wn);
                    if (n == -1000) "Eu esperava um número de página.";
                }
                if (n > 0) {
                    if (n > 389) "O livro não tem tantas páginas.";
                    if (n == 143)
                        "A página 143 contém uma descrição de como Akhenaten \
                         interrompeu o ritual de Osíris, uma cerimônia religiosa anual \
                         na qual o deus Osíris (às vezes identificado com Sethos, que \
                         representava os mortos e os ancestrais divinizados do faraó) \
                         era purificado, ungido e recebia mel do rei.^^Você se pergunta \
                         se era disso que o diário de laboratório de Malcolm falava.";
                     "Você descobre coisas que nunca soube sobre o período de Amarna, \
                     mas tudo é muito tedioso e acadêmico, e não permanece na sua cabeça \
                     nem por um segundo.";
                }
            }
            "Infelizmente, o livro não tem índice e você não encontra o que quer.";
         Take,Remove:
            if (self in Wilderspin) {
                move self to player;
                "Wilderspin entrega o livro, um tanto relutante.";
            }
        ];

Object  BookBarker "~Flower Fairies~"
 class  BookClass
 has    proper ~scored
  with   name "slim" "volume" "flower" "fairies" "fino" "volume" "flor" "fadas",
        description "O livro é de Cicely Barker e contém uma coleção de poemas \
            melosamente doces sobre fadas que vivem em flores. O Mestre deve ter \
            desprezado muito sua inteligência para lhe dar isto.";


!------------------------------------------------------------------------------
! 4.2 "B" STAIRCASE
!------------------------------------------------------------------------------

Object  BStairGround "~B~ Staircase, Ground Floor"
 has    light
         with   description "Você se sente deslocada e fora de lugar entre estas \
             salas antigas e escadarias estreitas de madeira escura. A leste fica \
             a porta de B1; a oeste, a porta de B2; escadas sobem e descem; e uma \
             porta leva a noroeste ao Primeiro Pátio.",
        u_to BStairFirst,
        d_to BStairBasement,
        nw_to FirstCourt,
        out_to FirstCourt,
        e_to DoorB1,
        w_to [;
            if (EM == 0 && Wilderspin in self)
                "Wilderspin bloqueia seu caminho.";
            return DoorB2;
        ],
        edward_dirs nw_obj;

Nearby  DoorB1 "x" class DoorClass
 with   name "B1" "Halfhide" "Halfhide^s", honorific doctor,
        room "B1", occupant "Halfhide", door_dir e_to;

Object  BStairFirst "~B~ Staircase, First Floor"
 has    light
 with   name "rickety" "ladder",
         description "A escada estreita é irregular e escorregadia após séculos de \
             passagem de moradores, homens famosos em seu tempo sem dúvida, agora \
             esquecidos, com seus livros acumulando poeira nas estantes. A leste fica \
             a porta de B3; a oeste, a porta de B4; uma escada precária sobe ao \
             segundo andar, e outra desce ao térreo.",
        u_to BStairSecond,
        d_to BStairGround,
        e_to DoorB3,
        w_to DoorB4,
        edward_dirs d_obj;

Nearby  DoorB3 "x" class DoorClass
 with   name "B3" "Moody" "Moody^s", honorific doctor,
        room "B3", occupant "Moody", door_dir e_to;

Nearby  DoorB4 "x" class DoorClass
 with   name "B4" "Jarboe" "Jarboe^s", honorific doctor,
        room "B4", occupant "Jarboe", door_dir w_to,
        before [;
         Knock,Attack:
            if (ClockTower.number > 18 || Jarboe notin JarboesSanctum) 
                rfalse;
             if (random(2) == 1)
                 "~Vá embora!~ grita Jarboe lá de dentro.";
             print "Jarboe abre a porta e espia você. ~Ah, é você~, diz ele";
            if (BookLab in Jarboe)
                 ". ~Você estava procurando isto?~ e ergue o livro do laboratório \
                 de seu irmão. Rindo cruelmente, bate a porta na sua cara.";
             ". ~Suma, não quero ver você.~ Ele bate a porta na sua cara.";
        ];

Object  BStairSecond "~B~ Staircase, Second Floor"
 has    light
 with   name "landing" "ladder" "turrets" "turret" "roof" "roofs"
            "gargoyle" "gargoyles" "walkway" "walkways",
         description "Este pequeno patamar tem uma única porta, que leva a leste \
             para B5. Uma escada desce ao primeiro andar, e uma janelinha dá para \
             uma vista complexa de telhados, torres, passarelas e gárgulas.",
        d_to BStairFirst,
        e_to DoorB5,
        edward_dirs d_obj;

Nearby  BStairSecondWindow "janela"
 has    scenery
 with   name "window",
         description "Ao espiar pela janela encardida, você vê uma vista complexa \
             de telhados, torres, passarelas e gárgulas.",
        before [;
          Open: "Parece não haver como abrir a janela (provavelmente para impedir \
             que os estudantes saiam e perambulem pelo telhado).";
         Search: <<Examine self>>;
        ];


!-------------------------------------------------------------------------
! 4.2 PROFESSOR WILDERSPIN
!-------------------------------------------------------------------------

Object  DoorB2 "x" BStairGround
 class  DoorClass
 with   name "B2" "Wilderspin" "Wilderspin^s", 
        honorific professor,
        room "B2", 
        occupant "Wilderspin",
        door_dir w_to,
        door_to WilderspinsRoom,
        before [;
         Close:
            if (Wilderspin in location)
                "Você não consegue, pois Wilderspin está no caminho.";
         Knock,Attack:
            if (Wilderspin in location)
                "Isso seria inútil, pois Wilderspin já está aqui.";
            if (Wilderspin notin WilderspinsRoom) rfalse;
            if (Wilderspin.state > 0) {
                give self ~locked;
                "~Entre!~ chama Wilderspin lá de dentro.";
            }
            give self ~locked open;
            MoveNPC(Wilderspin, BStairGround, e_obj);
            Wilderspin.state = 1;
            StartDaemon(Wilderspin);
            "A porta se abre e surge um homem alto e barbudo, que você presume \
             ser Wilderspin. ~Estou um pouco ocupado no momento~, diz ele. \
             ~O que você quer?~";
        ];

Object  WilderspinsRoom "Estudo do Professor Wilderspin"
 has    light no_edward proper
 with   name "study",
        initial [;
            Achieved("visiting Professor Wilderspin");
            DoneHint(WhatNextPuzzle,7,8);
        ],
         description [;
            if (ClockTower.number < 20) 
                 "Este estudo é uma sala confortável, bem iluminada por uma janela \
                 voltada para o Primeiro Pátio ao norte. A mesa de Wilderspin fica \
                 sob a janela, aproveitando melhor a luz. Há uma grande lareira apagada \
                 na parede oeste e uma saída a leste.";
            "Este estudo é uma sala confortável, com uma janela voltada para o \
            Primeiro Pátio ao norte. A mesa de Wilderspin fica junto à janela e há \
            uma grande lareira apagada na parede oeste. Você pode sair a leste.";
	],
        e_to BStairGround,
        out_to BStairGround,
        w_to [;
            if (Fireplace hasnt open)
                 "Você examina a lareira, mas não encontra nada de estranho.";
            DumpCarried(WilderspinsRoom);
            Wilderspin.state = 10;
            give Fireplace ~open;
            print "Você passa cuidadosamente pelo buraco atrás da \
                lareira. Ao passar pela soleira, seu pé prende e você tropeça, \
                derrubando tudo que carregava e caindo para a frente sobre um chão \
                duro de madeira. Você deve ter acionado algum mecanismo, pois o \
                fundo da lareira volta ao lugar com uma pancada perturbadoramente \
                definitiva. Você mergulha em...^";
            PlayerTo(SecretPassage);
            AdvanceTime(Fireplace);
            DoneHint(WhatNextPuzzle,9);
            rtrue;
        ],
        cant_go "A saída fica a leste.";

Nearby  WilderspinsWindow "janela"
 has    static concealed openable
 with   name "window",
        before [;
         Open: 
            if (Wilderspin in location) 
                "Você não consegue abrir a janela. ~Ela está emperrada há anos~, \
                 diz Wilderspin.";
            "Você não consegue abrir a janela.";
         Search: "Você olha para o Primeiro Pátio, mas não vê nada inesperado.";
        ];

Nearby  WilderspinsDesk "mesa"
 has    static concealed openable
 with   name "desk",
        before [;
         Open,Search: "Seria imperdoavelmente rude vasculhar a mesa de Wilderspin.";
        ];

Nearby  ExaminationScripts "provas"
 has    concealed
 with   name "examination" "pile" "of" "script" "exam" "scripts",
        article "a pile of",
        before [;
         Examine, Take: "Deixe as provas em paz para serem corrigidas.";
        ];

Nearby  Fireplace "lareira"
 has    scenery door
        ! general if you've examined the griffins
 with   name "fireplace" "fire" "place" "grate" "hole",
        description [;
            print "Como é verão, não há fogo na lareira, e a grade foi quase toda \
                limpa das cinzas. A lareira é ladeada por dois grifos de bronze";
            if (self has open)
                print ". Há um grande buraco atrás da lareira, levando a uma sala \
                    escura a oeste";
            ".";
        ],
        describe [;
            if (self has open)
                "^Um grande buraco atrás da lareira leva a uma sala escura a oeste.";
        ],
        door_to SecretPassage,
        door_dir w_to,
        before [;
         Receive,ThrownAt:
            if (self has open)
            "Por que não levar isso você mesma?";
            "Você só sujaria tudo com cinza e poeira.";
        ];

Class   GriffinClass
 has    static concealed
 with   name "brass" "griffin",
        article "the",
         description "Um grifo é uma criatura mitológica com corpo de leão e \
             cabeça e asas de águia. Este grifo é de bronze, tem cerca de sessenta \
             centímetros de altura e apenas um olho.",
        after [;
         Examine,Search:
            if (Fireplace hasnt general && Wilderspin in location) {
                give Fireplace general;
                print "^Wilderspin diz: ~Interessada nos grifos? Ao que parece, \
                    são do início do século XVII, colocados aqui por Henry Garton.~^";
            }
        ];

Nearby  Griffins "grifos"
 has    scenery
 with   name "griffins",
         description "Os grifos ficam ao lado da lareira, um à esquerda e outro à \
             direita. São de bronze, têm cerca de sessenta centímetros de altura e \
             cada um tem apenas um olho.",
        before [;
         Examine: ;
          default: "Você terá de dizer qual grifo quer dizer, o esquerdo ou o direito.";
        ];

Nearby  LeftGriffin "grifo esquerdo"
 class  GriffinClass
        ! general if Wilderspin's seen you push an eye
 with   name "left";

Nearby  RightGriffin "grifo direito"
 class  GriffinClass
 with   name "right";

Nearby  Eyes "olhos dos grifos"
 has    scenery
 with   name "eyes",
        before [;
          Push: "Os olhos são separados demais para você apertar os dois.";
          default: "Você terá de dizer de qual grifo é o olho, o esquerdo ou o direito.";
        ];

Class   GriffinEyeClass
 has    static concealed
 with   name "griffin^s" "eye",
        article "the",
         description "O único olho do grifo encara você.",
        before [;
         Push:
            if (Wilderspin.eye_pushed == self)
                print_ret "Wilderspin já está apertando ", (the) self, ".";
            if (self.other_obj ~= Wilderspin.eye_pushed) {
                print "Você aperta o olho, que afunda cerca de um centímetro e meio \
                    com um clique. Nada mais acontece. Você o solta e ele volta ao \
                    lugar.";
                if (Wilderspin in location && LeftGriffin hasnt general) {
                    give LeftGriffin general;
                    print " Wilderspin ouve o clique e se vira para ver o que você \
                        está fazendo. ~Minha nossa~, diz ele. ~Nunca soube que eles \
                        faziam isso.~";
                }
                new_line;
                rtrue;
            }
            give Fireplace open;
            Wilderspin.state = 8;
            Wilderspin.eye_pushed = 0;
            MoveNPC(Wilderspin, SecretPassage, w_obj);
            Achieved("opening the secret passage");
            "Você aperta o olho e ouve um clique vindo da lareira. A parede dos \
            fundos se abre, revelando um grande buraco para uma sala escura a \
            oeste.^^~Incrível!~, diz Wilderspin. ~Estou aqui há onze anos e nunca \
            pensei em tentar isso! Venha, vamos ver o que encontramos.~^^Ele passa \
            pelo buraco.";
        ];

Nearby  LeftGriffinEye "olho do grifo esquerdo"
 class  GriffinEyeClass
 with   name "left",
        other_obj RightGriffinEye;

Nearby  RightGriffinEye "olho do grifo direito"
 class  GriffinEyeClass
 with   name "right",
        other_obj LeftGriffinEye;

Object  Wilderspin "Professor Wilderspin" WilderspinsRoom
 class  FollowClass CarryingClass TalkableClass
 has    proper
        ! general if told you about Osiris
 with   name "professor" "wilderspin" "prof" "fellow",
        description [;
                print "Wilderspin é alto e barbudo, e você estimaria que tem cerca de \
                    cinquenta anos. Ele veste uma longa beca preta e ";
            if (self in BStairGround) {
                print "olha para você com impaciência."; rtrue;
            }
            if (self in WilderspinsRoom && self.state == 5 or 6 or 7) {
                print "segura ", (the) self.eye_pushed, ".";
                rtrue;
            }
            if (self in WilderspinsRoom && self.state == 4) {
                print "senta à mesa, corrigindo provas.";
                rtrue;
            }
            if (self in AlchemistsRoom) {
                print "examina o esqueleto com grande interesse.";
                rtrue;
            }
            print "** Error: Wilderspin doing something bizarre **";
        ],
        life [;
         Show,Give:
            if (noun == BookArkwright && DoorB1 hasnt general) {
                give DoorB1 general;
                move BookArkwright to self;
                MoveNPC(self, WilderspinsRoom, w_obj);
                self.state = 4;
                "~Ora~, diz Wilderspin, pegando o livro de suas \
                mãos. ~Arkwright sobre o período de Amarna, e uma primeira edição. \
                Pensei que nunca veria uma destas. Isso me lembra a expedição de \
                1932, procurando estelas em Akhetaten e ouvindo as teorias de \
                Arkwright sobre Osíris. Você precisa me deixar contar sobre elas um \
                dia. Sou Wilderspin, aliás, prazer em conhecê-la.~^^~Christabel \
                Spencer~, você responde, apertando a mão dele.^^~Entre~, diz ele, \
                voltando ao estudo para folhear as páginas do livro.";
            }
            if (noun == BookArkwright) {
                move BookArkwright to self;
                "Wilderspin aceita seu presente.";
            }
        ],
        orders [;
         Push:
            if (noun == LeftGriffinEye or RightGriffinEye) {
                if (self.state == 5 or 6 or 7)
                    "~Já estou apertando o máximo que consigo!~, diz ele.";
                if (LeftGriffin hasnt general)
                    "~Não tenho certeza de que entendi~, diz ele. ~Talvez você \
                     pudesse demonstrar?~";
                self.state = 5;
                self.eye_pushed = noun;
                print_ret "~Vou tentar, se você quiser~, diz o \
                    Professor. Ele caminha até a lareira e aperta ", (the) noun,
                    ", mantendo-o pressionado. ~Bem?~ \
                    pergunta ele, ~o que acontece agora?~";
            }
         Give:
            if (noun == BookArkwright && second == player)
                <<Take BookArkwright>>;
         Go,Enter,Climb:
            if (noun == player && self in SecretPassage)
                    "~Não acho que você conseguiria carregar meu peso~, diz \
                    Wilderspin.";
            if (self in SecretPassage) {
                if (player notin self)
                    "~Quem dera eu pudesse~, diz ele.";
                if (noun ~= n_obj or ne_obj or e_obj &&
                    noun ~= se_obj or s_obj or sw_obj &&
                    noun ~= w_obj or nw_obj)
                    "~Não entendo muito bem como fazer isso~, diz ele.";
                if (noun == self.next_to)
                    "~Não posso ir mais longe~, diz ele.";
                self.next_to = noun;
                "Wilderspin dá alguns passos naquela direção. Você cambaleia um \
                 pouco, mas consegue recuperar o equilíbrio. ~É isso, não posso ir \
                 mais longe~, diz ele.";
            }
         Take:
            if (noun == player && self in SecretPassage) <<Climb self>>;
         Drop:
            if (noun == player && player in self) <<Exit>>;
         default:
            if (noun == Skeleton) <<Question self QSkeleton>>;
        ],
        before [;
         Question:
            if (self in BStairGround)
                "~Estou ocupado demais para ajudar você com isso~, diz Wilderspin.";
            switch(second) {
             QGarton:
                "~Henry Garton foi um dos arquitetos da faculdade no \
                século XVII~, diz o Professor, ~mas não sei mais do que isso.~";
             QGriffins:
                "~Gosta dos grifos?~, diz Wilderspin. ~Os \
                de um olho só são muito incomuns. Estes são atribuídos a Henry Garton.~";
             QEdward:
                "~Edward Forbes?~, diz Wilderspin. ~Ele tem potencial para ser \
                um bom aluno, mas não tem força de vontade para fazer o trabalho \
                necessário. Suspeito que passará seus três anos à deriva e depois \
                irá trabalhar no serviço público, como todo mundo.~";
             QOsiris,QHoney:
                if (self hasnt general) {
                    give self general;
                    print "~Arkwright tinha ideias estranhas sobre o ritual~, \
                        diz Wilderspin, ~com base em sua interpretação das pinturas \
                        dos templos de Karnak e Abidos. Ele achava que os egípcios \
                        antigos realmente acreditavam que suas oferendas trariam \
                        Osíris de volta à vida e adoravam o tamarisco. Acho \
                        que ele pode ter interpretado demais algumas correspondências \
                        entre os cultos de Osíris e Hermes.^";
                    print "^~Segundo o mito egípcio, Osíris foi \
                        aprisionado pelo deus maligno Set e trancado num baú, que \
                        flutuou pelo Nilo até os pântanos de papiro, onde uma árvore \
                        de tamarisco cresceu ao redor dele. Mais tarde, a árvore foi \
                        derrubada por um rei local, e o tronco, ainda contendo o baú, \
                        foi usado como pilar central do palácio do rei.^";
                    print "^~A esposa de Osíris, a deusa Ísis, procurou por \
                        ele durante muitos anos. Quando finalmente o encontrou, \
                        Set o despedaçou e espalhou as partes pelo Egito. Mas o \
                        amor de Ísis era tão grande que ela visitou cada lugar e \
                        construiu um templo ali, e Osíris voltou à vida e reinou \
                        novamente sobre os deuses.~^";
                    print "^Você se sente bastante comovida com a narrativa da \
                        história.^";
                    "^Wilderspin acrescenta: ~Osíris mais tarde foi identificado com \
                    o semideus Hermes Trismegisto, o três vezes poderoso, e o \
                    tamarisco era conhecido pelos ocultistas medievais como a \
                    madeira de Hermes.~";
                }
                "Wilderspin já contou a você o mito de Ísis e \
                Osiris.";
             QArkwright:
                 "~Arkwright é um dos grandes egiptólogos~, diz \
                 Wilderspin. ~Estive com ele na expedição de 1931 ao Vale dos \
                 Reis, e ele era incansável! Sol escaldante, nativos inquietos, \
                 a equipe francesa rival de Pierre Vastang: nada conseguia \
                 detê-lo! Foi escandaloso Christminster nunca tê-lo nomeado \
                 chefe do departamento, e não me surpreendeu quando partiu \
                 para Chicago.~";
             QVastang:
                 "~Vastang era uma ameaça, sem dúvida~, diz \
                 Wilderspin. ~Tivemos problemas sem fim com ele subornando \
                 nossos trabalhadores para nos denunciar e atrapalhar nossas \
                 escavações. Ele chegou a vestir um turbante, fingindo ser um \
                 bandido muçulmano, e tentou nos expulsar do Vale dos Reis \
                 atirando contra nosso acampamento. Que figura!~";
             QArchaeology,QEgypt:
                 "~Isso mesmo~, diz Wilderspin. ~Antes de ser nomeado aqui, \
                 trabalhei em campo no Egito. Bons tempos! Calor abrasador, \
                 escorpiões nas botas, toneladas de areia e terra para remover, \
                 e túmulos por toda parte. Um paraíso para o egiptólogo.~";
             QJarboe:
                 "~Não conheço Jarboe muito bem~, diz Wilderspin. ~Ele é \
                 matemático, e todos os matemáticos são um pouco loucos.~";
             QBungay:
                 "~Bungay é especialista na Europa medieval e renascentista, \
                 ~diz Wilderspin, ~que é um pouco posterior à minha época. Não \
                 conte a ninguém que eu disse isto, mas não acho que alguém, \
                 muito menos seus alunos, ficaria triste se ele trocasse o ensino \
                 pela pesquisa.~";
             QSkeleton:
                if (self in AlchemistsRoom)
                     "~Não tenho certeza~, diz Wilderspin, ~mas ele, certamente \
                     ele, parece ter cerca de trezentos anos. Pelas garrafas e \
                     coisas do tipo, eu diria que era um alquimista e temia que \
                     suas pesquisas fossem descobertas. Mesmo na conservadora \
                     Christminster, teria corrido o risco de ser queimado como \
                     feiticeiro. Gostaria de saber como morreu.~";
            }
            if (self.state == 5 or 6 or 7)
                "~Bem, o que acontece agora?~, pergunta Wilderspin.";
            if (self.state == 4)
                "Wilderspin ignora você e continua corrigindo as provas.";
            if (self.state >= 10 && self.state <= 25)
                "Wilderspin procura sua mão e a aperta tranquilizadoramente. ~O melhor \
                que podemos fazer é manter a calma e pensar com cuidado no que fazer.~";
            if (self.state == 26)
                "~Gostaria que você decidisse o que quer que eu faça~, \
                Wilderspin resmunga. ~Não acho que consiga carregar você para sempre.~";
            if (self.state == 28 or 29 or 30)
                "~E agora?~, pergunta Wilderspin. ~Suponho que devamos explorar esta \
                saliência e ver aonde ela leva.~";
            if (self.state == 31)
                "Wilderspin está ocupado demais examinando a sala para prestar muita \
                atenção em você.";
            "** Erro: Wilderspin está em um lugar ou estado ilegal **";
         Climb,Enter:
            if (self in SecretPassage) {
                if (player in self)
                "Você já está sobre os ombros de Wilderspin.";
                move player to self;
                self.state = 26;
                self.next_to = 0;
            "~Deixe-me subir em seus ombros~, você diz. ~Está bem~, \
                ele responde. ~Podemos tentar... Está bem, estou ajoelhado.~ \
                Você sobe desajeitadamente no ombro dele, e ele segura suas pernas e \
                se levanta trêmulo.";
            }
            "~Não acho que isso seja necessário~, diz Wilderspin.";
        ],
        next_to 0,
        eye_pushed 0,
        state 0,
        daemon [;
            ! 0 in room and unfriendly
            ! 1-3 waiting outside door
            ! 4 in room and friendly
            ! 5-7 pushing Griffin's eye
            ! 8-9 waiting inside secret passage
            ! 10-25 trying to get out of secret passage
            ! 26 carrying Christabel
            ! 27 pulled up to ledge
            ! 28-30 in ledge
            ! 31 in Alchemists Room
            switch (self.state) {
             0,4: rtrue;
             3:
                MoveNPC(self, WilderspinsRoom, w_obj);
                give DoorB2 locked ~open;
                self.state = 0;
                if (player notin BStairGround) rtrue;
                "^Wilderspin diz: ~Sinto muito, mas estou muito ocupado e não \
                posso vê-la hoje. Adeus.~ Ele volta para o quarto, fechando e \
                trancando a porta.";
             7:
                self.state = 4;
                self.eye_pushed = 0;
                if (player notin WilderspinsRoom) rtrue;
                "^~Parece que nada aconteceu~, diz Wilderspin. ~Eu pensei que \
                você fosse apertar o outro olho.~ Ele volta a corrigir as provas.";
             9:
                if (player in WilderspinsRoom && random(2) == 1)
                    "^Você ouve Wilderspin chamando do outro lado da \
                    lareira: ~Venha ver isto! Que lugar estranho você encontrou!~";
                rtrue;
             10:
                print "^~Não entre em pânico!~, diz Wilderspin. Você tenta muito \
                    resistir à tentação de gritar.^";
             12:
                print "^~Já estive em situações piores~, diz \
                    Wilderspin. ~Como quando o teto desabou na antecâmara do \
                    túmulo de Amenhotep II.~^";
             13:
                print "^Wilderspin diz: ~Por sorte, eu estava preso sob uma laje \
                    do teto, e isso me protegeu do resto dos escombros.~^";
             14:
                print "^Wilderspin diz: ~Levaram cinco horas para me tirar de lá.~^";
             16:
                print "^~Vamos pensar com cuidado~, diz Wilderspin. ~Vi a sala \
                    rapidamente antes de você fechar a entrada, mas não consegui \
                    ver uma saída.~^";
             18,20:
                if (self has general)
                    print "^Você ouve Wilderspin arranhando uma das \
                        paredes. ~Deve haver algum jeito de abrir a porta \
                        novamente~, ele murmura para si mesmo.^";
                else {
                     print "^Wilderspin diz: ~Acho que nós dois precisamos de um pouco \
                         de ânimo, então deixe-me contar as ideias de Arkwright \
                         sobre Osíris, como prometi.~^^";
                    <Question self QOsiris>;
                }
             21:
                 print "^~Vamos pensar com cuidado~, diz Wilderspin. ~A sala tem \
                     cerca de um metro de largura e três metros de comprimento. \
                     As paredes são de pedra.~^";
             22:
                 print "^Wilderspin continua: ~O chão é de madeira, \
                     assustadoramente sólido, infelizmente.~^";
             23:
                print "^~Vamos, homem~, diz Wilderspin para si mesmo. \
                    ~Pense!~^";
             25: self.state = 10;
             26:
                if (random(3) == 1)
                 "^~Bem, e agora?~, pergunta Wilderspin.";
                rtrue;
             27:
                move Wilderspin to Ledge;
                 print "^~Muito bem!~, chama Wilderspin. ~Pode me puxar \
                     para cima?~ Você se abaixa e, depois de muito esforço e \
                     alguma atrapalhação, consegue fazê-lo. Vocês dois se sentam \
                     no chão escuro até recuperarem o fôlego.^";
             28,29,30:
                if (player notin Ledge) {
                    MovePrintNPC(self, AlchemistsRoom, e_obj);
                    self.state = 30;
                }
                if (self.state == 30 && player in Ledge) {
                    print "^~Vamos, senhorita Spencer~, diz Wilderspin. \
                         ~Vamos explorar!~ Você o ouve mover-se para o sul.^";
                    MovePrintNPC(self, AlchemistsRoom, s_obj);
                }
             31:
                StopDaemon(self);
                rtrue;
            }
            if (self.state > 31)
                "^** Erro: Wilderspin não está no estado 0-31 **";
            self.state = self.state + 1;
            if (parser_trace >= 1)
                print "[Wilderspin.state = ", self.state, "]^";
        ];

Nearby  WilderspinsGown "bata"
 has    clothing worn concealed
 with   name "long" "black" "gown" "sleeves",
        description "Você não entende desses assuntos, mas, se entendesse, \
                     então seria capaz de reconhecer que quem veste esta bata é um \
                     membro do Biblioll College examinando o comprimento e o corte \
                     das mangas.";

Nearby  WilderspinsMoustache "bigode"
 has    concealed
 with   name "whisker" "whiskers" "moustache",
         description "Um belo bigode de guidão. Em Londres, estaria fora de moda \
             há apenas vinte anos. Aqui em Christminster, Wilderspin provavelmente \
             está à frente de seu tempo.";


!------------------------------------------------------------------------------
! 4.4 THE SECRET PASSAGE
!------------------------------------------------------------------------------

Object  SecretPassage "** Erro: você não deveria ver isto **"
 has    no_edward
 with   before [;
            if (noun == d_obj && player notin Wilderspin)
                 "Você arranha as tábuas de madeira, mas elas são \
                 firmes demais.";
            if (noun == u_obj)
                "O teto está além do seu alcance.";
         Jump:
            if (player in Wilderspin)
                 "Sua posição é precária demais para esse tipo de \
                 acrobacia.";
         Climb:
            if (noun in compass)
                 "Tentar subir pelas paredes de pedra só resulta em uma unha \
                 quebrada.";
         Go,Enter,Touch:
            if (noun == d_obj && player in Wilderspin) <<Exit>>;
            if (noun in compass && player notin Wilderspin) {
                if (random(3) ~= 1)
                    "Você tateia naquela direção, mas quase \
                    imediatamente esbarra numa parede de pedra muito sólida. Você passa \
                    as mãos pelas pedras úmidas e frias, mas, até onde consegue alcançar, \
                    não há nenhuma abertura na alvenaria.";
                "Você tateia naquela direção e quase imediatamente esbarra em algo \
                immediately bump into something soft. You start to \
                 macio. Você começa a gritar, mas percebe que é Wilderspin. \
                 ~Perdão~, ele diz.";
            }
            if (CompassPoint(noun) == 1 && player in Wilderspin) {
                if (Wilderspin.next_to ~= noun)
                    print_ret "Não há nada ao alcance para o ",
                        (address) (noun.&name)-->1, ".";
                if (noun ~= s_obj)
                    print_ret "Você estende a mão e passa os dedos pelas \
                        pedras frias e úmidas de ", (the) noun,
                        ". Não há saída por aqui.";
                print "Você estende a mão e passa os dedos pelas pedras frias e \
                    úmidas da parede sul. De repente, sua mão escorrega para a frente \
                    e você quase cai. Há um buraco aqui, no alto da parede! ~Solte-me~, \
                    você diz, e se puxa para cima de uma saliência.^";
                Wilderspin.state = 27;
                PlayerTo(Ledge);
                Achieved("escaping from the secret passage");
                DoneHint(WhatNextPuzzle,10);
                rtrue;
            }
         Scream:
            quote = 2;
            "Wilderspin procura sua mão e a aperta tranquilizadoramente. ~Calma~, diz \
            ele. ~Mantenha a cabeça fria e sairemos daqui rapidinho.~";
         Listen: "O som do seu coração batendo é alto em seus ouvidos.";
        ],
        after [;
         Exit:
            if (Wilderspin.state == 26) {
		Wilderspin.state = 10;
            "Você desce dos ombros de Wilderspin e fica novamente sobre seus próprios \
            pés.";
	    }
        ];

Object  Ledge "** Erro: você não deveria ver isto **"
 has    no_edward
 with   n_to "Você não quer descer novamente no escuro.",
        d_to "Você não quer descer novamente no escuro.",
        s_to AlchemistsRoom,
        cant_go "Como você não quer descer novamente, é melhor \
            follow the ledge south.",
        before [;
         Go:
            if (noun == s_obj) {
                print "Você tateia para o sul, meio curvada e \
                    meio rastejando. A passagem vira à esquerda, e seus olhos, agora \
                    acostumados à escuridão, começam a distinguir algumas formas...^";
            }
        ];

Object  AlchemistsRoom "Sala Secreta"
 has    light no_edward
 with   name "cupboard" "socket" "sockets" "crack" "shaft" "light",
        description "Um feixe de luz vindo de uma fenda no alto da parede sul ilumina \
            uma salinha, talvez de um metro e meio por dois, pouco maior que um armário, \
            com uma passagem estreita que leva para oeste, à escuridão.^^Na luz fraca, \
            você vê uma bancada de laboratório junto a uma parede e um esqueleto humano \
            encolhido num canto. Um arrepio percorre sua espinha ao vê-lo.",
        w_to [;
            print "Você tateia de volta pela passagem, que vira para a direita.^";
            return Ledge;
        ],
        before [;
         Go:
            if (noun == d_obj or in_obj && Hole in self) <<Enter Hole>>;
         Smell: "Há um leve cheiro desagradável de decomposição.";
        ],
        each_turn [;
            if (Candle has light && LineOfSight(player,Candle) == 1 && Hole
              in self) {
                give Candle ~light;
                "^Uma corrente de ar vinda do buraco apaga sua vela.";
            }
        ];
                
Nearby  Skeleton "esqueleto"
 has    scenery
        ! general if Wilderspin's enthused about it
 with   name "skeleton" "corpse" "body" "robes" "rotten" "crumbling",
        description "Você mal consegue suportar aproximar-se daquilo. É o corpo de um \
            adulto, reduzido pela ação do tempo a um esqueleto branco, vestido com \
            mantos podres e em ruínas.",
        life [ i;
         Give:
            if (noun has is_vessel && noun has open && 
              children(noun) > 0 && child(noun) has is_liquid) {
                i = child(noun);
                remove i;
                print "Sentindo-se um tanto tola, você despeja ", (the) i, " \
                    na boca sorridente do esqueleto";
                if (i ~= ElixirC) ".";
                print ". Uma súbita corrente de ar frio sacode os ossos, \
                    e o esqueleto se ergue de um salto. ";
                if (Wilderspin in AlchemistsRoom) print "Wilderspin cai para trás, \
                    atônito, bate a cabeça na parede e desaba no chão. ";
                print "Paralisada de medo, você só consegue observar enquanto o \
                    esqueleto avança na sua direção, apontando o dedo ossudo \
                    dedo ossudo para sua garganta.^^~Quem sois?~ ele geme, ~Sois o \
                    Diabo? Não tendes poder sobre mim. Pela minha Arte, venci-vos, \
                    Belzebu! Eu vos conjuro em nome de Azraphel, Arioch, Apollyon, \
                    Anauel, Adonai, Adramelech, Anaphaxeton e Astaroth!~ Então, tão \
                    depressa quanto ganhou vida, ele vacila e cai ao chão, reduzido \
                    novamente a um amontoado de ossos brancos";
                if (Wilderspin in AlchemistsRoom) print ".^^Wilderspin \
                    geme e se senta. ~O que aconteceu?~, diz ele. ~Devo ter batido a \
                    cabeça. Ai, que dor!~ Você se aproxima dele solícita, mas ele a \
                    afasta. ~Já sofri pancadas piores~, diz ele. ~Não se preocupe comigo, \
                    vou ficar bem.~ Ele volta a examinar o esqueleto como se nada tivesse \
                    acontecido";
                ".";
            }
        ],
        before [;
         Take,Pull,Push,Turn,Touch,Search:
            "Argh! Você certamente não vai chegar perto o bastante do esqueleto \
            para tocá-lo.";
         SmellThing:
            "Ele ainda exala um leve cheiro desagradável de decomposição.";
        ],
        after [;
            quote = 5;
            if (Wilderspin in AlchemistsRoom && self hasnt general) {
                give self general;
                print "^~Não é emocionante?~, diz Wilderspin. ~Isso me lembra quando \
                    abrimos o túmulo de Neferneferuaten e encontramos os esqueletos de \
                    oito de seus escravos, assassinados para acompanhá-lo no além.~^";
            }
        ];

Nearby  Lever "alavanca"
 has    static concealed
        ! general if Wilderspin's commented
 with   name "lever" "handle",
        before [;
         Pull:
            if (Hole in AlchemistsRoom) 
                "A alavanca não se moverá mais nessa direção.";
            move Hole to AlchemistsRoom;
            print "Você puxa a alavanca e, com um satisfatório ~tum~, \
                uma seção da parede sob a bancada se move para o lado, revelando um \
                pequeno buraco que leva para baixo.^";
            if (self hasnt general) {
                give self general;
                "^~Muito bem!~, diz Wilderspin. ~Você será uma \
                arqueóloga! Desça, e eu a seguirei daqui a pouco, quando terminar aqui.~";
            }
            rtrue;
         Push:
            if (Hole in AlchemistsRoom) {
                remove Hole;
                "Você empurra a alavanca de volta à posição original e o buraco \
                desaparece.";
            }
            "A alavanca não se moverá mais nessa direção.";
        ];

Object  Hole "abertura"
 has    scenery
 with   name "hole" "passage" "secret",
        before [;
         Receive: "Cuidado, você pode danificá-la!";
         Enter:
            print "Você desce pelo buraco e, para sua surpresa, \
                você sai numa prateleira alta da biblioteca da faculdade (autores de \
                arquitetura começando com G, por acaso)! Você desce desajeitadamente e \
                atravessa as estantes até a entrada da biblioteca.^";
            PlayerTo(Library);
            Achieved("finding a secret way into the library");
            AdvanceTime(self);
            if (Edward in Library) {
                if (Edward.number > 1) Edward.number = 1;
                "^Edward pula de surpresa ao ver você. ~Não vi você entrar~, diz ele.";
            }
            rtrue;
        ];

Object  Bench "bancada" AlchemistsRoom
 has    scenery supporter
 with   name "laboratory" "bench",
        description "A bancada está coberta de cadinhos, frascos e \
            outros aparatos químicos.",
        before [ i;
         Search: <<Examine self>>;
         LookUnder:
            print "Sob a bancada você encontra ";
            objectloop(i in AlchemistsRoom) give i ~workflag;
            give Hole workflag;
            give Lever workflag;
            WriteListFrom(child(AlchemistsRoom), ENGLISH_BIT + WORKFLAG_BIT);
            ".";
        ];

Nearby  Paraphernalia "aparato químico"
 has    concealed
        ! general if bottle removed
 with   name "chemical" "paraphernalia" "flask" "flasks" "crucible"
            "crucibles" "crystalline" "residue" "residues" "bottles",
        description "O equipamento químico parece ter um projeto antigo. \
            A maior parte está quebrada; alguns cadinhos ainda contêm resíduos \
            cristalinos do produto químico que o experimentador preparava.",
        article "some",
        before [;
         SmellThing: "Os produtos químicos ainda exalam um leve cheiro acre.";
         Taste,Eat,Drink: "Isso provavelmente não seria sensato.";
         Take,Remove: 
            if (self hasnt general)
                <<Examine self>>;
            "Você já pegou tudo que não está quebrado.";
        ],
        after [;
         Examine,Search:
            if (self hasnt general) {
                give self general;
                move BottleA to Bench;
                move Retort to Bench;
                print "^Você realmente encontra alguns itens de equipamento \
                    equipamento: uma garrafa e um retorto.^";
            }
        ];
