! 9.1 THE GARDENS
!------------------------------------------------------------------------------

Object  Gardens "Jardins da Faculdade"
 has    light is_garden cat_allowed
 with   name "sward" "emerald" "emerald-green" "green" "grass" "lawn"
            "river" "line" "tall" "trees" "honeysuckle" "bee" "bees"
             "tree" "path" "window" "jardim" "jardins" "grama" "gramado"
              "relva" "esmeralda" "verde" "rio" "linha" "alto" "alta"
              "árvore" "árvores" "trilha" "caminho" "janela",
        description [;
            if (ClockTower.number < 20) 
                 "Uma longa extensão de grama verde-esmeralda se estende a \
                 nordeste por talvez cento e cinquenta metros, até encontrar \
                 uma fileira de árvores altas. Um portão leva a sudoeste, ao \
                 Segundo Pátio, com um grupo de arbustos por perto.^^Você \
                 respira fundo e sente o perfume da madressilva e da grama \
                 recém-cortada.";
             "À luz da lua, os jardins são escuros e misteriosos, cheios mais \
             de sons e cheiros que de formas. Você ouve o murmúrio suave de um \
             rio um pouco a leste. Uma trilha segue para nordeste, e um portão \
             leva a sudoeste, ao Segundo Pátio.";
        ],
        sw_to GardenGate,
         e_to "Seu caminho está bloqueado por um canteiro de rosas.",
        ne_to Arboretum,
        nw_to Bushes,
        before [;
          Listen: "Ao longe, você ouve o zumbido satisfeito das abelhas.";
          Smell: "Você respira fundo e sente o perfume da madressilva e da \
             grama recém-cortada.";
        ],
        edward_dirs sw_obj ne_obj;

Nearby  BedOfRoses "canteiro de rosas"
 has    scenery
  with   name "bed" "of" "rose" "roses" "rose-bush" "rose-bushes"
             "canteiro" "rosa" "rosas" "roseira" "roseiras",
         description "As flores são esplêndidas, mas os espinhos afiados e os \
             caules entrelaçados das roseiras formam uma barreira eficaz a \
             leste.",
        before [;
         SmellThing: 
            quote = 21;
             "Uma rosa teria o mesmo perfume, qualquer que fosse seu nome.";
        ];

Nearby  Bushes "arbustos"
 has    scenery door open
  with   name "bush" "bushes" "hedge" "stand" "dwarf" "conifer" "conifers"
             "arbusto" "arbustos" "sebe" "anões" "anã" "conífera" "coníferas",
         description "Esta fileira de coníferas anãs forma uma sebe a noroeste.",
        door_to OutsideShed,
        door_dir nw_to;

Object  GardenGate "portão de ferro forjado"
 has    door scenery locked lockable openable autoopen
  with   name "gate" "garden" "gardens" "wrought" "iron" "spikes"
              "portão" "jardim" "jardins" "ferro" "forjado" "espigões" "pontas",
         description "O portão dos jardins é alto, feito de barras de ferro \
             forjado. No centro há um baixo-relevo de uma cabeça de leão.",
        found_in Gardens SecondCourt,
        add_to_scope LionsHead,
        door_dir [;
            if (self in Gardens) return sw_to;
            return ne_to;
        ],
        door_to [;
            if (self in Gardens) return SecondCourt;
            return Gardens;
        ],
        with_key GardenGateKey,     
        before [;
         Search: 
            if (self in SecondCourt)
                 "Através do portão você distingue o verde dos jardins do \
                  faculdade.";
             "Através do portão você distingue as pedras do Segundo Pátio.";
          Climb: "Os espigões no alto do portão fazem você desistir.";
        ],
        after [;
         Lock:
            give self ~locked;
             "A fechadura está muito dura e, por mais força que você faça na \
             chave, não consegue fazê-la girar.";
          Unlock: "A fechadura está muito dura e parece estar enferrujando, \
             mas com grande esforço você consegue girar a chave e destrancar \
             o portão.";
        ];

Object  LionsHead "cabeça de leão"
 has    static concealed
  with   name "lion" "lion^s" "head" "bas" "relief" "bas-relief" "grin"
             "toothy" "mouth" "leão" "cabeça" "baixo-relevo" "sorriso"
             "dentes" "boca",
         description "Se estivesse viva, seria assustadora, com a boca aberta \
             num sorriso cheio de dentes.";

Object  OutsideShed "Do lado de fora do galpão de jardim"
 has    light is_garden cat_allowed
  with   name "path" "bush" "bushes" "latch" "caminho" "arbusto" "arbustos"
              "trava" "galpão" "abrigo",
         description "É um caminho estreito ao sul de um pequeno galpão de \
             jardim. Uma fileira de arbustos o esconde do restante dos jardins, \
             mas você poderia passar por eles de volta a sudeste.",
        se_to Gardens,
        n_to ShedDoor,
        in_to ShedDoor,
        out_to Gardens,
         cant_go "Você poderia passar pelos arbustos a sudeste, ou tentar entrar \
             no galpão ao norte.",
        edward_dirs se_obj;

Nearby  Shed "galpão de jardim"
 has    static concealed
  with   name "garden" "shed" "jardim" "galpão",
        before [;
         Enter: <<Enter ShedDoor>>;
        ];

Nearby  ShedDoor "porta"
 has    scenery door locked lockable openable autoopen
  with   name "door" "hinge" "porta" "dobradiça",
        description [;
            if (self hasnt open)
                 "A porta do galpão está bem fechada, exceto por uma fresta muito \
                 estreita no lado oposto à dobradiça.";
        ],
        door_to InsideShed,
        door_dir n_to,
        before [;
          Lock,Unlock: "Não há fechadura!";
         Open:
            if (self hasnt open)
                 "Parece presa por alguma trava, mas não há fechadura.";
        ],
        after [;
         Close: 
            give self locked;
            move Crack to OutsideShed;
             "^Com um clique, a trava se fecha.";
        ];

Nearby  Crack "fresta"
 has    static concealed
  with   name "narrow" "crack" "estreita" "fresta",
        before [;
          Search: "Você espia pela fresta, mas está escuro dentro do galpão.";
         Receive:
            if (noun.size > 0)
                 "A fresta é estreita demais.";
            give ShedDoor open ~locked;
            remove self;
            Achieved("opening the garden shed");
             print_ret "Você empurra ", (the) noun, " pela fresta e o desliza \
                 suavemente para cima. A trava cede, e você abre a porta, \
                 orgulhosa de sua habilidade de arrombadora.";
        ];

Object  InsideShed "Galpão de jardim"
 has    light is_garden cat_allowed
  with   name "shed" "wood" "garden" "door" "peg" "galpão" "madeira"
              "jardim" "porta" "gancho" "abrigo",
         description "Este galpão de madeira é onde os jardineiros da faculdade \
             fazem pausas para o chá e se abrigam da chuva. Agora está vazio. \
             Uma porta leva ao sul.",
        initial [;
            DoneHint(WhatNextPuzzle,15);
        ],
        s_to OutsideShed,
        out_to OutsideShed,
         cant_go "A única saída é ao sul.",
        before [;
          Smell: "O cheiro de tabaco velho é forte.";
        ],
        edward_dirs s_obj;

Nearby  GardenGateKey "chave de aço"
 class  KeyClass
  with   name "steel" "aço" "chave",
         initial "Uma chave de aço está pendurada num gancho.";

Nearby  Veil "véu de apicultor"
 class  FlimsyClass
 has    clothing
  with   name "bee-keeper" "beekeeper" "veil" "net" "hat" "apicultor"
              "apicultora" "véu" "rede" "chapéu" "tela",
         description "O véu consiste num chapéu de lona de abas largas, do qual \
             pende uma rede fechada que se ajusta ao pescoço de quem o usa.",
        describe [;
            if (self notin InsideShed) rfalse;
            if (Turmeric in InsideShed) rtrue;
             "^Um apicultor deixou seu véu no chão.";
        ],
        before [;
         Take,Remove:
            if (Turmeric in InsideShed) <<Attack Turmeric>>;
         Attack,Cut:
            if (self notin player)
                 "Você precisa estar carregando o véu antes de tentar rasgá-lo.";
            move Hat to parent(self);
            remove self;
            quote = 1;
             "Você rasga a rede do véu do apicultor, obtendo um chapéu feio, \
             mas prático.";
        ],
        after [;
         Wear: quote = 13;
        ],
        each_turn [;
            if (self has worn && location hasnt is_garden) {
                 print "^Você percebe de repente que parece muito boba usando o \
                     véu do apicultor, e o tira.^";
                keep_silent = 1; <Disrobe self>; keep_silent = 0;
            }
        ];

Object  Hat "chapéu"
 class  FlimsyClass
 has    clothing
  with   name "hat" "canvas" "chapéu" "lona",
         description "Um chapéu de lona mole e abas largas. Não é elegante, mas \
             protegerá você do sol.";

Object  WestBank "Pelo rio, na margem oeste"
 has    light is_garden is_water cat_allowed
  with   name "tree" "trees" "grass" "path" "lawn" "fish" "árvore"
             "árvores" "grama" "caminho" "peixe" "peixes",
        description [;
             print "Aqui, o gramado desce até a margem do rio, que flui \
                 preguiçosamente de sul para norte";
            if (ClockTower.number < 20)
                 " como se tivesse ficado indolente com o calor do verão. Uma \
                 trilha leva ao norte, até uma fileira de árvores.";
             ", brilhando ao luar. Uma trilha segue para o norte, noite adentro.";
        ],
        n_to Arboretum,
         e_to "Se pretende nadar, diga isso!",
         se_to "Se pretende nadar, diga isso!",
         ne_to "Se pretende nadar, diga isso!",
         cant_go "Você pode se aproximar das árvores ao norte, ou tentar \
             atravessar o rio a leste.",
        before [;
          Listen: "Você ouve o zumbido das abelhas vindo do leste.";
         Swim: <<Enter River>>;
         Enter:
            if (noun in compass)
                <<Go noun>>;
        ],
        edward_dirs n_obj;

Nearby  Punt "barco chato"
 has    static enterable transparent container open
   with   name "punt" "boat" "barco" "canoa" "embarcação",
         initial "Um barco chato flutua junto à margem.",
         description "Um barco chato de madeira, com cerca de cinco metros \
             de comprimento e um metro de largura. Ele é impulsionado em rios \
             rasos e lentos com a ajuda de uma vara comprida.",
        before [;
         Go:
            if ((self in WestBank && noun == sw_obj or w_obj or nw_obj)
                || (self in EastBank && noun == se_obj or e_obj or ne_obj))
                rfalse;
            if (PuntPole notin player)
                 print "Mas você não tem uma vara para impulsionar o barco.^";
            else {
                DoneHint(WhatNextPuzzle,16);
                 print "Você se afasta cuidadosamente da margem, e ";
                switch(random(3)) {
                  1: print "o barco gira quando a corrente o alcança. Você \
                     se atrapalha com a vara na água, tentando recolocar a \
                     embarcação no rumo certo, mas vira demais e, antes que \
                     perceba, está de volta à margem de onde partiu. Como esses \
                     barcos são irritantes!^";
                  2: print "então apoia todo o seu peso na vara. O barco dá um \
                     solavanco para a frente, seus pés escorregam na madeira \
                     molhada e você perde o equilíbrio, quase caindo na água. \
                     Agitando os braços, recupera a compostura, mas a corrente \
                     já o girou e você voltou à margem de onde partiu. Que barco \
                     perigoso!^";
                  3: print "finca a vara com firmeza no fundo do rio. Você dá um \
                     grande empurrão, mas a vara fica presa na lama, e seus braços \
                     quase são arrancados das articulações quando o barco para. \
                     Com algum esforço, você consegue tirar a vara do fundo do rio, \
                     mas não avançou nada.^";
                }
            }
            stop_library = 1;
            ! return false.
         Push:
            if (player notin self)
                 "Você empurra o barco para longe da margem, mas a corrente \
                 o agarra e lentamente o traz de volta.";
             "[Para tentar impulsionar o barco, basta digitar ~vá para leste~ \
             (ou a direção que preferir)]";
        ],
        after [;
          Enter: "O barco balança de modo alarmante, e é por pura sorte que você \
             não pisa na bainha da saia e cai no rio.";
        ];          

Object  PuntPole "vara" Punt
   with   name "pole" "vara" "bastão",
         description "A vara é enorme, talvez com quatro metros, e muito pesada. \
             Você sempre acha surpreendente que alguém escolha um objeto tão \
             bizarro como meio de propulsão.",
        size 4,
        before [;
          ThrowAt: "É pesado demais.";
         Take,Remove:
            if (self in player) rfalse;
            if (NCarried(player) > 0)
                 "São necessárias duas mãos para levantar a vara, e você está \
                 carregando coisas demais.";
            if (player notin Punt)
                 "Não faz sentido carregar a vara se você não está no barco.";
        ],
        each_turn [;
            if (self in player) {
                if (NCarried(player) > 1) {
                    move self to Punt;
                     "^Você tem dificuldade para segurar tudo o que carrega, \
                     então larga a vara.";
                }
                if (player notin Punt) {
                    move self to Punt;
                     "^Você deixa a vara no barco para a próxima pessoa que \
                     passar por aqui.";
                }
            }
            else if (parent(self) ~= Punt or Edward) 
                 "^** Erro: a vara está no lugar errado **";
        ];

Object  River "rio"
 has    scenery
   with   name "river" "water" "rio" "água" "correnteza",
        description [;
             print "O rio tem talvez vinte e cinco metros de uma margem à \
                 outra e flui suavemente de sul para norte. Você passa a mão \
                 pela água fresca e cristalina e observa a ";
            if (ClockTower.number < 20)
                 "luz do sol se espalhar pelas ondulações. As formas alaranjadas, \
                 quase invisíveis sob a superfície, podem ser peixes, ou apenas \
                 truques da luz.";
             "luz da lua se espalhar pelas ondulações.";
        ],
        found_in WestBank EastBank,
        before [;
          Enter: "Se você tivesse roupa de banho, uma toalha e menos coisas \
             importantes para fazer, poderia nadar. Mas não agora.";
         Receive:
            if (noun hasnt is_vessel) 
             "Você não quer perder coisas no rio, quer?";
            <<FillWith noun self>>;
         ThrownAt:
             "Você não quer perder coisas no rio, quer?";
         EmptyT: <<FillWith second self>>;
         Drink:
            if (WaterStore has general)
                 "Você não está com sede no momento.";
            give WaterStore general;
             "Você recolhe água com as mãos e a bebe avidamente.";
        ];

 Object  Arboretum "Arboreto"
 has    light is_garden cat_allowed
  with   name "arboretum" "arbor" "blossom" "petal" "petals" "path"
              "arboreto" "arborizado" "flor" "flores" "pétala" "pétalas" "trilha" "caminho",
        description [;
            if (ClockTower.number < 20) 
                 print "Esta fileira de árvores oferece alívio ao brilho do sol. \
                     A floração está chegando ao fim, e as flores caem no chão.^^";
            else
                 print "Feixes de luar salpicam o chão sob esta fileira de árvores. ";
             "Em uma das extremidades da fileira está a árvore mais alta de todas, \
             um olmo antigo e altivo.";
        ],
        other_obj EastBank,
        sw_to Gardens,
        s_to WestBank,
         u_to "As árvores são altas demais para subir, e você ainda rasgaria o \
             vestido.",
         cant_go "Você poderia caminhar para sudoeste, até um gramado amplo, ou \
             seguir uma trilha ao sul, em direção ao rio.",
        edward_dirs sw_obj;

Class   TreeClass
 has    scenery
  with   name "tree" "branch" "branches" "trunk" "leaf" "leaves" "árvore"
             "galho" "galhos" "tronco" "folha" "folhas",
        before [;
         Enter,Climb:
            print_ret (string) self.cant_go;
         Push:
            if (ParrotB in parent(self)) <<Invoke ParrotB>>;
        ];

Nearby  ElmTree "olmo"
 class  TreeClass
   with   name "elm" "olmo" "ulmeiro",
         cant_go "Os galhos mais baixos estão muito acima do seu alcance.";

Nearby  ParrotB "papagaio"
 class  TalkableClass
 has    animate
  with   name "grey" "parrot" "bird" "polly" "cinza" "papagaio" "pássaro",
         description "Um pássaro cinza olha para você do poleiro na árvore. De \
             vez em quando, ele pula um passo para a esquerda ou para a direita.",
        describe [;
            if (self in Arboretum)
                 "^Um papagaio pousa num galho alto do olmo.";
             "^Um papagaio está meio escondido entre os galhos do laburno.";
        ],
        life [;
         Kiss,Attack,Give,Show:
            <<Take self>>;
         ThrowAt:
            move noun to parent(self);
             if (self.state > 0) "Seu arremesso sai errado, e você mal roça os \
                 galhos baixos da árvore.";
            <<Invoke self>>;
        ],
        state 0,
        before [ i j;
          Speak: "O papagaio não dá atenção a você.";
         Examine,ThrownAt: rfalse;
          Follow: "Agora você vai me dizer que sabe voar!";
         Invoke:
            i = parent(self);
            j = i.other_obj;
	    if (self.state ~= 0)
		"O papagaio se assusta com seu ataque e, com um guincho alto, salta do \
		poleiro, dá uma volta ao redor da árvore e pousa novamente no galho.";
            MoveNPC(self,j,u_obj);
            if (Edward in i) {
                if (i == Arboretum) self.state = 1;
                else self.state = 9;
            }
            else self.state = 20;
            StartDaemon(self);
            print "O papagaio se assusta com seu ataque e, com um guincho alto, \
                 salta do poleiro e voa rapidamente para o ";
            if (i == Arboretum) "sudeste.";
            "noroeste.";
         default: "O papagaio está a nove metros acima da sua cabeça. Fora isso, \
             foi uma boa tentativa.";
        ],
        daemon [ i;
            self.state = self.state + 1;
            switch (self.state) {
             2,10:
                if (Edward in location)
                    print "^Edward observa o papagaio desaparecer com uma \
                        expressão de desânimo. ~Volte, Polly~, ele chama.^";
                if (Edward in Arboretum)
                    MovePrintNPC(Edward,WestBank,s_obj);
             3,11:
                if (parent(Punt) ~= parent(Edward)) 
                    print "^** Error: punt in the wrong place **^";
                MoveNPC(Edward, Punt, Punt);
                if (Punt in location)
                    "^Edward entra no barco.";
             4,12:
                i = parent(PuntPole);
                move PuntPole to Edward;
                if (Punt in location) {
                    if (i == Punt)
                        "^Edward pega a vara do barco.";
                    if (i ~= player)
                        print "^** Error: pole in wrong place **^";
                    "^~Dê-me a vara do barco~, ordena Edward, e, para sua \
                     surpresa, você obedece.";
                }
             5,13:
                if (Punt in location)
                    "^Edward finca a vara no leito do rio e se prepara para partir.";
             6,14:
                if (Punt in location) {
                    print "^Com aparente facilidade, Edward se afasta da margem, \
                        impulsiona o barco para o rio e segue ";
                    if (location == EastBank) print "rio abaixo";
                    else print "rio acima";
                    if (player in Punt) {
                        print " por cerca de um minuto. Com uma última manobra \
                            graciosa, ele encosta o barco na margem ";
                        if (location == EastBank) print "oeste";
                        else print "leste";
                        print ".^";
                        Achieved("crossing the river");
                        AdvanceTime(self);
                        DoneHint(WhatNextPuzzle,16,17);
                    }
                    else
                         print ", até desaparecer de vista depois de uma curva.^";
                }
                if (Punt in EastBank) move Punt to WestBank;
                else move Punt to EastBank;
                if (player in Punt)
                    PlayerTo(Punt);
                else if (Punt in location)
                    "^Um barco contorna uma curva do rio, conduzido por Edward. \
                     Ele guia a embarcação diretamente até você e, com uma última \
                     manobra graciosa, encosta o barco na margem.";
             7,15:
                move PuntPole to Punt;
                MoveNPC(Edward,parent(Punt),out_obj);
                if (Edward in location)
                    "^Edward deixa a vara no chão e sai do barco.";
             16:
                MovePrintNPC(Edward,Arboretum,n_obj);
             8,17:
                if (Edward in location)
                    print "^Edward olha tristemente para o papagaio. ~Venha aqui, \
                        Polly~, ele chama, embora sem muita convicção de que será \
                        obedecido.^";
                if (location == EastBank or BeeLoudGlade or EarthenPath)
                    i = EastBank;
                else i = Arboretum;
                if (Edward in i) {
                    self.state = 0;
                    StopDaemon(self);
                }
             9,18,24:
                if (self in location)
                    print "^Algo parece ter perturbado o papagaio, pois ele de \
                        repente dá um guincho alto e alça voo, desaparecendo \
                        rapidamente de vista.^";
                MoveNPC(self,(parent(self)).other_obj,u_obj);
                if (self in location) {
                    print "^Você ouve um guincho acima e, olhando para cima, vê um \
                        papagaio cinza pousar em ";
                    if (location == Arboretum) DefArt(ElmTree);
                    else DefArt(Laburnum);
                    print ".^";
                }
                if (self.state == 18) self.state = 1;
                if (self.state == 24) {
                    self.state = 0;
                    StopDaemon(self);
                }
            }
        ],
        each_turn [;
            switch (random(10)) {
              1: "^O papagaio grasna alto.";
              2: "^O papagaio guincha alto.";
            }
        ];

Object  Trees "árvores"
 has    static concealed
  with   name "trees" "árvores",
        found_in Arboretum BeeLoudGlade EarthenPath,
        before [;
          Climb: "São altas demais para subir, e você ainda rasgaria o vestido.";
        ];

Object  EastBank "Pelo rio, na margem leste"
 has    light is_garden is_water
  with   name "trees" "grass" "grassy" "meadow" "hive" "beehive" "bee-hive"
             "fish" "árvores" "grama" "prado" "colmeia" "peixe" "peixes",
         description "Um prado gramado desce até a margem oeste do rio, que \
             flui preguiçosamente de sul para norte, como se tivesse ficado \
             indolente com o calor do verão.^^Um laburno alto fica junto ao rio, \
             deixando suas flores amarelas penderem sobre a água, e uma trilha \
             sobe em direção a algumas árvores a sudeste.",
        other_obj Arboretum,
         w_to "Se pretende nadar, diga isso!",
        se_to BeeLoudGlade,
        before [;
          Listen: "Você ouve o zumbido das abelhas.";
         Swim: <<Enter River>>;
         Enter:
            if (noun in compass)
                <<Go noun>>;
        ];

Nearby  Laburnum "laburno"
 class  TreeClass
  with   name "laburnum" "laburno",
         cant_go "A profusão de galhos torna impossível subir no laburno sem \
             rasgar suas roupas em farrapos.";

Object  Bees "abelhas"
 has    scenery
  with   name "bee" "bees" "honeybee" "honeybees" "honey-bee" "swarm" "of"
             "abelha" "abelhas" "enxame",
        found_in EastBank BeeLoudGlade EarthenPath,
        before [;
          Take,Remove,Touch: "Isso é perigoso demais para você sequer pensar!";
        ];

Object  BeeLoudGlade "Clareira zumbindo de abelhas"
 has    light is_garden no_edward
        ! general if a hive has been opened
  with   name "glade" "earth" "earthen" "path" "river" "label" "clareira"
             "terra" "trilha" "rio" "placa",
         description "Uma clareira ensolarada protegida por árvores. O ar parece \
             cheio de abelhas, e o zumbido delas é alto em seus ouvidos. Você \
             poderia sair da clareira em direção ao rio, a noroeste, ou seguir \
             uma trilha de terra pela mata ao sul.^^Há três colmeias na clareira: \
             a primeira no canto nordeste, ao lado de uma árvore alta; a segunda \
             no canto sudeste, à sombra de uma árvore de flores cor-de-rosa; e a \
             terceira no lado oeste, perto de um arbusto de flores brancas.",
        nw_to EastBank,
        out_to EastBank,
        s_to EarthenPath,
        before [;
          Listen: "O zumbido é alto em seus ouvidos.";
        ],
        each_turn [;
            if (Veil hasnt worn) {
                print "^Você nunca foi muito corajosa com insetos que picam, e a \
                     visão de tantas criaturas desagradáveis voando diante do seu \
                     nariz é demais para você. Decide que é melhor ser prudente e \
                     recua.^";
                PlayerTo(EastBank,1);
                LookSub(1);
            }
        ];

Nearby  PersimmonTree "árvore alta"
 class  TreeClass
  with   name "persimmon" "tall" "diospyros" "virginiana" "caqui" "alta",
         description "Uma árvore alta, talvez com quinze metros de altura e \
             sessenta centímetros de diâmetro, com folhas verde-escuras em forma \
             de coração. Uma placa presa ao tronco diz ~Diospyros virginiana~.",
         cant_go "Os galhos mais baixos estão fora do seu alcance.";

Nearby  TamariskTree "arbusto de flores brancas"
 class  TreeClass
  with   name "thorny" "shrub" "tamarix" "africana" "tamarisk" "white"
             "flowering" "flower" "white-flowering" "flowers" "label"
             "espinhoso" "arbusto" "branco" "flor" "flores" "placa",
         description "Com talvez cinco metros de altura, este arbusto tem folhas \
             pequenas e estreitas, e minúsculas flores brancas agrupadas em longos \
             talos. Uma placa presa a um galho diz ~Tamarix africana~.",
         cant_go "As folhas são espinhosas demais para pensar em subir.";

Nearby  QuinceTree "árvore de flores cor-de-rosa"
 class  TreeClass
 with   name "pink" "flowering" "flower" "flowers" "pink-flowering"
             "cydonia" "oblonga" "quince" "rosa" "flor" "flores" "árvore",
         description "Uma árvore baixa, talvez com cinco metros de altura, com \
             uma massa compacta de galhos que carregam pequenas flores cor-de-rosa. \
             Uma placa presa ao tronco diz ~Cydonia oblonga~.",
         cant_go "Os galhos estão juntos demais para subir.";

Nearby  FakeHives "colmeias"
 has    scenery
  with   name "hives" "beehives" "bee-hives" "colmeias" "abelhas",
        before [;
             "Você deve dizer qual das três colmeias quer dizer.";
        ];

Class   HiveClass
 has    static container openable concealed
  with   name "hive" "ziggurat" "beehive" "bee-hive" "colmeia" "zigurate",
        description [;
             print_ret "A colmeia é um pouco mais alta que a cintura e tem o \
                 formato de um zigurate babilônico. Ela fica no lado ",
                  (PrintDirection) self.door_to, " da clareira, perto de ",
                 (the) self.other_obj, ".";
        ],
        before [;
         Open:
            if (self has open) rfalse;
            if (BeeLoudGlade has general)
                 "Você não acha que conseguiria fazer isso de novo.";
             print "Talvez você consiga abrir uma colmeia, mas duvida que tenha \
                 coragem para fazer isso mais de uma vez. Tem certeza de que quer \
                 continuar? -> ";
            if (YesOrNo() == 0) rtrue;
            give BeeLoudGlade general;
            move HoneyComb to self;
            new_line;
         Receive,Attack,Cut:
             "Provavelmente não é prudente incomodar as abelhas.";
        ];

Nearby  FirstHive "primeira colmeia"
 class  HiveClass
  with   name "first" "primeira",
        door_to ne_obj,
        other_obj PersimmonTree;

Nearby  SecondHive "segunda colmeia"
 class  HiveClass
  with   name "second" "segunda",
        door_to se_obj,
        other_obj QuinceTree;

Nearby  ThirdHive "terceira colmeia"
 class  HiveClass
  with   name "third" "terceira",
        door_to w_obj,
        other_obj TamariskTree;

Object  HoneyComb "favo de mel"
  with   name "honey" "comb" "honeycomb" "honey-comb" "mel" "favo",
         description "Escorrendo mel, mas coberto de dezenas de abelhas. Você \
             mal consegue suportar olhar para ele, quanto mais pensar em tocá-lo.",
        before [ i j;
         Take,Remove:
            j = FindOpenEmptyVessel();
            if (j == 0)
                "Não parece uma boa ideia; como você carregaria o mel? Se ao menos \
                 estivesse carregando uma garrafa vazia ou outro recipiente \
                 adequado...";
            move Honey to j;
            i = parent(self);
            give i ~open;
            if (i == ThirdHive) give Honey general;
            remove self;
             print_ret "Bem devagar, você enfia a mão na colmeia e pega o favo de \
                 mel (como gostaria de ter luvas de apicultor para combinar com \
                 seu véu!). Suspendendo o favo sobre ", (the) j, ", você consegue \
                 recolher algumas gotas de mel antes de não suportar mais, deixar \
                 o favo de volta na colmeia e fechá-la. Você passa alguns minutos \
                 escovando freneticamente as abelhas furiosas da mão, mas, por \
                 sorte, parece ter escapado sem ser picada. No entanto, não acha \
                 que tentará fazer isso de novo.";
        ];

Object  EarthenPath "Trilha de terra"
 has    light is_garden no_edward
  with   name "path" "earth" "earthen" "trilha" "terra",
         description "A parte mais remota dos jardins, uma estreita trilha de \
             terra que serpenteia entre árvores e termina junto a um imponente \
             muro de tijolos vermelhos.",
        before [;
          Listen: "Você ouve o zumbido das abelhas, mais alto ao norte.";
        ],
        n_to BeeLoudGlade;

Nearby  BirdTable "mesa para pássaros"
 has    supporter static
  with   name "bird" "table" "pássaro" "pássaros" "mesa",
         initial "Uma mesa para pássaros fica perto do muro.",
         description "Apesar de a primavera já estar bastante avançada, parece \
             que alguém ainda alimenta os pássaros.";

Class   PeanutClass
 class  PluralClass
 has    edible
  with   name "nut" "peanut" "noz" "amendoim",
         plural_name 'nozes' 'amendoins',
         plural "amendoins",
        size 1,
         description "Do tipo que é servido em tigelas em jantares enfadonhos e \
             que sempre acaba perdido no carpete ou sob as cadeiras, em vez de \
             ser comido.",
        before [;
         ThrowAt:
            if (second == ParrotB) {
                remove self;
                "O papagaio apanha o amendoim no ar e o come.";
            }
        ],
        after [;
         Eat:
            give WaterStore ~general;
             "Não foi uma refeição muito agradável, já que o amendoim provavelmente \
             ficou um ou dois dias na mesa para pássaros e tomou chuva. E agora \
             você está com sede.";
        ];

Object  Peanut1 "amendoim" BirdTable class PeanutClass;
Object  Peanut2 "amendoim" BirdTable class PeanutClass;
Object  Peanut3 "amendoim" BirdTable class PeanutClass;
Object  Peanut4 "amendoim" BirdTable class PeanutClass;
Object  Peanut5 "amendoim" BirdTable class PeanutClass;
Object  Peanut6 "amendoim" BirdTable class PeanutClass;
