[ DreamCantGo ;
    trigger_quotation(29);
    "Você flutua naquela direção, mas não avança nada.";
];

[ PremonitionStart ;
    move ghost_of_yourself to Premonition;
    ChangePlayer(ghost_of_yourself);
    PlayerTo(Premonition);
    rtrue;
];

Object ghost_of_yourself "seu próprio fantasma"
  with  before [;
            Sleep: "No sonho você não está sonolento.";
            Wake:
                if( game_section == T_DREAMING )
                    "Você não consegue se livrar do sonho.";
                else
                    "Não parece ser tão fácil.";
            Attack:
                if( game_section == T_DREAMING )
                    rfalse;
                print "Ai! Você acorda, sentindo dor.^";
                ChangePlayer(selfobj);
                <<Look>>;
            Go, Take, Drop, Look, Inv, Wait: rfalse;
            default:
                if( game_section == T_DREAMING ) "Você parece incapaz de se concentrar o suficiente.";
                rfalse;
        ],
        description "Você é transparente como um fantasma.",
        time_left 0,
        capacity 1,
  has   ;

Object Premonition "Premonição"
  with  e_to [;
            print "Você atravessa desconfortavelmente a parede de couro.^";
            return The_Generals_Tent;
        ],
        sw_to Camp_Fire,
        description "É uma noite clara e gélida, mas há um cheiro de fogueiras queimando ao longe. Você atravessa a paisagem como um fantasma, e tudo parece vagamente irreal. A leste há um lado de uma tenda de couro de animal, mas não há entrada por aqui. A sudoeste, alguns soldados se sentam ao redor das brasas de uma fogueira. Há uma terrível sensação de que algo está prestes a acontecer.",
        cant_go DreamCantGo,
        section T_DREAMING,
  has   light;

Object The_Generals_Tent "A Tenda do General"
  with  n_to Beside_Table,
        w_to [;
            print "Você atravessa desconfortavelmente de volta pela parede de couro.^";
            return Premonition;
        ],
        description "Esta é a tenda de um homem magro e esguio, sem uniforme, mas com uma presença óbvia e imponente. Ele tem um nariz aquilino e patrício e, com um metro e sessenta e dois, é mais alto que todos os demais presentes. Os outros são conselheiros, oficiais subalternos, políticos conspiradores e gente assim. Eles mantêm distância de uma mesa de cavaletes na extremidade norte da tenda.",
        cant_go DreamCantGo,
        section T_DREAMING,
  has   light;

Object Beside_Table "Santuário do Urso"
  with  s_to The_Generals_Tent,
        description "Este é um tipo de santuário improvisado. Uma mesa de cavaletes sustenta vísceras, desenhos grosseiros feitos em couro e animais enjaulados; ao lado dela está pendurada uma tapeçaria primitiva de um urso erguido sobre as patas traseiras.",
        cant_go DreamCantGo,
        section T_DREAMING,
  has   light;

Object -> bear_tapestry "tapeçaria de urso"
  with  name 'bear' 'tapestry',
        life [;
            Order, Ask, Answer: "Sua boca está peluda demais para falar.";
        ],
         description "Primitiva, bestial, aterrorizante.",
  has   scenery talkable;

Object -> heavy_iron_mascot "mascote de ferro pesado"
  with  name 'heavy' 'iron' 'mascot',
        before [;
            Give: "Isso realmente não seria muito gentil.";
        ],
        after [;
            Take:
                if( Beside_Table hasnt general ) {
                    give Beside_Table general;
                    remove Druid;
                    "A Druida vê sua mão fantasmagórica pegando o mascote e imediatamente começa seus ocultamentos, amaldiçoando você e seus ganhos ilícitos. Mas é incapaz de tocar você e se volta furiosa para a tapeçaria, sibilando ~lagach~ para o Urso. De repente, um redemoinho de vento parece puxá-la para dentro do tecido áspero, dissolvendo-a em nada.";
                }
                rfalse;
        ],
        initial "Sobre a mesa há um mascote pesado de ferro, de algum tipo.",
        description "O mascote tem a forma de um ankh, com um símbolo de lemniscata (ou infinito) moldado nele.",
        number 0,
        daemon [ i;
            if( heavy_iron_mascot notin player ) rfalse;
            i = self.number - 1;
            self.number = i;
            if( i == 0 ) {
                deadflag = DIED;
                print "^Num acidente extraordinariamente estranho, ";
                switch( random(5) ) {
                    1: "um meteorito atravessa a atmosfera terrestre e depois atravessa diretamente sua cabeça. Qualquer um pensaria que você está amaldiçoado (qualquer um que ainda consiga pensar).";
                    2: "um terremoto destrói tudo na vizinhança e engole você numa fenda no chão. Qualquer um pensaria que você está amaldiçoado.";
                    3: "um vulcão há muito adormecido entra instantaneamente em erupção sob seus pés. Qualquer um pensaria que você está amaldiçoado (qualquer um que ainda esteja de pé).";
                    4: "um raio atinge abruptamente seu corpo, arrepiando seus cabelos. (Ah, e vaporizando você por completo, é claro.)";
                    5: "quatrocentos soldados espartanos são transportados, por um acaso da mecânica quântica, da Batalha das Termópilas para bem perto de você. Eles querem muito que alguém lhes explique as coisas, mas infelizmente a maioria das lanças que arremessavam veio junto; uma delas atravessou diretamente o mascote e atingiu seu corpo.";
                }
            }
            if( i == 10 ) "^Você se sente muito nervoso, por alguma razão.";
            if( i == 7 ) {
                if( player notin servants_bed ) {
                    "^Você bate o dedo do pé com força e tropeça.";
                } else {
                    "^Você sente que estão surgindo escaras.";
                }
            }
            if( i == 5 ) "^Você se coça, incapaz de se livrar da sensação de comichão.";
            if( i == 2 ) "^Algo está muito errado. Sua mão começa a queimar.^";
        ],
        devil_hint "Uma necessidade absoluta.",
  has   ;

Object -> Druid "Druida"
  with  name 'druid' 'druidess',
        life [;
            Order, Ask, Answer: "Este é um daqueles sonhos em que você descobre que não consegue falar.";
        ],
        initial "Ao lado da mesa está uma conselheira mais importante, como se ela também caminhasse neste estranho plano espiritual. Ela veste trajes druídicos assustadores, feitos de peles estranhas, com amuletos de aparência desagradável ao redor do pescoço. De vez em quando parece avistar você pelo canto do olho, mas então olha em volta e não vê nada. Os militares não acreditam no poder dela, mas... tratam-na com respeito.",
  has   animate proper;

Object Camp_Fire "Fogueira"
  with  e_to Near_Dolmen,
        ne_to Premonition,
        description "Quase é possível sentir o cheiro do medo aqui. Um pelotão heterogêneo de soldados está sentado ao redor das brasas de uma fogueira. Ninguém conversa ou dorme, e o falso bom humor da noite desapareceu. Ao amanhecer, você percebe, haverá uma batalha. Não é um risco que você gostaria de correr no lugar deles. E já há uma luz estranha no leste... ainda não é alvorada, pois os soldados parecem não perceber.",
        cant_go DreamCantGo,
        section T_DREAMING,
  has   light;

Object Near_Dolmen "Perto do Dólmen"
  with  after [;
            Look:
                ChangePlayer(selfobj);
                if( heavy_iron_mascot in ghost_of_yourself ) {
                    move heavy_iron_mascot to player;
                    StartDaemon(heavy_iron_mascot);
                    heavy_iron_mascot.number = 15;
                    Achieved(SCORE_MASCOT);
                    score = score - 50;
                }
                "^Você desperta, tremendo de pavor.";
        ],
        description "Uma pedra erguida, talvez um bloco errático glacial, está aqui; sobre ela há uma pedra azul brilhante, cuja luminosidade quase cega você. Você se sente irresistivelmente atraído por ela, e sua mão se estende...",
        cant_go DreamCantGo,
        section T_DREAMING,
  has   light;

Object Melancholy_Dream "Sonho Melancólico"
  with  e_to nothing,
        d_to nothing,
        description "Uma passagem empoeirada e estranhamente familiar, descendo de uma extremidade sul banhada por luz hostil até algum tipo de barreira metálica ao norte.",
        cant_go DreamCantGo,
        each_turn [;
            ++DreamCnt;
            if( DreamCnt ~= 2 ) rfalse;
            move green_luminescence to Melancholy_Dream;
            Melancholy_Dream.e_to = Solid_Sand;
            Melancholy_Dream.d_to = Solid_Sand;
            "^A aparição fantasmagórica de um homem venerável surge na névoa. Ele ergue seu cajado de mogno e bate com ele (silenciosamente) no chão, depois aponta para as paredes, e de repente uma rajada de luminescência verde corre ao seu redor!^^Ele desaparece novamente, murmurando algo incoerente.";

        ],
        section (T_DREAMING|T_UNREAL),
  has   light;

Object -> metal_barrier "barreira metálica"
  with  name 'metal' 'barrier',
         before [; "A barreira metálica é indistinta, no limite da sua consciência, e você não consegue se aproximar. Por mais familiar que pareça."; ],
  has   scenery;

Object green_luminescence "flocos de luminescência verde"
  with  name 'green' 'flurries' 'of' 'luminesce',
        before [;
            Take, Remove, Touch:
                "Você golpeia os flocos com a mão, mas eles são apenas luz verde (com uma picada minúscula de mosquito).";
        ],
        initial "Flocos de luminescência verde giram sem parar ao seu redor, de oeste para leste e por cima.",
        description "Os flocos têm um fascínio quase infinito... mas você consegue desviar os olhos depois de, ah, uma hora?",
  has   static;

Object Solid_Sand "Areia Sólida"
  with  e_to Octagonal_Tomb,
        w_to Melancholy_Dream,
        u_to Melancholy_Dream,
        d_to Octagonal_Tomb,
        description "Seu eu fantasmagórico está embutido num poço diagonal descendente (que desce para leste), inteiramente cheio de areia seca. Lajes sólidas revestem as paredes.",
        cant_go DreamCantGo,
        section (T_DREAMING|T_UNREAL),
  has   light;

Object Octagonal_Tomb "Túmulo Octogonal"
  with  name 'torch' 'torches' 'slab',
        w_to Solid_Sand,
        u_to Solid_Sand,
        description "Tochas flamejantes presas à parede se apagam enquanto o último oxigênio do ar é consumido, e o tremeluzir das chamas brinca sobre o esmalte amarelo-alaranjado das paredes do túmulo.^^Esta câmara octogonal é revestida de hieróglifos egípcios. A areia se espalha pelo chão, vinda de baixo da única entrada, selada por uma engenhosa laje de pedra.",
        cant_go DreamCantGo,
        section (T_DREAMING|T_UNREAL),
  has   light;

Object -> hieroglyphic_symbols "hieroglyphic symbols"
  with  name 'symbols' 'hieroglyphs' 'egyptian',
        description [;
            print "O olhar do seu sonho é atraído por...^^";
            0-->8 = 2 | 0-->8;
            print "       (|/        ^   #   -o-  >>>   ^       /|)        ^";
            0-->8 = 65533 & 0-->8;
            "^Confuso e enevoado, você sente que consegue entender os hieróglifos, ou isso ainda não aconteceu?";
        ],
        article "some",
  has   scenery;

Object -> ships_wheel "ship's wheel"
  with  name 'ships' 'wheel',
        before [;
            Turn:
                if( self has general ) "Suas mãos parecem incapazes de tocá-lo novamente.";
                give self general;
                give sandstone_recess open;
                "Você tenta girar o volante, mas ele se move com uma lentidão infinitesimal. A porta começa a subir uma fração mínima, e alguns grãos de areia descem em câmera lenta, chacoalhando horrivelmente uns contra os outros...^^Vai levar uma eternidade, e o ar está acabando...";
        ],
        initial "Uma espécie de roda de navio (de madeira com oito raios) está fixada à parede noroeste.",
  has   static;
