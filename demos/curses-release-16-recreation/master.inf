[ StartMasterGame o sib ;
    game_section = T_ANCIENT_BRITAIN;
    o = child(player);
    give daisy_chain ~worn;
    while( o ~= nothing ) {
        sib = sibling(o);
        give o ~worn;
        move o to Infinity_Symbol;
        o = sib;
    }
    move historical_pamphlet to player;
    PlayerTo(Murky_Cave);
    rtrue;
];

[ Capture o s ;
    if( CouncilCnt < 8 ) {
        deadflag = DIED;
        "^Os guardas seguram seu queixo e examinam você, mas tomam-no por um simples ladrão e imediatamente o matam à espada. Pena que não perceberam sua importância, mas são apenas guardas e, além disso, provavelmente teriam feito algo ainda mais desagradável.";
    }
    print "^De repente, você é levado diante de uma figura druídica. Ele parece reconhecê-lo e fica perturbado. 
        Talvez por isso sua vida seja poupada e você seja levado sob custódia, no vale entre os acampamentos do exército.^";

    StartTimer(tent_pole,4);
    for( o = child(player) : o ~= nothing : o = s ) {
        s = sibling(o);
        if( o hasnt worn ) 
            remove o;
        o = s;
    }
    CouncilCnt = 0;
    PlayerTo(Rough_Tent);
    rtrue;
];

Object Murky_Cave "Caverna sombria"  
  with  w_to Spur_of_Rock,
        ne_to Valley_Prospect,
        initial [; StartDaemon(self); ],
        description "Esta é uma caverna sombria na encosta, cuja entrada se abre a nordeste, embora um aperto possa 
            levar um pouco para oeste. Lá fora há uma noite límpida e estrelada. Não há barulho de trânsito, e o ar
            cheira a fresco.",
        daemon [ cnt;
            if( game_section ~= T_ANCIENT_BRITAIN ) 
                StopDaemon(self);
            cnt = CouncilCnt;
            if( cnt > 0 ) 
                ++CouncilCnt;

            ! I don't think the following is ever printed:
            if( cnt == 1 ) "^Do alto da colina você ouve o toque de uma trompa.";
            if( cnt == 2 ) "^Cavalos se aproximam da vila, descendo a colina.";
            if( cnt == 3 ) "^O som dos cavalos se aproxima.";
            if( cnt == 4 ) {
                if( location == Entrance ) {
                    print "^Cavaleiros de repente entram a galope no pátio e logo você está cercado por guardas!^";
                    Capture();
                } else {
                    "^Há definitivamente atividade do lado de fora da vila.";
                }
            }
            if( cnt >= 5 ) {
                if( location == Entrance ) {
                    print "^Você caminha direto para os guardas.^";
                    Capture();
                }
                if( location == Roman_Villa ) {
                    print "^Você caminha direto para os guardas na porta dos fundos.^";
                    Capture();
                }
            }
            if( cnt == 7 ) {
                print "^Há uma súbita agitação enquanto os guardas fazem uma busca preventiva minuciosa na vila. ";
                if( location == Hypocaust ) {
                    "Por sorte, eles nem pensam em olhar aqui embaixo.";
                }
                if( location == Inside_Well ) {
                    print "Unfortunately, they do think of looking into the kitchen well, and drag you out onto the 
                        triclinium floor.^";
                }
                if( location == Murky_Cave or Spur_of_Rock or Hanging_on_Rope ) 
                    print "Com o tipo de zelo que marcou a guarda no início da Idade das Trevas, eles olham até aqui.^";
                else if( location ~= Inside_Well )
                    print "A utilidade disso fica demonstrada quando encontram você sem dificuldade.^";
                Capture();
            }
            if( cnt <= 7 ) 
                rfalse;

            if( location == Triclinium ) {
                print "^Um escravo de aparência diligente (que cozinha para os cavaleiros) fica bastante surpreso ao ver você, mas, com louvável presença de espírito, chama o guarda imediatamente.^";
                Capture();
            }
            if( location ~= Hypocaust ) 
                rfalse;
            if( cnt == 8 ) 
                "^Você ouve homens caminhando sobre o mosaico, logo acima de sua cabeça.";
            if( cnt == 9 ) {
                print "^Uma voz, que mal pode ser ouvida através da abertura, diz ";
                if( KnowLanguages == false ) {
                    "algo em anglo-saxão ou celta (difícil dizer qual).";
                }
                "~Welcome, great masters. We are convened in secret conclave to decide the fate of Britain. 
                 Lament, for the old ways are passing!  There will be a dark age, a collapse into many monarchies,
                 and any man who can hold a town will call himself King and heir to Vortigern.~";
            }
            if( cnt == 10 ) {
                print "^Uma voz mais jovem e impaciente diz ";
                if( KnowLanguages == false ) "outra coisa.";
                 "~Esta é uma oportunidade! Devemos ser o poder por trás dos tronos; em segredo, vamos nos unir e ser a verdadeira força da terra...~";
            }
            if( cnt == 11 ) {
                print "^Por um momento há uma risada cínica, e uma terceira voz interrompe ";
                if( KnowLanguages == false ) "alguma coisa.";
                 "~E quem liderará esta unidade? Tomamos todos os lados e nenhum, você sabe disso. Há druidas poderosos nas tendas de cada general naquela ralé. Eles se matariam assim que começasse a batalha.~";
            }
            if( cnt == 12 ) {
                print "^A primeira voz fala novamente. ";
                if( KnowLanguages == false ) {
                    new_line;
                    rtrue;
                }
                 "~Coisas muito piores virão. Os reis arrivistas e seus novos homens não acreditarão mais nos poderes antigos. Já sinto a magia druídica se enfraquecendo, e agora estamos perigosamente perto do nexo. Nos vales abaixo, exércitos aguardam a batalha decisiva. Qualquer lado que vença não precisará mais de nós. Em questão de horas, o poder será destruído para sempre.~";
            }
            if( cnt == 13 ) {
                print "^Depois de um silêncio sombrio, uma voz muito mais velha diz ";
                if( KnowLanguages == false ) "algo sábio. É realmente uma pena que você não consiga entendê-los.";
                 "~Você fez bem em nos reunir. Há um caminho preparado para nós, mas o sacrifício será terrível. Devemos concentrar toda a energia druídica restante nesta colina sagrada, para que ela dure por todo o tempo, e devemos garantir que druidas vivam neste local para sempre e mantenham a fé.~";
            }
            if( cnt == 14 ) {
                print "^A voz mais jovem fala novamente. ";
                if( KnowLanguages == false ) {
                    new_line;
                    rtrue;
                }
                 "~Por enquanto, sim, por um ou dois séculos, sim, mas e depois? Eles esquecerão os velhos costumes e não serão mais verdadeiramente druidas.~";
            }
            if( cnt == 15 ) {
                print "^A voz mais velha responde triunfalmente. ";
                if( KnowLanguages == false ) {
                    new_line;
                    rtrue;
                }
                 "~É isso que deve ser feito. Eles esquecerão, portanto devemos dar-lhes um substituto. Vamos amaldiçoá-los para que busquem sempre esta pedra mágica, que será quase impossível de encontrar. Ela assumirá a forma do que mais desejarem. Daqui a seiscentos anos, segundo minha profecia, guerras religiosas no Oriente conquistarão os corações dos homens, e então pensarão que ela é o Santo Graal, o cálice que guardou o sangue de Cristo. Mil anos depois pensarão que ela é...~ Mas, nesse momento, as vozes se afastam.";
            }
            rfalse;
        ],
        section T_ANCIENT_BRITAIN,
  has   ;

Object -> flaming_torch "tocha acesa" 
  with  name 'flaming' 'torch',
         initial "Pendurada em um suporte de ferro há uma tocha acesa.",
  has   light;

Object -> historical_pamphlet "folheto histórico"     
  with  name 'historical' 'pamphlet',
        sw_to n_obj,
        description "É um resumo dos escritos de um monge polêmico chamado Gildas e relata eventos posteriores à queda do tirano Vortigern na virada do século V d.C. Após décadas sombrias de pilhagem por mercenários saxões, a Bretanha foi reunida por Ambrósio Aureliano e depois defendida na Batalha do Monte Badon, em algum momento dos primeiros anos do século VI.^^Essa vitória extraordinária não teve significado religioso, portanto Gildas não se detém nela. Ele tende apenas a mencionar reis e líderes ruins, principalmente para insultá-los. (Falar de Gildas é uma excelente maneira de irritar um historiador anglo-saxão.) Ninguém sabe mais onde fica o Monte Badon, nem qualquer outra coisa sobre ele, embora alguns estudiosos da poesia galesa acreditem que Ambrósio foi a fonte da lenda do Rei Arthur.",
        article "an",
  has   ;

Object Spur_of_Rock "Afloramento rochoso"      
  with  e_to Murky_Cave,
        d_to Hanging_on_Rope,
        description "Um afloramento rochoso desconfortável nas escarpas da encosta. O único acesso natural a este lugar é uma fenda na colina a leste, mas também há uma corda bem presa que desce para a escuridão.",
        cant_go "As escarpas são íngremes demais.",
        section T_ANCIENT_BRITAIN,
  has   light;

Object -> hanging_rope "corda pendurada"   
  with  name 'hanging' 'rope',
        before [;
            Climb: << Go d_obj >>;
        ],
  has   scenery;

Object Hanging_on_Rope "Pendurado na corda"        
  with  name 'patrol' 'men',
        before [;
            Swing: if( noun ~= hemp_rope ) rfalse;
            give hemp_rope general;
            "Você faz a corda balançar para frente e para trás. Muito emocionante!";
        ],
        after [;
            Drop:
                remove(noun);
                print_ret (The) noun, " cai girando no vale abaixo.";
        ],
        u_to Spur_of_Rock,
        d_to [;
            print "Você desce pela corda e cai direto em uma patrulha de guardas que captura você!^";
            Capture();
            rtrue;
        ],
        description "Você está perigosamente pendurado em uma corda de cânhamo, suspensa de uma saliência rochosa acima, que 
            desce para a escuridão do vale. Nas trilhas abaixo, ouvem-se patrulhas de homens, e você
            sente instintivamente que não são amistosos.",
        cant_go "Francamente, só há para cima ou para baixo.",
        section T_ANCIENT_BRITAIN,
  has   light;

Object -> hemp_rope "corda de cânhamo" 
  with  name 'hemp' 'rope',
  has   scenery;

Object -> yellow_daisy "margarida amarela"   
  with  name 'yellow' 'daisy',
        before [;
            if( self has moved || hemp_rope has general ) rfalse;
            "Você estende a mão, mas não consegue alcançar a margarida, tamanha é a largura da saliência.";
        ],
        after [;
            Wear: "Você enfia a margarida atrás da orelha, quase fora de vista.";
            Take:
                if( self hasnt general ) {
                    give self general;
                    "Ajudado pelo balanço da corda, você colhe a margarida.";
                }
                rfalse;
        ],
!        u_to DaisyUp,
        initial "Uma única margarida amarela cresce em um pequeno tufo de grama nas rochas.",
  has   clothing scored;

Object Valley_Prospect "Vista do vale"        
  with  e_to Roman_Villa,
        sw_to Murky_Cave,
         description "A geografia aqui é estranhamente familiar. Você está em uma plataforma natural na encosta, observando o vale abaixo. Uma fenda quase invisível na rocha leva a uma caverna a sudoeste, e a encosta pode ser atravessada com segurança para leste.^^É uma noite de luar intenso, fria como o fim da primavera. Amanhã haverá uma geada forte. No vale, um grande círculo de fogueiras em forma de roda de carroça ilumina algumas formas escuras, talvez acampamentos rudimentares. Não há outro sinal de civilização.",
         cant_go "A encosta é íngreme demais.",
        section T_ANCIENT_BRITAIN,
  has   light;

Object Roman_Villa "Vila romana"        
  with  name 'timber' 'door',
        s_to Atrium_Cloister,
        e_to Villa_Stream,
        w_to Valley_Prospect,
         description "Você está ao lado de uma vila romana, cujas colunas projetam à luz da lua as sombras de um Império. Faz trinta anos que o Ocidente caiu, e a Bretanha está isolada do continente, onde em breve até a existência dos anglos se tornará um mito. Esta vila sobreviveu à peste e à devastação da guerra civil e, embora deva ter alguns séculos, ainda está de pé. Daqui você poderia atravessar a encosta de leste a oeste ou entrar por uma porta de madeira nada segura.",
        section T_ANCIENT_BRITAIN,
  has   light;

Object Villa_Stream "Riacho"  
  with  name 'river' 'road' 'stream' 'roof',
        before [;
             Swim: "Raso demais para ser confortável.";
             Drink: "Deliciosamente límpido e não poluído.";
        ],
        w_to Roman_Villa,
         u_to "Você sobe pela escada e está prestes a pular no telhado quando avista um homem enrolado em peles de animais, esparramado sobre as telhas e olhando para o pátio central da vila. Ele tem uma espada de aparência ameaçadora e, como não viu você, você desce silenciosamente pela escada.",
         description "Um riacho passa pela vila e desce em cascata pela encosta, juntando-se ao rio muito abaixo, perto da estrada romana que, daqui a 1.500 anos, se tornará a rodovia que tanto estraga a vista do seu jardim. Uma escada tosca de madeira amarrada com couro está apoiada na vila, no ponto mais baixo do telhado de telhas.",
        section T_ANCIENT_BRITAIN,
  has   light;

Object -> rough_ladder "escada tosca"   
  with  name 'rough' 'ladder',
        before [; Climb: << Go u_obj >>; ],
  has   scenery;

Object Atrium_Cloister "Claustro do átrio"        
  with  name 'timber' 'door',
        n_to Roman_Villa,
        s_to Atrium,
        description "Os claustros sombrios do átrio da vila. Você perturba um camundongo e ouve o arranhar de pequenas garras na pedra. A luz da lua entra do pátio central ao sul, e uma porta de madeira apodrecida leva de volta ao norte.",
        section T_ANCIENT_BRITAIN,
  has   light;

Object -> summoning_horn "trompa de convocação"       
  with  name 'horn' 'summoning' 'on' 'pole',
        before [;
            Blow:
                print "Você sopra a trompa, que emite um grande toque pelas colinas. ";
                if( CouncilCnt >= 7 ) {
                    print "Os guardas, espalhados pela vila, encontram você rapidamente.^";
                    Capture();
                } else {
                    print "Um chamado que logo recebe resposta...^";
                    CouncilCnt = 7;
                }
                rtrue; 
        ],
        initial "Encostada em uma coluna há uma trompa feita de uma presa, montada em uma longa haste semelhante a uma lança.",
        rod_assoc rod_of_language,
  has   hidden_rod;

Object Atrium "Átrio"  
  with  n_to Atrium_Cloister,
        s_to Entrance,
        e_to Guard_Quarters,
        w_to Triclinium,
        description "O poço central da vila, cercado por colunas. No lado norte há um claustro, e portas com vergas de pedra levam a leste, sul e oeste. A área central do piso é dominada por um belo mosaico romano, dividido em cenas individuais, ao redor do qual há aberturas do hipocausto. Não há teto sobre o pátio, e o átrio é iluminado pela lua.",
        section T_ANCIENT_BRITAIN,
  has   light;

Object -> ancient_mosaic "mosaico"       
  with  name 'mosaic',
        description "Os quatro quadrantes mostram barbas-brancas no Fórum, agricultores nos campos italianos, uma fortificação militar e um navio de grãos descarregando em Óssia.",
  has   scenery;

Object Guard_Quarters "Alojamento dos guardas"  
  with  name 'armour' 'spears' 'hides' 'blankets',
        w_to Atrium,
        description "Qualquer que tenha sido a função desta sala espaçosa, agora ela evidentemente abriga militares, pois está cheia de armaduras rudimentares, lanças e cobertores ásperos que não passam de peles de animais. Felizmente para você, os guardas estão ausentes.",
        section T_ANCIENT_BRITAIN,
  has   light;

Object -> bone_die "dado de osso rudimentar"     
  with  name 'die' 'dice' 'bone',
        after [;
            Drop:
                print_ret "Alea iacta est. O resultado é ", EnglishNumber(random(6)), ".";
        ],
        description "Um dado rudimentar de seis lados feito de osso animal.",
  has   ;

Object -> leather_sandals "sandálias de couro"     
  with  name 'sandals' 'shoes' 'leather',
        article "a pair of",
  has   clothing;

Object Triclinium "Triclínio"  
  with  e_to Atrium,
        d_to [;
            if( kitchen_well hasnt open )
                "O poço está coberto.";
            if( kitchen_well has general ) {
                print "Ciente dos perigos, você desce com muito cuidado...^";
                Achieved(SCORE_WELL);
                return kitchen_well;
            }
            deadflag = DIED;
            "Sem motivo para supor que o poço seja muito profundo, você desce alegremente. Isso se revela um erro de julgamento, e logo você perde o apoio e cai, batendo sem parar contra as paredes até que finalmente...";
        ],
        description "O que já foi o triclínio, ou cozinha, da vila agora está abandonado e há muito foi saqueado em busca de metal. (Ninguém vive sozinho neste século, e esta vila não seria fácil de defender.) Uma porta a leste dá para o átrio.",
        section T_ANCIENT_BRITAIN,
  has   light;

Object -> kitchen_well "poço da cozinha"   
  with  name 'well' 'hinged' 'wooden' 'cover',
        after [;
            Receive:
                remove noun;
                if( noun has light ) {
                    give kitchen_well general;
                    "Ele despenca para fora de vista, até que sua luz desaparece ao longe. Este deve ser um poço extremamente profundo.";
                }
                if( noun ~= historical_pamphlet ) {
                    StartTimer(self,2);
                }
                print_ret (The) noun, " cai no poço.";
        ],
        door_to Inside_Well,
        when_closed "Em um canto há uma espécie de tampa de madeira com dobradiças, fechada.",
        door_dir d_to,
        when_open "A tampa de madeira com dobradiças está levantada, revelando um poço circular com cerca de um metro de diâmetro. É muito escuro lá dentro.",
        description "O poço tem uma tampa de madeira com dobradiças. Não é possível saber, olhando, quão profundo ele é.",
        time_left 0,
        time_out [;
            if( player notin Triclinium ) rfalse;
            give kitchen_well general;
            trigger_quotation(9);
            "^Você ouve um respingo vindo do fundo do poço.";
        ],
  has   container door openable static;

Object Inside_Well "Dentro do poço"        
  with  name 'air',
        before [;
            Look, Go, Examine:
                rfalse;
            default:
                "Neste espaço confinado há pouco espaço para agir.";
        ],
        e_to Hypocaust,
        u_to Triclinium,
        description "Você se agarra perigosamente às paredes do poço profundo e perigoso. Mal consegue enxergar, mesmo com a ajuda da tocha, mas, curiosamente, sente ar quente soprando sobre você vindo do leste.",
        cant_go "Arriscado demais. Pelo que você sabe, pode não haver nada naquela direção.",
        section T_ANCIENT_BRITAIN,
  has   ;

Object Hypocaust "Hipocausto"    
  with  name 'fires' 'heating' 'log' 'logs',
        w_to Inside_Well,
        description "Este espaço muito baixo, quase um porão, sob o átrio é uma pequena área de acesso às fogueiras de lenha mantidas acesas para fornecer uma forma de aquecimento central à vila. Elas estão acesas e funcionando bem, curiosamente. Não é muito quente segundo os padrões do século XX, mas é preciso admitir que funciona.^^Uma pequena quantidade de luz entra pelas aberturas no teto, apenas o suficiente para enxergar. A única entrada parece ser por onde você veio.",
        cant_go "As fogueiras de lenha estão quentes e, de qualquer modo, a única saída grande o bastante para você fica de volta a oeste.",
        section T_ANCIENT_BRITAIN,
  has   light;

Object -> vents "aberturas" 
  with  name 'hypocaust' 'vents',
        before [;
            Examine, Search:
                if( CouncilCnt > 7 ) 
                    "Quatro homens em peles druídicas estão nos cantos do mosaico, em algum tipo de conferência sinistra. Esta velha vila deve ser um ponto de encontro. Entre os homens, uma pedra azulada repousa no piso de mosaico.";
                "Você enxerga o piso de mosaico do átrio iluminado pela lua.";
        ],
        article "the",
  has   scenery;

Object Entrance "Entrada"      
  with  before [;
            Go:
                if( noun ~= s_obj or sw_obj or se_obj )
                    rfalse;
                print "Você sai para o pátio e é imediatamente atacado pelos guardas, que o arrastam para longe.^";
                Capture();
                rtrue;
        ],
        after [;
            if( CouncilCnt == 0 ) 
                CouncilCnt = 1;
        ],
        n_to Atrium,
        description "Um pátio frontal bem pavimentado na entrada da vila, cercado por construções menores de madeira. Algumas são usadas como estábulos, e figuras de homens passam entre elas. Você se esconde, sem querer chamar atenção. No alto da colina, onde um dia será construído o Salão Meldrew, homens a cavalo podem ser vistos circulando pela trilha de acesso. Para uma vila abandonada, este lugar é certamente bem guardado.",
        section T_ANCIENT_BRITAIN,
  has   light scored;

Object Rough_Tent "Tenda rudimentar"  
  with  name 'hides',
        description "Pois bem, aqui está você, preso novamente. Desta vez, a cela é uma tenda de peles de animais costuradas, talvez com seis metros de diâmetro, sustentada por um mastro central. Você não faz ideia de onde fica a entrada, pois entrou vendado. Há ao menos uma luz fraca das fogueiras do lado de fora da tenda.",
        cant_go "Esta tenda também não parece ter uma saída.",
        section T_ANCIENT_BRITAIN,
  has   light scored;

Object -> tent_pole "mastro da tenda" 
  with  name 'tent' 'pole' 'central',
        before [;
            Attack: "Ele não vai quebrar.";
            Push, Pull, Turn: "A base está enterrada.";
        ],
        after [;
            Take:
                if( self has general ) {
                    rfalse;
                }
                give self general;
                print "Quando você arranca o mastro, a tenda inteira desaba ignominiosamente, e as peles de animais caem sobre sua cabeça. As peles são pesadas e o prendem, mas você consegue rastejar para fora...^";
                StartTimer(Encampment,10);
                PlayerTo(Encampment);
                rtrue;
        ],
        time_left 0,
        time_out [;
            print "^Sem aviso, um espião saxão (ou, como os guardas sem dúvida diriam, outro espião saxão) é atirado de corpo inteiro dentro da tenda, bate no mastro central e cai inconsciente no chão. Por um momento, a tenda inteira balança com o impacto: o mastro quase se parte.^";
            give tent_pole ~static;
            move unconscious_Saxon_spy to Rough_Tent;
            StartTimer(unconscious_Saxon_spy,5);
        ],
        rod_assoc rod_of_returning2,
  has   concealed static hidden_rod;

Object unconscious_Saxon_spy "espião saxão inconsciente"    
  with  name 'saxon' 'spy',
        before [;
            Search: "Além de os guardas serem melhores que você em revistar suspeitos, eles já fizeram isso antes.";
        ],
        life [;
            WakeOther: "O espião está profundamente inconsciente.";
            Attack, Kiss, ThrowAt: "Isso não é um ato digno de um Meldrew.";
            Order, Answer, Ask, Give: "Ele está dormindo.";
        ],
        initial "Um espião saxão inconsciente está caído no chão. Ocasionalmente, ouvem-se ruídos fracos vindos dele.",
        description "Ele está desgrenhado, esguio e inconsciente. Também está coberto de poeira e folhas, como se estivesse deitado de bruços ao ar livre há horas.",
        time_left 0,
        time_out [;
            if( location ~= Rough_Tent ) 
                rfalse;
            if( unconscious_Saxon_spy in Rough_Tent ) {
                print "^Homens chegam para arrastar o espião saxão rumo a algum destino horrível e desconhecido. Eles fazem uma careta para você como se dissessem: ~Você é o próximo.~^";
                remove unconscious_Saxon_spy;
                StartTimer(unconscious_Saxon_spy,5);
                rtrue;
            }
            deadflag = DIED;
            print "^Os homens chegam mais uma vez e agora seguram firmemente seus braços. Se você fosse antropólogo, ficaria fascinado pelo ritual em que é amarrado, estrangulado com uma corda e depositado em um pântano de turfa. Em vez disso, seu último pensamento é sobre o corpo célebre encontrado quando drenaram os pântanos em 1974 para construir uma área de serviço de rodovia.";
            rfalse;
        ],
  has   animate;

Object Encampment "Acampamento"  
  with  name 'fires' 'camp' 'dolmen',
        e_to [;
            if( leather_sandals has worn ) {
                print "Você atravessa habilmente as brasas quentes com suas sandálias.^";
                return dolmen;
            }
            "Atravessar essas brasas quentes! Você só pode estar brincando.";
        ],
        description "Por sorte, a tenda agora desabada quase não era vigiada, pois toda a atenção está voltada para um ritual medonho realizado além das fogueiras. Mas sua sorte não pode durar muito. Você está tão cercado por território hostil que simplesmente não tem para onde correr ou se esconder. As coisas, para dizer o mínimo, parecem sombrias.",
        cant_go "Arriscado demais, demais.",
        time_left 0,
        time_out [;
            if( game_section ~= T_ANCIENT_BRITAIN ) 
                rfalse;
            deadflag = DIED;
            "^Tinha de acontecer mais cedo ou mais tarde. Um dos druidas olha ao redor, vê você e dá o alarme imediatamente. É absolutamente inútil resistir, e você é arrastado aos gritos para seu destino.";
        ],
        section T_ANCIENT_BRITAIN,
  has   light scored;

Object -> dolmen "dolmen"       
  with  name 'dolmen' 'coals' 'hot' 'rock',
        door_to Beneath_Dolmen,
        door_dir e_to,
        when_open "Uma rocha glacial irregular, que à luz febril do fogo parece formar um dólmen natural, pode ser vista a leste, do outro lado de uma fogueira quase extinta de brasas quentes.",
  has   door open static;

Object Beneath_Dolmen "Sob o dólmen"  
  with  name 'dolmen',
        w_to Encampment,
        description "Você está ao lado do dólmen sinistro, cercado pelos ruídos terríveis e encantamentos de um rito druídico.",
        cant_go "Arriscado demais, demais.",
        section T_ANCIENT_BRITAIN,
  has   light scored;

Object -> bluish_stone "pedra azulada"   
  with  name 'stone' 'blue' 'bluish',
        initial "Sobre o dólmen repousa uma pedra azul polida.",
        rod_assoc fifty_franc_note,
        devil_hint "Eu não ficaria exibindo isso se fosse você!",
  has   scored hidden_rod;

Object fifty_franc_note "nota de cinquenta francos"      
  with  name 'fifty' 'franc' 'note' 'francs',
  has   ;
