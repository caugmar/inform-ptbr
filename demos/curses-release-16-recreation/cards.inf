class   TarotCard
  with  before [;
            Examine:
                if( self.door_to ~= nothing )
                     print "Uma imagem lindamente realista. ";
                rfalse;
        ],
         list_together "cartas de tarô",
        parse_name [ i j w len cnt;
            if( parser_action==##TheSame ) {
                 if( (parser_one.&name)-->0 == (parser_two.&name)-->0 )
                     return -1;
                 return -2;
            }
            len = (self.#name)/2;

            for( w = NextWord() : w : w = NextWord() ) {
                j = false;
                for( i=0: i < len : i++ ) {
                    if( w == 'cards' )
                        parser_action = ##PluralFound;
                    else if( w == self.&name-->i or 'card' or 'tarot' )
                        j = true;
                }
                if( j == false )
                    return cnt;
                else
                    cnt++;
            }
            return cnt;
       ],
        article "the",
  has   card;

TarotCard Death_card "Ceifador"
  with  name 'morte' 'ceifador' 'death' 'grim' 'reaper',
        door_to Ruined_Castle_Cafe,
         description "Capuz, foice, esqueleto, sorriso implacável: sim, é o Ceifador mesmo.",
         devil_hint "É essencial deslizar logo esta carta.";

TarotCard Fool_card "Louco"
  with  name 'louco' 'fool',
        door_to Ruined_Castle_Cafe,
         description "O Louco é um homem que olha diretamente para a frente enquanto pisa fora da beira de um penhasco.",
         devil_hint "Não se preocupe, ele não vai deslizar pelo penhasco.";

TarotCard Drowned_Sailor_card "Marinheiro Afogado"
  with  name 'afogado' 'marinheiro' 'drowned' 'sailor',
        door_to Ruined_Castle_Cafe,
         description "Aqueles eram os olhos dele, pérolas...",
         devil_hint "Ele agora é um dos meus colegas, é claro.";
