Object Crypt "Cripta"
  with  s_to bronze_mural,
        u_to Patio_in_Maze,
        d_to bronze_mural,
        initial [; MazeX = 7; MazeY = 5; rfalse; ],
         description "Uma cripta lúgubre, abandonada, castigada pela chuva e coberta de folhas. A luz entra pelo buraco quadrado no teto. Não há ossos nem urnas à vista.",
        section T_CATACOMBS,
  has   light;

LagachObj -> bronze_mural "mural de bronze"
  with  name 'bronze' 'mural',
        door_to Jagged_Passage,
         when_closed "A parede sul forma um gigantesco mural de bronze, que resistiu ao teste do tempo.",
        door_dir d_to,
         when_open "O mural está ligeiramente deslocado, revelando uma passagem que desce.",
         description "O mural retrata um velho sábio barbudo seguindo uma estrela no céu ocidental. Ele mantém o braço direito em torno de uma jovem atraente e segura um feixe de varinhas com a mão esquerda. Ao redor da borda há símbolos astrológicos de todo tipo, dos naipes do tarô às constelações do zodíaco.",
  has   door static;

[ CryptRoomBefore i ;
    if( action == ##Smell ) {
        if( location ~= The_Catacombs ) "Argh.";

        i = The_Catacombs.time_left + 1;
        The_Catacombs.time_left = i;
        if( i == 1 ) {
            "Algo como... talvez ar depois de uma tempestade... mas não, você ainda não consegue ter certeza do que é.";
        }
        if( i == 2 ) {
            move aluminium_staircase to The_Catacombs;
            The_Catacombs.d_to = Universe_Maintenance_Room;
            OzoneSmelled = true;
            Achieved(SCORE_SMELL);
            "Ozônio! É assim que se chama. Um cheiro curioso para uma caverna, especialmente porque, investigando melhor, você descobre que ele sobe de uma escada de alumínio escondida.";
        }
        "Definitivamente ozônio.";
    }
    rfalse;
];

Object Jagged_Passage "Passagem Irregular"
  with  name 'bones',
        before CryptRoomBefore,
        n_to Crypt,
        s_to The_Catacombs,
        e_to Charnel_Passage,
        u_to Crypt,
        d_to The_Catacombs,
         description "Uma passagem sinistra, que desce de uma abertura ao norte até profundezas sombrias ao sul. As paredes são irregulares, desniveladas e decoradas com ossos. Um odor desagradavelmente rançoso, de cadáveres, entra por uma fresta a leste.",
        section T_CATACOMBS,
  has   ;

Object -> wrought_iron_key "chave comprida de ferro forjado"
  with  name 'long' 'wrought' 'iron' 'key',
        sw_to compass,
         initial "Você parece estar pisando sobre uma chave de ferro forjado.",
         description "Um anel duplo em forma de oito, um cano comprido e uma lingueta finamente cortada com dez ranhuras: esta é a chave definitiva. É magnífica.",
  has   ;

Object Charnel_Passage "Passagem dos Cadáveres"
  with  before CryptRoomBefore,
        e_to Sarcophagus,
        w_to Jagged_Passage,
         description "Uma passagem longa, tortuosa e asquerosa pela terra, de leste a oeste. O odor repulsivo fica mais forte conforme você avança para leste.",
        section T_CATACOMBS,
  has   ;

Object Sarcophagus "Sarcófago"
  with  before CryptRoomBefore,
        w_to Charnel_Passage,
         description "Bem, talvez ~sarcófago~ seja um pouco melodramático, mas é esse tipo de momento. Isto deve ficar em algum lugar sob a velha igreja paroquial. Você está curvado dentro de um túmulo de pedra, manchado e esfarelado pela decomposição, interrompido apenas pela fenda por onde rastejou. É um lugar de pesadelo.",
        section T_CATACOMBS,
  has   ;

Object -> tombstone "tombstone"
  with  name 'tombstone' 'tomb' 'stone',
         initial "Como num pesadelo, até o chão onde você se ajoelha é uma lápide caída.",
         description "O essencial da inscrição é: ~Henri Maladreue, obiit mcdlvi.~",
  has   static;

Object The_Catacombs "Catacumbas"
  with  before CryptRoomBefore,
        n_to Jagged_Passage,
        w_to CR,
        u_to Jagged_Passage,
        d_to nothing,
         description "Uma caverna grande e horrenda, bem abaixo do jardim, mal iluminada e sinistra. A escuridão se enrola em torno dos pilares naturais de rocha como névoa, e há nela um odor peculiar e vagamente familiar. As únicas saídas óbvias são uma passagem irregular que sobe ao norte e um rastejo para oeste.",
         cant_go "Você esbarrou em algo desagradável ali.",
        time_left 0,
        section T_CATACOMBS,
  has   ;

Object aluminium_staircase "escada de alumínio"
  with  name 'staircase' 'stairs' 'stair' 'case' 'aluminium',
        before [; Climb, Enter: << Go d_obj >>; ],
         initial "O cheiro estranho parece ser ozônio, e sobe de uma escada de alumínio antes escondida.",
         description "Desce.",
        article "an",
  has   static;

[ AdjustSlide i j u v ;
    u = henri_post_array->i;
    v = henri_post_array->j;
    henri_post_array->j = u;
    henri_post_array->i = v;
    rtrue;
];

[ DisplaySlidePos ndx chr ;
    chr = henri_post_array->(ndx - 1);
    if( chr == 0 ) {
        print ". ";
        rfalse;
    }
    chr = chr + 65 - 1;
    print (char) chr, " ";
    rtrue;
];

[ DisplayWholeGrid ;
    0-->8 = 2 | 0-->8;
    print "     ";
    DisplaySlidePos(1);
    DisplaySlidePos(2);
    DisplaySlidePos(3);
    print "^      + +^", "     ";
    DisplaySlidePos(4);
    DisplaySlidePos(5);
    DisplaySlidePos(6);
    print "^      + +^", "     ";
    DisplaySlidePos(7);
    DisplaySlidePos(8);
    DisplaySlidePos(9);
    print "^      + +^", "     ";
    DisplaySlidePos(10);
    DisplaySlidePos(11);
    DisplaySlidePos(12);
    print "^      + +^", "     ";
    DisplaySlidePos(13);
    DisplaySlidePos(14);
    DisplaySlidePos(15);
    new_line;
    0-->8 = 65533 & 0-->8;
    rtrue;
];

Object CR "CR"
  with  name 'basket' 'seesaw' 'hand' 'cannon' 'glass',
        after [;
            Go, Enter:
                if (noun == n_obj or s_obj or metal_wall) {
                    print "^Atravessar o espelho é desconcertante, mas deixa você em algum lugar... quase exatamente
                        igual...^";
                    redraw_statusline = true;
                    Achieved(SCORE_REFLECTING);
                    if (noun == n_obj) {
                        self.s_to = metal_wall;
                        self.n_to = nothing;
                        metal_wall.door_dir = s_to,
                        self.time_left = 3;
                    } else {
                        self.n_to = metal_wall;
                        self.s_to = nothing;
                        metal_wall.door_to = n_to,
                        self.time_left = 2;
                    }
                    AdjustSlide(0,2);
                    AdjustSlide(3,5);
                    AdjustSlide(6,8);
                    AdjustSlide(9,11);
                    AdjustSlide(12,14);
                }
                rfalse;

        ],
        n_to metal_wall,
        s_to nothing,
        e_to [;
            if( self.time_left == 3 )
                "Você esbarra numa barreira invisível, talvez a borda do reflexo.";
            return The_Catacombs;
        ],
        description "O cartunista Heath Robinson se especializava em desenhos de máquinas fantasticamente complicadas,
            com cordas, roldanas, alavancas, contrapesos, engrenagens, ratos correndo em rodas e coisas assim. Uma
            engenhoca desse tipo ocupa o lado oeste desta sala, embora a maior parte do mecanismo esteja atrás de
            uma parede de vidro que, apesar de envelhecida, é tão sólida quanto no dia em que foi construída. As peças
            são muito antigas (feitas à mão, não usinadas), mas não estão corroídas.^^A única saída parece ser pelo
            rastejo a leste.",
        time_left 2,
        short_name [;
            if( self.time_left == 3 )
                print "Reflexo da Engenhoca";
            else
                print "Sala da Engenhoca";
            rtrue;
        ],
        section T_CATACOMBS,
  has   ;

Object -> metal_wall "metal wall"
  with  name 'mirror' 'metal' 'bronze' 'wall' 'sheet' 'amber',
        before [;
            Rub: "Você lustra um pouco o metal, mas há trabalho demais para fazer à mão.";
        ],
        door_to CR,
        when_closed "A borda norte da sala é uma grande chapa de metal cor de âmbar fosco.",
        door_dir n_to,
        when_open [;
            print "Toda a ";
            if( CR.time_left == 2 ) {
                print "parede norte";
            } else {
                print "parede sul";
            }
            " é ocupada por um espelho de bronze que reflete a sala.";
        ],
        description "Alguém bastante bonito, você não consegue deixar de pensar, está refletido na superfície metálica.",
  has   door static;

Object -> iron_grid "iron grid"
  with  name 'iron' 'grid' 'contraption' 'panel',
        initial [;
            print "No meio da parede de vidro há um painel de ferro dividido numa grade de três por cinco.^^Atrás do vidro há uma espécie de gangorra com dois cestos de couro nas extremidades opostas de um pivô de carvalho. ", "Num canto do teto, acima da extremidade distante da gangorra, há um ";
            if( ancient_well notin nothing ) {
                print "buraco pelo qual emana uma luz natural fraca.^^";
            } else {
                print "buraco escuro.^^";
            }
            print "Projetando-se da parte traseira do mecanismo do painel, na extremidade próxima, há uma mão metálica que ";
            if( CR has general ) {
                "agarra o ar vazio.";
            }
            "agarra uma bala de canhão no ar.";
        ],
        description [;
            print "Há quatorze peças na grade e uma lacuna. As peças têm letras ";
            if( CR.time_left == 3 ) {
                print "(em escrita refletida) ";
            }
            print "e estão dispostas assim:^^";
            DisplayWholeGrid();
            "^[Tente ~deslizar b~, por exemplo, para mover uma peça até a lacuna.]";
        ],
  has   static;

Object -> glowing_golden_orb "orbe dourado brilhante"
  with  name 'glowing' 'golden' 'orb',
         before [; default: "Está fora de alcance, além do vidro."; ],
         description "Como ele parece tentadoramente valioso.",
  has   scenery;

Object -> cannonball "bala de canhão"
  with  name 'cannon' 'ball' 'cannonball',
        before [;
            Examine: "Está fora de alcance, além do vidro.";
        ],
         description "Sólida, pesada, confiável, fora de alcance do outro lado do vidro.",
  has   scenery;

Object Universe_Maintenance_Room "Sala de Manutenção do Universo"
  with  name 'gauges' 'machines' 'cube' 'dials',
        u_to The_Catacombs,
         description "Você realmente deveria ficar mais maravilhado, pois esta é a caverna de Merlin, o centro da Criação. Cada visitante percebe este lugar de modo diferente, conforme seus próprios mitos e crenças. Como sua crença particular é a ciência, há apenas um cubo de metal preto de um metro, com uma coleção pouco impressionante de medidores e mostradores. Uma escada de alumínio sobe.",
        section T_CATACOMBS,
  has   scored;

Object -> big_electricians_switch "big electrician's switch"
  with  name 'big' 'electricians' 'switch',
        after [;
             SwitchOn: "Clique-clanc! O mundo parece exatamente igual.";
             SwitchOff: "Clanc-clique! Provavelmente nada mudou de verdade.";
        ],
         description "A posição inferior, ligada, está marcada ~Determinismo~. A posição superior, desligada, está marcada ~Acaso~.",
  has   on scenery static switchable;

Object -> large_dial "large dial"
  with  name 'large' 'dial' 'gauges' 'dials',
        before [;
            Turn:
                if( PlanckWarning == false ) {
                    PlanckWarning = true;
                    trigger_quotation(12);
                     "É mesmo sensato mexer nas coisas por aqui? Bem, só há um jeito de descobrir. Não espere um segundo aviso!";
                }
                deadflag = DESTROYED_UNIVERSE;
                score = 65437;
                 "Hmm. No geral, provavelmente é melhor não alterar uma das constantes fundamentais do universo físico enquanto ainda está dentro dele. Pelo lado bom, desta vez é improvável que culpem você.";
        ],
         initial "Destacam-se um mostrador grande, como o controle de volume de um amplificador hi-fi caro, e um grande interruptor elétrico. Ambos estão marcados em letras miúdas.",
         description "Acima do mostrador há uma letra h minúscula cortada por uma linha. Atualmente está ajustado para 1,055, mais ou menos. Há algo preocupantemente perigoso em sua simplicidade objetiva.",
  has   static;

Object Inside_the_Orb "Dentro do Orbe"
  with  name 'light',
        after [;
             Strike: "A esfera ressoa com um ruído oco, mas a haste se carrega.";
        ],
         description "Você fica meio de pé, meio flutuando numa esfera dourada e enevoada de talvez nove metros de diâmetro, que gira lentamente. O centro, fora de alcance e de algum modo insubstancial, é uma treliça de cristais oblongos de oito por oito, banhada por uma luz perolada e quente.",
        number 0,
        each_turn [ i j;
            i = Inside_the_Orb.number + 1;
            Inside_the_Orb.number = i;
            if( i == 1 ) {
                rtrue;
            }
            if( i == 2 ) {
                print "^A esfera gira, oferecendo uma nova visão das imagens: Reis e Rainhas estilizados?^";
            }
            if( i == 4 ) {
                print "^A esfera gira, oferecendo outra visão: humildes peças de guerreiros.^";
            }
            if( i == 6 ) {
                print "^A esfera gira, oferecendo outra visão: cabeças de cavalos entalhadas e mitras de bispos.^";
            }
            if( i == 8 ) {
                print "^(A esfera gira.) É um jogo de xadrez! Agora você entende. Mas ainda não consegue descobrir a solução propriamente dita.^";
            }
            if( i == 10 ) {
                print "^(A esfera gira.) Você tem a impressão de que as Brancas estão tentando atacar, com muitas peças sobrando.^";
                trigger_quotation(26);
            }
            if( i == 12 ) {
                print "^(A esfera gira.) Vendo o tabuleiro do ponto de vista das Pretas, a defesa parece sólida.^";
            }
            if( i == 14 ) {
                print "^(A esfera gira.) De volta ao lado das Brancas. Você definitivamente precisa romper de algum modo; toda aquela troca cautelosa de peças não funcionou. Isto é, se quiser que as Brancas vençam.^";
            }
            j = i % 4;
            if( j == 0 ) {
                give Inside_the_Orb ~general;
                if( i > 12 ) {
                    "^(A esfera gira.) As Pretas ainda parecem seguras.";
                }
            }
            if( j == 2 ) {
                give Inside_the_Orb general;
                if( i > 14 ) {
                    "^(A esfera gira.) As Brancas precisam escapar de algum modo.";
                }
            }
        ],
        section T_CATACOMBS,
  has   light;

Object -> array_of_oblong_crystals "conjunto de cristais oblongos"
  with  name 'array' 'oblong' 'lattice' 'crystals' 'images' 'board' 'chess' 'pieces' 'king' 'queen' 'white' 'black' 'kings' 'queens' 'bishops' 'knights',
         initial "Imagens espreitam entre o conjunto de cristais oblongos.",
         description "Eles são extremamente difíceis de ver e impossíveis de tocar, como se só fosse possível captar alguma coisa pelo canto do olho.",
        article "an",
  has   static;
