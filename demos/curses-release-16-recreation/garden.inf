Class   GRoom
  with  section T_GARDEN;

GRoom   Garden_Stream "Riacho do Jardim"    
  with  name 'reeds' 'juncos' 'riacho' 'agua' 'água',
        before [;
            Swim: "Raso demais para nadar confortavelmente.";
            Drink: "Dá para beber. Não é muito agradável, porém.";
        ],
        n_to "Melhor não... você seria visto da Biblioteca.",
        s_to coal_bunker,
        e_to Beside_the_Wall,
        w_to "Melhor não... você seria visto da Orangerie.",
        ne_to "Melhor não... você seria visto do Salão Antigo.",
        nw_to Family_Tree,
        d_to "Não é seguro subir pelo Salão.",
        description "Nos jardins exuberantes (isto é, malcuidados) da Casa Meldrew, um riacho murmura
            agradavelmente enquanto serpenteia pelos juncos. A casa se ergue bem acima de você ao sul,
            e você não ousa ser visto pelas janelas pelo resto da família; terá de seguir a noroeste,
            entrando mais fundo nos jardins, ou para leste pela trilha junto ao muro.",
        cant_go "A massa do Salão está no caminho.",
  has   light scored;

Object  -> coal_bunker "depósito de carvão"     
  with  name 'coal' 'bunker' 'loading' 'door' 'carvao' 'carvão' 'deposito' 'depósito' 'porta',
        after [;
            Close: give metal_door ~open; rfalse;
            Open: give metal_door open; rfalse;
            Lock: give metal_door locked; rfalse;
            Unlock: give metal_door ~locked; rfalse;
        ],
        door_to Dark_Passage,
        when_closed "No muro da casa há um depósito de carvão, cuja porta de carga está fechada.",
        door_dir s_to,
        when_open "No muro da casa há um depósito de carvão, cuja porta está aberta.",
  has   door locked openable static;

Object  -> stream "riacho"       
  with  name 'stream' 'water' 'gurgling' 'riacho' 'agua' 'água',
        before [;
            Enter: <<Swim>>;
            Drink: "Tem um gosto morno e não desagradável, de lodo e algas.";
        ],
  has   scenery;

GRoom   Beside_the_Wall "Ao Lado do Muro"        
  with  n_to "Por esse lado você seria visto do Salão Antigo.",
        s_to "Não há porta para o Salão.",
        w_to Garden_Stream,
        nw_to "Por esse lado você seria visto da Biblioteca.",
        u_to "As paredes do Salão são impossíveis de escalar para alguém com seu grau de vertigem.",
        d_to nothing,
        description "A trilha leste-oeste junto à base do Salão Meldrew termina aqui, num dos muros esculpidos
            que delimitam o jardim.",
        cant_go "O muro de pedra impede a passagem para leste.",
  has   light;

Object  -> potted_shrub "arbusto em vaso"   
  with  name 'pot' 'potted' 'tub' 'plant' 'shrub' 'vaso' 'planta' 'arbusto',
        before [;
            Climb, Enter: "Ele tem apenas um metro de altura!";
            Turn: "Você gira o vaso da planta.";
            Push, PushDir, Pull:
                if( self has general ) rfalse;
                give self general;
                move timber_hatch to location;
                Beside_the_Wall.d_to = timber_hatch;
                move self to location;
                "Ao empurrar um pouco o arbusto, você revela uma velha escotilha de madeira feia, com cerca de um metro de diâmetro.";
        ],
        initial "Um arbusto é cultivado num vaso redondo e largo no centro da trilha, protegido atrás do muro.",
  has   static;

Object  -> stone_wall "muro de pedra"       
  with  name 'stone' 'wall' 'carved' 'carvings' 'painted',
        before [;
            Climb, Enter:
                "O velho muro de jardim esculpido é um dos tesouros da Inglaterra rural, e você não está nem de longe
                 desesperado o bastante para transformá-lo ainda mais em ruínas.";
            Answer, Ask: "O velho muro é mudo.";
        ],
        orders [;
            Lagach: "Por um instante, a mais leve brisa sopra do muro, mas morre até não restar nada.";
            default: "O velho muro é mudo.";
        ],
        description "O muro do jardim já teve entalhes pintados, mas eles se deterioraram.",
        found_in Beside_the_Wall Beside_the_Drive,
  has   scenery talkable;

Object  timber_hatch "escotilha de madeira"      
  with  name 'timber' 'hatch' 'old' 'rotted' 'rotting' 'lid',
        after [;
            Open:
                give Wine_Cellars light;
                print (string) self.when_open;
                new_line;
                rtrue;
            Close:
                give Wine_Cellars ~light;
                rfalse;
        ],
        door_to Wine_Cellars,
        when_closed "Ao lado do arbusto há uma escotilha de madeira com um metro de largura.",
        door_dir d_to,
        when_open "A tampa de madeira está aberta ao lado do arbusto, revelando a velha escotilha do barril.",
  has   door openable static;

GRoom   Family_Tree "Árvore da Família"        
  with  name 'sign' 'signpost' 'post',
        n_to [;
            if( player in garden_roller )
                return Maze;
            "Você não pode ir por ali.^^Agora, isso exige uma pequena explicação... Hoje em dia, não é fácil manter
             uma casa do tamanho do Salão Meldrew, e sua família teve de fazer um acordo com o Patrimônio Nacional
             para abrir a casa ao público nos meses de verão. O labirinto é tão popular entre os visitantes que a
             grama desapareceu e está sendo replantada neste momento; portanto, você não deve pisotear tudo.";
        ],
        e_to Lawn_Ornaments,
        w_to Clearing,
        se_to Garden_Stream,
        u_to Up_the_Plane_Tree,
        initial [;
            MazeX = 4; MazeY = 6; rfalse;
        ],
        description "Você está à sombra de um grande plátano, cujas mudas foram trazidas da Espanha por um ancestral
            seu em 1806. A sudeste há um riacho, a oeste uma pequena clareira, e ao norte uma abertura na sebe verde
            de ligustro marca a entrada do famoso e difícil Labirinto do Salão Meldrew. Uma placa com os dizeres
            ~Para o Mosaico~ aponta para leste através do gramado.",
  has   light;

Object  -> plane_tree "plátano"       
  with  name 'plane' 'tree' 'family',
        before [; Climb: << Go u_obj >>; ],
  has   scenery;

GRoom   Lawn_Ornaments "Enfeites do Gramado"  
  with  name 'gnomes' 'nymphs' 'windmills' 'gnome' 'nymph' 'windmill' 'ornament' 'ornaments',
        e_to Mosaic,
        w_to Family_Tree,
        d_to Mosaic,
        description "Centenas de anos de rolagem fizeram deste um belo trecho de grama, entre a sebe de ligustro (norte),
            o plátano (oeste) e o mosaico (leste). Infelizmente, ele é adornado com todos os enfeites realmente feios
            (gnomos, ninfas de gesso e moinhos de pedra para cultivar flores), pois este é o canto do jardim menos
            visível da casa.",
        cant_go "As opções parecem ser leste ou oeste.",
  has   light;

Object  -> plaster_statuette "estatueta de gesso" 
  with  name 'plaster' 'statuette' 'bust' 'statue',
        initial "Entre eles se destaca uma estatueta de gesso, o busto de uma mulher.",
        description "Ela tem pouco mais de um metro de altura. Na base há uma inscrição: ~Autorretrato, H.M. '54~.
            (Presumivelmente não é da Sua Majestade a Rainha.)",
  has   static;

Object  ancient_well "poço antigo"      
  with  name 'ancient' 'well' 'dark',
        after [;
            Receive:
                move noun to hanging_cord;
                give CR ~general;
                "Ela despenca pelo poço.";
        ],
        initial "O gramado está levemente coberto de gesso quebrado e poeira, e no lugar da estatueta há um poço antigo e escuro.",
        description "Você não consegue distinguir nada lá embaixo, e o poço é estreito demais para descer.",
  has   container open static;

GRoom   Mosaic "Mosaico"  
  with  name 'perspex' 'scenes' 'quadrants',
        e_to nothing,
        w_to Lawn_Ornaments,
        u_to Lawn_Ornaments,
        description "Este canto rebaixado do jardim foi escavado e depois coberto com perspex resistente para protegê-lo
            dos sapatos dos visitantes. É um mosaico romano desgastado pelo tempo, dividido em quatro quadrantes,
            cada um mostrando cenas de uma vida romana idealizada. Provavelmente havia uma vila aqui, mas sua família
            nunca gostou de arqueólogos, então as escavações não avançaram.",
        cant_go "Daqui você pode subir de volta ao gramado.",
  has   light;

LagachObj -> Roman_mosaic "mosaico romano"   
  with  name 'roman' 'mosaic',
        description "Feito de fragmentos de terracota e cerâmica, ele se manteve surpreendentemente bem unido.",
  has   scenery;

Object  -> hard_wooden_ball "bola de madeira dura"   
  with  name 'croquet' 'hard' 'wooden' 'ball',
        initial "Uma bola de madeira dura, do tamanho da palma da mão, rola pelo mosaico.",
        angel_hint "Esplêndido, você está se divertindo à bola. Espero que vocês se deem bem.",
  has   ;

GRoom   Clearing "Clareira"      
  with  s_to Vegetable_Garden,
        e_to Family_Tree,
        w_to Garage,
        description "Uma clareira na borda do jardim, cercada por muros e pelas sebes de ligustro do labirinto. A leste
            fica o plátano, a oeste uma abertura no muro dá acesso à garagem, e ao sul há uma pequena horta.",
  has   light;

GRoom   Vegetable_Garden "Horta"      
  with  n_to Clearing,
        u_to runner_bean_plant,
        description "Uma horta recém-revolvida, ocupando um canto sombreado do jardim. O canteiro testemunha mais boas
            intenções do que horticultura.",
        cant_go "Deste canto, você só pode voltar à clareira.",
  has   light;

Object  -> runner_bean_plant "feijoeiro" 
  with  name 'runner' 'bean' 'plant',
        door_to Up_the_Beanstalk,
        when_closed "Apenas um feijoeiro enfeita a horta.",
        door_dir u_to,
        when_open "Um feijoeiro gigante sobe vertiginosamente daqui até o céu.",
        section T_GARDEN,
  has   door static;

GRoom   Up_the_Beanstalk "Subindo pelo Feijoeiro"      
  with  before [;
            Jump: deadflag = DIED; "Você cai e quebra o pescoço!";
        ],
        after [;
            Drop:
                 move noun to Family_Tree;
                 if( noun == medicine_bottle && noun has locked ) {
                print "O frasco de remédio despenca para a terra abaixo.^";
                    give medicine_bottle ~locked;
                    give medicine_bottle open;
                    rtrue;
                }
                print_ret (The) noun, " despenca para a terra abaixo.";
        ],
        n_to Heavenly_Place,
        d_to Vegetable_Garden,
        description "No topo do feijoeiro, em meio às nuvens. Não há maneira segura de sair daqui além de descer,
            como seria de esperar. Talvez fosse possível pisar nas nuvens ao norte, mas, mesmo sendo um conto de fadas,
            isso exigiria confiança demais.",
        cant_go "As nuvens são frágeis demais por esse lado.",
  has   light;

GRoom   Garage "Garagem"  
  with  e_to Clearing,
        description "Uma garagem modesta de tijolos, construída nos muros do jardim. Uma grande porta aberta leva para leste, à clareira.",
  has   light;

Object  -> garden_roller "rolo de jardim" 
  with  name 'garden' 'roller' 'switch' 'motor' 'motorised' 'power',
        before [;
            Go:
                if( self hasnt on )
                    print "(O motor não está ligado no momento.)^";
                else {
                    if( noun == u_obj or d_obj ) {
                        print "O rolo de jardim é um veículo um tanto horizontal.^";
                        return 2;
                    }
                    if( location == Garden_Stream && noun == s_obj ) {
                        print "O rolo de jardim nunca vai caber.^";
                        return 2;
                    }
                    if( location == Lawn_Ornaments && noun == e_obj ) {
                        print "Filisteu! Como ousa tentar dirigir um rolo de jardim sobre um mosaico romano?^";
                        return 2;
                    }
                    rtrue;
                }
                rfalse;
        ],
        s_to "Um grande rolo de jardim motorizado está estacionado aqui.",
        initial "O rolo de jardim está aqui, com o motor ainda ligado.",
        description "Um rolo de jardim motorizado do tipo em que se senta dentro; entre seus controles simples há um grande
            interruptor de liga/desliga.",
        each_turn [;
            if( player notin self || self hasnt on )
                rfalse;
            if( location == Lawn_Ornaments && plaster_statuette in Lawn_Ornaments ) {
                print "^Creck! O rolo de jardim bateu em alguma coisa ali.^";
                give CR light;
                remove plaster_statuette;
                move ancient_well to Lawn_Ornaments;
                give Lawn_Ornaments general;
            }
            if( medicine_bottle in location && medicine_bottle has locked && location ~= Garage ) {
                print "^Puxa. O frasco de remédio, que você deixou negligentemente no caminho do rolo,
                    parece ter rachado.^";
                give medicine_bottle open;
                give medicine_bottle ~locked;
            }
        ],
  has   container enterable open static switchable;

Object  -> weed_killer_bottle "frasco de herbicida"       
  with  name 'weed' 'killer' 'bottle' 'weedkille',
        before [ i;
            Squeeze, Push:
                if( self has general ) "Nada sai. O frasco deve estar vazio.";
                give self general;
                if( location == Wall_of_Thorns ) {
                    "Uma ideia valente, mas condenada. O herbicida mal prejudica uma única gavinha do muro.";
                }
                if( location == Vegetable_Garden ) {
                    remove runner_bean_plant;
                    Vegetable_Garden.u_to = nothing;
                    "Parabéns. Você devastou o feijoeiro.";
                }
                if( location == Family_Tree ) {
                    "Felizmente, o herbicida não causa efeito algum na bela árvore antiga.";
                }
                if( game_section == T_GARDEN ) {
                    ! no code
                } else {
                    if( game_section ~= T_GARDEN_PAST ) {
                        "Um jato de herbicida sai, mas evapora quase imediatamente, ainda bem, considerando o cheiro horrível.";
                    }
                    if( location ~= Maze_Foundations ) {
                        ! no code
                    } else {
                        i = MazeBoundary(MazeX,MazeY);
                        if( i == 0 ) 
                            "Um jato de herbicida encharca a grama e não faz nada evidente.";
                        WeedkillerX = MazeX;
                        WeedkillerY = MazeY;
                        StartDaemon(self);
                        "Um jato de herbicida encharca o canteiro e não faz nada evidente.";
                    }
                }
                "Um jato de herbicida encharca a terra e não faz nada evidente.";
        ],
        initial "Nas sombras há um frasco de herbicida.",
        description "Se apertado, ele borrifa herbicida no chão. Há muitos rótulos de advertência sobre o contato com as mãos.",
        daemon [ ndx;
            if( game_section ~= T_GARDEN_PAST ) {
                ndx = WeedkillerX + 9 * WeedkillerY;
                garden_array->ndx = 48;
                StopDaemon(self);
            }
        ],
        angel_hint "O curioso é que não havia herbicidas no começo do século XIX, e mesmo assim eles planejavam jardins maravilhosos.",
  has   ;

Object  -> spade "spade" 
  with  name 'bladed' 'agricultural' 'implement' 'zzzzzzzzz',
        before [;
            Examine:
                if( spade has general ) {
                    rfalse;
                }
                give spade general;
                spade.&name-->3 = 'spade';
                "Pensando bem, vamos chamar uma pá de pá.";
        ],
        initial "Pendurada num gancho há uma ferramenta agrícola laminada.",
        short_name [ ;
            if( self has general ) {
                print "pá";
            } else {
                print "ferramenta agrícola laminada";
            }
            rtrue;
        ],
        angel_hint "Você acha que há algum lugar do jardim especialmente adequado para uma ferramenta dessas?",
  has   ;

GRoom   Up_the_Plane_Tree "No Alto do Plátano"    
  with  name 'jemima' 'conservatory' 'window',
        before [;
            Jump:
                deadflag = DIED; "Você cai e quebra o pescoço!";
        ],
        d_to Family_Tree,
        description "Uma vista magnífica dos jardins seria sua, não fossem os galhos e folhas que o cercam. Você
            distingue Tia Jemima numa das janelas da estufa, mas se esconde de sua vista. Lá embaixo, o traçado do
            labirinto de sebes de ligustro pode ser visto através dos galhos inferiores.",
        cant_go "Não, não vá se arriscar assim.",
  has   light;

Object  -> maze_layout "traçado do labirinto"     
  with  name 'maze' 'layout',
        description [ x y wallp;
            print "O traçado é aproximadamente o seguinte:^^";
            0-->8 = 2 | 0-->8;
            y = 0;
            --y;
            while( y < 6 ) {
                y++;
                print "    ";
                x = 0;
                x--;
                while( x < 8 ) {
                    x++;
                    wallp = MazeBoundary(x,y);
                    if( wallp == true )
                        print "###";
                    else
                        print "...";
                }
                new_line;
            }
            0-->8 = 65533 & 0-->8;
        ],
        article "the",
  has   scenery;

GRoom  Bricked_Path "Caminho de Tijolos"      
  with  e_to Hedgery,
        sw_to White_Hallway,
        initial [; trigger_quotation(22); rfalse; ],
        description "Você passeia por um agradável caminho de tijolos, passando dos cômodos externos do Salão Meldrew para uma trilha pelo lado leste do jardim.",
        section T_GARDEN,
  has   light;

Object Hedgery "Jardim de Sebes"        
  with  n_to [;
            give flock_of_sparrows general;
            print "Seu primeiro passo em direção aos pardais os assusta, e eles sobem e voam em círculos em pânico,
                gorjeando o alarme.^";
            return Summer_House;
        ],
        e_to Croquet_Lawn,
        w_to Bricked_Path,
        description "Batizado por algum brincalhão da família gerações atrás, este é um tranquilo jardim de sebes,
            coroado por uma casa de verão ao norte e aberto para um amplo gramado de croqué a leste.",
        section T_GARDEN,
  has   light;

Object -> flock_of_sparrows "bando de pardais" 
  with  name 'flock' 'of' 'sparrows',
        initial "Um bando de pardais se aglomera nas calhas da casa de verão. De vez em quando um voa e pousa em outro lugar, e todos se movimentam alegremente.",
  has   static;

GRoom  Summer_House "Casa de Verão"      
  with  after [;
            if( flock_of_sparrows hasnt general ) {
                    print "^Os pardais gorjeiam felizes junto à calha alta.^";   
                } else {
                    print "^Pardais assustados circulam alto no céu, sem mostrar sinais de se acalmar.^";
                }
                rfalse;
        ],
        n_to nothing,
        s_to [;
            if( flock_of_sparrows has general ) {
                give flock_of_sparrows ~general;
                print "Quando você sai, os pardais gradualmente voltam a pousar.^";
            }
            return Hedgery;
        ],
        description "Uma velha casa de verão de madeira, cheirando a verniz e instável sob seus pés. Faltam vários
            segmentos do alto telhado piramidal de vidro multifacetado, e outros estão rachados, mas ela ainda é de
            algum modo um refúgio acolhedor. A única entrada também é a única saída.",
        section T_GARDEN,
  has   light;

Object -> croquet_mallet "marreta de croqué"       
  with  name 'croquet' 'mallet',
        initial "Uma marreta de croqué está junto a uma parede de madeira.",
        devil_hint "É para amassar batatas de croqué.",
        angel_hint "Croqué é o jogo do próprio Diabo!",
  has   ;

Object -> gold_watch_on_a_chain "relógio de ouro com corrente" 
  with  name 'gold' 'watch' 'on' 'chain',
        before [;
            if( self hasnt moved )
                "O relógio está à vista, mas bem fora de alcance.";
            Swing, Wave: "Você chega perigosamente perto de hipnotizar a si mesmo.";
        ],
        initial "Algo dourado pende por uma corrente de uma vidraça solta no teto, mas está alto demais para alcançar.",
        description "É belamente polido e cativa o olhar. Você poderia ficar olhando por horas...",
        angel_hint "Como os fracos são facilmente mesmerizados por bugigangas.",
  has   ;

GRoom   Behind_Summer_House "Atrás da Casa de Verão"        
  with  s_to loose_board,
        w_to Mosaic,
        se_to Croquet_Lawn,
        d_to Mosaic,
        description "Entre sebes densas junto à parte traseira maltratada, feita de ripas, da casa de verão. Galhos escuros
            e ásperos cercam você, mas é possível descer para oeste ou sair para o gramado de croqué a sudeste.",
        section T_GARDEN,
  has   light scored;

Object -> loose_board "tábua solta"     
  with  name 'loose' 'board',
        before [;
            Open, Push, Pull, Turn:
                if( irate_squirrel_friend in location )
                    "O esquilo se ergue e belisca seu pulso. Você recua, machucado.";
                rfalse;
        ],
        door_to Summer_House,
        when_closed "Uma tábua da parede traseira está visivelmente solta, formando uma rachadura razoável.",
        door_dir s_to,
        when_open "Você poderia facilmente passar pela tábua solta para o sul, entrando na casa de verão.",
  has   door openable static;

Object -> crack "rachadura" 
  with  name 'crack' 'gap' 'hole' 'summerhou' 'summer' 'house',
        before [;
            Search: "Pela rachadura você vê a luz do sol nas tábuas do chão da casa de verão.";
        ],
        after [;
            Receive:
                if( noun == bunch_of_nuts ) {
                    give loose_board open;
                    move bunch_of_nuts to irate_squirrel_friend;
                    move irate_squirrel_friend to Summer_House;
                    GoNuts();
                    Summer_House.n_to = Behind_Summer_House;
                    "Você joga as nozes pela tábua solta para dentro da casa de verão, e o esquilo salta atrás delas,
                    arrebentando a tábua e abrindo um buraco na parede.";
                }
                move noun to Summer_House;
                "Jogado pela tábua solta para dentro da casa de verão.";
        ],

        description "Pela rachadura você vê a casa de verão.",
  has   container open scenery;

[ GoNuts ;
    irate_squirrel_friend.initial = "O esquilo está sentado aqui, bicando as nozes atentamente.";
    rtrue;
];

Object -> irate_squirrel_friend "amigo esquilo irritado" 
  with  name 'irate' 'my' 'squirrel' 'friend',
        life [;
            Show:
                if( noun == bunch_of_nuts ) "O esquilo considera as nozes extremamente interessantes.";
                rfalse;
            Give:
                if( noun has edible ) {
                    remove noun;
                    if( noun == bunch_of_nuts ) {
                        GoNuts();
                        "O esquilo fica extremamente satisfeito e devora as nozes com prazer. Você tem a desconfortável
                         sensação de ter sido feito de bobo.";
                    }
                    print "Grato por qualquer comida que consiga, por mais inadequada que seja, o esquilo consome ansiosamente ";
                    if( noun == Ekmek_Special ) {
                        print "o ";
                    }
                    print (the) noun;
                    ". Naturalmente, ele não se sente obrigado a nada com você por causa disso, então não espere nenhum
                     favor.";
                }
                rfalse;
        ],
        initial nothing,
        description "Não é nem um pouco tímido em seu próprio território.",
        article "seu",
  has   animate;

[ DugHoleDesc ;
    if( OldDigX == DigX && OldDigY == DigY ) {
        "^O buraco que você cavou no gramado está bem aqui.";
    }
    print "^Algum vândalo cavou um buraco no gramado, ";
    DescribePaces(OldDigX - DigX,OldDigY - DigY);
    ".";
];

[ DescribePaces x y ;
    if (x ~= 0) {
        DescribePacesPoetically(x);
        if (x > 0) {
            print " leste";
        } else {
            print " oeste";
        }
        if (y ~= 0) {
            print " e ";
        }
    }
    if (y ~= 0) {
        DescribePacesPoetically(y);
        if (y > 0) {
            print " norte";
        } else {
            print " sul";
        }
    }
    rtrue;
];

GRoom  Croquet_Lawn "Gramado de Croqué"      
  with  w_to Hedgery,
        nw_to nothing,
        initial [; DigX = 0; DigY = 0; rfalse; ],
        description [;
            print "Um dos mais belos gramados da Inglaterra, cercado por sebes e abafado por árvores, escondido da casa,
                é uma joia dos jardins há séculos. Desde os anos vinte também é um gramado de croqué, um quadrado
                regulamentar de vinte e quatro jardas, com uma estaca colorida central e seis aros periféricos";
            if( self.nw_to == nothing ) ".";
            ". A sebe está ligeiramente rompida a noroeste.";
        ],
        cant_go "O gramado é cercado por todos os lados, exceto por uma abertura a oeste.",
        short_name [;
            if( DigX == 0 && DigY == 0 ) {
                rfalse;
            }
!            if( before_short_desc == true ) {
!                rfalse;
!            }
            print "Gramado de Croqué (";
            DescribePaces(DigX,DigY);
            print " da estaca)";
            rtrue;
        ],
        section T_GARDEN,
  has   light;

Object -> peg_and_six_hoops "estaca e seis aros" 
  with  name 'peg' 'hoop' 'hoops',
        description "Há seis aros arqueados num conjunto de croqué, dispostos ao redor de uma estaca central. Estes
            estão seguramente ancorados desde que o gramado foi instalado, digamos, no Solstício de Verão de 1923,
            se a tradição familiar merece crédito.",
  has   scenery;

Object strongbox "strongbox"    
  with  name 'strong' 'box' 'strongbox',
        with_key iron_key,
        description "Um baú realmente resistente, enterrado por dois séculos e agora desenterrado; traz uma bela fechadura
            gótica de ferro e um brasão de mau gosto (um javali rampante).",
        angel_hint "Talvez você tenha lido sobre isso. Um de seus ancestrais é a chave, talvez?",
  has   container lockable locked openable;

Object -> golden_astrolabe "golden astrolabe"   
  with  name 'golden' 'gold' 'astrolabe' 'eyepiece',
        before [;
                Remove: if( noun == second ) "Ele está inteiro.";
            Search:
                if( parent(golden_astrolabe) ~= Palace_Balustrade || golden_astrolabe has moved ) 
                    "Você tem um vislumbre fascinante, mas breve demais, de algo cinzento, angular e alto... que sai do
                     campo de visão quando sua mão trêmula se move.";
                print "Pela ocular dourada você vê, não a lua (pois o astrolábio está inclinado baixo demais), mas um
                    curioso triângulo cinzento iluminado pelo sol.^^Fascinado, você se aproxima mais da visão... mais...^";
                PlayerTo(Out_on_the_Spire);
                rtrue;
        ],
        after [; Take: trigger_quotation(43); rfalse; ],
        initial nothing,
        description "Um instrumento muito antigo para medir altitudes, isto é tudo o que resta do tesouro de ouro roubado
            por Sir Joshua Meldrewe. Há uma ocular.",
        angel_hint "Um instrumento magnífico, embora não seja muito útil na mão.",
  has   scored;

Object dug_hole "buraco cavado"      
  with  name 'hole' 'dug',
        before [; Take: "Uma ideia surreal, um tanto reminiscente do filme dos Beatles ~Yellow Submarine~."; ],
        description "A terra rica, a prata das minhocas, a dignidade do trabalho... nenhum desses consolos pastorais é
            seu enquanto você remexe a sujeira.",
        describe DugHoleDesc,
  has   container open static;
