    }
    Achieved(SCORE_HENRIPOST);
    print "^O mecanismo faz um clique. As roldanas puxam. As engrenagens giram. Pequenos trechos de corda correm.^";
    if (CR hasnt general) {
        give CR general;
        print "^A bala de canhao cai da mao metalica na cesta superior, que despenca, 
            lancando a outra cesta para cima, ";
        j = child(hanging_cord);
        if (j == 0) {
            "mas ela deve ter estado vazia.";
        }
        j = sibling(j);
        print "e projetando ";
        if (j == 0) {
            print "algo";
        } else {
            print "algumas coisas";
        }
        print " pelo buraco no canto.^";
        if (CR has light) {
            j = child(hanging_cord);
          .label129019;
            if (j ~= 0) {
                i = sibling(j);
                move j to Lawn_Ornaments;
                j = i;
                jump label129019;
            }
            move ancient_well to Lawn_Ornaments;
        } else {
            print "^Um momento depois, porem, ouve-se um baque distante, mas alto. Logo depois, algo 
                despenca pelo buraco (numa chuva de gesso branco fino) para dentro da cesta superior,
                que, gracas a uma maquinaria fantastica, volta a descer, lancando a bala de canhao pela outra ponta
                para o ar.^^A mao metalica pega a bala de canhao com perfeicao.^";
            give CR ~general;
        }
        if (parent(golden_orb) == hanging_cord) {
            move glowing_golden_orb to CR;
        } else {
            remove glowing_golden_orb;
        }
    }
    rtrue;
];

[ SailSub ;
    if (player notin skiff) 
        "Voce nao esta em nenhum meio de transporte adequado.";
    if (skiff in Warehouses_and_Port || skiff in Garden_Stream) {
        if (skiff in Warehouses_and_Port) {
            move skiff to Garden_Stream;
            location = Garden_Stream;
        } else {
            move skiff to Warehouses_and_Port;
            location = Warehouses_and_Port;
        }
        print "O bote apanha vento de algum lugar, que assobia ao seu redor ate seus olhos ficarem turvos e lacrimejantes. 
            Quando olha em volta, voce descobre que esta atracado novamente...^";
        << Look >>;
    }
    if (skiff has general) 
        "Parece que isso esta acontecendo goste voce ou nao.";
    give skiff general;
    move skiff to Harbour_Mouth;
    location = Harbour_Mouth;
    print "Voce zarpa, e uma brisa leve impulsiona seu bote...^";
    << Look >>;
];

[ JumpSub ;
    if( Austin in location ) {
        if( game_section == T_ALEXANDRIA ) {
            "Austin esta completamente tranquilo.";
        }
        print "Por alguma razao, Austin se assusta e salta para salvar a vida ";
        trigger_quotation(7);
        if( location == Souvenirs_Room && charcoal_sketch in slide_projector && south_wall hasnt concealed ) {
            move Austin to Causeway;
            Achieved(SCORE_AUSTIN);
            "direto pela parede sul e para dentro de Alexandria!";
        }
        AustinMovements(true);
        rfalse;
    }
    L__M(##Jump);
    rtrue;
];


[ HintsSub ;
    "Ha dicas incorporadas a este jogo, mas voce tera de descobrir sozinho como obte-las.";
];

