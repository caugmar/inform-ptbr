    if( game_section == T_UNREAL ) print "E de madrugada em 5 de outubro de 1922, e voce esta na Cidade Irreal.";
    if( game_section == T_HAMBURG ) print "E quase meia-noite de 31 de outubro de 1988, e voce esta num museu em Hamburgo.";
    if( game_section == T_TAROT ) print "Voce atravessa o estranho mundo sobrenatural da caixa de Taro.";
    if( game_section == T_GARDEN ) print "E a tarde de 3 de junho de 1993, e voce esta nos jardins.";
    if( game_section == T_GARDEN_PAST ) print "E quase meio-dia de 14 de marco de 1808, e voce esta nos jardins.";
    if( game_section == T_ANCIENT_BRITAIN ) print "Estamos em algum momento do seculo VI d.C., e voce esta no Jogo Mestre.";
    if( game_section == T_DREAMING or (T_DREAMING|T_UNREAL) ) print "O tempo parece nao ter significado, e voce esta sonhando.";
    if( game_section == T_CATACOMBS ) print "E a tarde de 3 de junho de 1993, e voce esta nas catacumbas sob os jardins.";
    if( game_section == T_ALEXANDRIA ) print "Estamos em algum momento do inverno de 275 a.C., no reinado de Ptolomeu II, e voce esta na Alexandria antiga.";
    if( game_section == T_NE_OF_HOME ) print "E a tarde de 3 de junho de 1993, e voce esta a nordeste do Solar Meldrew.";
    if( game_section == T_SPIRIT_WORLD ) print "Voce esta no Mundo dos Espiritos, seculos a frente de seu corpo adormecido.";
    if( game_section == T_AFTERLIFE ) print "Na grande Prisao do alem-vida do tabuleiro de Banco Imobiliario, voce esta ~Apenas Visitando~.";
    rtrue;
];

