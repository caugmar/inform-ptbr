[ FullScoreSub ndx score_var ;  
    ScoreSub();
    if( score == 0 ) {
        rfalse;
    }
    new_line;
    L__M(##FullScore,1);
    ndx = 0;
    while( ndx < 45 ) {
        if( task_done->ndx == 1 ) {
            if( ndx == 21 ) {
                PANum(65486);
                score_var = score_var - 50;
            } else {
                PANum(task_scores->ndx);
                score_var = score_var + task_scores->ndx;
            }
            PrintTaskName(ndx);
        }
        ++ndx;
    }
    if( rod_score ~= 0 ) {
        PANum(rod_score);
        print "descobrindo varas^";
    }
    if( things_score ~= 0 ) {
        PANum(things_score);
        L__M(##FullScore,2);
    }
    if( places_score ~= 0 ) {
        PANum(places_score);
        L__M(##FullScore,3);
    }
    if( good_try_bonus ~= 0 ) {
        PANum(5);
        print "bonus por uma boa tentativa^";
        score_var = score_var + 5;
    }
    score_var = score_var + rod_score + things_score + places_score;
    if( score == 65437 ) {
        score_var = 0 - score_var - 99;
        PANum(score_var);
        print "destruindo o universo^";
    }
    new_line;
    PANum(score);
    L__M(##FullScore,4);
    if( deadflag == WON && task_done->11 == 0 ) {
        "^Infelizmente, voce perdeu o bonus de 50 pontos por resgatar Andromeda.";
    }
    rtrue;
];

[ WaveSub r ;
    if (noun notin player) {
        "Mas voce nao esta segurando isso.";
    }
    if (noun has hidden_rod) {
        if (daisy_chain in player && daisy_chain has worn && daisy_chain.number == 1) {
            score = score + 6;
            rod_score = rod_score + 6;
            print "A luz pulsa ao redor da corrente de margaridas, entao salta para envolver ", (the) noun, " que derrete e se transforma em ";
            remove noun;
            r = noun.rod_assoc;
            itobj = r;
            give r moved;
            give r unidentifed_rod;
            move r to player;
            print (a) r;
            "!";
        }
        if (yellow_daisy in player && yellow_daisy has worn) {
            score = score + 6;
            rod_score = rod_score + 6;
            print "A luz pulsa da margarida atras da sua orelha, saltando para envolver ", (the) noun, " que derrete e se transforma em ";
            remove noun;
            r = noun.rod_assoc;
            itobj = r;
            give r moved;
            move r to player;
            if (r has rod_attr) {
                print (the) r;
            } else {
                print (a) r;
            }
            "!";
        }
    }
    if (noun has rod_attr) {
        "Parece que nao e bem assim que elas funcionam...";
    }
    if (noun has worn) {
        "Voce nao pode agitar o que esta vestindo.";
    }
    print "Voce parece ridiculo agitando ";
    Defart(noun);
    ".";
];

