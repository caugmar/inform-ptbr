[ readchar s i j k ;
    j = wn * 4 + 1;
    k = parse->j;
    s = k + buffer;
    i = parse->(j - 1);
    if (i ~= true) {
        return -1;
    }
    j = -1;

    if (s->0 >= 97 && s->0 <= 122) {
        j = s->0 - 97 + 1;
    }
    if (s->0 >= 65 && s->0 <= 90) {
        j = s->0 - 65 + 1;
    }
    if (j == -1) {
        return -1;
    }
    parsed_number = j;
    ++wn;
    return 1;
];

[ SlideSub i j col;
    if (location ~= CR) {
        "~Deslizar~ nao e apropriado aqui.";
    }
    if (noun == nothing) {
        "Que peca foi essa?";
    }
    i = 0;
  .label128490;
    if (i <= 14) {
        if (henri_post_array->i == noun) {
            if (i >= 3) {
                j = i - 3;
                if (henri_post_array->j == 0) {
                    jump label128652;
                }
            }
            if (i < 12) {
                j = i + 3;
                if (henri_post_array->j == 0) {
                    jump label128652;
                }
            }
            col = i % 3;
            if (col ~= 0) {
                j = i - 1;
                if (henri_post_array->j == 0) {
                    jump label128652;
                }
            }
            if (col ~= 2) {
                j = i + 1;
                if (henri_post_array->j == 0) {
                    jump label128652;
                }
            }
        }
        ++i;
        jump label128490;
    }
    print "Infelizmente, '" , (char) noun + 65 - 1, "' nao esta adjacente ao espaco vazio.";
    new_line;
    rtrue;
  .label128652;
    ++slide_moves;
    if (slide_moves == 8) {
        trigger_quotation(36);
    }
    if (slide_moves == 5) {
        trigger_quotation(42);
    }
    col = henri_post_array->i;
    henri_post_array->j = col;
    henri_post_array->i = 0;
    print "Voce desliza '" , (char) noun + 65 - 1, "' para o espaco vazio, deixando a grade assim:^^";
    DisplayWholeGrid();
