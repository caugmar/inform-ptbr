[ DigSub ;
    if( spade notin player ) "Voce nao tem nenhuma ferramenta adequada a mao.";
    if( location == Vegetable_Garden or Maze_Foundations ) "Voce so consegue remexer ainda mais a terra.";
    if( location == Mosaic ) "Arqueologia nao e para amadores!";
    if( location == Beside_the_Drive ) "O cascalho e fino e esta sobre concreto.";
    if( location == Up_the_Plane_Tree ) "Surreal!";
    if( location ~= Croquet_Lawn ) "O solo nao serve.";

    if( DigX == 0 && DigY == 0 ) 
        "Voce certamente nao quer cavar aqui, bem no meio de um gramado tao bonito. A estaca cairia, e isso nao pode acontecer.";
    if( DigX == OldDigX && DigY == OldDigY ) "Ja existe um buraco exatamente neste ponto do gramado.";

    OldDigX = DigX;
    OldDigY = DigY;
    print "Voce cava um pequeno buraco vigoroso na grama excelente";
    if( dug_hole in Croquet_Lawn ) {
        print ", enchendo o anterior com a terra retirada";
        while( child(dug_hole) ~= nothing ) {
            remove child(dug_hole);
            dig_cnt = 2;
        }
    }
    if( DigX == StrongboxX && DigY == StrongboxY && strongbox hasnt moved ) {
        print ", ate sua pa bater em algo solido";
        move strongbox to dug_hole;
        Achieved(SCORE_STRONGBOX);
    } else if( dig_cnt == 1 ) {
        dig_cnt = 0;
        print ", sem encontrar o que quer que voce tenha enterrado";
    }
    move dug_hole to Croquet_Lawn;
    if( dig_cnt == 2 ) {
        dig_cnt = 1;
    }
    ".";
];

