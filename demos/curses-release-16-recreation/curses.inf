Include "Parser";
Global hint_menu;
[ HelpSub ;
    if( hints_in_a_row == 0 ) {
        hints_in_a_row = 1;
        print "Há dicas incorporadas a este jogo, mas você terá de descobrir sozinho como obtê-las.^";
        "Se você estiver realmente perdido, digite DICAS novamente para acessar o sistema completo de dicas. Mas só faça isso se você estiver REALMENTE perdido, porque vai afetar sua experiência do jogo.";
    }
    hints_in_a_row = 0;
    hint_menu.select();
];
Include "Utility";
