Include "Parser";
Global hint_menu;
[ HelpSub ;
    if( hints_in_a_row == 0 ) {
        hints_in_a_row = 1;
        print "Ha dicas incorporadas a este jogo, mas voce tera de descobrir sozinho como obte-las.^";
        "Se você estiver realmente perdido, digite DICAS novamente para acessar o sistema completo de dicas. Mas só faça isso se você estiver REALMENTE perdido, porque vai afetar sua experiência do jogo.";
    }
    hints_in_a_row = 0;
    hint_menu.select();
];
