[ Initialise; ;
    StartSplash();
    hint_menu = menu_de_dicas;
    location = Attic;

    #Ifdef DEBUG;
    deterministic_transportation = 1;
    #Endif;

    move crumpled_piece_of_paper to player;
    move electric_torch to player;
    move chocolate_biscuit to player;

    StartDaemon(electric_torch);

    InsertCardIntoDeck(Drowned_Sailor_card);
    InsertCardIntoDeck(Fool_card);
    InsertCardIntoDeck(Death_card);

    StrongboxX = random(18) - 9;
    StrongboxY = random(18) - 9;

    "^^^^Agora é uma questão de orgulho não desistir. O mapa turístico de Paris deve estar em algum lugar aqui em meio a toda esta bagunça, mesmo que já faça cinco anos desde sua última viagem. E a culpa é sua. Parece que seu bisavô foi a última pessoa a arrumar estes sótãos...^";
];

[ trigger_quotation i ;
    if (quote_flag_set->i == 0) {
        quote_flag_set->i = 1;
        quote_selection = i;
    }
    rtrue;
];

[ GoodTry ;
    if( one_time_try_bonus == true ) {
        rtrue;
    }
    one_time_try_bonus = true;
    redraw_statusline = true;
    StartTimer(Old_Winery,4);
    score = score + 5;
    good_try_bonus = 1;
    "^Seria uma pena ver uma tentativa tão boa sem recompensa... vá em frente, fique com cinco pontos extras.";
];

[ GoodTryRevoked ;
    if( good_try_bonus == 1 ) {
        score = score - 5;
        good_try_bonus = 0;
        "^Nestas circunstâncias, o bônus de cinco pontos foi perdido.";
    }
    rtrue;
];

[ DarkToDark ;
    deadflag = DIED;
    if( game_section ~= T_MODERN ) {
        "Enquanto você avança trôpego pela escuridão, o ar fica gélido e sussurra em línguas secretas. De repente, um enorme urso se ergue diante de você e golpeia ferozmente com a pata!";
    }
    deadflag = FAILED;
    print "Enquanto você se atrapalha imprudentemente no escuro, ";
    if( location == Priests_Hole ) 
        "você escorrega por uma passagem lateral da chaminé, cada vez mais para baixo, e aterrissa às cegas numa nuvem de fuligem na lareira da sala no andar inferior. Felizmente, sua família está por perto para limpá-lo e mandá-lo de volta a fazer as malas.";

! TODO: handle this
    if( location >= 123 ) 
        "você perde o equilíbrio, tropeça e bate a cabeça... Algum tempo depois, acorda no hospital, muito confuso e sem estar de férias. Felizmente, Tia Jemima visita você todas as tardes com muitas tarefas...";
    "você pisa em falso e atravessa um telhado fino de gesso, caindo felizmente sobre a cama de um dos quartos do andar de cima. Anos depois, a família transforma em piada o fato de você ter demolido metade da casa por causa de um velho mapa turístico.";
];

Object carbolic_soap "carbolic soap"
  with  name 'soap' 'carbolic',
        before [; Eat: << Wash self >>; ],
        description "~For foulmouths everywhere~.",
        article "um pedaço de",
        devil_hint "Esse é o espírito, continue assim!",
        angel_hint "Really!  How disgraceful!",
  has   concealed;

[ PrintRank s ndx ;     
    print ", dando a voce o posto de ";
    s = score;
    if (s ~= 65437 && task_done->11 ~= 0) {
        s = s - 50;
    }
    ndx = 1;
    while (ndx <= rank_levels-->0 * 2) {
        if (s >= rank_levels-->ndx) {
            print (string) rank_levels-->(ndx + 1);
            new_line;
            rtrue;
        }
        ndx = ndx + 2;
    }
    rtrue;
];

