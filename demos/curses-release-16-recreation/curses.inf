    if( n == SCORE_KNIGHT_ENCOURAGE ) {
        "encorajando o cavaleiro";
    }
    if( n == SCORE_HIGHROD ) {
        "escolhendo uma Vara Superior";
    }
    "** Nameless task **";
];

[ DeathMessage ;
    if( deadflag == FAILED ) {
        print "Você perdeu completamente o sentido da coisa";
    }
    if( deadflag == DESTROYED_UNIVERSE ) {
        print "Você desincorporou o universo inteiro";
    }
    if( deadflag == AUSTRALIA ) {
        print "Você foi transportado para a Austrália";
    }
    if( deadflag == PARADOX ) {
        print "Você foi aniquilado por um paradoxo temporal";
    }
    if( deadflag == MYTH ) {
        print "Você se tornou uma constelação";
    }
    if( deadflag == PRISON ) {
        print "Você foi preso como terrorista";
    }
    if( deadflag == CHECKMATED ) {
        print "Você sofreu xeque-mate";
    }
    if( deadflag == SPOOKED ) {
        print "Você levou um susto";
    }
    rtrue;
];

[ display_quote n ;     
    redraw_statusline = true;
    if (n == 0) {
        quote_line-->0 = "Quatro são as coisas que eu estaria melhor sem:";
        quote_line-->1 = "Amor, curiosidade, sardas e dúvida.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Dorothy Parker, ~Inventory~";
        quote_display(4,43,quote_line);
    }
    if (n == 1) {
        quote_line-->0 = "Parecia que no minuto seguinte descobririam";
        quote_line-->1 = "uma solução. Mas estava claro para ambos que";
        quote_line-->2 = "o fim ainda estava muito, muito distante, e que a";
        quote_line-->3 = "parte mais difícil estava apenas começando.";
        quote_line-->4 = 0;
        quote_line-->5 = "-- Anton Chekhov, ~The Lady with the Dog~";
        quote_display(6,50,quote_line);
    }
    if (n == 2) {
        quote_line-->0 = "                           O rato";
        quote_line-->1 = "Gritou atrás do lambril apodrecido.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Alfred, Lord Tennyson, ~Mariana~";
        quote_display(4,40,quote_line);
    }
    if (n == 3) {
        quote_line-->0 = "As montanhas estão em trabalho de parto, nascerá um rato ridículo.";
        quote_line-->1 = 0;
        quote_line-->2 = "-- Horace, ~Ars Poetica~";
        quote_display(3,42,quote_line);
    }
    if (n == 4) {
        quote_line-->0 = "Zeus, cuja vontade traçou para o homem";
        quote_line-->1 = "Um único caminho onde reside a sabedoria,";
        quote_line-->2 = "Ordenou um plano eterno:";
        quote_line-->3 = "O homem deve sofrer para ser sábio.";
        quote_line-->4 = 0;
        quote_line-->5 = "-- Aeschylus, ~Agamemnon~";
        quote_display(6,35,quote_line);
    }
    if (n == 5) {
        quote_line-->0 = "Eu poderia repetir para mim mesma, lenta e suavemente,";
        quote_line-->1 = "uma lista de belas citações de mentes profundas;";
        quote_line-->2 = "se conseguir lembrar de alguma dessas malditas coisas.";
        quote_line-->3 = 0;
        quote_line-->4 = "-- Dorothy Parker";
        quote_display(5,51,quote_line);
    }
    if (n == 6) {
        quote_line-->0 = "Há mais maneiras de matar um gato";
        quote_line-->1 = "do que sufocá-lo com creme.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Charles Kingsley";
        quote_display(4,28,quote_line);
    }
    if (n == 7) {
        quote_line-->0 = "Eu gostaria de estar lá,";
        quote_line-->1 = "nem que fosse para ver como o gato pula.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Sir Walter Scott";
        quote_display(4,37,quote_line);
    }
    if (n == 8) {
        quote_line-->0 = "Não entre mansamente nessa boa noite.";
        quote_line-->1 = "Revolte-se, revolte-se contra o apagar da luz.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Dylan Thomas";
        quote_display(4,42,quote_line);
    }
    if (n == 9) {
        quote_line-->0 = "Não, não é tão profundo quanto um poço, nem tão largo quanto";
        quote_line-->1 = "a porta de uma igreja; mas basta, servirá.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Shakespeare, ~Romeo and Juliet~";
        quote_display(4,46,quote_line);
    }
    if (n == 10) {
        quote_line-->0 = "...acabei de assinar uma lei que banirá";
        quote_line-->1 = "a Rússia para sempre. Começamos a bombardear em cinco minutos.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Presidente Reagan, acreditando por engano que as câmeras";
        quote_line-->4 = "   de TV estavam desligadas";
        quote_display(5,51,quote_line);
    }
    if (n == 11) {
        quote_line-->0 = "O que é um navio senão uma prisão?";
        quote_line-->1 = 0;
        quote_line-->2 = "-- Robert Burton (1577-1640)";
        quote_display(3,28,quote_line);
    }
    if (n == 12) {
        quote_line-->0 = "O fato extraordinário é que os valores desses";
        quote_line-->1 = "números foram ajustados com extrema precisão";
        quote_line-->2 = "para permitir o desenvolvimento da vida.";
        quote_line-->3 = 0;
        quote_line-->4 = "-- Stephen Hawking, ~A Brief History of Time~";
        quote_display(5,47,quote_line);
    }
    if (n == 13) {
        quote_line-->0 = "Lembre-se de que você é inglês e, portanto,";
        quote_line-->1 = "ganhou o primeiro prêmio na loteria da vida.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Cecil Rhodes (1853-1902)";
        quote_display(4,52,quote_line);
    }
    if (n == 14) {
        quote_line-->0 = "Les plus desesperes sont les chants les plus beaux";
        quote_line-->1 = "Et j'en sais d'immortels quit sont de purs songlots.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Alfred de Musset, ~La Nuit de mai~";
        quote_display(4,52,quote_line);
    }
    if (n == 15) {
        quote_line-->0 = "Não há partida de volta entre um homem e suas estrelas.";
        quote_line-->1 = 0;
        quote_line-->2 = "-- Samuel Beckett, ~Murphy~";
        quote_display(3,52,quote_line);
    }
    if (n == 16) {
        quote_line-->0 = "Joga fora tua vara,";
        quote_line-->1 = "Joga fora tua ira:";
        quote_line-->2 = "Ó meu Deus.";
        quote_line-->3 = "Segue o caminho gentil.";
        quote_line-->4 = 0;
        quote_line-->5 = "-- George Herbert, ~Discipline~";
        quote_display(6,31,quote_line);
    }
    if (n == 17) {
        quote_line-->0 = "Fala suavemente, ela pode ouvir";
        quote_line-->1 = "As margaridas crescem.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Oscar Wilde, ~Requiescat~";
        quote_display(4,28,quote_line);
    }
    if (n == 18) {
        quote_line-->0 = "Pobre demais para um suborno e orgulhoso demais para importunar,";
        quote_line-->1 = "ele não tinha o método de fazer fortuna.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Thomas Grey, ~Sketch of His own Character~";
        quote_display(4,48,quote_line);
    }
    if (n == 19) {
        quote_line-->0 = "Facilis descensus Averno:";
        quote_line-->1 = "Noctes atque dies patet atri ianua Ditis;";
        quote_line-->2 = "Sed revocare gradum superasque evadere ad auras,";
        quote_line-->3 = "Hoc opus, hic labor est.";
        quote_line-->4 = 0;
        quote_line-->5 = "-- Virgílio, ~A Eneida~, Livro VI:126";
        quote_display(6,48,quote_line);
    }
    if (n == 20) {
        quote_line-->0 = "Somos filhos da noite primeva; carregamos";
        quote_line-->1 = "o nome de Maldições em nosso lar profundo sob a terra.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Aeschylus, ~The Eumenides~";
        quote_display(4,48,quote_line);
    }
    if (n == 21) {
        quote_line-->0 = "Fazes sua beleza desaparecer,";
        quote_line-->1 = "como uma traça que rói uma vestimenta:";
        quote_line-->2 = "portanto, todo homem é apenas vaidade.";
        quote_line-->3 = 0;
        quote_line-->4 = "-- Psalms 39:12 (Book of Common Prayer version)";
        quote_display(5,47,quote_line);
    }
    if (n == 22) {
        quote_line-->0 = "O lilás branco se curvou,";
        quote_line-->1 = "As vielas perdidas da renda-da-rainha";
        quote_line-->2 = "E aquela nuvem alta";
        quote_line-->3 = "Movendo-se ao ritmo do verão.";
        quote_line-->4 = 0;
        quote_line-->5 = "-- Philip Larkin, ~Cut Grass~";
        quote_display(6,31,quote_line);
    }
    if (n == 23) {
        quote_line-->0 = "Ao fim do dia, a vitória pertence às Maldições,";
        quote_line-->1 = "que gritam em triunfo estridente";
        quote_line-->2 = "sobre a derrota completa da casa vencida.";
        quote_line-->3 = 0;
        quote_line-->4 = "-- Aeschylus, ~Seven Against Thebes~";
        quote_display(5,52,quote_line);
    }
    if (n == 24) {
        quote_line-->0 = "Ele os separará uns dos outros,";
        quote_line-->1 = "como um pastor separa suas ovelhas dos bodes.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Matthew 25:32";
        quote_display(4,48,quote_line);
    }
    if (n == 25) {
        quote_line-->0 = "Agora, rapidamente, o âmbar";
        quote_line-->1 = "  captura a mosca de joelhos desordenados";
        quote_line-->2 = "para ser enterrada sem ser vista, sem ser encontrada";
        quote_line-->3 = "  e irrevogavelmente transformada.";
        quote_line-->4 = 0;
        quote_line-->5 = "-- Dean Waynflete, ~Substance~";
        quote_display(6,35,quote_line);
    }
    if (n == 26) {
        quote_line-->0 = "Assim o diabo jogou xadrez comigo e, cedendo";
        quote_line-->1 = "um peão, pensou obter de mim uma rainha, aproveitando-se";
        quote_line-->2 = "de meus esforços honestos.";
        quote_line-->3 = 0;
        quote_line-->4 = "-- Sir Thomas Browne, ~Religio Medici~ pt I";
        quote_display(5,52,quote_line);
    }
    if (n == 27) {
        quote_line-->0 = "Estás pálido de cansaço";
        quote_line-->1 = "de subir ao céu e contemplar a terra?";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Shelley, ~To The Moon~";
        quote_display(4,43,quote_line);
    }
    if (n == 28) {
        quote_line-->0 = "Uma donzela simpática, respeitável, de classe média e meia-idade,";
        quote_line-->1 = "com tempo disponível e dinheiro para passá-lo,";
        quote_line-->2 = "digamos... Tia Edna... Tia Edna é universal,";
        quote_line-->3 = "e para aqueles que acham que todos os problemas do";
        quote_line-->4 = "teatro moderno se resolveriam com sua liquidação, acrescento";
        quote_line-->5 = "que... ela também é imortal.";
        quote_line-->6 = 0;
        quote_line-->7 = "-- Terence Rattigan, preface to the ~Collected Plays~";
        quote_display(8,60,quote_line);
    }
    if (n == 29) {
        quote_line-->0 = "Parecia mover-me entre um mundo de fantasmas,";
        quote_line-->1 = "e sentir-me a sombra de um sonho.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Alfred, Lord Tennyson, ~The Princess~";
        quote_display(4,41,quote_line);
    }
    if (n == 30) {
        quote_line-->0 = "Se as portas da percepção fossem purificadas,";
        quote_line-->1 = "tudo apareceria ao homem como é, infinito.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- William Blake";
        quote_display(4,50,quote_line);
    }
    if (n == 31) {
        quote_line-->0 = "Siga as instruções,";
        quote_line-->1 = "diga-nos o que pensa:";
        quote_line-->2 = "elas perdem algo na tradução,";
        quote_line-->3 = "poderiam muito bem estar escritas em tinta invisível.";
        quote_line-->4 = 0;
        quote_line-->5 = "-- Peter Hammill, ~Invisible Ink~";
        quote_display(6,47,quote_line);
    }
    if (n == 32) {
        quote_line-->0 = "Numa esfera redonda";
        quote_line-->1 = "Um artesão que tenha modelos pode desenhar";
        quote_line-->2 = "Uma Europa, uma África e uma Ásia,";
        quote_line-->3 = "e rapidamente tornar tudo aquilo que era nada.";
        quote_line-->4 = 0;
        quote_line-->5 = "-- John Donne, ~Valediction: Of Weeping~";
        quote_display(6,46,quote_line);
    }
    if (n == 33) {
        quote_line-->0 = "O que você não sabe daria um ótimo livro.";
        quote_line-->1 = 0;
        quote_line-->2 = "-- The Rev. Sydney Smith";
        quote_display(3,44,quote_line);
    }
    if (n == 34) {
        quote_line-->0 = "Sir Walter Elliot, de Kellynch-hall, em Somersetshire,";
        quote_line-->1 = "era um homem que, para seu próprio divertimento, jamais pegava";
        quote_line-->2 = "outro livro senão o Baronetage; ali encontrava ocupação";
        quote_line-->3 = "numa hora ociosa e consolo numa hora angustiada.";
        quote_line-->4 = 0;
        quote_line-->5 = "-- Jane Austen, ~Persuasion~";
        quote_display(6,54,quote_line);
    }
    if (n == 35) {
        quote_line-->0 = "Sou o Amor que não ousa dizer seu nome.";
        quote_line-->1 = 0;
        quote_line-->2 = "-- Lord Alfred Douglas, ~Two Loves~";
        quote_display(3,43,quote_line);
    }
    if (n == 36) {
        quote_line-->0 = "'Inclino-me a pensar -' disse eu.";
        quote_line-->1 = "'Eu faria isso', observou Sherlock Holmes";
        quote_line-->2 = "impacientemente.";
        quote_line-->3 = 0;
        quote_line-->4 = "-- Sir Arthur Conan Doyle, ~The Valley of Fear~";
        quote_display(5,47,quote_line);
    }
    if (n == 37) {
        quote_line-->0 = "O inferno é uma cidade muito parecida com Londres -";
        quote_line-->1 = "Uma cidade populosa e enfumaçada.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Shelley, ~Peter Bell the Third~";
        quote_display(4,34,quote_line);
    }
    if (n == 38) {
        quote_line-->0 = "Espero nunca ser impedido de denunciar";
        quote_line-->1 = "o que considero uma fraude pelas ameaças de um canalha.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Dr Johnson (a letter from 1775)";
        quote_display(4,50,quote_line);
    }
    if (n == 39) {
        quote_line-->0 = "Passeia livremente por toda esta cena humana;";
        quote_line-->1 = "Um labirinto imenso! mas não sem um plano.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Alexander Pope, ~An Essay on Man~";
        quote_display(4,42,quote_line);
    }
    if (n == 40) {
        quote_line-->0 = "É difícil ser religioso quando certas pessoas";
        quote_line-->1 = "jamais são incineradas por raios.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Bill Watterson, ~Calvin & Hobbes~";
        quote_display(4,45,quote_line);
    }
    if (n == 41) {
        quote_line-->0 = "Siga-me, siga";
        quote_line-->1 = "até a depressão";
        quote_line-->2 = "e ali vamos chafurdar";
        quote_line-->3 = "na lama gloriosa.";
        quote_line-->4 = 0;
        quote_line-->5 = "-- Flanders and Swann";
        quote_display(6,23,quote_line);
    }
    if (n == 42) {
        quote_line-->0 = "Zoe, a lógica apenas permite";
        quote_line-->1 = "estar errado com autoridade";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Dr Who, aboard ~The Wheel In Space~";
        quote_display(4,38,quote_line);
    }
    if (n == 43) {
        quote_line-->0 = "Pois, como diz um filósofo,";
        quote_line-->1 = "~ele se envolve no amigo que se dispõe";
        quote_line-->2 = "às justas preces de seu amigo,~";
        quote_line-->3 = "por isso te dei um astrolábio suficiente";
        quote_line-->4 = "para nosso horizonte, composto segundo a";
        quote_line-->5 = "latitude de Oxford;";
        quote_line-->6 = 0;
        quote_line-->7 = "-- Geoffrey Chaucer, ~A Treatise on the Astrolabe~";
        quote_display(8,50,quote_line);
    }
    if (n == 44) {
        quote_line-->0 = "Certa noite, ao deitar-se para dormir,";
        quote_line-->1 = "pareceu-lhe que o deus alado Mercúrio";
        quote_line-->2 = "estava diante dele e o mandava alegrar-se.";
        quote_line-->3 = "Trazia erguido na mão seu bastão sonolento;";
        quote_line-->4 = "usava um chapéu sobre seus cabelos brilhantes.";
        quote_line-->5 = 0;
        quote_line-->6 = "-- Geoffrey Chaucer, ~The Knight's Tale~";
        quote_display(7,45,quote_line);
    }
    if (n == 45) {
        quote_line-->0 = "Benedick:";
        quote_line-->1 = "  Para me prender ou desfazer, uma dessas.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Shakespeare, ~Much Ado About Nothing~";
        quote_display(4,40,quote_line);
    }
    if (n == 46) {
        quote_line-->0 = "Na vitrine central há um curioso";
        quote_line-->1 = "modelo de cerâmica, representando talvez o Labirinto";
        quote_line-->2 = "de Minos ou um sistema de resfriamento de água.";
        quote_line-->3 = 0;
        quote_line-->4 = "-- W. J. Murnane's ~Guide to Ancient Egypt~";
        quote_display(5,48,quote_line);
    }
    if (n == 47) {
        quote_line-->0 = "Não sei quem esteve aqui antes de mim:";
        quote_line-->1 = "Uma pessoa, várias, nenhuma;";
        quote_line-->2 = "Isso não importa.";
        quote_line-->3 = "Há marcas nas lajes de pedra,";
        quote_line-->4 = "algumas belas, todas misteriosas;";
        quote_line-->5 = "algumas certamente não feitas por mãos humanas.";
        quote_line-->6 = 0;
        quote_line-->7 = "-- Primo Levi, ~A Valley~";
        quote_display(8,39,quote_line);
    }
    if (n == 48) {
        quote_line-->0 = "Sempre me pareceu que eu tinha de responder";
        quote_line-->1 = "às perguntas que o destino fizera a meus antepassados,";
        quote_line-->2 = "e que ainda não haviam sido respondidas, como se eu";
        quote_line-->3 = "tivesse de completar, ou talvez continuar, coisas que";
        quote_line-->4 = "eras anteriores haviam deixado inacabadas.";
        quote_line-->5 = 0;
        quote_line-->6 = "-- Carl Jung, ~Memories, Dreams, Reflections~";
        quote_display(7,50,quote_line);
    }
    rtrue;
];

[ StartSplash i generic_globvar ;
    @erase_window 65535;
    print "^^^^^^^^^^^^^";
    i = 0->33;
    if( i == 0 ) {
        i = 80;
    }
    i = (i - 50) / 2;
    style bold;
    0-->8 = 2 | 0-->8;
    generic_globvar = i;
    while( generic_globvar >= 1 ) {
        print " ";
        generic_globvar = generic_globvar - 1;
        if( generic_globvar == 0) break;
    }
    print "               Bem-vindo a MALDIÇÕES^";
    style roman;
    print "^^";
    generic_globvar = i;
    while( generic_globvar >= 1 ) {
        print " ";
        generic_globvar = generic_globvar - 1;
        if( generic_globvar == 0) break;
    }
    print "         [Pressione ESPAÇO para começar.]^";
    0-->8 = 65533 & 0-->8;
    i = random(3);
    if( i == 1 ) {
        quote_line-->0 = "Nove vezes ela agitou ao redor o véu esvoaçante,";
        quote_line-->1 = "e fez um pequeno pedaço de chão mágico.";
        quote_line-->2 = "E nesse círculo de margaridas, dizem os homens,";
        quote_line-->3 = "Merlim é prisioneiro até o dia do julgamento...";
        quote_line-->4 = 0;
        quote_line-->5 = "-- Matthew Arnold, Tristram and Iseult III (1852)";
        generic_globvar = quote_display(6,49,quote_line);
    }
    if( i == 2 ) {
        quote_line-->0 = "Maldições são como galinhas jovens,";
        quote_line-->1 = "sempre voltam para dormir no poleiro.";
        quote_line-->2 = 0;
        quote_line-->3 = "-- Robert Southey (1774-1843),";
        quote_line-->4 = "   ~The Curse of Kehama~";
        generic_globvar = quote_display(5,31,quote_line);
    }
    if( i == 3 ) {
        quote_line-->0 = "Que Roma derreta no Tibre, e caia o amplo arco";
        quote_line-->1 = "do império disposto! Aqui está meu espaço.";
        quote_line-->2 = "Reinos são barro.";
        quote_line-->3 = 0;
        quote_line-->4 = "-- Shakespeare, ~Antony and Cleopatra~ I:1";
        generic_globvar = quote_display(5,44,quote_line);
    }
    do {
        @read_char 1 0 0 -> i;
    } until(  i == 32 or 10 or 13 );
    @erase_window 65535;
    rtrue;
];

[ DrawStatusLine columns c2 tmpvar ;
    columns = 0->33;
    if (columns == 0) {
        columns = 80;
    }
    0-->8 = 2 | 0-->8;
    if (pretty_flag == true) {
        @split_window 2;
    } else {
        @split_window 1;
    }
    @buffer_mode false;
    @set_window 1;
    style reverse;
    if (current_game_sec ~= location.section) {
        redraw_statusline = true;
    }
    current_game_sec = location.section;
    if (deadflag > 0 || just_undone == 1) {
        redraw_statusline = true;
    }
    if (redraw_statusline == true) {
        @set_cursor 1 1;
        tmpvar = columns;
        spaces tmpvar;
        if (pretty_flag == true) {
            @set_cursor 2 1;
            tmpvar = columns;
            spaces tmpvar;
        }
    }
    if (redraw_statusline == true || short_loc_var ~= location) {
        @set_cursor 1 2;
        before_short_desc = true;
        PrintShortName(location);
        before_short_desc = false;
        tmpvar = 20;
        spaces tmpvar;
        short_loc_var = location;
        redraw_statusline = true;
    }
    if (pretty_flag == false) {
        c2 = columns - 15;
        @set_cursor 1 c2;
        save_score = score;
        print score, "/", turns, "   ";
    } else {
        if (redraw_statusline == true) {
            c2 = columns - 35;
            @set_cursor 1 c2;
            if (deadflag > 0) {
                print "Pontuação final: ";
            } else {
                print "Pontuação: ";
            }
        } else {
            c2 = columns - 28;
            @set_cursor 1 c2;
        }
        if (redraw_statusline == true || save_score ~= score) {
            print score;
            if (deadflag > 0) {
                print "/550";
            }
        }
        @set_cursor 2 c2;
        if (redraw_statusline == true) {
                print "Turnos: ";
        }
        print turns;
        if (redraw_statusline == true || save_game_sec ~= game_section) {
            game_section = location.section;
            c2 = columns - 20;
            @set_cursor 2 c2;
            if (game_section == T_MODERN) {
                print "    3 de junho de 1993";
            }
            if (game_section == T_UNREAL) {
                print " 5 de outubro de 1922";
            }
            if (game_section == T_HAMBURG) {
                print "31 de outubro de 1988";
            }
            if (game_section == T_GARDEN) {
                print "    3 de junho de 1993";
            }
            if (game_section == T_GARDEN_PAST) {
                print " 14 de março de 1808";
            }
            if (game_section == T_ANCIENT_BRITAIN) {
                print "  século VI d.C.";
            }
            if (game_section == T_CATACOMBS) {
                print "    3 de junho de 1993";
            }
            if (game_section == T_ALEXANDRIA) {
                print "  Inverno de 275 a.C.";
            }
            if (game_section == T_NE_OF_HOME) {
                print "    3 de junho de 1993";
            }
            if (game_section == T_EGYPT_DREAMING or T_SPIRIT_WORLD or T_TAROT or T_AFTERLIFE) {
                print "                  ";
            }
            @set_cursor 2 2;
            if (game_section == T_MODERN) {
                print "(no Solar Meldrew)      ";
            }
            if (game_section == T_UNREAL) {
                print "(na Cidade Irreal)      ";
            }
            if (game_section == T_HAMBURG) {
                print "(Hamburgo à noite)      ";
            }
            if (game_section == T_TAROT) {
                print "(na caixa de Tarô)      ";
            }
            if (game_section == T_GARDEN) {
                print "(nos jardins)           ";
            }
            if (game_section == T_GARDEN_PAST) {
                print "(nos jardins)           ";
            }
            if (game_section == T_ANCIENT_BRITAIN) {
                print "(no Jogo Mestre)        ";
            }
            if (game_section == T_DREAMING or T_EGYPT_DREAMING) {
                print "(sonhando?)             ";
            }
            if (game_section == T_CATACOMBS) {
                print "(nas catacumbas)        ";
            }
            if (game_section == T_ALEXANDRIA) {
                print "(em Alexandria)         ";
            }
            if (game_section == T_NE_OF_HOME) {
                print "(a nordeste do Solar)";
            }
            if (game_section == T_SPIRIT_WORLD or T_AFTERLIFE) {
                print "                        ";
            }
        }
    }
    style roman;
    @buffer_mode true;
    @set_cursor 1 1;
    @set_window 0;
    0-->8 = 65533 & 0-->8;
    redraw_statusline = false;
    if (quote_selection ~= -1 ) {
        display_quote(quote_selection);
        quote_selection = -1;
    }
    rtrue;
];

[ quote_display lines margin lines_arr columns center cursor i l generic_globvar;
    i = lines + 6;
    @split_window i;
    @set_window 1;
    columns = 0->33;
    if (columns == 0) {
        columns = 80;
    }
    center = (columns - margin) / 2;
    style reverse;
    columns = center - 2;
    cursor = 5;
    i = 0;
    @set_cursor 4 columns;
    generic_globvar = margin + 4;
    while (generic_globvar >= 1) {
        print " ";
        generic_globvar = generic_globvar - 1;
        if (generic_globvar == 0) break;
    }
    do {
        @set_cursor cursor columns;
        generic_globvar = margin + 4;
        while (generic_globvar >= 1) {
            print " ";
            generic_globvar = generic_globvar - 1;
            if (generic_globvar == 0) break;
        }
        @set_cursor cursor center;
        l = lines_arr-->i;
        if (l ~= 0) {
            print (string) l;
        }
        ++cursor;
        ++i;
    } until (i == lines);
    @set_cursor cursor columns;
    generic_globvar = margin + 4;
    while (generic_globvar >= 1) {
        print " ";
        generic_globvar = generic_globvar - 1;
        if (generic_globvar == 0) break;
    }
    @buffer_mode true;
    style roman;
    @set_window 0;
    @split_window 1;
    @output_stream 65535;
    print "[ ";
    i = 0;
  .label186748;
    columns = lines_arr-->i;
    if (columns ~= 0) {
        print (string) columns;
    }
    ++i;
    if (i == lines) {
        print "]^^";
    } else {
        print "^  ";
        jump label186748;
    }
    @output_stream 1;
    rtrue;
];

[ GamePreRoutine ;
    if( action ~= ##Help )
        hints_in_a_row = 0;
    if( action == ##Go && carbolic_soap hasnt concealed ) {
        trigger_quotation(13);
        "Você não vai a lugar algum até se redimir por esse palavrão horrível.";
    }
    if( gas_mask has worn ) {
        if( action == ##Smell ) {
            "Com a máscara de gás, você só sente cheiro de cortiça velha e borracha.";
        }
        if( action == ##Eat ) {
            "Não com uma máscara de gás!";
        }
        if( action == ##Order or ##Answer or ##Ask ) {
            "A máscara de gás abafa sua fala até o silêncio.";
        }
    }
    rfalse;
];

Include "PortuguesG";
Include "newverbs.inf";
Include "hints.inf";
