[ MazeBoundary x y cell ;       
    if( x < 0 || x > 8 || y < 0 || y > 6 ) {
        rfalse;
    }
    cell = garden_array->(9 * y + x);
    if( cell == '0' ) {
        rfalse;
    }
    if( cell == '1' ) {
        rtrue;
    }
    rtrue;
];

[ TestMazeConfines x y cell ;    
    if( x == 0 or 8 || y == 0 or 6 ) {
        cell = garden_array->(9 * y + x);
        if( cell == '0' ) {
            rfalse;
        }
        if( cell == '1' ) {
            return 2;
        }
    }
    return MazeBoundary(x,y);
];

[ CheckMaze x y z ;     
    z = TestMazeConfines(x,y);
    if( z == 2 ) {
        z = 0;
    }
    return z;
];

[ CheckMaze2 x y z ;    
    z = TestMazeConfines(x,y);
    if( z == 1 ) {
        z = 0;
    }
    if( z == 2 ) {
        z = 1;
    }
    return z;
];

[ MazeDescribe numwalls n_side e_side s_side w_side ;
    --MazeY;
    n_side = MazeBoundary(MazeX,MazeY);
    ++MazeY;
    ++MazeX;
    s_side = MazeBoundary(MazeX,MazeY);
    --MazeX;
    ++MazeY;
    e_side = MazeBoundary(MazeX,MazeY);
    --MazeY;
    --MazeX;
    w_side = MazeBoundary(MazeX,MazeY);
    ++MazeX;
    numwalls = n_side + s_side + e_side + w_side;
    if( numwalls == 4 ) {
        "^Você está cercado por sebes de todos os lados.";
    }
    if( numwalls == 3 ) {
        print "^Você está cercado e só pode voltar ";
    }
    if( numwalls == 2 ) {
        print "^O corredor segue ";
    }
    if( numwalls == 1 ) {
        print "^Neste cruzamento, o labirinto segue ";
    }
    if( numwalls == 0 ) {
        "^Este é um cruzamento no labirinto.";
    }
    while( numwalls < 4 ) {
        if( n_side == false ) {
            print "norte";
            n_side = true;
        } else if( s_side == false ) {
            print "leste";
            s_side = true;
        } else if( e_side == false ) {
            print "sul";
            e_side = true;
        } else if( w_side == false ) {
            print "oeste";
            w_side = true;
        }
        ++numwalls;
        if( numwalls == 4 ) {
            ".";
        }
        if( numwalls == 3 ) {
            print " e ";
        }
        if( numwalls == 2 ) {
            print ", ";
        }
        if( numwalls == 1 ) {
            print ", ";
        }
    }
    rtrue;
];

[ MazeOldDescribe numwalls n_side e_side s_side w_side cornerp ;
    numwalls = MazeBoundary(MazeX,MazeY);
    if( MazeX == 7 && MazeY == 5 ) {
        numwalls = 2;
    }
    new_line; 
    if( numwalls == 1 ) {
        print "Você está sobre um canteiro onde sementes foram plantadas recentemente. ";
    }
    if( numwalls == 0 ) {
        print "Você está sobre um trecho irregular de grama. ";
    }
    if( numwalls == 2 ) {
        print "Você está sobre um trecho irregular de grama, demarcado com cal. ";
    }
    --MazeY;
    n_side = CheckMaze(MazeX,MazeY);
    ++MazeY;
    ++MazeX;
    s_side = CheckMaze(MazeX,MazeY);
    --MazeX;
    ++MazeY;
    e_side = CheckMaze(MazeX,MazeY);
    --MazeY;
    --MazeX;
    w_side = CheckMaze(MazeX,MazeY);
    ++MazeX;
    numwalls = n_side + s_side + e_side + w_side;
    if( numwalls == 4 ) {
        print "Há canteiros de sementes por todos os lados. ";
    } else {
        if( numwalls == 3 ) {
            print "Há canteiros de sementes ao ";
        }
        if( numwalls == 2 ) {
            print "Há canteiros de sementes ao ";
        }
        if( numwalls == 1 ) {
            print "Há um canteiro de sementes ao ";
        }
        if( numwalls > 0 ) {
            while( numwalls > 0 ) {
                if( n_side == true ) {
                    print "norte";
                    n_side = false;
                } else if( s_side == true ) {
                    print "leste";
                    s_side = false;
                } else if( e_side == true ) {
                    print "sul";
                    e_side = false;
                } else if( w_side == true ) {
                    print "oeste";
                    w_side = false;
                }
                --numwalls;
                if( numwalls == 0 ) {
                    print ". ";
                } else {
                    if( numwalls == 1 ) {
                        print " and ";
                    }
                    if( numwalls == 2 ) {
                        print ", ";
                    }
                    if( numwalls == 3 ) {
                        print ", ";
                    }
                }
            }
        }
    }
    --MazeY;
    n_side = CheckMaze2(MazeX,MazeY);
    ++MazeY;
    ++MazeX;
    s_side = CheckMaze2(MazeX,MazeY);
    --MazeX;
    ++MazeY;
    e_side = CheckMaze2(MazeX,MazeY);
    --MazeY;
    --MazeX;
    w_side = CheckMaze2(MazeX,MazeY);
    ++MazeX;
    numwalls = n_side + s_side + e_side + w_side;
    if( numwalls == 0 ) {
        new_line;
        rfalse;
    }
    if( numwalls == 1 ) {
        print "Há uma cerca ao ";
    }
    if( numwalls == 2 ) {
        print "Há cercas ao ";
    }
    if( numwalls == 3 ) {
        print "Há cercas ao ";
    }
    if( numwalls == 4 ) {
        "Esta é uma área cercada.";
    }
    if( numwalls == 2 && s_side == true && w_side == true ) {
        cornerp = 1;
    }
    while( numwalls > 0 ) {
        if( n_side == true ) {
            print "norte";
            n_side = false;
        } else if( s_side == true ) {
            print "leste";
            s_side = false;
        } else if( e_side == true ) {
            print "sul";
            e_side = false;
        } else if( w_side == true ) {
            print "oeste";
            w_side = false;
        }
        --numwalls;
        if( numwalls == 0 ) {
            if( cornerp == 1 ) {
                "; camponeses grosseiros trabalham ao sul, mas felizmente ainda não viram você.";
            }
            ".";
        }
        if( numwalls == 1 ) {
            print " and ";
        }
        if( numwalls == 2 ) {
            print ", ";
        }
        if( numwalls == 3 ) {
            print ", ";
        }
    }
];



GRoom   Maze "Labirinto"      
  with  before [ x y;
            Exit: "Lembre-se da pobre grama!";
            Go:
                if( garden_roller hasnt on ) {
                    "Mas o rolo de jardim está desligado e não anda.";
                }
                if( MazeX == 4 && MazeY == 6 && noun == s_obj ) {
                    rfalse;
                }
                if( MazeX == 0 && MazeY == 1 && noun == w_obj ) {
                    rfalse;
                }
                x = 100;
                y = 100;
                if( noun == n_obj ) {
                    x = MazeX;
                    y = MazeY - 1;
                }
                if( noun == e_obj ) {
                    x = MazeX + 1;
                    y = MazeY;
                }
                if( noun == s_obj ) {
                    x = MazeX;
                    y = MazeY + 1;
                }
                if( noun == w_obj ) {
                    x = MazeX - 1;
                    y = MazeY;
                }
                if( x == 100 ) {
                    "O labirinto é construído com linhas retangulares de ligustro, então você só pode seguir para norte, leste, sul ou oeste.";
                }
                if( MazeBoundary(x,y) == 1 ) {
                    "A sebe de ligustro está no caminho.";
                }
                MazeX = x;
                MazeY = y;
                if( location == Patio_in_Maze ) {
                    location = Maze;
                    move garden_roller to Maze;
                }
                if( MazeX == 7 && MazeY == 5 ) {
                    location = Patio_in_Maze;
                    move garden_roller to Patio_in_Maze;
                }
                trigger_quotation(39);
                << Look >>;
        ],
        after [; Look: MazeDescribe(); rtrue; ],
        s_to Family_Tree,
        w_to Viewpoint_Ledge,
        description "Um labirinto de passagens de ligustro verde, todas iguais.",
        cant_go "As sebes de ligustro estão no caminho.",
  has   light scored;

GRoom   Patio_in_Maze "Pátio no Labirinto"    
  with  name 'patio' 'flagstone',
        before [;
            Go:
                if( noun == d_obj or u_obj )
                    rfalse;
                if( player notin garden_roller ) "Não se deve pisar na grama agora!";
                return RunRoutines(Maze, before);
        ],
        after [; Look: MazeDescribe(); rtrue; ],
        u_to "Para cima? Estamos jogando o mesmo jogo?",
        d_to Crypt,
        description "Este é um velho pátio de pedra no coração do labirinto do jardim. Uma pedra ausente oferece uma intrigante perspectiva escura abaixo.",
        cant_go "As sebes de ligustro estão no caminho.",
  has   light scored;

Object  -> marble_rose "rosa de mármore"     
  with  name 'marble' 'rose' 'flower',
        before [;
            Insert, Give:
                if( second == statue_of_Diana )
                            "Ela ficaria perfeita no cabelo de Diana, mas a cabeça dela está alta demais para alcançar.";
        ],
        initial "Uma rosa de mármore perfeitamente esculpida desponta da terra macia.",
        angel_hint "Perfeição gravada em pedra. Não é presente para mulheres mortais!",
  has   ;

GRoom   Viewpoint_Ledge "Mirante"        
  with  name 'motorway' 'coaches',
        before [;
            Examine:
                if( player in garden_roller && noun == plaque ) "A inscrição é pequena demais para ser lida daqui.";
            Go:
                if( noun == e_obj && player notin garden_roller )
                    "Pelo bem da grama, você não pode ir por ali.";
        ],
        e_to Maze,
        description "Esta muralha de pedras na encosta dá para o vale e, infelizmente, para a rodovia abaixo. Ônibus
            passam, lembrando você de que logo chegará a hora de deixar os visitantes entrarem novamente no verão.
            O único caminho seguro é voltar para leste, ao labirinto. De um lado há uma placa.",
        cant_go "A encosta é íngreme demais.",
  has   light scored;

Object  -> plaque "plaque"       
  with  name 'plaque',
        description "~Este mirante, um dos melhores do condado, foi construído por Capability Meldrew, famoso paisagista
            de sua época. Destinava-se a ser uma das recompensas do labirinto do jardim e foi construído por volta de
            1808, depois que uma antiga torre no local desabou.~",
  has   scenery;

Object  -> miniature "miniatura" 
  with  name 'miniature' 'plastic' 'etching',
        door_to Folly,
        initial "Uma gravura plástica em miniatura repousa sobre a placa.",
        description "Não maior que uma carta de baralho, ela representa a Torre que antes ficava na saliência da encosta.",
        devil_hint "Qual é o sentido de um desenho tão pequeno que quase poderia ser uma carta de baralho?",
  has   ;

Object Folly "Torre"    
  with  name 'wain' 'hay' 'valley',
        after [; default: MazeX = 0; MazeY = 1; rfalse; ],
        e_to Maze_Foundations,
        description "Esta é uma muralha na encosta, uma saliência natural que leva para leste. Lá embaixo, no vale,
            chalés rústicos cercam uma igreja. Trabalhadores labutam nos campos, e uma carroça de feno é puxada pelo
            rio.^^Erguida sobre você há uma construção monstruosamente horrível, uma Torre. A torre independente não
            tem finalidade perceptível nem entrada aparente. Ainda bem, pois parece extremamente insegura.",
        cant_go "A encosta é íngreme demais.",
        section T_GARDEN_PAST,
  has   light scored;

Object -> Folly_tower "torre"     
  with  name 'folly' 'tower' 'bricks' 'unsafe',
        description "Decididamente instável.",
  has   scenery;

Object -> bean_pole "bean pole" 
  with  name 'bean' 'pole' 'beanpole',
        after [;
            Take:
                if( self hasnt general ) {
                    rfalse;
                }
                give self general;
                StartTimer(self,5);
                rfalse;
        ],

        initial "Uma vara de feijão, do tipo usado para cultivar trepadeiras, está apoiada na lateral da torre.",
        time_left 0,
        time_out [;
            if( game_section == T_GARDEN_PAST ) {
                print "^Há um grande estrondo e então uma avalanche trovejante de pedras desce pela encosta até o vale.
                    A Torre desabou! Capability Meldrew e seus trabalhadores correm para investigar. Na confusão,
                    eles encontram você e, naturalmente, culpam-no pela alvenaria incompetente. Você é levado perante
                    o tribunal do condado...^";
                deadflag = AUSTRALIA;
            }
        ],
        rod_assoc rod_of_stalking,
        devil_hint "Faça o que fizer, ela sempre será uma vara de feijão.",
  has   general hidden_rod;

Object Maze_Foundations "Fundações do Labirinto"      
  with  before [ x y;
            Go:
                if( MazeX == 4 && MazeY == 6 && noun == s_obj ) {
                    rfalse;
                }
                if( MazeX == 0 && MazeY == 1 && noun == w_obj ) {
                    rfalse;
                }
                x = 100;
                y = 100;
                if( inp1 == n_obj ) {
                    x = MazeX;
                    y = MazeY - 1;
                }
                if( inp1 == e_obj ) {
                    x = MazeX + 1;
                    y = MazeY;
                }
                if( inp1 == s_obj ) {
                    x = MazeX;
                    y = MazeY + 1;
                }
                if( inp1 == w_obj ) {
                    x = MazeX - 1;
                    y = MazeY;
                }
                if( inp1 == ne_obj ) {
                    x = MazeX + 1;
                    y = MazeY - 1;
                }
                if( inp1 == nw_obj ) {
                    x = MazeX - 1;
                    y = MazeY - 1;
                }
                if( inp1 == se_obj ) {
                    x = MazeX + 1;
                    y = MazeY + 1;
                }
                if( inp1 == sw_obj ) {
                    x = MazeX - 1;
                    y = MazeY + 1;
                }
                if( x == 100 ) {
                    "O labirinto é apenas bidimensional.";
                }
                if( CheckMaze2(x,y) ~= 0 ) {
                    "A cerca de madeira está no caminho.";
                }
                MazeX = x;
                MazeY = y;
                << Look >>;
        ],
        after [;
            Look: MazeOldDescribe(); rtrue;
            Drop: deadflag = PARADOX; "Você sente um puxão alarmante nas entranhas.";
        ],
        s_to Tree_Planting,
        w_to Folly,
        description "Uma grade quadrada de trechos de grama e canteiros de sementes, todos iguais.",
        section T_GARDEN_PAST,
  has   light;

Object Tree_Planting "Plantio de Árvores"    
  with  after [; deadflag = AUSTRALIA; ],
        description "Capability Meldrew e seu grupo de trabalhadores plantam delicadamente uma muda de plátano aqui.
            Sua perturbação os irrita enormemente, e você é imediatamente preso por vadiagem e roubo. Depois de alguns
            meses na prisão, você é levado perante o Tribunal do Condado e condenado...",
        section T_GARDEN_PAST,
  has   light;
