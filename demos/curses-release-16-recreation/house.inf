                give Inside_Cupboard light;
                give cranked_skylight open;
                "abre a claraboia, inundando o cômodo de luz solar.";
            Open, Close: "Como, exatamente?";
        ],
        door_to Roof,
        when_closed "Acima de você há uma claraboia escurecida com uma manivela.",
        door_dir u_to,
        when_open "A claraboia acima está aberta, e o céu realmente ilumina o cômodo.",
         description "Ela foi pintada de preto durante a primeira onda de ataques aéreos dos zepelins na Primeira Guerra Mundial.
             Isso é completamente irrelevante, mas você perguntou.",
  has   door static;

Object  -> gas_mask "mascara de gas"   
  with  name 'gas' 'mask' 'gasmask' 'gas' 'mascara' 'máscara',
