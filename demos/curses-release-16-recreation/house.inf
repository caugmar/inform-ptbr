Object  dog_eared_old_letter "carta velha com orelhas"      
  with  name 'old' 'letter' 'velha' 'carta',
        list_together n_obj,
        description [;
            print "Uma carta datilografada quase apagada, carimbada no Cairo em outubro de 1920, com uma nota manuscrita assinada
                simplesmente ~Ellingsworth~:^^Hartley - Talvez você consiga datar alguns destes pictogramas e determinativos
                estranhos, início do Novo Império? Cerâmica incerta, trabalho continua^";
            0-->8 = 2 | 0-->8;
            print "^  ::   e        #     o               #.    isto^  :;   mas        +*+   deus/espírito?       (())  tudo^  =    de         []    casa/construção    |||   indica plural^  ->   através    >>>   move             <>    item/coisa?^  __   senta/deita/repousa/está perto            /     para/em direção a^";
            0-->8 = 65533 & 0-->8;
            rtrue;
        ]
         devil_hint "Os delírios de um louco. Ignore-os.",
  has   ;

[ HalfwayUpStairsUp ;   
    Servants_Room.d_to = Halfway_up_the_Stairs;
    Servants_Room.n_to = Halfway_up_the_Stairs;
    move tight_door to Servants_Room;
    self.u_to = Servants_Room;
    print "A escada sobe para...^";
    return Servants_Room;
];

 HRoom   White_Hallway "Corredor branco"    
  with  s_to Halfway_up_the_Stairs,
        ne_to Bricked_Path,
