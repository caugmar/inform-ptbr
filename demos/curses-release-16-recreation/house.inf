Object  fire_escape "escada de incendio"       
  with  name 'fire' 'escape' 'hatchway' 'hatch' 'fogo' 'incendio' 'incêndio' 'abertura' 'alcapao' 'alçapão',
        door_to Beside_the_Drive,
        door_dir d_to,
         when_open "Uma abertura na parede leste, para uma velha escada de incêndio de ferro, está aberta e a luz entra por ela.
         (Algum idiota deve ter disparado o alarme.)",
  has   door open static;

HRoom   Inside_Cupboard "Dentro do armario"        
  with  s_to East_Annexe,
        w_to big_iron_fireplace,
        u_to cranked_skylight,
         description "Este é um armário surpreendentemente espaçoso, que você não se lembra de ter visitado antes de hoje. Você
         realmente deveria usar este cômodo vazio e conveniente para alguma coisa...",
  has   ;

Object  -> painting_of_Mad_Isaac_Meldrewe "quadro de Isaac Meldrewe, o Louco"       
  with  name 'painting' 'of' 'mad' 'isaac' 'picture' 'quadro' 'louco' 'retrato' 'imagem',
        after [;
            Take:        
                if( self in White_Hallway && picture_hook has scenery ) {
                    give self ~scenery;
                    give self static;
                    give self ~talkable;
                     "Você tira Mad Isaac da parede.";
                }
                if( big_iron_fireplace has concealed ) {
                    give big_iron_fireplace ~concealed ~talkable;
                     "Pego. (A propósito, há uma lareira atrás dele.)";
                }
                rfalse;
        ],
         initial "Um grande quadro de Mad Isaac Meldrewe, seu ancestral do século XVIII, está apoiado contra a parede oeste.",
         description "Ele costumava ficar no patamar de baixo, e os olhos vermelhos e dementes irritavam todos que passavam.
         Então tia Jemima teve a ideia ridícula de que era obra de Sir Joshua Reynolds e mandou avaliá-lo. Felizmente não era
         e, para encurtar uma história longa, acabou aqui.",
         devil_hint "Leve isto com você aonde quer que vá.",
  has   ;

Object  -> big_iron_fireplace "grande lareira de ferro"       
  with  name 'iron' 'fireplace' 'chimney' 'ferro' 'lareira' 'chamine' 'chaminé',
        after [;
            Receive:
                move noun to Priests_Hole;
                if( sooty_old_stick hasnt moved ) {
                    move sooty_old_stick to Priests_Hole;
                    give sooty_old_stick moved;
                }
                if( noun == medicine_bottle && medicine_bottle has locked ) {
                    give medicine_bottle ~moved;
                     medicine_bottle.initial = "O frasco de remédio, infelizmente, não sofreu danos na queda pela chaminé.";
                }
                 print_ret (The) noun, " rola para fora de vista pela chaminé.";
        ],
        door_to Chimney,
        door_dir w_to,
         when_open "Há uma grande lareira de ferro na parede oeste.",
  has   concealed container door open static;

Object  -> cranked_skylight "claraboia com manivela"   
  with  name 'crank' 'cranked' 'skylight' 'handle' 'manivela' 'claraboia' 'clarabóia' 'alca' 'alça',
        before [;
            Turn:
                print "Com um rangido horrível, a manivela ";
                if( Inside_Cupboard has light ) {
                    give Inside_Cupboard ~light;
                    give cranked_skylight ~open;
                    "fecha a claraboia, bloqueando a luz do sol.";
