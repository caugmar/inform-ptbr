         description "Um corredor branco e baixo junto ao Octógono, convertido do que antes era a copa e a despensa dos criados. Uma
         escada estreita e escura sobe e segue ao sul; um caminho diagonal de tijolos sai a nordeste para os jardins.",
  has   light;

Object  -> picture_hook "gancho para quadros"   
  with  name 'picture' 'hook' 'quadro' 'gancho',
        before [;
            Receive:
                if( noun ~= painting_of_Mad_Isaac_Meldrewe ) {
                    "De algum modo, isso não parece certo ali.";
                }
                move painting_of_Mad_Isaac_Meldrewe to White_Hallway;
                give painting_of_Mad_Isaac_Meldrewe ~moved;
                give painting_of_Mad_Isaac_Meldrewe talkable;
                give self ~static;
                give self scenery;
                painting_of_Mad_Isaac_Meldrewe.initial = "O quadro de Mad Isaac encara você do gancho.";
                "Você pendura Mad Isaac, que parece perfeitamente colocado ali.";
        ],
        initial "No alto de uma parede há um gancho para quadros.",
  has   static;

Object  -> umbrella_stand "porta-guarda-chuvas"       
  with  name 'umbrella' 'stand' 'elephants' 'foot' 'guarda-chuva' 'suporte' 'elefante' 'pe',
        initial "Ao lado da porta do jardim há um porta-guarda-chuvas antiquado em formato de pé de elefante.",
        description "Um porta-guarda-chuvas fundo e velho em formato de pé de elefante.",
        article "um",
  has   container open static;

Object  -> -> model_golden_sceptre "cetro dourado de modelo"        
  with  name 'model' 'golden' 'gold' 'sceptre' 'modelo' 'dourado' 'ouro' 'cetro',
        before [ i;
            Wave: "Aparentemente, ele não reage a isso.";
            Turn:
                if( self notin Quite_an_Undertaking || self has moved ) 
                    rfalse;
                if( self.number ~= 0 && mummy_case has open ) {
                    give mummy_case ~open;
                    print "Com um estrondo, a tampa do caixão bate e fecha.^^";
                }
                print "Você gira o cetro, perde o controle por um instante e um mecanismo primitivo gira. A palavra para em ~";
                i = random(6);
                EtruscanInt(i);
                print "~.^";
                self.number.number = i;
                if( deterministic_transportation == 1 ) {
                    first_socket.number = 3;
                    second_socket.number = 6;
                    third_socket.number = 1;
                }
                if( first_socket.number == 3 && second_socket.number == 6 && third_socket.number == 1 || 
                   (first_socket.number == 1 && second_socket.number == 6 && third_socket.number == 3) ) {
                    give mummy_case open;
                    mummy_case.initial = "A grande tampa do caixão está aberta.";
                    "^Com um gemido terrível, a tampa do caixão se abre. E está...^^Vazio!";
                }
                rtrue;
        ],
        after [;
            Take, Remove:
                if( location == Quite_an_Undertaking ) self.number = 0;
                rfalse;
        ],
        initial nothing,
        description "Uma cópia, em meia escala, do que está no sarcófago de Tutancâmon. Também não é de ouro verdadeiro.",
        number 0,
        angel_hint "Sem utilidade para ninguém nos últimos dois mil anos, desculpe!",
  has   ;

 HRoom   Halfway_up_the_Stairs "Meio da escada"    
  with  u_to HalfwayUpStairsUp,
        d_to White_Hallway,
         description "Esta escada escura e íngreme, que ziguezagueia pela casa, antes dava aos criados acesso a todos os lugares. Mas
         esses dias ficaram para trás, e agora todas as portas estão trancadas.",
  has   ;
