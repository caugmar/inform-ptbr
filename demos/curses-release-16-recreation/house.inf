[ BookParsename ;
    if (NextWord() == 'books' or 'volumes' or 'tomes') {
        parser_action = ##PluralFound;
        return 1;
    }
    --wn;
    return -1;
];

[ EnterDream ;
    ChangePlayer(ghost_of_yourself);
    PlayerTo(Melancholy_Dream);
    rtrue;
];

! Um comodo da casa
Class   HRoom
  with  section T_MODERN; 

Object  crumpled_piece_of_paper "pedaço de papel amassado"        
  with  name 'pedaço' 'papel' 'amassado' 'pedaco',
        list_together n_obj,
         description "   Coisas a fazer:^^   1. Encontrar o mapa^   2. Telefonar para o aeroporto para verificar o estacionamento^   3. Formulários de saúde...^^e assim por diante. Convenhamos: a primeira opção é mais interessante que todas as outras juntas.",
         devil_hint "Isso é imensamente útil.",
  has   ;

Object  electric_torch "lanterna elétrica"  
  with  name 'elétrica' 'eletrica' 'lanterna' 'compartimento',
        before [;
            Receive:
                if( child(self) ) 
                    "Já há uma bateria dentro.";
                if( noun hasnt battery_flag )
                    "Como era de esperar, ela não cabe no compartimento da bateria.";
                rfalse;
            SwitchOn,SwitchOff:
                "Não há interruptor, apenas um compartimento de bateria.";
        ],
        after [ bat i;
            Open:
                if( self has light ) {
                    give self ~light;
                    "A lanterna se apaga quando você abre o compartimento da bateria.";
                }
                "Você abre o compartimento da bateria da lanterna.";
            Close:
                print "Você fecha o compartimento da bateria da lanterna";
                bat = child(self);
                if( bat == nasty_battery ) {
                    if( game_section == T_MODERN ) {
                        deadflag = FAILED;
                         ", e ela explode em luz, fica quente o bastante para derreter, cai no chão, pega fogo e incendeia a maior parte do sótão...^^Talvez sirva de consolo saber que, como você passa as férias na ala de queimados do hospital local, não chega a se incomodar muito por não encontrar o mapa.";
                    } else {
                        remove electric_torch;
                         ", e ela explode em luz, fica quente o bastante para derreter, cai da sua mão e desaparece por completo.";
                    }
                }
                if( bat == new_battery )
                    Achieved(SCORE_TORCH);
                if( bat == old_smudged_battery or new_battery ) {
                    i = bat.number;
                    if( i == 0 )
                        ", mas a bateria deve estar descarregada, pois nada acontece.";
                    give self light;
                    if( i > 5 ) {
                        ", e acende com força.";
                    }
                    ", e acende fracamente.";
                }
                ".";
        ],
        list_together s_obj,
         description "A lanterna tem um compartimento de bateria que pode ser alcançado abrindo-a.",
         article "uma",
        number 0,
        daemon [ o n;
            if( self hasnt on )
                rfalse;
            o = child(self);
            if( o == nothing )
                rfalse;
            n = o.number - 1;
            if( n < 200 )
                o.number = n;
            if( n == 2 )
                print "^A lanterna pisca de modo ameaçador.^";
            if( n == 0 ) {
                print "^A lanterna finalmente se apaga.^";
                give electric_torch ~light;
                trigger_quotation(8);
            }
        ],
         devil_hint "É uma pena que você não possa trocar as baterias.",
  has   container light moved openable;

Object  -> old_smudged_battery "bateria velha e manchada"     
  with  name 'velha' 'manchada' 'bateria',
        list_together s_obj,
        article "uma",
        number 200,
  has   battery_flag;

Object  chocolate_biscuit "biscoito de chocolate"    
  with  name 'chocolate' 'biscoito',
        after [;
            Eat: Achieved(SCORE_BISCUIT); rfalse;
        ],
         description "Aveia coberta com chocolate puro, já que você perguntou.",
         devil_hint "Aposto que você não sabia que os fabricantes de biscoitos de chocolate estão condenados por toda a eternidade? Temo que os capítulos do Antigo Testamento que explicavam o motivo tenham se perdido, e agora ninguém se lembra por quê.",
  has   edible moved;

HRoom   Attic "Sótão"    
  with  name 'vigas' 'fiação' 'chão' 'assoalho',
        n_to Old_Winery,
        s_to Old_Furniture,
        e_to Servants_Room,
        d_to hinged_trapdoor,
         description "O sótão, cheio de vigas baixas e ângulos incômodos, começa aqui em uma área relativamente arrumada que se estende para o norte, o sul e o leste. O assoalho de madeira parece razoavelmente firme, ainda bem, considerando o peso desses baús de chá. Mas a fiação antiga deixou de funcionar há anos, e não há luz elétrica.",
  has   ;

Object  -> hinged_trapdoor "alçapão articulado"     
  with  name 'articulado' 'alçapão' 'alcapao' 'porta',
        before [;
            Open:
                if( antique_jewellery_box hasnt concealed )
                    rfalse;
                give antique_jewellery_box ~concealed;
                move antique_jewellery_box to Attic;
                 "Você descobre uma caixa de joias de senhora sob o alçapão!";
        ],
        after [;
            Open: give self ~light; rfalse;
            Close:
                if( antique_jewellery_box has concealed ) {
                    give antique_jewellery_box ~concealed;
                    move antique_jewellery_box to Attic;
                    "Você fecha o alçapão, surpreso ao ver que ele escondia algo brilhante.";
                }
                "Você fecha o alçapão outra vez. Mas não há mais caixas de joias.";
        ],
        door_to House,
         when_closed "Há um alçapão fechado no meio do chão.",
        door_dir d_to,
         when_open "Um alçapão articulado no chão está aberto, e a luz entra por baixo.",
  has   door light open openable static;

Object  -> teachests "baus de cha" 
  with  name 'tea' 'chests' 'teachests' 'chest' 'teachest' 'baus' 'baú' 'cha' 'chá' 'bau',
        before [;
            Search:
                print "Esse foi o primeiro lugar que voce tentou, ha horas e horas";
                if( Meldrewes_History has concealed ) {
                    print ", e nao ha nada ali alem daquele livro velho e enfadonho. Mesmo assim voce o pega, entediado como esta";
                    trigger_quotation(33);
                    give Meldrewes_History ~concealed;
                    move Meldrewes_History to player;
                }
                ".";
        ],
        description "Aberto em cima. Voce poderia olhar dentro facilmente, se quisesse.",
        article "alguns",
  has   container open scenery;

Object  -> -> Meldrewes_History "Historia dos Meldrews (vol. II)"      
  with  name 'book' 'history' 'livro' 'historia' 'história' 'meldrews',
        parse_name BookParsename,
        before [ w ;
            Consult:
                wn = consult_from;
                w = NextWord();
                if( w == 'mad' or 'sir' or 'honourable' )
                    w = NextWord();
                if( w == 'me' or 'myself' or 'self' ) {
                    trigger_quotation(48);
                    "Talvez um dia voce possa conquistar um lugar no vol. III.";
                }
                if( w == 'peter' )
                    "Modestamente, o autor (morto por volta de 1940?) deixou a si mesmo de fora.";
                if( w == 'jemima' )
                    "Ela e recente demais para ser incluida.";
                if( w == 'isaac' )
                    "Mad Isaac (1705-1792) dedicou-se a experimentos místicos de todo tipo e era um antiquário renomado. Ele
                    acreditava que a família Meldrew sofria de uma maldição ancestral, condenando cada membro a empreender
                    uma busca inútil. Pensava que a única maneira de quebrar a maldição era alguém realmente conseguir
                    ter sucesso... infelizmente, morreu em circunstâncias peculiares antes de descobrir como.^^Além disso, acreditava
                    que Merlin, o mago do rei Arthur, não estava enterrado numa caverna de Tintagel, como geralmente se afirma,
                    mas em algum lugar no fundo do jardim (perto de onde hoje fica a rodovia), e que a Lua era um enorme par
                    de discos pretos e brancos puxados pelo céu noturno por uma equipe de anjos.";
                if( w == 'ebenezer' )
                    "Parece que Ebenezer (1846-1908), o mais jovem de um par de gêmeos, abandonou certo dia uma carreira
                    promissora na Companhia das Índias Orientais, tomou um navio a vapor para a Colônia do Cabo e simplesmente
                    marchou para o mato em busca de um rio lendário. Seus mapas foram usados durante alguns anos, e uma
                    província recebeu seu nome por algum tempo, mas hoje os moradores a chamam de outra coisa.";
                if( w == 'roger' )
                    "Roger (1846-1913), o mais velho de um par de gêmeos, era muito vitoriano, sobretudo na desaprovação
                    à carreira literária de sua bela esposa jovem. Achava seus romances tão imorais que se recusou a permitir
                    que o nome da família aparecesse neles. Importante membro da administração paroquial local, limitou seus
                    próprios escritos a numerosas monografias sobre problemas de drenagem municipal, mas morreu antes de
                    concluir seu grandioso Plano Nacional de Esgotos.";
                if( w == 'capability' or 'willard' )
                    "~Capability~ Meldrew (1761-1817) tornou-se um paisagista razoavelmente célebre, iniciando uma breve
                    moda de usar criptas e memoriais como ornamentos de jardim (ele dizia que isso era mais próximo da natureza).
                    Pouquíssimo de seu trabalho sobrevive hoje. Seu nome verdadeiro, aliás, era Willard.";
                if( w == 'henri' )
                    "Sabe-se muito pouco sobre Henri, que viveu em algum momento do século XV. Quando jovem, lutou em Agincourt
                    e parece ter sido uma espécie de engenheiro de combate. Diz a história que ganhou o apelido de O Poste Negro
                    por uma piada do rei, quando estava enterrado até a cintura numa vala. Deve ter se orgulhado, pois seu brasão
                    traz seu nome escrito do lado esquerdo e Poste Negro do lado direito.^^Nos últimos anos, tornou-se morbidamente
                    obcecado e (segundo a lenda) passou a velhice trabalhando na própria tumba, que insistia ser de importância celestial.";
                if( w == 'helene' )
                    "Helene Meldrew (1902-) é uma pintora e escultora renomada. Rompeu relações com a família nos anos 20,
                    quando se casou com Anton e fugiu para Paris para estudar arte, mas voltou recentemente à Casa em busca,
                    como ela diz, do ~azul perfeito, o azul do céu, o azul da água~. Desejamos-lhe boa sorte.";
                if( w == 'anton' or 'smyslov' )
                    "Anton Smyslov não deveria realmente estar no livro, mesmo tendo se casado com Helene, mas há uma breve passagem,
                    já que ele foi tão famoso: era um grande-mestre de xadrez e venceu o Aberto de Paris por cinco anos seguidos
                    na década de 1930. Sua especialidade eram ataques ousados e sacrificiais, mas também era famoso por comer
                    iogurte de mirtilo diante do tabuleiro.";
                if( w == 'alison' )
                    "Sob o pseudônimo Marie Swelldon, sua ancestral Alison (1871-1930) escreveu vários romances de sucesso moderado.
                    Colecionava obsessivamente amuletos da sorte e anunciava nos jornais em busca de moedas de duas caras e coisas
                    do tipo (embora nunca tenha localizado um suposto trevo de cinco folhas em algum lugar do Condado de Donegal).^^
                    Para escrever em tranquilidade e evitar o marido, foi ela quem instalou a parede falsa no extremo sul da ala
                    leste do sótão, e todas as tardes subia sorrateiramente para afastá-la.";
                if( w == 'joshua' )
                    "Oh, o profundamente lamentável Sir Joshua Meldrewe (1710-1776). Membro da Sociedade Dilettanti e do Clube
                    Hell-Fire, além de político (chanceler do Tesouro em 1762-3; ~provavelmente o ministro menos competente a
                    ocupar esse cargo~ - História da Inglaterra de Oxford, vol. XII).^^", "Seu pai o deserdou por seu estilo de
                    vida extravagantemente excessivo (quase sempre usava botões cravejados de joias que valiam pelo menos mil
                    libras) e por se casar com uma dama de virtude duvidosa enquanto fugia de uma prisão na França, onde fora
                    condenado à decapitação. Para impedir que a irmã recebesse a fortuna, voltou à Itália e anunciou em busca de
                    uma noiva grávida que lhe desse um herdeiro homem. O plano nefasto foi frustrado quando morreu engasgado com
                    um osso de galinha.^^Dizem que ainda assim roubou o dinheiro perto do fim, e certamente algum ouro desapareceu.
                    (Também conseguiu fazer a família perder o baronato ao trapacear no piquet com o Príncipe de Gales.)";
                if( w == 'hartley' )
                    "Seu tio-avô distante Hartley era um egiptólogo amador entusiasmado de modo irritante que, todo Natal, costumava
                    colocá-lo no colo e discorrer monotonamente sobre trincheiras, inscrições e felás. Agora você descobre que tudo
                    era uma espécie de fraude, pois ele só foi ao Egito uma vez: houve tamanho escândalo por sua recusa em doar sua
                    melhor descoberta ao Museu Britânico que nunca mais lhe permitiram escavar, embora tenha passado anos escrevendo
                    em vão ao governo egípcio.";
                if( w == 'gerard' )
                    "Gerard (1898-1916), filho mais velho de Roger, morreu na Batalha do Somme. Sua mãe, ~Marie Swelldon~,
                    abandonou a escrita depois disso.";
                if( w == 'austin' )
                    "Austin é bastante venerável para um gato, mas não é tão velho.";
                if( w == 'tobias' )
                    "Tobias Meldrew (1801-1870) foi professor de Teologia em Christminster, de 1850 a 1866. Propôs-se a provar
                    a existência de Deus a partir de primeiros princípios, tarefa que anunciou ter concluído em 1860 com o auxílio
                    de dez mil lemas intermediários. O escárnio que recebeu ao tentar publicar a obra colossal acabou levando-o à
                    loucura, e ele passou os quatro últimos anos de vida no hospício.";
                "Irritantemente, não há índice (haveria um índice consolidado no vol. I), e você não consegue encontrar
                 o que procura.";
        ],
        list_together n_obj,
        description "Deveria ter sido a obra da vida do Honorável Peter Meldrew, uma edição em dois volumes com a história
            definitiva da família. Infelizmente, embora afirmasse ter procurado evidências nos confins da Terra, nunca encontrou
            um detalhe que desejava para o volume I, e ele jamais foi publicado. De algum modo, isso tipifica sua família, e
            consultar este respeitável livro sobre seus antepassados faz você perceber como eles tinham um talento extraordinário
            para nunca chegar a realizar nada.^^A menos, é claro, que se conte ter tido filhos demais. Há tantos Meldrews listados
            aqui que você terá de procurá-los individualmente.",
        article "o",
         devil_hint "Que livro velho e enfadonho! Não há ninguém que valha a pena consultar.",
  has   concealed consultable;

Object  antique_jewellery_box "caixa de joias antiga"    
  with  name 'antique' 'jewellery' 'box' 'antiga' 'joia' 'joias' 'caixa',
        with_key delicate_gold_key,
        initial "Num canto ha uma caixa de joias, antes escondida pelo alçapao aberto.",
        description "Uma elegante caixa feminina, com as iniciais A. M. e gravada com o desenho do que parece ser uma pata de coelho.",
        article "uma",
        angel_hint "Tente investigar o mundo do romance, nas varandas da vida.",
  has   concealed container lockable locked openable;

Object  -> four_leafed_clover "trevo de quatro folhas"       
  with  name 'four' 'leafed' 'clover' 'quatro' 'folhas' 'trevo',
        description "Na verdade, um ramo de erva-de-paris (Paris Quadrifolia) de quatro folhas, no formato de um no do amor verdadeiro. Mas isso bastava para Alison.",
        rod_assoc rod_of_luck,
        angel_hint "Nao serve para muita coisa assim, serve?",
  has   hidden_rod;

HRoom   House "Casa"    
  with  after [ ; 
            if( tourist_map_of_Paris in player || (tourist_map_of_Paris in rucksack && rucksack in player) ) {
                deadflag = WON;
                 "Voce conseguiu se livrar da Maldicao dos Meldrews: pela primeira vez em sessenta geracoes, um Meldrew encontrou o objeto inutil que estava condenado a procurar! Infelizmente, a caminho do aeroporto, voce percebe que deixou o mapa na mesa da cozinha na correria, mas nao importa, agora voce esta de ferias.";
            }
            deadflag = FAILED;
            "Sim, provavelmente e melhor desistir de procurar, e Deus sabe que ha bastante coisa para arrumar, com o resto da familia em alvoroço. Fazer o que.";
        ],
  has   light;

HRoom   Servants_Room "Quarto dos criados"   
  with  name 'bedside' 'table' 'cabeceira' 'mesa' 'mesinha',
        before [;
            Sleep:
                if( carbolic_soap hasnt concealed ) 
                    "Dominado pela culpa por sua linguagem indecente, voce nao consegue dormir.";
                if( player notin servants_bed ) 
                    rfalse;
                if( Austin in location ) 
                    "Austin salta para a cama, pula um pouco e depois cai de volta no chão. Você não consegue dormir.";
                if( servants_bed has general ) 
                    "Voce cochila por um tempo, mas e so isso.";
                give servants_bed general;
                print "Você dorme inesperadamente bem, mas justamente quando acha que está começando a acordar, tem uma
                    experiência súbita...^";
                PremonitionStart();
                rtrue;
        ],
        n_to nothing,
        w_to Attic,
        d_to nothing,
        description "Antigamente, criados de grandes casas viviam em frestas terríveis e imitações de cômodos como este.
            Deviam estar sob perigo permanente de sufocamento, pois não há janelas, apenas uma porta a oeste. Uma cama ainda
            é mantida aqui, e sua visão provoca sonolência neste ar quente e abafado. Tudo o que você quer é se enroscar e dormir.",
  has   ;

Object  -> classical_dictionary "dicionario classico"   
  with  name 'hobsons' 'choice' 'classical' 'dictionary' 'book' 'hobson' 'escolha' 'classico' 'clássico' 'dicionario' 'dicionário' 'livro',
        parse_name BookParsename,
        before [ w;
            Consult:
                wn = consult_from;
                w = NextWord();
                if( Homer has general && Homer.number < 3 && Homer in location ) {
                    HomerSleeps();
                    print "~Bem, se voce vai trapacear, esqueca,~ diz Homero em voz alta enquanto adormece.^^";
                }
                if( w == 'galita' ) "Divindade menor dos tumulos, reencarnada de uma mosca que voou para dentro de ambar em solidificacao.";
                if( w == 'menelaus' ) "General na Guerra de Troia e irmao de Agamemnon.";
                if( w == 'agamemnon' ) "General na Guerra de Troia e irmao de Menelau.";
                if( w == 'ares' ) "Deus grego da guerra.";
                 if( w == 'chlamys' ) "Manto (retangular) de um imperador.";
                if( w == 'husbandry' ) "Nao neste dicionario!";
                if( w == 'hades' ) "Mundo subterraneo dos espiritos.";
                if( w == 'adamantine' ) "A pedra mais dura conhecida pelos antigos.";
                 if( w == 'iliad' or 'odyssey' ) "Epopeia de Homero.";
                if( w == 'helicon' ) "Montanha mitica dos poetas e das musas.";
                if( w == 'hephaestus' ) "Deus grego dos ferreiros e mestre dos metais.";
                if( w == 'pan' ) "Deus grego dos pastos e pastores; toca a sirinx, ou flauta.";
                if( w == 'demeter' ) "Deusa grega da abundancia.";
                if( w == 'poseidon' ) "Deus grego do mar e dos cavalos.";
                if( w == 'apollo' or 'loxias' ) "Deus grego das palavras, musica e poesia.";
                if( w == 'zeus' ) "Governante grego dos deuses.";
                if( w == 'leda' ) "Mulher mortal seduzida por Zeus, que apareceu para ela na forma de um cisne.";
                if( w == 'hera' ) "Esposa ciumenta de Zeus.";
                if( w == 'aphrodite' ) "Deusa grega da beleza.";
                if( w == 'athene' ) "Deusa grega da sabedoria.";
                if( w == 'diana' ) "Deusa da caca, do mundo subterraneo (com Pluto) e da lua.";
                if( w == 'selenae' ) "Ilha mitica, lar montanhoso de Diana.";
                 if( w == 'sosostris' ) 
                     "Faraó mítico do Egito, após o qual surgiu um culto curioso; às vezes confundido com Alexandre, o Grande.";
                if( w == 'pluto' ) "Personagem canino de Walt Disney, que deu nome ao planeta.";
                if( w == 'dionysus' ) "Deus grego do vinho e da folia.";
                 if( w == 'furies' or 'curses' or 'eumenides' ) 
                     "Deusas gregas que perseguiam eternamente e faziam cumprir as regras divinas punindo as famílias dos malfeitores ao longo do tempo.";
                if( w == 'omphalos' ) "Diz-se que e a pedra no centro (literalmente ~umbigo~) do mundo.";
                 if( w == 'oracle' or 'pythian' ) 
                     "Sacerdotisa de Apolo: suas previsões eram lendárias pela precisão e também pela dificuldade de interpretação.";
                if( w == 'pharos' ) 
                    "Torre-farol. O grande farol de Alexandria era uma das Sete Maravilhas do Mundo.";
                if( w == 'aeschylus' ) "O primeiro grande dramaturgo tragico (525 - c.456 a.C.).";
                 if( w == 'kraken' ) 
                     "Monstro marinho lendário de Poseidon (embora a palavra venha do norueguês; pouca gente sabe disso).";
                if( w == 'andromeda' ) 
                    "Donzela sacrificada a um monstro marinho, salva por Perseu segundo a lenda.";
                if( w == 'perseus' ) "Heroi grego e matador de monstros.";
                 if( w == 'syrinx' ) "Flauta de Pã: feita de canas cortadas.";
                 if( w == 'homer' ) 
                     "Primeiro poeta da tradição grega, lendariamente cego: nada se sabe sobre ele, exceto que (supostamente)
                      escreveu a ~Ilíada~ e a ~Odisseia~.";
                 if( w == 'ekmek' or 'eraina' ) 
                     "O Especial Ekmek é uma iguaria ainda servida pela Taverna Eraina, na Free School Lane, Cambridge, Inglaterra.
                      Muito apreciada por matemáticos itinerantes.";
                if( w == 'callimachus' ) 
                    "Catalogador da biblioteca de Alexandria, o mais famoso dos poetas epigramaticos, espirituosos e concisos.";
                 if( w == 'apollonius' ) "Bibliotecário, matemático, poeta épico e político.";
                if( w == 'arthur' ) "Alto rei dos britanos, meio mitico.";
                if( w == 'merlin' or 'merlyn' ) "Mago meio mitico da corte do rei Arthur.";
                if( w == 'alexandria' ) "Cidade no delta do Nilo fundada por Alexandre, o Grande.";
                if( w == 'alexander' ) "Macedonio que conquistou o mundo conhecido aos vinte e poucos anos.";
                if( w == 'ptolemy' ) "General de Alexandre, o Grande, governou e depois herdou o Egito.";
                if( w == 'odysseus' or 'ulysses' ) "Ele nao era marinheiro?";
                "Desculpe, nao ha nada sobre isso.";
        ],
        list_together n_obj,
        initial "Ha um livrinho sobre a mesinha ao lado da cama.",
        description "~Hobson: Um Dicionario Classico de Escolhas~. Ele afirma ter numerosos verbetes.",
        article "de Hobson",
        devil_hint "Ha muitas palavras indecentes nesse.",
  has   consultable;

Object  -> servants_bed "cama de campanha"       
  with  name 'camp' 'bed' 'campanha' 'cama',
  has   enterable scenery supporter;

Object  -> old_striped_scarf "cachecol listrado velho" 
  with  name 'old' 'striped' 'scarf' 'velho' 'listrado' 'cachecol',
        initial "Um cachecol listrado velho esta pendurado atras da porta.",
         description "Este é um velho cachecol do Biblioll College, feito pela Dunn and Co. (naturalmente). Tem quatro listras:
             azul-real, esmeralda, cinza-escuro e escarlate.",
        article "um",
        devil_hint "O auge da moda, se voce ignorar as cores e usa-lo mesmo assim.",
  has   clothing;

Object  tight_door "porta estreita"  
  with  name 'tight' 'door' 'estreita' 'porta',
        initial "Uma porta estreita esta aberta na parede norte, dando para a escada dos criados.",
  has   static;

HRoom   Old_Furniture "Moveis velhos"    
  with  name 'armchairs' 'umbrella' 'table' 'stand' 'rubbish' 'armchair' 'poltronas' 'poltrona' 'guarda-chuva' 'mesa' 'suporte' 'lixo' 'moveis' 'móveis',
        n_to Attic,
        se_to Over_the_East_Wing,
        description "Móveis velhos e maltratados estão empilhados aqui: poltronas com molas saindo, suportes de guarda-chuva,
            um armário muito arranhado, uma mesa sem uma perna... Você tenta lembrar por que guarda toda essa tralha e falha.
            De todo modo, o sótão continua a sudeste.",
        cant_go "O sotao muda do norte para o sudeste aqui.",
  has   ;

Object  -> furniture "moveis" 
  with  name 'furniture' 'moveis' 'móveis',
        description "Nada ali, mas aquele armario parece interessante.",
  has   scenery;

Object  -> scratched_cupboard "armario arranhado"       
  with  name 'scratched' 'cupboard' 'arranhado' 'armario' 'armário',
  has   container open openable scenery;

Object  -> -> bird_whistle "apito de passarinho"        
  with  name 'bird' 'whistle' 'harrison' 'passaro' 'pássaro' 'apito',
        before [;
            Blow:
                if( gas_mask has worn ) "Com a mascara de gas?";
                 print "Fweep!  Fweep!^";
                if( Austin in location ) 
                    print "^Austin se assusta, mas e preguicoso demais para olhar para cima.^";
                if( location == Hedgery ) 
                    "^Os pardais mergulham e voam ao seu redor, mas logo perdem o interesse.";
                 if( location == Summer_House ) {
                    if( flock_of_sparrows has general ) 
                        "^Mas os pardais nao conseguem ouvir.";
                    if( gold_watch_on_a_chain has moved ) 
                        "^Mas os pardais ja conhecem esse truque.";
                    give gold_watch_on_a_chain moved;
                    give flock_of_sparrows general;
                    remove irate_squirrel_friend;
                    Achieved(SCORE_WATCH);
                     "^Os pardais mergulham no telhado, batendo contra o vidro. No processo, o relógio de ouro se solta
                      e cai no chão com um baque desconcertante.^^Por pouco não atinge o esquilo, que foge assustado.^^O
                      movimento súbito perturba outra vez os pardais inquietos, que levantam voo. De repente, você se sente bastante abandonado.";
                }
                if( location == Cliffs or Cave_Mouth ) 
                    "^O falcao sagrado de Apolo circula alto no ceu sobre a entrada da caverna, mas depois voa para longe.";
                if( location == Necropolis && unexciting_tombstone in nothing )  {
                    move cloak_of_many_colours to Necropolis;
                    move unexciting_tombstone to Necropolis;
                    Necropolis.d_to = unexciting_tombstone;
                     "^As aves de rapina descem, assustadas, sobre uma lápide sem graça que você não havia notado antes; mas,
                      depois de um momento, relaxam e desaparecem na escuridão.";
                }
                if( location == Hollow && corn_crake in Hollow ) 
                     "Embora pareça distraível, o codornizão deve ser surdo como uma pedra. (Você se lembra vagamente de ter lido
                      que os codornizões são as aves mais barulhentas da Irlanda, famosas por manter trabalhadores rurais acordados
                      à noite.)";
                rtrue;
        ],
        description "Um apito de passarinho ~Harrison~, segundo o slogan em um dos lados.",
        devil_hint "Ele tem um efeito calmo e tranquilizador.",
  has   ;

Object  -> -> gift_wrapped_parcel "pacote embrulhado para presente"  
  with  name 'gift' 'parcel' 'presente' 'pacote',
        before [ ;
            Open:
                remove gift_wrapped_parcel;
                move postcard_of_the_Champs_Elysees to player;
                move box_of_chocolates to player;
                move wrapping_paper to location;
                "Voce rasga o pacote e encontra uma caixa de chocolates e um cartao.";
        ],
        devil_hint "Que pena que o papel de presente nao sai.",
  has   ;

Object  -> -> medicine_bottle "frasco de remedio"       
  with  name 'medicine' 'bottle' 'remedio' 'remédio' 'frasco',
        before [;
            Attack:
                     "Você se torna extremamente violento na tentativa, mas o vidro resiste a todos os ataques. O que seria
                  preciso para quebrar essa maldita coisa?";
            Open:
                if( self hasnt locked ) rfalse;
                 "Você tenta absolutamente tudo: empurrar a tampa para baixo, girá-la, puxá-la, colocá-la no chão e pular
                  sobre ela. Tudo. Ela é decididamente à prova de adultos. O que seria preciso para quebrar essa maldita coisa?";
            Receive:
                if( self has open && noun ~= red_tablet )
                    "O gargalo e estreito demais para caber qualquer coisa alem do comprimido.";
                rfalse;
        ],
        initial nothing,
        description "~Somente antidoto: nenhum efeito preventivo.~",
        short_name [;
            if( self hasnt locked ) {
                 print "frasco de remédio rachado";
            } else {
                print "frasco de remedio indestrutivel garantido com trava a prova de criancas";
            }
            rtrue;
        ],
        devil_hint "Esses frascos sobrevivem ate a quedas longas, entao talvez voce deva tentar o fogo.",
  has   container locked openable;

Object  -> -> -> red_tablet "comprimido vermelho" 
  with  name 'red' 'pill' 'tablet' 'vermelho' 'comprimido' 'tablete',
        after [;
            Eat:
                give player ~general;
                tablet_eaten = true;
                "O gosto alarmante e de chocolate.";
        ],
        devil_hint "Esta droga e para diversao, nao e um antidoto. E tem um sabor delicioso...",
  has   edible scored;

Object  box_of_chocolates "caixa de chocolates"    
  with  name 'box' 'of' 'chocolate' 'chocs' 'caixa' 'chocolates',
        devil_hint "Bom demais para dar a qualquer outra pessoa. Na verdade...",
  has   edible;

Object  wrapping_paper "papel de presente com renas" 
  with  name 'wrapping' 'paper' 'reindeer' 'embrulho' 'papel' 'rena' 'renas',
        article "alguns",
        devil_hint "As renas tem enorme importancia.",
  has   ;

Object  postcard_of_the_Champs_Elysees "cartao-postal dos Campos Eliseos"  
  with  name 'postcard' 'card' 'cartao' 'cartão' 'postal',
        after [;
            Examine:
                if( location == Dark_Room && Dark_Room has light ) {
                    Achieved(SCORE_HAMBURG);
                    trigger_quotation(31);
                     "^Não... espere. A luz sinistra da lâmpada revela uma mensagem em tinta invisível:^^   Hamburgo
                      1420^^   Bilhete 7.-^^O sete está riscado à maneira continental.";
                }
        ],
        list_together n_obj,
        description "E enderecado a casa e carimbado em 1963, mas nao tem mensagem. Estranho.",
        devil_hint "Nao ha mensagem para ler.",
  has   ;

HRoom   Over_the_East_Wing "Sobre a ala leste"  
  with  name 'steps' 'degraus' 'escada',
        s_to Disused_Observatory,
        e_to East_Annexe,
        w_to Dark_Room,
        nw_to Old_Furniture,
        d_to Disused_Observatory,
        initial [;
            if( Austin in self )
                StartDaemon(Austin);
            rfalse;
        ],
        description "O ar é poeirento e quente, quase fazendo você engasgar nesta área bastante vazia. O sótão se estende
            do noroeste ao leste, e há também uma porta estreita levando a oeste. Um pequeno lance de degraus de madeira
            desce para o sul.",
  has   ;

Object  -> Austin "Austin"       
  with  name 'austin' 'cat' 'ginger' 'tail' 'gato' 'ruivo' 'rabo' 'cauda',
        before [;
            Rub, Touch, Squeeze:
                "Austin se enrola implacavelmente em seu pe.";
            Take:
                "Austin se afasta ressentido, para fora do alcance, e depois arrota.";
            Pull:
                "Austin sibila e nao deixa que puxem seu rabo.";
            Push:
                "Talvez voce deva dizer para que lado empurrar Austin.";
            PushDir:
                if( ( location == Attic && second == n_obj or e_obj or s_obj ) ||
                    ( location == Old_Winery && second == w_obj or s_obj ) ||
                    ( location == Conservatory && second == w_obj or e_obj ) ||
                    ( location == Old_Furniture && second == n_obj or se_obj ) ||
                    ( location == Servants_Room && second == w_obj ) ||
                    ( location == Over_the_East_Wing && second == nw_obj or s_obj or w_obj ) ||
                    ( location == Over_the_East_Wing or Dark_Room && second == e_obj ) ||
                    ( location == East_Annexe && second == w_obj ) ||
                    ( location == Disused_Observatory && second == n_obj or s_obj ) ||
                    ( location == Souvenirs_Room && second == n_obj ) ) {
                    AllowPushDir();
                    give self moved;
                    rtrue;
                }
                "Austin se recusa a ir por ali.";
        ],
        after [;
            PushDir: "Austin acompanha voce de ma vontade.";
        ],
        life [;
            Attack: 
                 "É tão pateticamente fácil chutar Austin que você nunca tem coragem. Assim, ele o engana outra vez.";
            Order, Answer: "Vejo que voce nunca teve um gato.";
            Ask: "Austin arrota esplendidamente em resposta.";
            Kiss: "Austin apenas tolera essa demonstracao de afeto.";
            Give:
                if( noun == chicken_wishbone ) {
                    GoodTry();
                    "Alguns gatos gostam do cheiro de ossos de galinha, mas Austin nao.";
                }
                if( noun == robot_mouse ) {
                    move robot_mouse to location;
                    "Austin derruba isso no chao com as garras, de modo irritadico.";
                }
                if( noun has edible )
                    "Pela primeira vez, Austin nao esta realmente com fome.";
                print_ret "Austin nao se impressiona com ", (the) noun, ".";
        ],
        initial "Austin, seu gato ruivo incorrigivel, fica esparramado por aqui.",
         description "(Tia Jemima tem dois gatos, Jane e Austin, mas considera Austin especialmente irritante, o que é praticamente
             o único ponto em que você já concordou com ela.)^^Austin, ruivo, de cauda longa e expressão irremediavelmente preguiçosa,
             é o tipo de gato que odeia ser empurrado.",
        daemon [;
            if( self has moved ) {
                give self ~moved;
                rfalse;
            }
            if( game_section ~= T_MODERN or T_ALEXANDRIA ) rfalse;
            if( game_section == T_ALEXANDRIA ) {
                if( Austin notin location ) rfalse;
                print "^Austin ";
                switch( random(6) ) {
                     1: print "se lambe";
                     2: print "se contorce";
                     3: print "salta";
                     4: print "brinca";
                     5: print "ronrona";
                     6: print "sibila";
                }
                switch( random(3) ) {
                     1: " contente.";
                     2: " feliz.";
                     3: " alegremente."; 
                }
            }
            AustinMovements(false);
        ],
  has   animate proper;

[ AustinMovements to_current env i newroom ;
    env = parent(Austin);
    newroom = -1;
    if( to_current == true ) {
        env = location;
    } else {
        if( env == Potting_Room ) {
            move Austin to Conservatory;
            if( location == Potting_Room ) {
                "^Jemima ve Austin e, sem aviso, pula no lugar, assustando-o. Ele salta para longe, sibilando.";
            }
            if( location == Conservatory ) {
                "^Austin entra da sala de jardinagem como um gato escaldado, mas logo reassume seu habitual jeito de ~folgado tranquilo~.";
            } 
            rfalse;
        }
        i = random(10);
        if( i > 8 ) {
            ! no code
        } else {
            if( env ~= location ) {
                rfalse;
            }
            if( robot_mouse in location ) {
                "^Austin brinca com o rato robo, chutando-o pelo assoalho. Ele apita lastimosamente, esperando ser resgatado.";
            }
            if( location == East_Annexe && random(2) == 1 ) {
                "^Austin se atraca com os rolos de isolamento, como se tentasse enterrar algo.";
            }
            if( location == Dark_Room && random(2) == 1 ) {
                "^Austin pula na corda, mas cai de volta, rosnando.";
            }
            if( i == 1 ) {
                 "^Austin boceja.";
            }
            if( i == 2 ) {
                "^Austin rola de costas e se espreguica.";
            }
            if( i == 3 ) {
                 "^Austin parece inefável outra vez.";
            }
            if( i == 4 ) {
                "^Austin ronrona e lambe uma das patas.";
            }
            rfalse;
        }
        if( env == House && hinged_trapdoor hasnt open ) {
            if( location == Attic ) {
                 "^Há um leve ruído de arranhões no alçapão.";
            }
            rfalse;
        }
        if( env == House ) {
            move Austin to Attic;
            if( location == Attic ) {
                 "^Austin, seu gato ruivo, salta pelo alçapão.";
            }
        }
        if( env == Attic && hinged_trapdoor has open && i == 10 ) {
            move Austin to House;
            if( location == Attic ) {
                 "^Austin, entediado outra vez, desaparece pelo alçapão.";
            }
        }
    }
    if( env == Attic ) {
        i = random(3);
        switch( i ) {
            1: newroom = Old_Furniture;
            2: newroom = Old_Winery;
            3: newroom = Servants_Room;
        }
    }
    if( env == Servants_Room ) {
        newroom = Attic;
    }
    if( env == Old_Furniture ) {
        if( i == 9 ) {
            newroom = Attic;
        } else {
            newroom = Over_the_East_Wing;
        }
    }
    if( env == Over_the_East_Wing ) {
        i = random(4);
        switch( i ) {
            1: newroom = Old_Furniture;
            2: newroom = East_Annexe;
            3: newroom = Dark_Room;
            4: newroom = Disused_Observatory;
        }
    }
    if( env == East_Annexe ) {
        newroom = Over_the_East_Wing;
    }
    if( env == Dark_Room ) {
        newroom = Over_the_East_Wing;
    }
    if( env == Disused_Observatory ) {
        if( slide_projector has on && ball_polished ~= false && to_current == false ) {
            if( location == Disused_Observatory ) {
                 "^Austin parece fascinado pelo feixe de luz.";
            }
            rfalse;
        }
        i = random(3);
        switch( i ) {
            1: newroom = Over_the_East_Wing;
            2: newroom = Library_Storage;
            3: newroom = Souvenirs_Room;
        }
    }
    if( env == Library_Storage ) {
        newroom = Disused_Observatory;
    }
    if( env == Souvenirs_Room ) {
        if( slide_projector has on && to_current == false ) {
            if( location == Souvenirs_Room ) {
                 "^Austin encara a apresentação de slides com curiosidade.";
            }
            rfalse;
        }
        newroom = Disused_Observatory;
    }
    if( env == Old_Winery ) {
        i = random(2);
        switch( i ) {
            1:  newroom = Attic;
            2: newroom = Conservatory;
        }
    }
    if( env == Conservatory ) {
        i = random(2);
        switch( i ) {
            1: newroom = Potting_Room;
            2: newroom = Old_Winery;
        }
    }
    if( newroom == -1 ) {
        rfalse;
    }
    move Austin to newroom;
    if( location == env or newroom ) {
        if( to_current == false ) {
            print "^Austin ";
            i = random(10);
            switch( i ) {
                 1: print "se esgueira";
                 2: print "caminha";
                 3: print "passeia";
                 4: print "corre";
                 5: print "se arrasta";
                 6: print "dispara";
                 7: print "anda na ponta das patas";
                 8: print "salta";
                 9: print "rasteja";
                 10: print "rola";
            }
            if( location == env ) {
                 print " para ";
                i = newroom;
            } else {
                 print " vindo de ";
                i = env;
            }
        } else {
             print "até ";
            i = newroom;
        }
         print "o ";
        if (i == Attic) {
            "sótão.";
        }
        if (i == Old_Furniture) {
            "depósito de móveis.";
        }
        if (i == Old_Winery) {
            "adega.";
        }
        if (i == Servants_Room) {
            "quarto dos criados.";
        }
        if (i == Conservatory) {
            "estufa.";
        }
        if (i == Potting_Room) {
            "sala de jardinagem.";
        }
        if (i == Over_the_East_Wing) {
            "patamar leste.";
        }
        if (i == East_Annexe) {
            "anexo.";
        }
        if (i == Dark_Room) {
            "câmara escura.";
        }
        if (i == Disused_Observatory) {
            "observatório.";
        }
        if (i == Souvenirs_Room) {
            "sala das lembranças.";
        }
        if (i == Library_Storage) {
            "depósito de livros.";
        }
            "frio.";
    }
    rtrue;
];

HRoom   Dark_Room "Camara escura"    
  with  after [;
            Look:
                if( self has light )
                    print "^A sala está cheia de uma luz avermelhada e sinistra. Você se sente sombrio e não consegue evitar
                        pensar em estatísticas de acidentes aéreos.^";
                rfalse;
        ],
        e_to Over_the_East_Wing,
        description "Esta é uma câmara escura de fotógrafo, mobiliada de modo rudimentar e usada por seu avô anos atrás. Não há muita coisa agora, pois você jogou fora os produtos químicos para o caso de as crianças encontrá-los.",
        cant_go "A única porta fica de volta a leste.",
  has   ;

Object  -> sepia_photograph "fotografia em sepia"   
  with  name 'sepia' 'photo' 'photograp' 'plaque' 'sépia' 'sepia' 'foto' 'fotografia' 'placa',
        initial "Montada numa placa há uma velha fotografia sépia de um homem.",
         description "A fotografia é uma das primeiras, com aparência de ter sido tirada no escuro porque os produtos químicos
             oxidaram aos poucos. O pobre homem no quadro (o Sr. Roger Meldrew) parece ter sido sustentado por uma grande presilha
             para ficar imóvel durante cinco minutos, e foi exatamente isso que aconteceu.",
        article "a velha",
  has   static;

Object  -> hanging_cord "cordao pendurado"   
  with  name 'hanging' 'cord' 'pendurado' 'cordao' 'cordão',
        before [;
            Pull:
                 print "Clique!  ";
                if( Dark_Room has light ) {
                    give Dark_Room ~light;
                    remove red_lamp;
                    "A lâmpada se apaga.";
                }
                give Dark_Room light;
                move red_lamp to Dark_Room;
                "Uma lâmpada de revelação se acende, emitindo uma luz vermelha sinistra.";
        ],
        initial "Você bate a cabeça no cordão pendurado no teto pela enésima vez.",
        description "Ele está preso ao teto.",
  has   static;

Object  -> -> golden_orb "orbe dourado brilhante"    
  with  name 'glowing' 'golden' 'orb' 'brilhante' 'dourado' 'orbe',
        before [;
            Rub:
                if( self has general ) "Já está brilhando!";
                print "De modo desconcertante, a condensação dissolve sua mão, e a água sobe pelo seu corpo como se ele fosse
                    papel absorvente. Você não sente nada além de desorientação, mas sua confusão logo se transforma em...^";
                move golden_orb to location;
                ContainerSave = parent(player);
                LocationSave = location;
                PlayerTo(Inside_the_Orb);
                rtrue;
        ],
        initial "Sobre a grama, ao lado do poço, há um orbe dourado brilhante.",
        description "Um tesouro em todos os sentidos, mas embaçado como a condensação numa janela fria. Formas estranhas parecem
            visíveis através da névoa: a cabeça de um cavalo, muralhas de castelo, o báculo de um sacerdote.",
  has   scored;

Object  -> photographers_flash "flash fotografico"    
  with  name 'photograp' 'flash' 'compartment' 'fotografico' 'fotográfico' 'compartimento',
        before [ i j;
            Receive:
                j = 0;
                objectloop( i in self )
                    j++;
                if( j == 2 )
                    "O flash já está cheio.";
                if( noun == timer_detonator ) rfalse;
                if( noun hasnt battery_flag ) "Só cabem baterias e temporizadores.";
                if( child(self) && child(self) has battery_flag )
                    "Já há uma bateria dentro, e agora só há espaço para um temporizador."; 
                rfalse;
        ],
        list_together s_obj,
        initial "Um flash fotográfico relativamente moderno está numa prateleira ao lado.",
        description "O tipo de caixa preta que costuma ficar sobre uma câmera, usada para iluminar cenas escuras. Tem um compartimento
        lateral que pode ser aberto, com espaço para uma bateria e um mecanismo temporizador (aparentemente opcionais).",
        angel_hint "Quando conseguir fazê-lo funcionar, talvez deva levá-lo a algum lugar de destaque.",
  has   container openable;

Object  red_lamp "lampada vermelha"      
  with  name 'red' 'lamp' 'light' 'developing' 'vermelha' 'lampada' 'lâmpada' 'luz' 'revelacao' 'revelação',
        description "As coisas parecem sutilmente diferentes sob esta luz.",
  has   scenery;

HRoom   Disused_Observatory "Observatorio desativado"        
  with  name 'mural' 'zodiac' 'beam' 'stand' 'zodiaco' 'zodíaco' 'feixe' 'suporte',
        after [;
            Look:
                if( slide_projector hasnt on || projector_reversed == false ) rfalse;
                 print "^Um feixe de luz branca entra na sala vindo do projetor de slides ao sul e atinge a ";
                if( solid_glass_ball hasnt general )
                    "bola de vidro opaca.";
                print "bola de vidro, que ";
                ObservatoryDiffraction();
                rtrue;
        ],
        n_to Over_the_East_Wing,
        s_to Souvenirs_Room,
        w_to Library_Storage,
        u_to Over_the_East_Wing,
        d_to Souvenirs_Room,
         description "Antigamente, esta pequena sala circular tinha uma cúpula e um telescópio, mas vazava terrivelmente e agora
         tem um telhado adequado.^^Um mural circular pintado com os signos do zodíaco é interrompido por um pequeno lance de
         escadas que sobe ao norte, um detector de fumaça, uma porta oeste para um nicho sombrio e a continuação das escadas
         descendo ao sul.",
  has   ;

[ ObservatoryDiffraction card ;
    card = child(slide_projector);
    if( card == nothing ) {
        "o difrata num belo espectro pelo teto.";
    }
    if( card == Eight_of_Wands_card ) {
        "o transforma numa haste reta de luz branca sobre uma parede.";
    }
    if( card == Castle ) {
        "o faz girar descontroladamente, como uma luz estroboscópica numa discoteca.";
    }
    if( card == Star ) {
        "o amplia numa poderosa luz amarela de busca que gira lentamente pela sala.";
    }
    if( card == Crescent_Moon ) {
        "o projeta em forma de crescente contra uma parede.";
    }
    print "de algum modo o curva para atingir o mural no signo de ";
    if( card == miniature ) {
        "Escorpião.";
    }
    if( card == Maiden_card ) {
        "Virgem.";
    }
    if( card == Ace_of_Cups_card ) {
        "Aquário.";
    }
    if( card == Death_card ) {
        "Câncer."; 
    }
    if( card == Drowned_Sailor_card ) {
        "Peixes.";
    }
    if( card == Fool_card ) {
        print "Capricórnio.^";
        TriggerAlert();
        Achieved(SCORE_SMOKE);
        rtrue;
    }
    if( card == charcoal_sketch ) {
        "Leão.";
    }
    rtrue;
];  

[ TriggerAlert ;  
    if( fire_escape in Dead_End ) {
        rfalse; 
    }
    Dead_End.e_to = fire_escape;
    Dead_End.d_to = fire_escape;
    move fire_escape to Dead_End;
    Beside_the_Drive.u_to = Dead_End;
    Beside_the_Drive.w_to = Dead_End;
    give Dead_End light;
    "^Seu passo faz a bola de cristal oscilar ligeiramente, o suficiente para o feixe de luz atravessar o detector de fumaça.
        Clique! Então vêm alguns bipes eletrônicos. Pequenos motores servo ganham vida com indolência, depois desabam exaustos.
        O alarme logo se reduz a um zumbido minúsculo e então ao silêncio.^^Mas há um estrondo bastante alto vindo de algum
        lugar a leste.";
];

Object  -> smoke_detector "detector de fumaca"       
  with  name 'smoke' 'detector' 'alarm' 'fire' 'fumaca' 'fumaça' 'detector' 'alarme' 'incendio' 'incêndio' 'fogo',
        description "Não está claro segundo que princípio o detector funciona. Certamente parece um detector de fumaça. Mas
            você deixou os empreiteiros resolverem por conta própria todas aquelas questões tediosas de prevenção contra incêndio.^^
            Pelo que você se lembra, eles também eram uma empresa descuidada. Colocaram a pequena coisa branca bem no alto,
            exatamente no meio da cena de Capricórnio do mural. E, mesmo que houvesse um incêndio, provavelmente seria inútil.",
  has   scenery;

Object  -> solid_glass_ball "bola de vidro macico"   
  with  name 'glass' 'ball' 'vidro' 'bola',
        before [;
            Rub:
                give self general;
                if( projector_reversed == true && slide_projector has on ) {
                    print "Você lustra a bola até deixá-la brilhando e sai do caminho do feixe. Agora a bola de vidro ";
                    ObservatoryDiffraction();
                    rtrue;
                }
                "Você lustra a bola até deixá-la brilhando.";
            Examine, Search:
                if( self hasnt general ) "A bola está arranhada e embaçada.";
                trigger_quotation(32);
                print "Na bola, a névoa gira e então se abre para mostrar ";
                switch( random(12) ) {
                    1: "um reflexo do seu rosto.";
                    2: "uma vertiginosa vista aérea dos jardins de Meldrew Hall.";
                    3: "imagens confusas de uma árvore sendo plantada.";
                    4: "a imagem de uma datilógrafa, de volta do trabalho e vagando pelo quarto de seu apartamento.";
                    5: "uma imagem escura de uma vitrine de museu.";
                    6: "uma pintura de mestre antigo, talvez um Watteau, com uma cena da mitologia clássica.";
                    7: "uma vista em ângulo estranho de uma vila romana parcialmente em ruínas.";
                    8: "uma visão tremeluzente de rostos ao redor de uma fogueira.";
                    9: "uma visão escura e assustadora de uma cripta.";
                    10: "uma visão onírica e fechada de um lugar meio familiar.";
                    11: "um esboço de um grande palácio de mármore.";
                    12: "uma visão do interior da Inglaterra.";
                }
        ],
        initial "Montada no velho suporte do telescópio há algo que parece uma bola de vidro maciço.",
  has   static;

HRoom   Library_Storage "Deposito da biblioteca"        
  with  name 'tank' 'tanque',
        e_to Disused_Observatory,
        description "Antigamente, a biblioteca da casa era usada como depósito de armas, e todos os livros indesejados eram
            guardados aqui. Agora é apenas outro recanto incômodo, com um tanque de água e alguns canos num canto, relacionados
            ao aquecimento central.",
        cant_go "Daqui, você só pode se espremer de volta a leste, até o observatório.",
  has   ;

Object  -> water_pipe "cano de agua"       
  with  name 'water' 'pipe' 'joint' 'pipes' 'agua' 'água' 'cano' 'juncao' 'junção' 'canos',
        before [;
            TurnWith:
                if( second ~= steel_wrench ) print_ret (The) second, " se mostra inadequado como ferramenta de encanamento.";
            Turn, Repair:
                if( steel_wrench has general ) 
                    "A junção já está razoavelmente firme.";
                if( steel_wrench notin player ) {
                    if( old_gardeners__gloves in player && old_gardeners__gloves has worn )
                        "Mesmo usando luvas, você não consegue apertar a junção sem algum tipo de ferramenta.";
                    "Com as mãos nuas, você não consegue apertar a junção.";
                }
                give steel_wrench general;
                Achieved(SCORE_PLUMBING);
                give book_of_Twenties_poetry ~concealed;
                give book_of_Twenties_poetry moved;
                give romantic_novel ~concealed;
                give romantic_novel moved;
                "Você aperta a junção com a chave, apenas o suficiente para os livros caírem sem uma explosão de água jorrando.";
        ],
        description "A junção do cano de água não parece muito resistente.",
  has   concealed static;

Object  -> romantic_novel "romance"       
  with  name 'romance' 'romantic' 'novel' 'book' 'romance' 'romantico' 'romântico' 'livro',
        parse_name BookParsename,
        before [;
            Take:
                if( steel_wrench hasnt general ) {
                    PlumbingDisaster();
                    rtrue;
                }
            Examine:
                if( steel_wrench hasnt general ) "Você não pode lê-lo enquanto ele sustenta o cano.";
                trigger_quotation(35);
                rfalse;
        ],
        list_together n_obj,
        initial "Um romance e um livro de poesia são os únicos livros restantes, sustentando um cano de água perto de uma junção
            bastante frouxa; já passou da hora de chamar um encanador para resolver isso.",
        description "~Coroas para a Garota do Algodão~, da senhorita Marie Swelldon, publicado em Londres em 1912. Trata da filha
            despreocupada de um dono de moinho de Yorkshire e de suas aventuras ao se casar com a aristocracia.",
        devil_hint "Não se dê ao trabalho de ler ou pensar nisso. Não tem nada a ver com sua família.",
  has   consultable;

[ PlumbingDisaster ;
    deadflag = FAILED;
    "Quando você puxa o livro, o cano estoura e espalha água por toda parte, encharcando você, tornando o livro ilegível,
        vazando pelo teto para os quartos abaixo e causando um enorme tumulto. Você é obrigado a passar o resto da tarde
        conseguindo um encanador às pressas.";
];

Object  -> book_of_Twenties_poetry "livro de poesia dos anos vinte"     
  with  name 'poetry' 'book' 'poesia' 'livro',
        parse_name BookParsename,
        before [;
            Take:
                if( steel_wrench hasnt general ) {
                    PlumbingDisaster();
                    rtrue;
                }
            Examine:
                if( steel_wrench hasnt general ) "Você não pode lê-lo enquanto ele sustenta o cano.";
                if( location == thedark )
                    "A poesia dos anos 1920 pode ser esclarecedora no sentido literário, mas não literalmente. Na verdade, está
                     escuro demais para decifrar a impressão.";
                if( location == Lighthouse )
                    "O brilho do sol refletido no oceano é forte demais para distinguir as palavras sem lhe causar dor de cabeça.";
                print "Editores falam muita bobagem sobre leitores serem transportados pelos livros, mas de algum modo você chegou à...^";
                move book_of_Twenties_poetry to location;
                PlayerTo(Unreal_City);
        ],
        list_together n_obj,
        devil_hint "Ora, ora, uma era dourada para a poesia clara e simples. Finalmente, o fim da obscuridade tediosa de Tennyson,
            Kipling e Hardy.",
  has   concealed consultable;

[ WallDisplay o ;       
    print "a imagem em ", (the) o;
    if( o.n_to == nothing )
        ".";
    ", magnificamente ampliada e incrivelmente realista. Ora, mal se perceberia que há uma parede ali.";
];

! Hmm, yep, there are two functions that do the exact same thing.
[ DisplayCardDesc o ;
    print "a imagem em ", (the) o;
    if( o.n_to == nothing ) {
        ".";
    }
    ", magnificamente ampliada e incrivelmente realista. Ora, mal se perceberia que há uma parede ali.";
];

HRoom   Souvenirs_Room "Sala das lembrancas"  
  with  name 'souvenirs' 'holiday' 'snaps' 'beam' 'lembrancas' 'lembranças' 'ferias' 'férias' 'fotos' 'feixe',
        before [ o;
            Examine:
                if( noun == s_obj && slide_projector has on ) {
                    o = child(slide_projector);
                    if( o == nothing ) "A parede sul está iluminada pelo projetor.";
                    print "A parede sul mostra "; WallDisplay(o); rtrue;
                }
                rfalse;
        ],
        after [ o;
            Look:
                if( slide_projector hasnt on ) rfalse;
                o = child(slide_projector);
                if( o == nothing )
                    print "^A parede sul está iluminada pelo projetor.^";
                else {
                    print "^A parede sul exibe "; DisplayCardDesc(o);
                }
                if( projector_reversed == true )
                    "^Um feixe de luz branca aponta diretamente para trás do projetor, pela porta norte até o observatório.";
                rtrue;
        ],
        n_to Disused_Observatory,
        s_to [; << Enter south_wall >>; ],
        u_to Disused_Observatory,
        description "É aqui que você deveria ter deixado o maldito mapa, no depósito familiar de lembranças e fotos de férias.
            Você o revistou minuciosamente antes e não suporta a ideia de procurar tudo outra vez. Um projetor de slides aponta
            para a parede sul caiada, uma das paredes externas da casa. O único caminho é subir de volta ao observatório.",
  has   ;

Object  -> slide_projector "projetor de slides"     
  with  name 'slide' 'projector' 'switch' 'dial' 'slot' 'focus' 'slides' 'projetor' 'interruptor' 'botao' 'botão' 'abertura' 'foco',
        before [;
            Receive:
                if( child(self) )
                    "Já há um slide dentro.";
                if( noun == postcard_of_the_Champs_Elysees ) {
                    print "O cartão-postal é grande demais para caber.^";
                    GoodTry();
                    rtrue;
                }
                if( noun == framed_charcoal_sketch ) {
                    print "A moldura é volumosa demais.^";
                    GoodTry();
                    rtrue;
                }
                if( noun == charcoal_sketch or miniature )
                    rfalse;
                if( noun hasnt card ) 
                    "Não cabe. Só há espaço para algo plano e do tamanho, digamos, de uma carta de baralho.";
            Turn:
                if( projector_reversed == true ) {
                    projector_reversed = false;
                    if( self has on ) {
                        give Disused_Observatory ~light;
                        "O feixe intenso de luz se apaga outra vez.";
                    }
                    "Click.";
                }
                projector_reversed = true;
                if( self has on ) {
                    give Disused_Observatory light;
                     "Um feixe intenso de luz branca surge para trás do projetor. Quando você sai do feixe, ele se estende
                      perfeitamente reto pela porta norte.";
                }
                "Click.";
        ],
        after [ o;
            Receive:
                if( self has on ) {
                    ToggleSouthWall(noun);
                    rtrue;
                }
                rfalse;
            LetGo:
                if( self has on ) {
                    ToggleSouthWall(nothing);
                    rtrue;
                }
                rfalse;
            SwitchOn:
                give Souvenirs_Room light;
                if( projector_reversed == true ) {
                    give Disused_Observatory light;
                }
                o = child(slide_projector);
                if( o == nothing ) {
                     print "A parede sul está iluminada. ";
                    if( projector_reversed == true ) {
                         print "Além disso, um estreito feixe branco se estende para trás do projetor, apontando pela porta do
                            observatório ao norte.";
                    }
                    new_line;
                    rtrue;
                }
                ToggleSouthWall(o);
                rtrue;
            SwitchOff:
                give Souvenirs_Room ~light;
                give Disused_Observatory ~light;
                give south_wall concealed;
                rfalse;
        ],
         description "Ele tem um interruptor liga/desliga na lateral e uma abertura para segurar o que será projetado. Há
            também um pequeno botão atrás, talvez para o foco.",
  has   container open scenery switchable;

[ ToggleSouthWall o ;
    if( o ~= nothing ) {
        if( o.door_to ~= nothing ) {
            south_wall.door_to = o.n_to;
            give south_wall ~concealed;
        }
        print "A parede sul se ilumina com ";
        DisplayCardDesc(o);
        rtrue;
    }
    give south_wall concealed;
     "A parede sul volta a ficar em branco.";
];

[ FakeDie card ;
    print "^^    ";
    style bold;
     print "*** Você morreu ***";
    style roman;
    print "^^Ou será que morreu? Não... este não é exatamente o fim. Você vê uma luz azul-branca intensa no fim do que parece
        um túnel e flutua em direção a ela, até perceber, atordoado, que encara a luz do projetor de slides e mal se moveu.^";
    give card general;
    rtrue;
];

Object  -> south_wall "parede sul"       
  with  before [ o;
            Enter:
                o = child(slide_projector);
                 if( o == nothing ) 
                     "Você não pode ir por ali.";
                if( o == Eight_of_Wands_card ) 
                     "Você não consegue entrar na imagem. Ela não é muito realista, mais uma figura oito estilizada.";
                 print "Você caminha confiante para dentro da parede sul...^";
                if( o has general ) 
                     "Mas não consegue entrar na cena uma segunda vez.";
                if( o == Death_card ) {
                     print "^E se vê num milharal dourado numa tarde ensolarada. Você mal tem tempo de admirar as espigas
                        antes que a foice do Ceifador separe sua alma do corpo.^";
                    FakeDie(o);
                    rtrue;
                }
                if( o == Drowned_Sailor_card ) {
                     print "^Você está debaixo d'água, no naufrágio de um navio, cercado pelos esqueletos da antiga tripulação,
                        à qual se junta abruptamente quando seu ar acaba.^";
                    FakeDie(o);
                    rtrue;
                }
                if( o == Fool_card ) {
                     print "^E se vê saindo de um penhasco. Tudo vai bem por um instante, até que, como um personagem de desenho,
                        você percebe que não há chão sob seus pés e despenca para uma morte pedregosa muito abaixo.^";
                    FakeDie(o);
                    rtrue;
                }
                give o general;
                PlayerTo(o.door_to);
                rtrue;
        ],
        door_to nothing,
        door_dir s_to,
  has   concealed door open scenery static;

HRoom   East_Annexe "Anexo leste"        
  with  name 'gap' 'tiles' 'roof' 'fresta' 'telhas' 'telhado',
        before [;
            Go, Enter:
                if( old_smudged_battery in electric_torch && noun == n_obj or cupboard_door ) {
                     "Você sabe que só tem uma bateria velha, quase descarregada, na lanterna e reluta em pisar nas tábuas
                      mais frágeis dentro do armário sem uma iluminação mais segura.";
                }
                if( child(electric_torch) == nothing && noun == n_obj or cupboard_door ) 
                    "Mas está escuro lá dentro e não há bateria na lanterna.";
        ],
        n_to cupboard_door,
        s_to Dead_End,
        w_to Over_the_East_Wing,
        description [;
             print "Este anexo estreito no extremo leste da casa está cheio de rolos velhos de isolamento do sótão, sobras da
                 última vez em que o serviço foi feito (seja quando for). Uma fresta entre as telhas do telhado (que você realmente
                 precisa consertar antes do inverno) deixa entrar um pouco de luz natural";
            if( Dead_End.d_to == nothing ) 
                ", mas os sótãos a oeste e ao sul estão escuros.";
            " e o beco sem saída ao sul está claro, iluminado pelo sol através de uma abertura quadrada no telhado.";
        ],
  has   light;

Object  -> insulation_rolls "rolos de isolamento"   
  with  name 'insulation' 'rolls' 'roll' 'isolamento' 'rolos' 'rolo',
        before [;
            Examine, Search, LookUnder:
                if( old_gardeners__gloves hasnt worn ) 
                    "Uma atitude imprudente. As fibras irritantes do isolamento logo o fazem desistir.";
                if( new_battery notin self )
                    "Infelizmente, não há mais nada ali.";
                move new_battery to East_Annexe;
                Achieved(SCORE_BATTERY);
                 "Você descobre uma bateria nova e brilhante. Ela deve ter caído por acidente quando o isolamento do sótão
                  estava sendo instalado.";
        ],
        article "alguns",
  has   scenery;

Object  -> -> new_battery "bateria aparentemente nova"  
  with  name 'new' 'battery' 'nova' 'bateria',
        list_together s_obj,
        number 300,
         devil_hint "Esse é um quebra-cabeça difícil, sim.",
  has   battery_flag;

Object  -> cupboard_door "porta do armario" 
  with  name 'cupboard' 'door' 'armario' 'armário' 'porta',
        before [;
             Knock: "Não há resposta e, francamente, é difícil imaginar que haja alguém lá dentro.";
        ],
        door_to Inside_Cupboard,
         when_closed "Na parede norte há uma intrigante porta de armário fechada.",
        with_key small_brass_key,
        door_dir n_to,
         when_open "Na parede norte há uma porta de armário aberta, grande o bastante para entrar.",
  has   door lockable openable static;

HRoom   Dead_End "Beco sem saida"      
  with  name 'soot' 'chimney' 'sweeping' 'gear' 'fuligem' 'chamine' 'chaminé' 'limpeza' 'equipamento',
        before [;
            Go:
                if( noun == e_obj or d_obj && self.d_to ~= nothing )
                      print "Você sai desajeitadamente para uma escada precária que desce pela parede leste do saguão e desce
                        nervosamente...^";
                rfalse;
        ],
        n_to East_Annexe,
        s_to secret_door,
        e_to nothing,
        d_to nothing,
         description "O sótão sinuoso termina aqui, e este trecho é particularmente sujo, cheio de fuligem do velho equipamento
         quebrado de limpeza da chaminé.",
  has   ;

! this is not in the original, which gives the compass objects names 'wall'. I'm just going to add it for simplicity
Object  -> south_wall2 "parede sul"
         with name 'south' 'wall' 'sul' 'parede',
        before [;
             Knock: "A parede sul produz um som curiosamente oco.";
            Push:
                if( secret_door hasnt concealed ) rfalse;
                give secret_door ~concealed;
                move secret_door to Dead_End;
                Achieved(SCORE_SECRETDOOR);
                 "Uma porta secreta se abre de repente!";
        ],
        has scenery;

Object  -> rucksack "mochila de lona"     
  with  name 'canvas' 'rucksack' 'sack' 'lona' 'mochila' 'saco',
         initial "Minha nossa! Essa velha mochila de lona deve ser justamente a que seu famoso ancestral, o explorador africano
            Ebenezer Meldrew, trouxe da Expedição do Zambeze de 1882!",
         description "Pensando melhor, agora que você olha com mais atenção, parece ser a mochila que comprou para ir a Paris
            cinco anos atrás.",
         devil_hint "Ela poderia ser útil, se ao menos pudesse carregar alguma coisa.",
  has   clothing container open openable;

