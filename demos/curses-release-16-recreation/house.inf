Object  -> delicate_gold_key "chave de ouro delicada" 
  with  name 'delicate' 'gold' 'key' 'delicada' 'ouro' 'chave',
        sw_to compass,
        devil_hint "Ouro e chumbo são naturalmente relacionados, então você quer encontrar uma caixa de chumbo para abrir.",
  has   concealed scored;

HRoom   Old_Winery "Adega velha"  
  with  name 'banister' 'rail' 'crack' 'paraphernalia' 'corrimao' 'corrimão' 'trilho' 'rachadura' 'utensilios' 'utensílios',
        before [;
            PutOn:
                if( second == demijohn )
                    "Já sabemos o que acontece com coisas equilibradas sobre o garrafão.";
                rfalse;
        ],
        after [;
            Look:
                if( self has general )
                    rfalse;
                give self general;
                print "^Ao perturbar o ar parado, a chave do sótão, equilibrada sobre o garrafão, escorrega para o chão e desaparece
                    numa rachadura entre as tábuas. Seu ânimo afunda enquanto ela chacoalha por alguma distância. Como diabos você
                    vai recuperá-la?^";
                rfalse;
        ],
        s_to Attic,
        e_to Storage_Room,
        w_to Conservatory,
        d_to Conservatory,
        description "Esta pequena cavidade no extremo norte do sótão já abrigou todo tipo de utensílio para fazer vinho em casa,
        agora perdido e não lamentado. Degraus com um corrimão firme descem para baixo e a oeste, enquanto o corrimão continua
        por uma passagem a leste.",
        time_left 0,
        time_out [;
            print "^Desculpe. Pensando melhor, a pontuação só fica confusa assim, então é melhor retirar os pontos bônus.^";
            good_try_bonus = 0;
            redraw_statusline = true;
            score = score - 5;
            rfalse;
        ],
  has   ;

Object  -> demijohn "garrafao de vidro rotulado" 
  with  name 'demijohn' 'glass' 'bottle' 'label' 'garrafao' 'garrafão' 'vidro' 'garrafa' 'rotulo' 'rótulo',
        before [;
            Open:
                if( old_gardeners__gloves hasnt worn )
                    "Suas mãos escorregam na tampa de rosca do garrafão e não conseguem segurá-la.";
                Achieved(SCORE_DEMIJOHN);
                rfalse;
            Attack:
                "O garrafão é feito de algo parecido com vidro químico industrial. Você o chuta e machuca o pé.";
        ],
        description "A tinta desbotada do rótulo diz: Sabugueiro '63.",
  has   container openable static transparent;

Object  -> -> nasty_battery "bateria vermelha de aspecto desagradavel"       
  with  name 'nasty' 'red' 'battery' 'desagradavel' 'desagradável' 'vermelha' 'bateria',
        list_together s_obj,
        description "Na lateral está a palavra ~Achtung~.",
        devil_hint "Ela foi feita para sua lanterna, e não para outra coisa.",
  has   battery_flag;

Object  -> -> tourist_map "mapa turistico"  
  with  name 'hamburg' 'tourist' 'map' 'hamburgo' 'turistico' 'turístico' 'mapa',
        before [ n;
            Consult:
                if( self in demijohn ) "Você não consegue olhar de perto o suficiente.";
                n = TryNumber(consult_from);
                if( n ~= 1420 )
                    "Apenas algumas ruas anônimas. O detalhamento deste mapa é tão minúsculo que, sem a referência exata de quatro
                     dígitos do que procura, você nunca a encontrará.";
                if( Museum_Foyer has visited ) "Você se lembra: o museu.";
                print "^Nessa referência exata fica a Meldreustrasse, uma ruela que abriga um museu de ocultismo.^^De repente você
                    se lembra! Visitou o lugar certa vez, e o curador Doktor Stein mostrou tudo... e hipnotizou você até transformá-lo
                    num redemoinho de inconsciência...^^";
                move tourist_map to location;
                PlayerTo(Museum_Foyer);
                rtrue;
        ],
        list_together n_obj,
        description "A boa notícia é que ele tem excelentes referências de grade, fáceis de consultar. A má notícia é que é um mapa
        do centro de Hamburgo.",
        devil_hint "Puramente decorativo.",
  has   ;

HRoom   Conservatory "Covil da tia Jemima"        
  with  name 'objets' 'trouves' 'pottery' 'bric' 'brac' 'objetos' 'encontrados' 'ceramica' 'cerâmica' 'quinquilharia',
        after [;
            Look:
                if( antiquated_wireless has general && antiquated_wireless in Airing_Cupboard )
                    print "^Música execrável vem do armário de roupas.^";
                rfalse;
        ],
        s_to Airing_Cupboard,
        e_to Old_Winery,
        w_to Potting_Room,
        sw_to House,
        u_to Old_Winery,
        description "Este lugar costumava ser chamado de estufa, antes de tia Jemima tomá-lo para mexer com plantas, pintura e,
            ocasionalmente, cerâmica. Ela o encheu de objetos encontrados e quinquilharias, além de pendurar um calendário caseiro
            de aquarelas. Até o velho armário de roupas ao sul está abarrotado.^^Uma porta aberta leva de volta a sudoeste, ao
            patamar superior, e você ouve o ruído caótico de malas sendo manuseadas; ainda bem que ninguém o viu. Uma escada estreita
            sobe a leste para o sótão.^^A própria Jemima parece estar na sala de jardinagem a oeste.",
  has   light;

Object  -> daisy_calendar "calendario de margaridas"       
  with  name 'calendar' 'page' 'pages' 'daisy' 'calendario' 'calendário' 'pagina' 'página' 'paginas' 'páginas' 'margarida',
        before [ i w;
            Examine: 
                print "O calendário está em ";
                i = self.number;
                switch( i ) {
                    0: print "janeiro";
                    1: print "fevereiro";
                    2: print "março";
                    3: print "abril";
                    4: print "maio";
                    5: print "junho";
                    6: print "julho";
                    7: print "agosto";
                    8: print "setembro";
                    9: print "outubro";
                    10: print "novembro";
                    11: print "dezembro";
                }
                print " e uma aquarela de algumas ";
                DaisyType(i);
                " margaridas.";
            Turn, SwitchOn:
                self.number = (self.number + 1) % 12;
                << Examine self >>;
            Consult:
                if( consult_words == 1 ) {
                    wn = consult_from;
                    w = NextWord();
                    i = -1;
                    if( w == 'january' ) i = 0;
                    if( w == 'february' ) i = 1;
                    if( w == 'march' ) i = 2;
                    if( w == 'april' ) i = 3;
                    if( w == 'may' ) i = 4;
                    if( w == 'june' ) i = 5;
                    if( w == 'july' ) i = 6;
                    if( w == 'august' ) i = 7;
                    if( w == 'september' ) i = 8;
                    if( w == 'october' ) i = 9;
                    if( w == 'november' ) i = 10;
                    if( w == 'december' ) i = 11;
                    if( i >= 0 ) {
                        self.number = i;
                        << Examine self >>;
                    }
                }
                "Ele só tem os doze meses habituais.";
        ],
        number 5,
  has   scenery;

HRoom   Airing_Cupboard "Armario de roupas"        
  with  name 'coffee' 'mugs' 'sculpture' 'racks' 'mug' 'cafe' 'café' 'canecas' 'escultura' 'prateleiras' 'caneca',
        n_to Conservatory,
        description "Um espaço de cerca de dois metros quadrados. Os velhos varais agora contêm esculturas de cerâmica estranhas,
            quase, mas não exatamente, irreconhecíveis como canecas de café. Um canto está cheio de uma enorme pilha de lençóis
            tingidos, do infame período de Revivência dos Anos Sessenta de tia Jemima em outubro passado.",
        cant_go "O único caminho daqui é voltar ao norte.",
  has   light;

Object  -> pile_of_sheets "pilha de lencois"       
  with  name 'pile' 'of' 'sheets' 'sheet' 'pilha' 'lencois' 'lençóis' 'lençol',
        before [;
            Take:
                print "Só de pensar na ira de Jemima se você realmente pegasse um de seus lençóis tingidos (~Tingir é uma arte como
                    qualquer outra... Eu faço isso muito bem~) já é terrível demais. ";
                if( antiquated_wireless has concealed ) "Mas parece haver algo escondido embaixo.";
                new_line;
                rtrue;
            Search, Examine, LookUnder:
                if( antiquated_wireless has concealed ) {
                    give antiquated_wireless ~concealed;
                    Achieved(SCORE_WIRELESS);
                    "Não havia tantos lençóis quanto você pensava; eles estavam sobre um grande rádio preto, agora exposto à luz
                     pela primeira vez em meses.";
                }
                print "Não, você só está sujando suas ";
                if( old_gardeners__gloves has worn )
                    print "luvas";
                else
                    print "mãos";
                " de aparência manchada.";
        ],
        daemon [;
            if( antiquated_wireless hasnt on ) {
                StopDaemon(self);
                give antiquated_wireless ~general;
                rtrue;
            }
            if( antiquated_wireless in Conservatory && location == Potting_Room ) {
                print "^Jemima cantarola junto com ";
            } else if( antiquated_wireless in location ) {
                print "^O rádio toca ";
            } else {
                rtrue;
            }
            if( random(81) == 1 ) 
                "um esplêndido concerto para violino de Sibelius pela Orquestra Sinfônica de Minot, Dakota do Norte.";
            print_ret (string) RandomEntry(type_of_tune), (string) RandomEntry(tune_version), (string) RandomEntry(horrible_tunes);
        ],
  has   scenery;

Object  -> antiquated_wireless "radio antiga"     
  with  name 'switch' 'cabinet' 'radio' 'wireless' 'interruptor' 'armario' 'armário' 'radio' 'rádio',
        before [;
            if( self has concealed )   ! pretty sure this is impossible to reach -- ATG
                "Você já jogou este jogo antes.";
            Take: "É pesado demais para tirar dos rodízios.";
            Push, Pull, Turn: "Ele se move facilmente sobre os rodízios.";
            PushDir:
                if( location == Conservatory && second == e_obj )
                    "Você não pode subir por ali.";
                if( location == Conservatory && second == w_obj ) {
                    deadflag = FAILED;
                    "Tia Jemima passa as quatro horas seguintes explicando exatamente por que guardou o rádio. A razão é muito
                     complicada e se deve à sua firme convicção de que campos magnéticos influenciam o crescimento das plantas.
                     A essa altura você precisa partir para o aeroporto...";
                }
                AllowPushDir();
                rtrue;
        ],
        after [;
            SwitchOn:
                StartTimer(self,6);
                "Você aperta o interruptor do rádio, mas nada acontece.";
            SwitchOff:
                if( self has general ) {
                    give antiquated_wireless ~general;
                    "Graças aos céus.";
                }
                rfalse;
            PushDir:
                print "Ele se move facilmente sobre os rodízios.^";
                rfalse;
        ],
        description "Ele rola sobre rodízios e tem um interruptor liga/desliga de baquelite.",
        describe [;
            if( self has general )
                "^O rádio enche o ar com a estação favorita de Jemima, ~Mild-n-Breezy FM~, sobre a qual é melhor falar o mínimo possível.";
            print "^De um lado há um armário pesado sobre rodízios contendo um rádio antigo, do tipo com ";
            if( self has on ) print "válvulas brilhantes ";
            "lá dentro. No topo há um interruptor de baquelite.";
        ],
        article "um",
        time_left 0,
        time_out [;
            if( self has on ) {
                StartDaemon(pile_of_sheets);
                give self general;
                if( antiquated_wireless in location )
                    print "^As válvulas do rádio brilham, e uma música execrável, supostamente fácil de ouvir, enche o ar como algodão-doce sonoro.^";
                if( location == Potting_Room && antiquated_wireless in Conservatory )
                    print "^Música execrável começa a soar da estufa, e tia Jemima cantarola distraidamente.^";
            }
        ],

  has   concealed static switchable;

HRoom   Potting_Room "Sala de jardinagem"      
  with  name 'plants' 'flowers' 'seeds' 'trowels' 'plantas' 'flores' 'sementes' 'espatulas' 'espátulas',
        after [;
            Go:
                if( parent(daisy_chain) == nothing && daisy_given == true ) {
                    give Jemima general;
                    print "^~Oh, seu bobo,~ diz Jemima condescendentemente, ~Você perdeu sua corrente de margaridas! Que cor
                        você quer então?~^";
                }
                rfalse;
            Look:
                if( antiquated_wireless has general && antiquated_wireless in Conservatory ) 
                    print "^Música execrável vem da estufa.^";
                if( antiquated_wireless has general && antiquated_wireless in Airing_Cupboard )
                    print "^Felizmente, o rádio quase não é audível daqui.^";
                rfalse;
        ],
        e_to Conservatory,
        description "Esta sala clara está cheia de vasos de plantas, flores, sementes, espátulas ornamentais e outros utensílios
            variados de jardinagem.",
        cant_go "A única saída é voltar a leste, para a estufa.",
  has   light;

Object  -> old_gardeners__gloves "luvas velhas de jardineiro" 
  with  name 'old' 'gardeners' 'gloves' 'velhas' 'jardineiro' 'jardinagem' 'luvas',
        before [;
            Take:
                if( antiquated_wireless in Conservatory && antiquated_wireless has general ) rfalse;
                if( self has moved ) rfalse;
                deadflag = FAILED;
                "Tia Jemima de repente ouve você, vira-se e o vê furtando suas luvas, gritando irritada até finalmente chamar toda
                 a família. Você se oferece para mover algumas malas só para escapar dela.";
        ],
        initial "Um par de luvas amarelas de borracha pende de um gancho numa parede.",
        article "alguns",
        devil_hint "Não servem para nada. Por que você iria querer luvas?",
  has   clothing scored;

Object  -> Jemima "Jemima"       
  with  name 'aunt' 'jemima' 'tia',
        life [ i;
            Give:
                if( noun == box_of_chocolates ) {
                    remove box_of_chocolates;
                    Achieved(SCORE_CHOCOLATE);
                    give Jemima general;
                    Jemima.description = "Definitivamente apaziguada.";
                    "Tia Jemima se atira sobre os chocolates, devora um bombom de morango e convence você a aceitar um horrível
                     crocante de caramelo. ~Agora~, diz ela, ~é sua vez de ganhar uma corrente de margaridas!~^^Você tenta parecer
                     satisfeito.^^~Vejamos, os outros já ganharam as suas... Só restam algumas cores. O que você gostaria?~";
                }
                if( noun == chocolate_biscuit ) {
                    print "Jemima pega o biscoito a contragosto e mordisca-o, mas continua amuada.^";
                    GoodTry();
                    remove chocolate_biscuit;
                    rtrue;
                }
                if( noun == red_tablet ) 
                    "Jemima olha para o comprimido com muita desconfiança. ~Agora não, obrigada.~";
                if( noun == medicine_bottle && noun has locked ) {
                    remove red_tablet;
                    give medicine_bottle ~locked;
                    give medicine_bottle open;
                    "Jemima pega o frasco distraidamente, abre-o sem a menor dificuldade e (antes que você consiga impedi-la) engole
                     o comprimido. É melhor torcer para que ele não fosse útil mesmo.^^~Estou sempre deixando meu remédio por aí~,
                     diz vagamente enquanto devolve o frasco. ~Um dia vou esquecer a cabeça.~";
                }
                print "Uma oferta de paz é uma boa ideia, mas de algum modo ", (the) noun;
                if( noun == gift_wrapped_parcel ) {
                    print " não tem estilo... afinal, não é Natal.^";
                    GoodTry();
                    rtrue;
                }
                " parece inadequado.";
            Kiss: 
                print "Ela fica um pouco apaziguada, mas só um pouco.^";
                GoodTry();
                rtrue;
            Attack:
                trigger_quotation(28);
                "Bem, ela é irritante, mas isso é família para você.";
            Answer:
                if( self hasnt general ) {
                    trigger_quotation(17);
                    "Ela finge não ter ouvido, seu truque favorito quando está amuada.";
                }
                give Jemima ~general;
                i = 0;
                if (noun == 'yellow' or 'yellowish') {
                    i = 1;
                }
                if (noun == 'blue') {
                    i = 2;
                }
                if (noun == 'red') {
                    i = 4;
                }
                if (noun == 'white' or 'plain') {
                    i = 5;
                }
                if (noun == 'green') {
                    i = 6;
                }
                if (noun == 'orange') {
                    i = 9;
                }
                if (i ~= 0) {
                    print "~Então está bem, tenho certeza de que tenho algumas perfeitas para isso.~^^";
                }
                if (i == 0) {
                    i = 5;
                    print "~Não restou nada assim. Então serão margaridas velhas e simples para você, querida!~^^";
                }
                StartTimer(Jemima,7);
                daisy_chain.number = i;
                "Depois de um momento ela percebe que você ainda está ali. ~Volte mais tarde, logo estará pronto.~ Você geme por
                dentro, mas força um sorriso pálido. Eu deveria ter comido os chocolates sozinho, você pensa.";
            Ask:
                trigger_quotation(17);
                if (second == 'daisies' or 'chains') "Jemima lança um olhar frio. ~São apenas para decoração.~";
                if (second == 'austin' or 'cat') "~Gato miserável! Dá mais trabalho do que vale.~";
                if (second == 'rubber' or 'gloves') "~Essas são minhas luvas.~";
                if (second == 'tourist' or 'map' or 'paris' or 'holiday') 
                    "~Eu não saberia. Não sou eu quem vai viajar.~";
                if (second == 'attic' or 'key' or 'winery') "~Você não perdeu a chave do sótão outra vez? Hum.~";
                if (second == 'demijohn' or 'bottle') "~Um monte de quinquilharia velha.~";
                if (second == 'dumb' or 'waiter' or 'dumbwaiter') "~Deixe aquela coisa velha e precária em paz!~";
                if (second == 'calendar') "~Nada mal. É claro que minhas margaridas são melhores, mas não é ruim para iniciantes.~";
                if (second == 'colour' or 'colours') "~Cada um tem sua favorita.~";
                if (second == 'radio' or 'wireless') 
                    "~Já lhe disse cem vezes, não quero um rádio transistor. Aquele velho rádio de válvulas me basta.~";
                if (second == 'curse' or 'curses' or 'family') 
                    "~Nada há de errado com esta família que uma boa viagem longa não possa consertar.~";
                if (second == 'me') "~Conhece-te a ti mesmo, é o que diz o bom livro.~";
                "Jemima não tem nada a dizer sobre o assunto.";
        ],

        orders [;
            Give:
                if( noun == old_gardeners__gloves )
                    "~Não posso lhe dar essas, estou usando-as!~^^(Isso claramente não é verdade, mas você sabe como são as tias.)";   
            default:
                "Tia Jemima nunca fez o que você sugeriu nem nas melhores ocasiões. Esta não é uma delas.";
        ],
        initial "Tia Jemima, que coleciona variedades de margaridas há anos, está ocupada com seu passatempo anual de decidir
            quais espécies formam as melhores correntes.",
        description "Ela passou a tarde toda mexendo nessas flores cortadas. Também está um pouco chateada por ter sido deixada
            sozinha em casa enquanto você viaja, então é melhor não ficar do lado errado dela. Você realmente deveria fazer as pazes
            de algum modo.",
        article "Tia",
        time_left 0,
        time_out [;
            if( location ~= Potting_Room ) {
                StartTimer(self, 1);
                rtrue;
            }
            print "^~Pronto! Tudo terminado.~ Jemima pendura uma corrente de margaridas em seu pescoço, depois franze a testa e
                ajeita seu cabelo de um modo extremamente irritante.^";
            Achieved(SCORE_DAISY);
            give daisy_chain moved;
            give daisy_chain worn;
            daisy_given = true;
            move daisy_chain to player;
            rtrue;
        ],
  has   animate proper;

[ DaisyType n ;
    switch( n ) {
        0: print "Orgulho de Jemima salpicado";
        1: print "Chapéu de Merlyn amarelado";
        2: print "sino azulado";
        3: print "Orgulho de Dorset de cabeça pesada";
        4: print "coração-do-campo avermelhado";
        5: print "branca comum silvestre"; 
        6: print "cerca viva de bordas verdes";
        7: print "Estepe Russa simples";
        8: print "bretã de caule alto"; 
        9: print "campestre laranja";
        10: print "Meldrew de folhas curtas"; 
        11: print "bonsai minúsculo";
    }
];

Object  daisy_chain "corrente de margaridas"        
  with  name 'daisy' 'chain' 'daisychain' 'margarida' 'corrente',
        before [;
            Examine:
                print_ret "Uma corrente delicada e bonita de ", DaisyType(self.number), " margaridas.";
            Drop:
                remove self;
                give self ~worn;
                "A corrente de margaridas se desfaz em suas mãos! Anime-se, talvez Jemima lhe dê outra.";
        ],
!        u_to DaisyUp,
        number 11,
         devil_hint "Perigosa de usar. Mas pelo menos qualquer tipo de margarida serve.",
  has   clothing;

HRoom   Storage_Room "Despensa"      
  with  before [;
            Enter:
                if( noun == dark_shaft_obj ) {
                    if( dumbwaiter in dark_shaft_obj )
                        << Enter dumbwaiter >>;
                    "Mas você sofre de vertigem. Até pensar na viagem de avião amanhã dá nervos.";
                }
        ],
        w_to Old_Winery,
        description "Uma despensa abandonada junto à adega. Numa parede há uma abertura para um eixo escuro e ameaçador, ao lado
        de uma grande roda no estilo de motor a vapor vitoriano com uma manivela.",
        cant_go "A única porta fica de volta a oeste, para a adega.",
  has   ;

[ WheelBefore r ;
    if( action == ##TurnWith ) {
        if( second == steel_wrench ) 
            "A chave não serve numa roda manual como esta.";
        rfalse;
    }
    if( action == ##Turn ) {
        if( player in dumbwaiter ) "Você consegue alcançar a roda daqui, mas não tem alavanca suficiente para girá-la.";
        if( self has on ) "Ela não gira. Talvez esteja quebrada ou apenas enferrujada.";
        print "Ela gira suavemente, e o monta-cargas é içado ";
        if( dumbwaiter in location ) {
            print "para fora de vista.";
        } else {
            print "à vista. ";
            if( medicine_bottle in dark_shaft_obj2 && medicine_bottle has locked ) {
                give medicine_bottle ~locked;
                give medicine_bottle open;
                print "(Pouco antes de chegar ao fundo houve um estalo curioso. Foi mesmo prudente deixar algo no eixo?)";
            }
        }
        r = parent(dumbwaiter);
        if( r == Storage_Room ) {
            move dumbwaiter to Cellars;
        }
        if( r == Dark_Shaft ) {
            move dumbwaiter to location;
        }
        if( r == Cellars ) {
            move dumbwaiter to Storage_Room;
        }
        new_line;
        rtrue;
    }
    rfalse;
];

Object  -> wheel2 "roda"        
  with  name 'wheel' 'handle' 'catch' 'safety' 'roda' 'manivela' 'trava' 'seguranca' 'segurança',
        before WheelBefore,
         description "Há uma trava de segurança escondida (mal escondida) na roda.",
  has   on scenery switchable;

Object  -> dumbwaiter "monta-cargas"       
  with  name 'dumb' 'waiter' 'dumbwaiter' 'monta-cargas' 'montacargas',
         initial "Dentro do eixo escuro está o velho monta-cargas.",
         article "o velho",
  has   container enterable open static;

Object  -> -> pulley_ropes "cordas da roldana"        
  with  name 'pulley' 'rope' 'ropes' 'roldana' 'corda' 'cordas',
        before [ r;
            Climb: "Se ao menos você não sofresse de uma vertigem tão terrível...";
            Pull:
                if( player notin dumbwaiter ) "Você não consegue alcançá-las!";
                Achieved(SCORE_WAITER);
                if( location == Storage_Room ) {
                    r = Cellars;
                    print "Você começa a se mover e então despenca, mas o atrito gradualmente o desacelera e você aterrissa sem
                        muito baque...^";
                }
                if( location == Dark_Shaft ) {
                    r = Storage_Room;
                    print "Você se puxa de volta até o sótão...^";
                }
                if( location == Cellars ) {
                    r = Dark_Shaft;
                    print "Você se puxa até a metade do caminho e então precisa parar para descansar.^";
                }
                move dumbwaiter to r;
                location = r;
                << Look >>;
        ],
        initial "O monta-cargas pende de fortes cordas de roldana que sobem e descem daqui.",
        article "o",
  has   static;

Object  -> -> chicken_wishbone "osso da sorte de galinha"        
  with  name 'wish' 'bone' 'wishbone' 'chicken' 'sorte' 'osso' 'galinha',
        before [;
            Pull: "Isso já aconteceu. A parte que você tem se perdeu.";
        ],
        description "Na verdade, a metade que não realizou o desejo.",
        devil_hint "Ela nem é mencionada em nenhum dos livros que li.",
  has   ;

Object  -> dark_shaft_obj "eixo escuro"   
  with  name 'shaft' 'dark' 'eixo' 'escuro',
        after [;
            Receive:
                move noun to dumbwaiter;
                if( dumbwaiter in location ) "Coloque no monta-cargas.";

                if( noun == medicine_bottle ) {
                    give medicine_bottle ~locked open;
                    "Ele desaparece na escuridão, e há um leve estalo.";
                }
                "Ele desaparece na escuridão.";
        ],
        description "Nada convidativo.",
  has   container open scenery;

Object  -> steel_wrench "chave de boca de aco"   
  with  name 'steel' 'wrench' 'aco' 'aço' 'chave',
        after [;
            Take: "É uma chave, mas você a pega.";
        ],
        initial "Uma chave de aço acumula poeira no canto.",
  has   ;

HRoom   Dark_Shaft "Eixo escuro"  
  with  before [;
            Go:
                if( noun == d_obj && dumbwaiter in Dark_Shaft )
                    "Como o monta-cargas está aqui, por que não viajar nele?";
                rfalse;
        ],
        after [;
            Look:
                if( dumbwaiter notin Dark_Shaft )
                    print "^Como o monta-cargas não está aqui, o melhor que você pode fazer é descer pelo eixo até as adegas.^";
                rfalse;
        ],
        n_to Dark_Passage,
        d_to Cellars,
        description "A meio caminho para cima, ou para baixo, e também um lugar sombrio: apenas um corredor escuro que leva ao norte.",
  has   ;

HRoom   Dark_Passage "Passagem escura"      
  with  name 'coal' 'dust' 'carvao' 'carvão' 'poeira',
        before [;
            if( sandstone_recess has open ) 
                Achieved(SCORE_SECRET_PASS);
            Enter:
                if( noun == sandstone_recess ) "O nicho é raso demais.";
                rfalse;
            Go: rfalse;
            default:
                if( gas_mask has worn ) rfalse;
                "A poeira de carvão faz você tossir e ofegar, e seus olhos lacrimejam. Você não consegue se concentrar para fazer
                 qualquer coisa aqui.";
        ],
        n_to metal_door,
        s_to Dark_Shaft,
        e_to sandstone_recess,
        d_to sandstone_recess,
        description "Uma passagem que desce muito levemente ao sul, cheia de poeira de carvão à qual você infelizmente é alérgico.
            Não é lugar para permanecer.",
        number 2,
  has   ;

Object  -> sandstone_recess "nicho de arenito"   
  with  name 'sandstone' 'recess' 'shallow' 'arenito' 'nicho' 'raso',
        door_to Sandstone_Passage,
        when_closed "Há um nicho raso de arenito na parede leste.",
        door_dir e_to,
        when_open "Uma passagem secreta desce a leste através de um nicho de arenito.",
  has   door static;

Object  -> metal_door "porta de metal"       
  with  name 'metal' 'door' 'metal' 'porta',
        after [;
            Unlock: give coal_bunker ~locked; rfalse;
            Lock: give coal_bunker locked; rfalse;
            Open: give coal_bunker open; rfalse;
            Close: give coal_bunker ~open; rfalse;
        ],
        door_to Garden_Stream,
        when_closed "No extremo norte há uma porta de metal fechada.",
        with_key small_brass_key,
        door_dir n_to,
        when_open "No extremo norte há uma porta de metal aberta.",
  has   door lockable locked openable static;

HRoom   Cellars "Poroes"        
  with  before [;
            Enter:
                if( noun == dark_shaft_obj2 ) {
                    if( dumbwaiter in self )
                        << Enter dumbwaiter >>;
                    "Não, não faça isso. Não há nada ali, e é imundo e sujo. Traga o monta-cargas para baixo.";
                }
                rfalse;
        ],
        s_to Cellars_South,
        e_to Wine_Cellars,
        w_to Cellar_West,
        description "Adegas velhas cobertas de teias. Não há nada para ver além de uma abertura numa parede para um eixo escuro e
            uma grande roda no estilo de motor a vapor vitoriano ao lado, com uma manivela. A adega continua de leste a oeste e ao sul.",
  has   ;

Object  -> wheel "roda" 
  with  name 'wheel' 'handle' 'catch' 'safety' 'roda' 'manivela' 'trava' 'seguranca' 'segurança',
        before WheelBefore,
         description "Há uma trava de segurança escondida (mal escondida) na roda.",
  has   on scenery switchable;

Object  -> dark_shaft_obj2 "eixo escuro"  
  with  name 'shaft' 'dark' 'eixo' 'escuro',
         description "Nada convidativo.",
  has   container enterable open scenery;

Object  -> little_window1 "janelinha" 
  with  name 'little' 'window' 'vent' 'windowven' 'window-v' 'pequena' 'janela' 'ventilacao' 'ventilação',
         initial "Há uma pequena janela-ventilação fechada, baixa na parede norte.",
         description "Você mal consegue distinguir um brilho dourado.",
  has   static;

Object  -> robot_mouse "rato robô"     
  with  name 'robot' 'mouse' 'robo' 'robô' 'rato',
        orders [ frm dst prev_loc;
            if (gas_mask has worn && MouseUnderstandsMask == false) {
                MouseUnderstandsMask = true;
                print "(incrivelmente, o rato consegue distinguir sua voz mesmo quando você está usando a máscara de gás; isso sim é engenharia)^";
            }
            Beep, Sing:
                "O rato apita com orgulho feliz. Isso é uma coisa que ele realmente sabe fazer.";
            Go:
                if( noun == ne_obj or nw_obj or se_obj or sw_obj or d_obj or u_obj )
                    "O rato apita irritado.";
                frm = parent(self);
                if (frm == Cellars_South) {
                    if (noun == n_obj) {
                        dst = Cellars;
                    }
                    if (noun == w_obj) {
                        dst = hole_in_the_wall;
                        Mouse_x = 8;
                        Mouse_y = 3;
                    }
                } else if (frm == Cellar_West) {
                    if (noun == e_obj) {
                        dst = Cellars;
                    }
                } else if (frm == Wine_Cellars) {
                    if (noun == w_obj) {
                        dst = Cellars;
                    }
                } else if (frm == Cellars) {
                    if (noun == w_obj) {
                        dst = Cellar_West;
                    }
                    if (noun == s_obj) {
                        dst = Cellars_South;
                    }
                    if (noun == e_obj) {
                        dst = Wine_Cellars;
                    }
                } else
                    "As rodas do rato giram, mas não conseguem aderência suficiente para movê-lo.";
                if( dst == nothing )
                    "O rato emite um bipe grave.";

                prev_loc = frm;
                move robot_mouse to dst;
                give robot_mouse moved;

                if (location == prev_loc) {
                    if (dst == hole_in_the_wall) {
                        trigger_quotation(1);
                        "O rato se espreme pelo buraco e desaparece de vista. Infelizmente, agora não é fácil falar com ele...";
                    } else 
                        "O rato sai correndo conforme ordenado.";
                }
                "POSSÍVEL BUG?";
            default: "O rato emite um bipe queixoso e infeliz.";
        ],

        initial "Num canto há um rato robótico coberto de poeira.",
        description "Lembra do fim dos anos 1970, quando uma febre de robôs caseiros tomou conta do mundo da computação doméstica?
                Talvez não, mas aqui está um remanescente daquela época. O rato é bastante grande (quase trinta centímetros de
                largura e altura) e tem um grande sorriso pintado no chassi metálico. No entanto, possui circuitos surpreendentemente
                modernos e até zumbe muito baixinho, então alguém deve ter trabalhado nele recentemente.",
        devil_hint "Ele nem consegue seguir ordens.",
  has   talkable;

HRoom   Wine_Cellars "Adegas de vinho"      
  with  name 'wine' 'woodlice' 'hexagonal' 'racks' 'shaft' 'vinho' 'tatuzinho' 'hexagonal' 'prateleiras' 'eixo',
        before [;
            Drink:
                "Mas você é abstêmio, e é por isso que as adegas chegaram a este estado.";
        ],
        w_to Cellars,
        u_to [;
            if( self hasnt light )
                rfalse;
            "O eixo do barril é íngreme demais para subir. Você teve sorte de não quebrar o pescoço na descida.";
        ],
        description [;
            print "As adegas agora estão bastante mal abastecidas, e muitas das prateleiras hexagonais abrigam apenas tatuzinhos.
                Grande parte do que há foi armazenada por seu pai e está arrolhada";
            if( self hasnt light ) 
                ".";
            ". O eixo do barril sobe ao norte, e uma luz intensa entra pelos jardins acima.";
        ],
        cant_go "Este é o extremo leste das adegas; daqui você só pode ir a oeste.",
  has   ;

Array mouse_maze string "111111111111001001111100101111110000111100111111110011111111111";

! was MouseMove2 in my r7 recreation
[ MouseBoundary x y cell ;
    if( x < 0 || x > 8 || y < 0 || y > 6 )
        rfalse;
    cell = mouse_maze->(9 * y + x);
    if( cell == '0' )
        rfalse;
    if( cell == '1' )
        rtrue;
    rtrue;
];

HRoom   Cellars_South "Adegas ao sul"    
  with  n_to Cellars,
        description "O fechamento desta adega com tijolos parece incompleto, pois há um buraco de cerca de vinte e cinco centímetros
            na parede oeste. Você o observa com interesse, mas nada ao alcance está dentro, e ele é pequeno demais para você passar.
            As adegas continuam ao norte e, ao que parece, você também.",
  has   ;

Object  -> hole_in_the_wall "buraco na parede"   
  with  name 'hole' 'mousehole' 'buraco' 'rato',
        before [;
            Receive:
                "Nada se ganha com isso.";
            LetGo:
                "Não há nada ao alcance lá dentro.";
        ],
        orders [ x1 y1;
            if( robot_mouse notin self )
                rfalse;
            Go:
                if( Mouse_x == 8 && Mouse_y == 3 && noun == e_obj ) {
                    move robot_mouse to Cellars_South;
                    print "O rato sai correndo do buraco, parecendo mais empoeirado, mas sem piora após a aventura";
                    if( parent(small_brass_key) ~= robot_mouse )
                        ".";
                    move small_brass_key to Cellars_South;
                    trigger_quotation(3);
                     ", e então quase parece orgulhoso quando um ímã se desliga e algo metálico cai da parte inferior do rato no chão. A chave perdida foi encontrada!";
                } else if( noun == n_obj ) {
                    x1 = Mouse_x;
                    y1 = Mouse_y - 1;
                } else if( noun == e_obj ) {
                    x1 = Mouse_x + 1;
                    y1 = Mouse_y;
                } else if( noun == s_obj ) {
                    x1 = Mouse_x;
                    y1 = Mouse_y + 1;
                } else if( noun == w_obj ) {
                    x1 = Mouse_x - 1;
                    y1 = Mouse_y;
                }
                if( MouseBoundary(x1,y1) == true )
                    "De algum lugar dentro do buraco, você ouve um bipe desolado.";

                Mouse_x = x1;
                Mouse_y = y1;

                if( Mouse_x == 4 && Mouse_y == 1 && small_brass_key in hole_in_the_wall ) {
                    move small_brass_key to robot_mouse;
                    trigger_quotation(2);
                     "De algum lugar dentro do buraco, você ouve o giro de pequenas rodas, seguido por um bipe agudo e animado e
                      um ruído surdo de metal.";
                }
                "De algum lugar dentro do buraco, você ouve pequenas rodas girando.";

            default: "O rato emite um bipe queixoso e infeliz.";
        ],
  has   scenery talkable;

Object  -> -> small_brass_key "chave pequena de latão"  
  with  name 'small' 'brass' 'attic' 'key' 'pequena' 'latao' 'latão' 'sotao' 'sótão' 'chave',
        sw_to compass,
         initial "Onde o rato a deixou há uma pequena chave cor de latão.",
         description "Latão é, naturalmente, uma liga não magnética de cobre e zinco, então presumivelmente esta chave também contém ferro.",
         devil_hint "Receio que não seja a chave do sótão.",
  has   ;

 HRoom   Cellar_West "Adega oeste"        
  with  s_to Hellish_Place,
        e_to Cellars,
        nw_to ironbound_door,
