
Object  Beside_the_Drive "Ao lado da alameda"      
  with  name 'wistaria' 'car' 'gravel',
        before [;
            Go:
                if( noun == w_obj or u_obj && self.u_to == Dead_End )
                    print "Com o coração na boca, você sobe novamente pela velha escada de incêndio, soltando um 
                        suspiro de alívio ao entrar pela escotilha aberta no topo.^";
                rfalse;
        ],
        n_to "A velha muralha sul entalhada dos jardins bloqueia seu caminho ao redor do Salão.",
        w_to "O Salão está no caminho.",
        ne_to Public_Footpath,
        u_to "A escada de incêndio é perigosa e não leva a lugar algum. Sem dúvida seria inútil em um incêndio de verdade.",
        description "Aos pés do Salão fica a alameda, uma longa faixa de cascalho que chega à casa por entre as árvores.^^Como sua família carrega malas no carro de vez em quando, o que só faz você se sentir culpado, o único modo seguro de escapar é pela trilha pública, a nordeste.",
        cant_go "Melhor não: podem pegar você.",
        section T_NE_OF_HOME,
  has   light;

Object  -> fire_escape2 "escada de incêndio"     
  with  name 'fire' 'escape' 'white' 'rope' 'rickety',
        before [; Climb, Enter: << Go u_obj >>; ],
        initial [;
            if( Beside_the_Drive.u_to ~= Dead_End )
                "Wistaria sobe por uma escada de incêndio desesperadamente precária na lateral do Salão.";
            "Wistaria sobe por uma escada de incêndio desesperadamente precária no lado leste do Salão, e você também pode fazê-lo: 
                no topo, a porta da escada para o sótão está aberta.";
        ],
        description "Nos primeiros andares, uma velha estrutura de ferro em zigue-zague; depois, uma escada que talvez esteja bem ancorada, talvez não. Os jardineiros fizeram um bom trabalho escondendo-a atrás da glicínia, que (de qualquer modo) parece a mais resistente das duas.",
  has   static;

Object  Public_Footpath "Trilha pública"        
  with  name 'stile' 'dragonflies' 'house' 'hall' 'battlements',
        n_to Stone_Cross,
        sw_to Beside_the_Drive,
        d_to Hollow,
        description "Junto a uma escada de cerca na trilha pública que atravessa os campos até a aldeia, ao norte. Sentado na escada, você tem uma vista esplêndida da casa e de suas ameias. O ar está repleto de pólen e libélulas.^^Talvez seja possível descer desajeitadamente até uma depressão, mas certamente não seria agradável.",
        cant_go "A trilha vai do sudoeste para o norte.",
        section T_NE_OF_HOME,
  has   light;

Object  Hollow "Depressão"  
  with  nw_to Mosaic,
        u_to Public_Footpath,
        description "Uma depressão baixa, lamacenta e fétida, pisoteada por juncos, seca durante o longo verão e agora apenas úmida. Você poderia subir de volta ou seguir para noroeste, mas isso exigiria rastejar por uma sebe espinhosa.",
        section T_NE_OF_HOME,
  has   light;

Object  -> nest "nest"   
  with  name 'nest',
         initial "Há um ninho de pássaro no fundo da depressão.",
  has   static;

Object  -> bunch_of_nuts "punhado de nozes" 
  with  name 'bunch' 'of' 'nuts',
        before [;
            ! Yes, unconditional "before"
            trigger_quotation(41);
            if( corn_crake in Hollow ) "O codornizão não deixa você se aproximar do ninho.";
        ],
         initial "Entrelaçado no ninho há um punhado de nozes.",
         description "Um punhado de nozes, sobras do outono passado.",
         devil_hint "Nozes para você também.",
         angel_hint "Sabe, eu adoro nozes, mas agora preciso ter muito cuidado com o que como... Ainda assim, os pequenos vão comê-las.",
  has   edible scored;

Object  -> corn_crake "codornizão"       
  with  name 'corn' 'crake' 'corncrake' 'deaf' 'rail' 'bird',
         life [; Order, Ask, Answer: "O pássaro parece não ter escutado."; ],
         initial "E, sentado nele, como seria de esperar, há um pássaro: na verdade, um codornizão.",
         description "Um ralídeo de chamado característico. E um olhar possessivo.",
  has   animate;

Object  Stone_Cross "Cruz de pedra"        
  with  name 'pub' 'goat' 'compasses',
        n_to parish_church,
        s_to Public_Footpath,
         description "Ao lado do longo triângulo do gramado, sob a cruz de pedra do memorial da Primeira Guerra Mundial. A trilha pública segue para o sul até uma escada de cerca. A aldeia é minúscula: a igreja paroquial, o pub ~Bode e Compassos~ (fechado devido às pitorescas leis inglesas de licenciamento) e algumas casas e casas de chá ocasionais para turistas que visitam o Salão Meldrew.",
         cant_go "Você passeia pelo gramado tranquilo por um tempo, mas não há nada para fazer.",
        section T_NE_OF_HOME,
  has   light;

[ OldEvansLife ;
    if( action == ##Order or ##Ask ) {
        if( self hasnt general ) {
            "~Só um instante, estou estudando meu formulário.~";
        }
        print "Ele olha para você em transe hipnótico,";
        if( action == ##Give && noun == Crescent_Moon && second == player ) {
            move Crescent_Moon to player;
            Achieved(SCORE_HYPNOSIS);
            self.description = "O chapéu do velho Evans está vazio. Você se sente terrivelmente culpado.";
            " e, antes que você consiga dizer ~Como sou desalmado~, ele obedientemente lhe entrega a Lua.";
        }
        " incapaz de seguir sua instrução perfeitamente clara.";
    }
    if( action == ##Answer ) {
        "Evans está perdido. O que você quer dizer?";
    }
    if( action == ##Give ) {
        if( noun == Crescent_Moon ) {
            "Evans olha tristemente para o talismã. Mas agora ele está manchado, você o estragou. Sua culpa aumenta ainda mais.";
        }
        rfalse;
    }
    rfalse;
];

Object  -> Old_Evans "Velho Evans" 
  with  name 'racing' 'enthusiast' 'old' 'evans',
        life OldEvansLife,
        orders [;
            print "Ele olha para você em transe hipnótico,";
            Give:
                if( noun == Crescent_Moon && second == player ) {
                    move Crescent_Moon to player;
                    Achieved(SCORE_HYPNOSIS);
                    self.description = "O chapéu do velho Evans está vazio. Você se sente terrivelmente culpado.";
                    " e, antes que você consiga dizer ~Como sou desalmado~, ele obedientemente lhe entrega a Lua.";
                }
            " incapaz de seguir sua instrução perfeitamente clara.";
        ],
        initial "O velho Evans, entusiasta das corridas da aldeia, senta-se nos degraus do memorial, lendo as páginas de resultados do jornal ~Tempos das Corridas~.",
        description "Na faixa do chapéu está seu talismã da sorte: uma pequena imagem da lua crescente.",
  has   animate proper transparent;

TarotCard -> -> Crescent_Moon "Lua crescente"      
  with  name 'crescent' 'moon' 'mascot' 'lucky',
        before  [;
            Take, Remove:
                if( self in Old_Evans )
                    "Evans não vai entregar seu talismã tão facilmente.";
                rfalse;
        ],
        door_to Parish_Church_Room,
        description "Uma espécie de lua crescente, um antigo símbolo druídico.",
        devil_hint "Isso não leva a lugar algum.";

Object  -> -> Racing_Times "Tempos das Corridas"        
  with  name 'paper' 'newspaper' 'racing' 'times',
        before [;
            Take, Remove: "Evans não vai entregar seu jornal.";
        ],
        description "A notícia da primeira página (~Shergar, nova aquisição de Lorde Lucan, sai da aposentadoria para vencer o Grande Nacional~) é tão sem emoção que você perde o interesse rapidamente. Mas Evans se fascina eternamente pelos mínimos detalhes do formulário dos cavalos, pelas corridas de amanhã, pelas cotações atuais dos bookmakers e assim por diante.",
  has   ;

Object  -> -> hat_band "faixa do chapéu"        
  with  name 'hat' 'band',
        before [;
            Take, Remove: "Evans não vai entregar a faixa do chapéu.";
        ],
        description "Os aficionados por corridas consideram dar sorte usar talismãs nas faixas dos chapéus.",
  has   ;

Object  -> war_memorial "memorial de guerra"   
  with  name 'war' 'memorial' 'cross' 'green' 'stone' 'fallen',
        description "A cruz de pedra, dedicada aos mortos da Grande Guerra de 1914-18, contém mais nomes do que há casas na aldeia.^^Seu olhar é atraído pelo segundo-tenente Gerard Meldrew, do 19/21 Regimento de Fuzileiros, e você estremece, embora a tarde esteja quente.",
  has   scenery;

Object  -> parish_church "igreja paroquial" 
  with  name 'parish' 'church' 'door',
        before [; 
            Enter:
                if( self hasnt open )
                    "A porta da igreja está travada do outro lado.";
                rfalse;
        ],
        door_to Parish_Church_Room,
        door_dir n_to,
        when_closed "A Igreja de São Miguel e Todos os Anjos, do século XIV, não parece exatamente trancada: apenas está travada do outro lado.",
  has   door scenery;

Object  -> Goat_and_Compasses "Goat and Compasses"       
  with  name 'pub' 'goat' 'compasses' 'public' 'house' 'bar',
         before [; Enter: "O pub está fechado, dadas as leis de licenciamento."; ],
        door_dir w_to,
        description "Nos dias de Oliver Cromwell, chamava-se ~Deus Abrange~, mas os moradores desgastaram o nome ao longo dos séculos até ~Bode e Compassos~. É claro que está fechado devido às leis de licenciamento. Você se parabeniza por viver em um país tão moderno e progressista.",
  has   door locked proper scenery;

Object  pet_monkey "macaco de estimação"  
  with  name 'pet' 'monkey',
        before [;
            Touch: "Você acaricia o pelo do macaco. Ele pula, piando.";
            Kiss: "Evans se ressente um tanto desse avanço importuno.";
        ],
         initial "O macaco senta-se no ombro de Evans, piando de excitação. Evans encontrou um animal de estimação e está tão rudemente encantado que esqueceu completamente o talismã que você roubou. Agora, se ele ao menos pudesse prever a corrida das 15h40 em Borchester Mills...",
  has   animate;

Object  Parish_Church_Room "Igreja paroquial"    
  with  name 'flowers' 'pews' 'woven' 'mattings' 'lectern' 'altar',
        s_to [;
            if (parish_church hasnt open) {
                give parish_church open;
                parish_church.description = "A porta da igreja está aberta.";
                print "Você destrava a porta e sai.^";
            }
            return Stone_Cross;
        ],
        e_to East_Side_Chapel,
        w_to West_Side_Chapel,
        u_to Bell_Tower,
        d_to [;
            if( Moonstone has open ) 
                "Para seu horror, seu corpo se transforma parcialmente em névoa ao descer pela soleira! Alarmado, você recua. O submundo sob a Pedra lunar, ao que parece, não é para mortais.";
            "A Pedra lunar é enorme e sólida.";
        ],
        description "Antes de ser a igreja normanda de São Miguel e Todos os Anjos, esta era uma igreja saxônica: é um local antigo. Um grande espaço de pedra, cheio de bancos escuros de madeira e esteiras trançadas. Flores que sobraram do domingo enfeitam o púlpito e o altar. Uma escada estreita sobe, e o gramado da aldeia fica ao sul.^^Antigas capelas laterais ficam a leste e a oeste.",
        section T_NE_OF_HOME,
  has   light;

Object  -> Moonstone "Moonstone" 
  with  name 'moonstone' 'moon' 'stone' 'door' 'flagstone' 'iron' 'rings' 'old',
        before [;
            Examine: trigger_quotation(47); rfalse;
            Open, Push, Pull, Take:
                trigger_quotation(19);
                "Diz a lenda que nada prende a pedra, mas, se for assim, ela é pesada demais para se mover.";
            PointAt, Knock:
                if( adamantine_knight in location ) 
                    "O cavaleiro se aproxima um pouco, levando a mão a uma orelha para mimetizar que escuta. Ele parece ter alguma audição.";
        ],
        when_closed "Inserida no chão e ligeiramente elevada está a Pedra lunar, uma antiga laje larga do tamanho de uma porta, gravada com uma lua crescente.",
        door_dir d_to,
        when_open "Uma passagem desce por uma porta de cristal sólido na Pedra lunar.",
        description "A Pedra lunar é muito antiga, provavelmente anterior ao restante da igreja em vários séculos. Abundam lendas sobre ela: dizem que os espíritos dos mortos passam por baixo. Velhos anéis de ferro estão fixados nela, mas ninguém jamais conseguiu erguer seu peso colossal.",
        article "the",
  has   door static;

Object  West_Side_Chapel "Capela lateral oeste"      
  with  name 'stained' 'glass' 'windows' 'resurrect',
        before [;
            Repair, Insert, PutOn:
                if( second ~= adamantine_statue ) rfalse;
                if( noun ~= adamantine_hand or adamantine_skull or adamantine_heart )   
                    "Isso parece incongruente.";
                if( noun == adamantine_hand ) {
                    move adamantine_hand to West_Side_Chapel;
                    give adamantine_hand concealed;
                    LeftHand = 2;
                    "A mão se encaixa frouxamente no ~pulso~ esquerdo do cavaleiro de adamantino.";
                }
                if( noun == adamantine_skull ) {
                    move adamantine_skull to West_Side_Chapel;
                    give adamantine_skull concealed;
                    SkullFit = 2;
                    "O crânio se encaixa muito frouxamente no ~pescoço~ do cavaleiro de adamantino.";
                }
                if( noun == adamantine_heart ) {
                    remove adamantine_heart;
                    give adamantine_heart general;
                    "O coração se acomoda bem na caixa torácica tão vazia do cavaleiro de adamantino.";
                }
                rfalse;
            Turn:
                if( noun == adamantine_skull or adamantine_hand && noun has concealed ) {
                    if( noun == adamantine_hand ) {
                        remove adamantine_hand;
                        LeftHand = 0;
                        give adamantine_hand general;
                        give adamantine_hand ~concealed;
                        "A mão se aparafusa firmemente ao cavaleiro de adamantino.";
                    }
                    if( noun == adamantine_skull ) {
                        remove adamantine_skull;
                        SkullFit = 0;
                        give adamantine_skull general;
                        give adamantine_skull ~concealed;
                        "O crânio se aparafusa firmemente ao cavaleiro de adamantino.";
                    }
                }
                rfalse;
        ],

        after [;
            Look:
                if( adamantine_statue in West_Side_Chapel ) DisplayKnight();
                rfalse;
        ],
        e_to Parish_Church_Room,
        description "Um nicho no antigo lado oeste da igreja, sob vitrais da Ressurreição.",
        cant_go "A igreja fica a leste.",
        each_turn [;
            if( SkullFit > 0 ) {
                --SkullFit;
                if( SkullFit == 0 ) {
                    give adamantine_skull ~concealed;
                    "^O crânio balança e cai novamente do cavaleiro.";
                }
            }
            if( LeftHand > 0 ) {
                --LeftHand;
                if( LeftHand == 0 ) {
                    give adamantine_hand ~concealed;
                    "^A mão vacila e cai novamente do cavaleiro.";
                }
            }
        ],
        section T_NE_OF_HOME,
  has   light;


[ DisplayKnight ;
    if( adamantine_skull hasnt general && adamantine_skull hasnt concealed ) 
        print "^Uma estátua sem cabeça ";
    else 
        print "^Uma ";
        print "uma estátua de adamantino jaz aqui, um cavaleiro sobre um túmulo";
    if( adamantine_hand hasnt general && adamantine_heart hasnt general ) 
        ".";
    if( adamantine_hand has general || adamantine_hand has concealed ) 
        print " com a mão estendida";
    if( adamantine_heart has general ) 
        ", um coração na caixa torácica. E, ainda assim, não há nele nenhuma centelha de vida.";
    ", sem coração e implacável.";
];

Object  -> adamantine_statue "estátua de adamantino" 
  with  name 'adamantine' 'statue' 'adamant' 'knight',
        description "A estátua é metade esqueleto, e você consegue enxergar através dos ossos.",
        article "an",
  has   concealed static;

Object  adamantine_knight "cavaleiro de adamantino"    
  with  name 'adamantine' 'statue' 'adamant' 'knight',
        life [;
            Ask, Answer: "É uma pena que não existam orelhas de adamantino, realmente.";
            Show, Give:
                if (noun == marble_rose) {
                    move marble_rose to adamantine_knight;
                    "O cavaleiro fica extremamente satisfeito e pega a flor.";
                }
                if (noun == silver_keepsake) {

                    if (marble_rose notin adamantine_knight) 
                        "O cavaleiro olha tristemente para a imagem.";

                    if (location ~= East_Side_Chapel) 
                        "O cavaleiro olha tristemente para a imagem, incapaz de perceber sua relevância imediata.";

                    move marble_rose to statue_of_Diana;
                    give adamantine_knight general;
                    statue_of_Diana.initial = "A alta estátua de mármore de Diana banha-se ao luar, e uma flor foi colocada alegremente em seus cabelos.";
                    Achieved(SCORE_KNIGHT_ENCOURAGE);
                    remove silver_keepsake;
                    "O cavaleiro pega a lembrança e a examina. Entendendo a intenção, coloca a flor de mármore nos cabelos de Diana, bem acima do seu alcance. Depois, faz uma reverência solene para você. Mas há um pouco de tristeza em seu olhar ao se afastar dela.";
                }
                "O cavaleiro renunciou às coisas terrenas a serviço de Diana.";
            Attack: "Ele é adamantino.";
        ],
        orders [ o;
            Jump, Dance, Sing:
                "O cavaleiro dança uma jiga com pura exuberância.";
            Open, Pull, Take:
                if( noun == Moonstone && Moonstone hasnt open ) {
                    if( adamantine_knight hasnt general ) 
                        "O cavaleiro entende o que deve ser feito. Mas está cansado do mundo e triste, e ainda não está a seu serviço.";
                    give Moonstone open;
                    "O cavaleiro se curva e abre a Pedra lunar, enormemente pesada. Ele claramente esperava que fosse fácil, mas, quando termina, quase se pode ver suor fantasmagórico brotando nos tendões fantasmagóricos de seu corpo de adamantino.";
                }
                "O cavaleiro está confuso. Talvez você tenha sido um pouco brusco com o crânio.";
            Go:
                "O cavaleiro entende mais ou menos que deve ir a algum lugar, mas não consegue compreender a direção. Você terá de indicá-la de algum modo. (É uma pena que não existam orelhas de adamantino, realmente.)";
            PointVague:
                if( location == Parish_Church_Room && noun == d_obj ) {
                    if( Moonstone hasnt open ) {
                        "O cavaleiro não consegue atravessar diretamente a Pedra lunar.";
                    }
                    remove adamantine_knight;
                    move rod_of_life to Parish_Church_Room;
                    move rod_of_death to Parish_Church_Room;
                    move rod_of_love to Parish_Church_Room;
                    move Moonstone to Parish_Church_Room;
                    "O cavaleiro desce para o submundo sob a Pedra lunar, perdido de sua vista... para sempre?^^Pois nem ele tem força vital suficiente para permanecer unido na névoa: seu esqueleto começa a se desfazer em nada, caindo em todas as direções, enquanto seu coração, sua mão e seu crânio retornam de algum modo a seus pés. E eles estão mudando, mudando enquanto você olha para o vazio...";
                }
                o = nothing;
                if( location == Parish_Church_Room ) {
                    if( noun == s_obj ) {
                        o = Stone_Cross;
                    }
                    if( noun == e_obj ) {
                        o = East_Side_Chapel;
                    }
                    if( noun == w_obj ) {
                        o = West_Side_Chapel;
                    }
                    if( noun == u_obj ) 
                        "De modo um tanto cômico, o cavaleiro é corpulento demais para passar pela escada. Depois de observar por um ou dois instantes um objeto imóvel lutando contra uma força irresistível, você aponta para trás e o cavaleiro retorna, repreendido.";
                }
                if( location == East_Side_Chapel && noun == w_obj ) {
                    o = Parish_Church_Room;
                }
                if( location == West_Side_Chapel && noun == e_obj ) {
                    o = Parish_Church_Room;
                }
                if( o == nothing ) {
                    "O cavaleiro balança a cabeça solenemente.";
                }
                if( o == Stone_Cross ) {
                    "O cavaleiro não deixará solo sagrado.";
                }
                move adamantine_knight to o;
                if( o == East_Side_Chapel ) {
                    adamantine_knight.initial = "O cavaleiro está aqui, curvando-se para Diana.";
                    move statue_of_Diana to o;
                } else if( marble_rose in adamantine_knight ) {
                    adamantine_knight.initial = "O cavaleiro está aqui, segurando a flor.";
                } else {
                    adamantine_knight.initial = "O cavaleiro está aqui, firme.";
                }
                print "O cavaleiro caminha ousadamente para o ";
                if( noun == n_obj ) {
                    "norte.";
                }
                if( noun == s_obj ) {
                    "sul.";
                }
                if( noun == e_obj ) {
                    "leste.";
                }
                "oeste.";
            Give, Insert:
                if( second == statue_of_Diana && noun == marble_rose ) 
                    "O cavaleiro gosta da ideia, mas está confuso.";
                "O cavaleiro está confuso. Talvez você tenha sido um pouco brusco com o crânio.";
            default: 
                "O cavaleiro está confuso. Talvez você tenha sido um pouco brusco com o crânio.";
        ],
        initial "O cavaleiro de adamantino está aqui, firme.",
        description [  ;
            print "O cavaleiro transborda vida e entusiasmo, como se nada pudesse apagar sua energia ilimitada para existir. ";
            if( marble_rose in self ) 
                print "Ele segura a flor de mármore. ";
            if( statue_of_Diana in location && marble_rose notin statue_of_Diana ) 
                "Ele contempla Diana com tristeza, desejando apenas servi-la cavalheirescamente.";
            new_line;
            rtrue;
        ],
        article "the",
  has   animate;

Object  East_Side_Chapel "East Side Chapel"      
  with  name 'stained' 'glass' 'windows' 'nativity',
        w_to Parish_Church_Room,
        description "Um pequeno espaço aberto ao lado da igreja, em uma abside cercada por vitrais da Natividade.",
        cant_go "A igreja fica a oeste.",
        section T_NE_OF_HOME,
  has   light;

Object  -> statue_of_Diana "statue of Diana"     
  with  name 'marble' 'statue' 'of' 'diana',
        before [;
            PointAt:
                if( adamantine_knight in location ) {
                    if( marble_rose in self )
                        "O cavaleiro fez tudo o que podia por Diana e agora está a seu serviço.";
                    "O cavaleiro não consegue pensar em como servir Diana.";
                }
                rfalse;
        ],
        initial "Uma alta estátua de mármore de Diana está aqui: uma descoberta das ruínas romanas próximas.",
        description "Há um olhar astuto em seus olhos enquanto ela sorri de lado.",
  has   static;

Object  Bell_Tower "Torre do sino"  
  with  name 'clerestory' 'plaque',
         u_to "As cordas são lisas e barulhentas demais para subir.",
        d_to Parish_Church_Room,
         description "A câmara dos sinos, no meio da torre da igreja. Cordas grossas e trançadas pendem, terminando em faixas. Uma placa em uma parede anuncia que, em 1901, dez homens (entre eles Roger Meldrew) tocaram um Triplo Bob de Kent.",
        section T_NE_OF_HOME,
  has   light;

Object  -> bell_ropes "bell ropes"       
  with  name 'bell' 'bells' 'rope' 'ropes' 'braided' 'sash' 'sashes',
        before [;
             Pull, Push, Blow: "Você toca uma sequência amadora e desafinada.";
        ],
        article "eight",
  has   scenery;

Object  Out_on_the_Spire "No pináculo"      
  with  name 'village' 'clerestory' 'hills' 'farmlands' 'weather' 'vane' 'weathervane',
        d_to [;
             print "Você escorrega ruidosamente por uma corda de sino...^";
            return Bell_Tower;
        ],
         description "Há uma bela vista dos campos cultivados e das colinas que cercam a aldeia, e você sente certo orgulho ao ver o Salão Meldrew entre eles. Também venta e é perigoso aqui, no pináculo cinzento de chumbo da igreja paroquial, ao lado do velho relógio: felizmente, uma abertura leva à câmara superior.",
        section T_NE_OF_HOME,
  has   light;

Object  -> adamantine_hand "adamantine hand"     
  with  name 'adamantine' 'hand' 'adamant',
         initial "Montada frouxamente na ponta do cata-vento, uma mão de adamantino aponta para onde sopra o vento.",
