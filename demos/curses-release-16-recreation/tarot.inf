Class   TRoom
  with  section T_TAROT;

[ BombTicks w i ;
    print "O relógio está contando para trás e está ";
    if( complicated_looking_bomb.number == 0 ) {
        print "bem na zona vermelha!  ";
    } else {
        EnglishNumber(complicated_looking_bomb.number);
        print " minuto";
        if( complicated_looking_bomb.number ~= 1 ) {
            print "s";
        }
        print " aquém da zona vermelha. ";
        if( complicated_looking_bomb.number == 5 ) {
            trigger_quotation(10);
        }
    }
    w = complicated_looking_bomb.time_left;
    if( w == 0 ) "Os quatro fios estão conectados ao temporizador.";
    if( w == 1 ) print "Apenas o ";
    if( w == 2 ) print "O ";
    if( w == 3 ) print "O ";
    if( w == 4 ) "Nenhum dos fios está conectado.";

    i = w;
    if( red_wire has general ) {
        PrintShortName(red_wire);
        --i;
        AndList(i);
    }
    if( green_wire has general ) {
        PrintShortName(green_wire);
        --i;
        AndList(i);
    }
    if( blue_wire has general ) {
        PrintShortName(blue_wire);
        --i;
        AndList(i);
    }
    if( black_wire has general ) {
        PrintShortName(black_wire);
        --i;
        AndList(i);
    }
    if( w == 1 ) 
        " está desconectado.";
    " estão desconectados.";
];

[ AndList i ;   
    if( i == 1 ) {
        print " e ";
        rfalse;
    }
    if( i == 0 ) {
        rfalse;
    }
        print ", ";
    rtrue;
];

TRoom   Ruined_Castle_Cafe "Café do Castelo em Ruínas"  
  with  name 'decor' 'arrows' 'quartet' 'waiter',
        after [;
            Look:
                if( Cups_and_Glasses has visited && complicated_looking_bomb has concealed ) 
                    "^Num canto, você vê uma pequena janela quadrada, atrás da qual deve ficar o depósito de copos.
                     Ao se lembrar disso, você se distrai e não consegue apreciar o entretenimento. Até a mesa incomoda.
                     Uma perna deve ser mais curta que as outras, ou algo assim, pois ela chacoalha de vez em quando.";
            Strike:
                "Você chama bastante atenção ao bater o bastão na mesa do café, mas todos presumem que você faz parte
                 do cabaré. De todo modo, o bastão se carrega como sempre.";
        ],
        initial [;
            if( complicated_looking_bomb has concealed ) StartTimer(complicated_looking_bomb,10);
        ],
        description "Este café boêmio e lotado lembra apenas vagamente o castelo em ruínas da carta do Tarô: a decoração
            imita muros de castelo e seteiras. Você se encontra sentado sozinho a uma mesa no centro do salão. É um lugar
            barulhento, movimentado e alegre; um quarteto de cordas toca Strauss sob a conversa de vozes alemãs. Suas
            chances de atrair um garçom são mínimas.",
        cant_go "A multidão é animada e empolgante, mas também inconveniente e corpulenta.",
        each_turn [;
            if( complicated_looking_bomb hasnt concealed ) {
                new_line;
                BombTicks();
            } else {
                print "^A mesa chacoalha novamente.^";
            }
        ],
  has   light scored;

Object  -> cafe_table "mesa do café"       
  with  name 'cafe' 'table' 'leg' 'legs',
        before [;
            LookUnder, Search:
                if( complicated_looking_bomb has concealed ) {
                    give complicated_looking_bomb ~concealed;
                    move complicated_looking_bomb to Ruined_Castle_Cafe;
                    "Não entre em pânico, mas há uma bomba-relógio presa frouxamente à parte inferior da mesa em que você está sentado!";
                }
                "Você não faz mais nenhuma descoberta alarmante.";
            Enter:
                "Mesmo num café tão animado, suas inibições inglesas naturais tornam impossível subir na mesa.";
        ],
  has   scenery supporter;

Object  complicated_looking_bomb "bomba de aparência complicada"      
  with  name 'bomb',
        after [;
            Take:
                deadflag = PRISON;
                "De repente, alguém vê você com a bomba e grita. Uma coisa leva a outra e, bem, você sabe como são os
                 sistemas jurídicos estrangeiros. Pelo menos a bomba é desarmada, e vinte e cinco anos não é tanto assim.";
        ],
        initial "Presa frouxamente à parte inferior da mesa há uma bomba de aparência complicada.",
        description "Ela contém um temporizador-detonador, um feixe de explosivos plásticos e muitos, muitos fios. Os
            mais óbvios são verde, vermelho, azul e preto. Eles sairiam facilmente de seus soquetes frouxos no
            temporizador; talvez esse negócio de desarmar bombas não seja tão difícil quanto dizem.",
        number 0,
        time_left 0,
        time_out [;
            if( location ~= Ruined_Castle_Cafe ) 
                rfalse;
            if( complicated_looking_bomb hasnt concealed ) {
                if( blue_wire ~= bomb_wires-->0 || green_wire ~= bomb_wires-->1 || black_wire ~= bomb_wires-->2 || red_wire ~= bomb_wires-->3 ) {
                    print "^Clique! Talvez desarmar bombas seja mais complicado do que você pensava.^";
                } else {
                    print "^Clique! O temporizador chega ao fim, mas a bomba foi desarmada. Você guarda o temporizador no bolso e esconde o resto das provas sob a mesa.^";
                    move timer_detonator to player;
                    give timer_detonator ~static;
                    remove complicated_looking_bomb;
                    rtrue;
                }
            }
            print "^Num cataclismo repentino, uma enorme explosão vem da sua mesa, estourando todas as janelas de seteira,
                produzindo um estrondo, iniciando um pequeno incêndio e, naturalmente, tendo outra consequência:^";
            deadflag = DIED;
        ],
  has   concealed container open;

Object  -> timer_detonator "temporizador-detonador"
  with  name 'timer' 'detonater' 'detonator',
        before [ i;
            Examine:
                print "O temporizador parece bastante simples de ajustar. ";
                i = self.number;
                if( self.time_left ~= 0 ) {
                    print "O relógio está funcionando e marca ";
                    EnglishNumber(i);
                    " minutos.";
                }
                if( i ~= 0 ) {
                    BombTicks();
                    rtrue;
                }
                "No momento, o relógio está zerado.";
            Set:
                if( self.time_left ~= 0 ) {
                    "Ele já está funcionando!";
                }
                StartTimer(self,10);
                "Você ajusta o temporizador para dez minutos, e ele começa a funcionar.";
        ],
        number 10,
        time_left 0,
        time_out [ i j k;
            i = timer_detonator;
            j = parent(i);
            self.time_left = 0;
            while( parent(i) ~= nothing )
                i = parent(i);

            if( location == i ) {
                print "^Você ouve um clique agudo!^";
                if( j == photographers_flash ) {
                    new_line;
                    k = child(j);
                    if( k == timer_detonator ) {
                        k = sibling(k);
                    }
                    if( k == nothing ) {
                        "Mas o flash não faz nada.";
                    }
                    if( k ~= nasty_battery ) {
                        "E o flash produz uma quantidade pateticamente pequena de luz.";
                    }
                    print "O flash de repente produz uma enorme luz de magnésio, quase cegante em sua intensidade. Seus olhos demoram um pouco para se ajustar. ";
                    if( location == Ruined_Castle_Cafe ) {
                        print "Consequentemente, você só consegue ouvir a plateia do cabaré aplaudindo o que considera um truque de mágica.";
                    }
                    k = photographers_flash;
                    k = parent(k);
                    if( k == mirrored_device && photographers_flash hasnt general ) {
                        give photographers_flash general;
                        print "Consequentemente, você só consegue ouvir enquanto a mancha no horizonte se ergue das ondas, transforma-se num enorme monstro marinho Kraken e avança contra a torre de pedra. (Considerando que isto deveria ser um mito grego, parece surpreendentemente um filme japonês de monstros dos anos 1960.) O Kraken golpeia você, exagera no movimento e cai para a frente, empalando-se de modo extremamente grotesco no farol. Seus olhos mal se recuperam a tempo de o resto do seu corpo ser esmagado pelo peso.^^No alto do Monte Olimpo, Zeus continua furioso. ~Leve-me até sua Leda~, você exige espirituosamente, mas isso não parece melhorar as coisas. Poseidon também parece bastante farto, mas felizmente um grupo considerável de deusas fica do seu lado e providencia sua ressurreição...^";
                        Achieved(SCORE_ANDROMEDA);
                        remove photographers_flash;
                        give Lighthouse ~visited;
                        give Lighthouse ~scored;
    
                        for( i = child(player) : i ~= nothing : i = j ) {
                            j = sibling(i);
                            if( i ~= daisy_chain ) {
                                move i to Lighthouse;
                                give i ~worn;
                            }
                        }
                        PlayerTo(Family_Tree);
                        rtrue;
                    }
                    if( Austin in location )
                        "^Austin salta assustado, depois volta a se esparramar em sua pose ~descolada~.";
                    if( irate_squirrel_friend in location )
                        "^O esquilo cobre os olhos com as patas por um momento.";
                }
            }
        ],
        devil_hint "Time flies down here, you know. Eternity simply breezes by.",
        angel_hint "Um bom equipamento fotográfico. Você não o conseguiu de uma... bem, de uma bomba, espero.",
  has   static;

Class   Wire_Class
  with  before [ i;
            Pull:
                if( self has general ) {
                    "Esse já foi puxado.";
                }
                give self general;
                print "Você puxa ", (the) noun, ". ";
                i = complicated_looking_bomb.number;
                complicated_looking_bomb.number = i + 1;
                bomb_wires-->i = self;
                if( i == 3 ) {
                    give complicated_looking_bomb general;
                    "Todos os quatro fios estão desconectados.";
                }
                rtrue;
        ],
  has   static wire;

Wire_Class -> green_wire "fio verde"
  with  name 'green' 'wire';

Wire_Class -> red_wire "fio vermelho"
  with  name 'red' 'wire';

Wire_Class -> blue_wire "fio azul"
  with  name 'blue' 'wire';

Wire_Class -> black_wire "fio preto"
  with  name 'black' 'wire';

TRoom   Cups_and_Glasses "Copos e Taças"      
  with  name 'skylight' 'old' 'women' 'conspirators',
        n_to windowed_door,
        description "Este porão está cheio de caixas e mais caixas de copos e taças, suficientes para um hotel inteiro,
            ou talvez um restaurante. Quase qualquer coisa poderia estar escondida entre elas. Entra um pouco de luz
            por uma claraboia opaca ao nível da rua. Não há saída, pois a única porta está bem fechada.",
        cant_go "Não há saída aparente daqui.",
        number 0,
        each_turn [ i;
            self.number = self.number + 1;
            i = self.number;
            if( i == 2 ) 
                "^Há um ruído de passos enquanto algumas pessoas se reúnem na calçada, do lado de fora da claraboia.";
            if( i == 3 ) 
                "^Os homens começam a falar como conspiradores, mas em parte como se entoassem cânticos. Você capta sons
                 ocasionais, mas não consegue entendê-los bem.";
            if( i == 4 ) 
                "^Alarmantemente, você capta a palavra ~incendiário~ e quase tem certeza de ouvir alguém dizer
                 ~maldito Meldrew~ (à moda antiga, de modo que ~maldito~ rime com ~morto~). Paranoia, sem dúvida.
                 Certamente não pode haver uma conspiração de adoradores de druidas atrás de você, pode?";
            if( i == 5 ) 
                "^~A profecia deve ser cumprida!~ avisa um deles, numa voz sobrenatural que de repente se faz ouvir.
                 Os outros o mandam calar.";
            if( i == 6 ) 
                "^Os homens se afastam, talvez alguns metros, talvez um quilômetro.";
        ],
  has   light;

Object  -> windowed_door "porta com janela" 
  with  name 'door' 'window' 'windowed',
        door_to Cups_and_Glasses,
        door_dir n_to,
        description "Pela janela quadrada da porta você vê um bar onde funcionários servem bebidas e, além dele, um café-restaurante muito cheio e animado. A artista do cabaré está de costas para você e bastante de frente para os clientes.",
  has   door lockable locked openable scenery;

Object  -> cups_and_glasses_obj "copos e taças"   
  with  name 'crates' 'glasses' 'cups',
        before [;
            Search, Examine, LookUnder:
                if( model_ship hasnt general ) 
                    "Nada mais.";
                give model_ship ~general;
                give model_ship moved;
                move model_ship to player;
                "Na verdade, não há nada escondido entre as caixas além de um modelo de navio à vela. Você o pega por força do hábito.";
        ],
        article "numerosos",
  has   scenery;

Object  -> mounted_bottle "garrafa montada"       
  with  name 'mounted' 'whisky' 'glass' 'bottle',
        initial "Uma garrafa de uísque sem rótulo, deitada de lado e montada numa placa de madeira, está merecidamente abandonada sobre uma das caixas.",
        description "Velha, indesejada, empoeirada, vazia.",
        before [;
            Receive:
                if( noun == model_ship )
                    "O modelo de navio é, naturalmente, grande demais para caber na garrafa.";
                if( noun ~= stick_with_an_anchor )
                    "Não vai caber.";
        ],
        after [;
            Receive:
                remove mounted_bottle;
                remove stick_with_an_anchor;
                move ship_in_a_bottle to player;
                give ship_in_a_bottle moved;
                Achieved(SCORE_SHIP);
                "O feixe de gravetos passa bem pelo gargalo da garrafa. Com um salto repentino, assim que o último
                 graveto passa pelo gargalo, seus mastros se abrem... e você colocou o navio na garrafa.";
        ],
        angel_hint "O grande desafio, naturalmente, é colocar um navio dentro.",
  has   open container transparent;

Object ship_in_a_bottle "navio numa garrafa"      
  with  name 'ship' 'in' 'bottle',
        before [;
            Examine:
                if( self notin player ) 
                    "Você não consegue olhar bem daqui.";

                if( game_section ~= T_TAROT ) 
                    "Você admira os detalhes do modelo de navio à vela e se sente estranhamente atraído por ele. Mas fora
                     do mundo da caixa de Tarô, nada mais poderia acontecer.";

                if( location == Lighthouse )
                    "A luz intensa do sol cintila na garrafa de vidro, tornando impossível ver os detalhes dentro dela.";

                move ship_in_a_bottle to Souvenirs_Room;
                PlayerTo(Aboard_Ship,1);
                "Você observa atentamente os detalhes do modelo de navio à vela. Talvez seja o vidro deformador da
                 garrafa, talvez sua imaginação romântica, mas o convés parece mais detalhado, o cordame quase parece
                 balançar, e a pequena figura junto a um mastro quase parece viva...^^Na verdade, quanto mais olha,
                 mais enjoado você fica.^^Graças aos céus pelo corrimão do convés, algo em que se segurar enquanto
                 passa esse momento de náusea.";
        ],
        description "Dentro da garrafa de uísque há um modelo de navio à vela, grande demais para ter passado pelo gargalo.",
        angel_hint "Muito bem! Por que não olha mais de perto? Você merece.",
  has   ;

Object model_ship "modelo de navio"  
  with  name 'model' 'sailing' 'ship' 'anchor' 'chain' 'mermaid' 'filigree' 'prow' 'stern',
         description "Um soberbo modelo de navio à vela, com cerca de quinze centímetros da proa à popa, impecável em cada detalhe, da âncora numa corrente de filigrana à sereia esculpida na frente.",
        before [;
            Pull:
                remove model_ship;
                move stick_with_an_anchor to player;
                itobj = stick_with_an_anchor;
                give itobj moved;
                 "Quando você puxa a corrente da âncora, os mastros se dobram para dentro e os conveses se recolhem,
                  até que você não esteja segurando mais que um feixe compacto de gravetos.";
        ],
         angel_hint "O grande desafio, naturalmente, é colocá-lo dentro de uma garrafa.",
  has   general;

Object  stick_with_an_anchor "gravetos com âncora"      
  with  name 'stick' 'with' 'anchor' 'chain' 'sticks' 'ship',
        before [;
             Wave: "Sempre otimista.";
            Pull:
                remove stick_with_an_anchor;
                move model_ship to player;
                itobj = model_ship;
                 "Quando você puxa a corrente da âncora, os gravetos saltam para fora e voltam a formar o modelo de navio à vela totalmente aparelhado que você conhecia.";
        ],
         description "Um feixe de gravetos dobrado compactamente, com cerca de quinze centímetros, com uma corrente de filigrana e uma âncora penduradas nele.",
         angel_hint "O grande desafio, naturalmente, é colocá-lo dentro de uma garrafa.",
  has   ;

TRoom   Sea_Shore "Costa Marítima"    
  with  before [;
             Drink: "Água salgada! Não, obrigado.";
            Swim:
                if( poseiden_warning == false ) {
                    poseiden_warning = true; 
                     "Hum. Aqui está seu primeiro e único aviso: o mar é o domínio de Poseidon, e ele não é exatamente
                      o que se chamaria de cavalheiro.";
                }
                deadflag = MYTH;
                 "Ao mergulhar no mar, você vê Andrômeda de repente alegre. Logo fica claro o motivo, quando um Kraken
                  desperta das profundezas e o agarra para um lanche rápido. Parece que você a substituiu como sacrifício...
                  uma vitória pírrica que nem a perspectiva de virar uma estrela consegue amenizar.";
        ],
        u_to Cliffs,
        description [;
             print "Uma costa marítima rochosa e irregular abaixo de penhascos quase escaláveis, contra os quais lambe
                 um convidativo mar azul-profundo. Parece ser manhã cedo, pouco depois do amanhecer, pelo aspecto do sol na água.^";
            if( Lighthouse has visited && Lighthouse hasnt general ) {
                give Lighthouse general;
                 "^Você mal consegue distinguir o Faros no alto dos penhascos. Mas parece ser mais cedo, mais perto do
                  amanhecer, que em sua última visita.";
            }
            rtrue;
        ],
         cant_go "As rochas são perigosas demais. Você terá de escalar o penhasco.",
  has   light;

Object  -> Andromeda "Andrômeda" 
  with  name 'andromeda' 'maiden',
        life [;
             Kiss: "Ela o evita habilmente, depois de anos de prática com homens gregos.";
             Attack: "Não é necessário, se o monstro marinho for tudo o que dizem.";
            Give:
                if( noun has edible ) {
                    if( noun == Ekmek_Special ) {
                        remove noun;
                        give amber_hairband ~static;
                        give amber_hairband moved;
                        move amber_hairband to player;
                         "Ela sorri como se dissesse que não adianta mais cuidar da cintura e devora faminta sua sobremesa
                          favorita. Como gesto de agradecimento, tira a faixa de cabelo de âmbar e entrega-a a você. Logo
                          retoma sua pose nobre, para o caso de alguém estar olhando.";
                    }
                     "Ela olha com fome evidente, mas seu senso de dever vence e ela recusa.";
                }
                 "Ela olha para você com desprezo.";
            Order, Ask, Answer:
                 "Andrômeda sibila algo depreciativo para você em grego. (Ático, não demótico, ironicamente, mas para
                  você é tudo grego mesmo.)";
        ],
        initial "Acorrentada à face do penhasco está a bela Andrômeda, olhando nobremente para o mar enquanto aguarda seu destino.",
        description [;
            print "Desvie os olhos. Ela está nua";
            if( amber_hairband has static ) 
                print " (a menos que se conte a faixa de cabelo)";
            print ", como era moda nos sacrifícios humanos: a vítima passava a noite sem comida nem abrigo até o amanhecer. É preciso dizer que ela não parece muito ansiosa para ser resgatada";
            if( photographers_flash hasnt general ) 
                ".";
                ".^^É claro que, em certo sentido, você já a resgatou, mas isso só acontecerá para ela daqui a uma ou duas horas, então dificilmente pode esperar agradecimentos. Ainda assim, dá uma agradável sensação interior.";
        ],
  has   animate proper;

Object  -> amber_hairband "faixa de cabelo de âmbar"       
  with  name 'amber' 'hairband' 'hair' 'band',
        description "Um longo prendedor de âmbar, perfeito para cabelos gregos longos e desgrenhados.",
        article "de Andrômeda",
        rod_assoc rod_of_sacrifice,
        devil_hint "Hum... ainda tem o perfume dela. Hehehehe. Aposto que ela já morreu.",
  has   concealed static hidden_rod;

TRoom   Cliffs "Penhascos"  
  with  name 'pharos' 'lighthouse' 'tower',
        e_to Clifftop_Walk,
        sw_to Cave_Mouth,
        d_to Sea_Shore,
         description "No alto de penhascos expostos sobre o Mediterrâneo. Uma descida perigosa leva de um lado à costa; todos os outros caminhos para baixo são ainda mais arriscados. No alto dos penhascos fica a torre de Faros, um farol no topo de um pináculo redondo de pedra, mas não há como entrar por aqui.^^Uma trilha gramada segue para leste, e uma fenda estreita leva a sudoeste até a boca de uma caverna.",
         cant_go "Por esse lado só há um terreno gramado e sem graça.",
  has   light;

TRoom   Clifftop_Walk "Trilha no Alto dos Penhascos"    
  with  s_to Wall_of_Thorns,
        e_to [;
            if( herd_of_goats hasnt general ) 
                "As cabras chiam e dão cabeçadas em você, não deixando que passe.";
            print "As cabras obedientemente se afastam para permitir sua passagem.^";
            return Outside_Taverna;
        ],
        w_to Cliffs,
         description "Uma longa trilha no alto dos penhascos junto ao mar, do farol a oeste até a vila não muito distante a leste. Esses campos são ocupados por rebanhos de resistentes cabras montanhesas, que vivem dando cabeçadas umas nas outras e saltitando. Ao sul, uma trilha atravessa o terreno gramado esparso até uma grande formação de algum tipo.",
         cant_go "Por esse lado só há um terreno gramado e sem graça.",
  has   light;

Object  -> herd_of_goats "rebanho de cabras" 
  with  name 'goat' 'goats' 'herd' 'of',
        life [;
            Order, Ask, Answer:
                "Grunt!";
        ],
  has   scenery talkable;

TRoom   Outside_Taverna "Fora da Taverna"        
  with  s_to Eraina_Taverna,
        w_to Clifftop_Walk,
         description "Uma longa trilha pelos penhascos, vinda naturalmente do farol, chega aqui, logo diante da Taverna Eraina, cuja porta aberta fica ao sul.",
         cant_go "Por esse lado só há um terreno gramado e sem graça.",
  has   light;

Object  -> small_thorny_tree "árvore pequena e espinhosa" 
  with  name 'tree' 'thorny' 'small',
        before [;
            Climb, Enter: "Os espinhos fazem você desistir.";
        ],
         description "Apenas uma pequena figueira espinhosa e impossível de escalar.",
  has   scenery;

Object  -> fig "fig"     
  with  name 'fig',
         initial "Pendurado num galho baixo de uma figueira está, como seria de esperar, um figo.",
         description "Diz a lenda que o imperador romano Augusto foi morto por sua esposa Livia, que pintou os figos de sua árvore com veneno. Na verdade, este parece ser um fruto perfeitamente bom.",
         devil_hint "Você pode pedir uma data a um deus, mas eles simplesmente não dão a mínima.",
         angel_hint "Bom o bastante para um deus.",
  has   edible;

TRoom   Eraina_Taverna "Taverna Eraina"  
  with  before [;
             Buy: "Dada a dificuldade com o idioma, é melhor recorrer à troca.";
        ],
        n_to Outside_Taverna,
         description "Uma taverna simples, mas alegre, cheia de homens miseráveis e um tanto envergonhados que bebem muita retsina. O dia amanhece do lado de fora da porta norte, mas, estranhamente, eles não compartilham sua animação ao ver isso.",
         cant_go "A entrada da taverna fica ao norte.",
        each_turn [ i;
            i = random(13);
            if( i == 1 ) "^Os clientes resmungam e jogam gamão com ferocidade.";
            if( i == 2 ) "^O bartender lança um olhar duro para você.";
            if( i == 3 ) "^Começa uma briga por causa de uma questão obscura envolvendo o primo de segundo grau de alguém.";
            if( i == 4 ) 
                "^O som suave de um bouzouki começa ao fundo, subindo gradualmente a um tom intolerável. Depois de um momento, ouve-se um baque surdo e um ruído estrangulado, então abençoado silêncio.";
        ],
  has   light scored;

Object  -> Ekmek_Special "Especial Ekmek" 
  with  name 'ekmek' 'special' 'dessert',
        before [;
            Take:
                if( self hasnt moved && copper_coin hasnt general )
                    "Você não entende uma palavra do que o bartender diz, mas o sentido está claro o bastante. Só depois que pagar.";
                rfalse;
        ],
         initial "Intocado sobre uma mesa está um doce Especial Ekmek.",
         description "Uma sobremesa especial da Taverna: sorvete, kadaifi, calda de framboesa e creme. Um gosto que se aprende a apreciar.",
         devil_hint "Acho que fica melhor com sorvete de chocolate.",
         angel_hint "Outra pessoa não precisa mais disso do que você?",
  has   edible proper scored;

Object  -> bartender "bartender" 
  with  name 'bar' 'tender' 'bartender',
        life [;
            Give:
                 if( noun == copper_coin ) {
                    remove copper_coin;
                    give copper_coin general;
                     "O bartender pega a moeda cansado, com uma expressão de ~como você consegue comer numa hora dessas?~";
                }
                print_ret "O bartender olha para ", (the) noun, " com uma expressão apática.";
            Ask, Answer, Order:
                "Por ser instruído, o bartender fala um pouco de latim e aramaico. Por não ser instruído, você não fala, e a comunicação se mostra impossível.";
            Attack, Kiss: "Aqui, cercado por todos os seus amigos?";
        ],
         initial "Atrás do balcão, um bartender deprimido lustra copos.",
         description "Mal-humorado e pouco sociável nos melhores momentos. Este não é um dos melhores momentos.",
  has   animate;

TRoom   Wall_of_Thorns "Muro de Espinhos"  
  with  n_to Clifftop_Walk,
        s_to wall_of_thorns_object,
         description "A paisagem ondulada e relativamente árida é dominada aqui por um muro maciço e suspeitosamente antinatural de espinhos, que forma um grande anel ao redor de uma área talvez com cem metros de diâmetro. Ao norte há pastos de cabras.",
         cant_go "Por esse lado só há um terreno gramado e sem graça.",
  has   light;

Object  -> wall_of_thorns_object "muro de espinhos"        
  with  name 'gap' 'thorns' 'of' 'wall',
        door_to Sacred_Earth,
         when_closed "O muro farfalha e faz seus espinhos chocarem como uma fera viva.",
        door_dir s_to,
         when_open "Uma abertura irregular foi queimada no muro ao sul.",
         description "É difícil imaginar o que poderia mover um muro desses.",
  has   door static;

TRoom   Sacred_Earth "Terra Sagrada"      
  with  after [; trigger_quotation(4); rfalse; ],
        n_to Wall_of_Thorns,
        s_to [;
             print "Zeus, chefe de todos os deuses, aparece e lança um raio bem quando você começa a atravessar para o Templo. ";
            if( big_electricians_switch has on ) {
                deadflag = DIED;
                "Com o tipo de cálculo que só um deus poderia fazer, Zeus descobriu exatamente o que aconteceria e apontou o raio para atingir você bem nas costas, apesar de suas tentativas de se esquivar. Uma previsão impressionante, é seu último pensamento.";
            }
            if( rod_of_luck has general ) {
                print "Espantosamente, você supera a sorte dos deuses e entra no templo por pouco, escapando do raio. ~Droga, errei!~ diz uma voz sepulcral do lado de fora.^";
                return Temple_of_Zeus;
            }
            deadflag = DIED;
            "Com a sorte dos deuses, o raio de Zeus atinge você exatamente nas costas, apesar de suas tentativas de se esquivar.";
        ],
        description "Aqui, dentro do muro de espinhos, um caminho de norte a sul atravessa a terra sagrada até o imponente Templo de mármore de Zeus. Você se sente claramente desconfortável caminhando em solo tão sagrado. Há inúmeros mitos sobre deuses que se irritam com esse tipo de coisa.",
        cant_go "O muro de espinhos mantém você encurralado.",
  has   light;

TRoom   Temple_of_Zeus "Templo de Zeus"  
  with  name 'pillar',
        n_to [;
             print "~Desta vez eu pego você, verme!~ brada Zeus e lança outro raio, mas agora está tão furioso que erra completamente o alvo. Você sobrevive mais uma vez.^";
            return Sacred_Earth;
        ],
        se_to East_Cloister,
        sw_to West_Cloister,
         description "O belo Templo de Zeus, iluminado por velas, é uma caverna de pilares de mármore completamente vazia e sem características, exceto pela entrada ao norte. Quanto aos rumores sobre tesouros escondidos: parece que Zeus (que, aliás, uiva de raiva do lado de fora) estava blefando o tempo todo.^^Claustros levam a sudeste e sudoeste, mais para dentro do templo.",
  has   light scored;

Object  -> copper_coin "copper coin"     
