[ HomerSleeps ;
    give Homer ~general;
    Homer.initial = "Homero está dormindo novamente, com a sirinx apertada nos braços.";
    rtrue;
];

[ Hopeless;
    HomerSleeps();
    "~Sem esperança,~ diz ele com desdém e adormece.";
];

Object  -> Homer "Homero" 
  with  name 'homer' 'blind' 'poet',
        life [;
            Order, Ask:
                if( self has general )
                    "Homero está ocupado demais compondo o Livro XIV da Ilíada.";
                "Homero está dormindo.^";
            WakeOther:
                if( self has general )
                    "Homero já está acordado.";
                give Homer general;
                Homer.time_left = 0;
                Homer.initial = "Homero se senta meio acordado, agarrado à sirinx.";
                "Homero acorda assustado. ~Suponho que você queira a sirinx,~ resmunga, ~todos querem. Há três perguntas que você deve responder com sabedoria. O acordo de sempre.~^^(Ele parece estar sob um encantamento e ser capaz de falar inglês moderno, ou pelo menos americano.)^^~Primeiro: quem é o irmão de Menelau?~";
            Attack: "O quê, atacar o maior poeta que já viveu?";
            Answer:
                if( Homer hasnt general ) "Homero está dormindo.";
                if( Homer.time_left == 3 ) "Homero olha de volta para você.";
                if( Homer.time_left == 0 ) {
                    if( special_word == 'agamemnon' ) {
                        Homer.time_left = 1;
                        "~Mph,~ diz ele (de modo intraduzível). ~Mas você consegue ver o futuro? Quem vai governar Alexandria depois da queda daquele sujeito que vão chamar de Alexandre, o Grande?~";
                    }
                    Hopeless();
                }
                if( Homer.time_left == 1 ) {
                    if( special_word == 'ptolemy' ) {
                        Homer.time_left = 2;
                        "~Qual é sua cor favorita?~";
                    }
                    Hopeless();
                }
                if( special_word == 'yellow' ) {
                    Homer.initial = "Homero encara você através de olhos cegos.";
                    move Pan_pipes to player;
                    Homer.time_left = 3;
                    Achieved(SCORE_HOMER);
                    "Homero entrega a você a sirinx, relutante. ~Agora me deixe em paz, ainda tenho seis livros da Ilíada para compor.~";
                }
                Hopeless();
        ],
        initial "O poeta cego Homero cochila aqui, agarrado à sirinx (ou flautas de Pã).",
        description "Homero veste uma capa de chuva ao estilo Columbo.",
        number 0,
        time_left 0,
  has   animate proper;

Object  -> -> Pan_pipes "flautas de Pã"      
  with  name 'pan' 'pipes' 'panpipes' 'syrinx',
        before [;
            Blow:
                if( gas_mask has worn ) 
                    "Com a máscara de gás?";
                if( location == Clifftop_Walk ) "As cabras se divertem com sua execução ridícula.";
                if( location ~= Cave_Mouth ) "Você produz algumas notas dissonantes.";
                print "Tomado por inspiração divina, você começa a tocar ";
                switch( random(5) ) {
                    1: print "Prelúdio número 1";
                    2: print "Passacaglia";
                    3: print "Fantasia cromática e fuga";
                    4: print "partita para flauta desacompanhada";
                    5: print "dueto número quatro";
                }
                if( Oracle in location ) {
                    ".";
                }
                move Oracle to location;
                give flaming_bronze_urn ~static;
                give flaming_bronze_urn scenery;
                print ". De repente, o grande deus Apolo aparece diante de você! Enquanto fala, a própria rocha reverbera.^^   ~Toda a sabedoria é minha, mortal!^   Embora você procure sua maldição^   por mil anos ou mais. Agora pergunte!~^^Apolo, ao desaparecer, ri daquele jeito popularizado mais recentemente por ditadores do Terceiro Mundo e cientistas loucos. Sua sacerdotisa, a Oráculo, sai das sombras.^";
                Achieved(SCORE_ORACLE);
                rtrue;
        ],
        description "Cuidadosamente cortadas de juncos de rio, estas flautas pertenceram ao proprio Homero, como voce deve se lembrar.",
        article "a",
        angel_hint "Maravilhoso! Um som que acalma o espírito.",
  has   ;

TRoom   Cross_Centre "Centro da Cruz"      
  with  before [;
            Take, Remove:
                if( noun == inscribed_stone or old_timber_spar && noun has scenery )
                    give noun ~scenery moved;
                rfalse;
        ],
        after [;
            Take, Remove:
                if( noun == inscribed_stone or old_timber_spar && noun has static )
                     inscriptions.when_open = "A abertura de sessenta centimetros esta livre novamente.";
                rfalse;
        ],
        s_to Inner_Sanctum,
        ne_to Northeast_Cross,
        se_to Southeast_Cross,
        nw_to Northwest_Cross,
        sw_to Southwest_Cross,
        u_to Inner_Sanctum,
        d_to inscriptions,
        initial [; StartDaemon(self); ],
        description "O lendário Labirinto parece consistir apenas numa cruz larga. Seus braços seguem para nordeste, noroeste, sudeste e sudoeste, enquanto uma escada de pedra se alarga e sobe para o sul.",
        daemon [;
            if( parent(statue_of_Poseidon) == Northeast_Cross && parent(statue_of_Demeter) == Northwest_Cross && 
                parent(statue_of_Ares) == Southeast_Cross && parent(statue_of_Dionysus) == Southwest_Cross ) {
                if( inscriptions has open ) 
                    rtrue;
                give inscriptions open;
                Achieved(SCORE_TEMPLE);
                 "^Voce ouve o som de pedra raspando contra pedra.";
            }
        ],
  has   ;

Object  -> inscriptions "inscrições"   
  with  name 'inscription' 'opening',
        before [;
            Receive:
                if( self hasnt open ) rfalse;

                if( noun ~= inscribed_stone or old_timber_spar )
                     print_ret (The) noun, " simplesmente cairia pela abertura.";

                if( noun == inscribed_stone ) {
                     self.when_open = "A abertura esta firmemente bloqueada pela pedra.";
                } else {
                     self.when_open = "A abertura esta firmemente bloqueada pela escora.";
                }
                give noun scenery ~moved ~scored;
                move noun to location;
                 print_ret "Voce atravessa a abertura com ", (the) noun, ".";

        ],
        door_to Oubliette,
         when_closed "Ha inscricoes muito gastas e desbotadas no centro da cruz.",
        door_dir d_to,
         when_open "Ao lado das inscricoes ha uma abertura no chao, com cerca de sessenta centimetros quadrados.",
        description "~ka-i ur-a re-im ka an-ge~",
        article "a",
  has   door static;

TRoom   Oubliette "Oubliette"    
  with  name 'crushed' 'broken' 'bones',
        u_to Cross_Centre,
         description "Um poco de ossos fetido e mofado, sob a cruz, onde vitimas sacrificiais eram jogadas e ~esquecidas~.",
  has   ;

Object  -> gleaming_amber_gem "gema de âmbar reluzente"       
  with  name 'amber' 'gem',
        before [;
            Take:
                if( self has moved ) 
                    rfalse;
                 print "Ocorre um guincho horrivel quando uma armadilha e acionada. ";
                if( inscribed_stone has scenery || old_timber_spar has scenery ) {
                     print "As paredes comecam a se fechar, mas estao firmemente bloqueadas e nao conseguem se mover...^^";
                    rfalse;
                }
                deadflag = DIED;
                 "A abertura se fecha, e as paredes tambem! Em questao de segundos, elas reduzem voce a po de biscoito para caes.";
        ],
         initial "A vista, sobre ossos esmagados e quebrados, repousa uma gema de ambar reluzente.",
         description "Dentro dela está o corpo de uma mosca. Raspada numa das faces está a palavra ~GALITA~.",
         angel_hint "Nao ha alguma lenda classica sobre ela?",
  has   scored;

TRoom   Northeast_Cross "Cruz Nordeste"        
  with  name 'carvings' 'fish' 'nets',
        sw_to Cross_Centre,
         description "Este canto da cruz é incrustado com entalhes de peixes, ondas e grandes redes varrendo a água.^^O Labirinto fica a sudoeste.",
  has   ;

Class Statue
  with  before [;
             Push: "Talvez voce deva dizer em que direcao empurrar.";
            PushDir:
                if( inscriptions has open ) 
                     "A unica direcao para empurrar a estatua e o centro da cruz, mas ha um poco aberto no chao ali.";
            if( second ~= u_obj or d_obj ) {
                AllowPushDir();
                rtrue;
            }
            rfalse;
        ],
         after [; PushDir: "Voce empurra a estatua junto com voce."; ],
  has   static statue_flag;

