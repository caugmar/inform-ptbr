Object  -> inscribed_stone "pedra inscrita"
  with  name 'rosetta' 'stone' 'inscribed' 'pumice',
         initial "No nicho repousa uma pedra-pomes inscrita, com sessenta centímetros de altura.",
        description [;
             print "A pedra traz duas inscrições, lado a lado:^";
            0-->8 = 2 | 0-->8;
            print "^   #. [] = # +*+  __             an-ta re-im ka u bir ka-i^             |||       ^        |        |     ^   / # -+- :; # -+-                 ka ne : to-ro-ma ka ur^        |        |     ^                       ^   >>> -> # (---)         .je-fe-im ka ur-a an-ge to-ro-ma^             |||^";
            0-->8 = 65533 & 0-->8;
            rtrue;
        ],
        article "um",
         angel_hint "Quem escreveu isto deve ter querido transmitir a mensagem com muita insistência, a ponto de escrevê-la duas vezes.",
  has   scored;

