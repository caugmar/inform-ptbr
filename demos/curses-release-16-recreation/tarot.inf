TRoom   Cave_Mouth "Boca da Caverna"  
  with  name 'lamps' 'trestle' 'altar' 'stone',
        ne_to Cliffs,
        description "Uma caverna seca que começa numa fenda a nordeste, tornando-se uma gruta de bom tamanho, mobiliada com bronze e iluminada por lamparinas suspensas em correntes no teto.",
  has   light;

Object  -> flaming_bronze_urn "urna de bronze flamejante"       
  with  name 'flaming' 'bronze' 'urn' 'flame' 'cube' 'obsidian' 'altar' 'stone',
        before [;
            Receive:
                if( noun == player ) << Enter self >>;
                remove noun;
                 if( Oracle notin location )
                    "Talvez os deuses ja nao habitem lugares assim. Sua oferenda queima em vao.";
                if( noun == fig ) {
                    move fig to Outside_Taverna;
                     fig.initial = "O deus Apolo age de maneiras misteriosas, pois outro figo apareceu na arvore.";
                    give fig ~moved;
                }
                if( noun has edible ) {
                    give Oracle general;
                     "Voce agradou ao deus Apolo, Loxias, deus das palavras e dos conselhos, como ja foi chamado! Muito sabio.";
                }
                 "O deus Apolo nao se impressiona com sua oferenda, que alimenta a chama eterna.";
             Enter: "Voce nao deseja ser queimado.";
        ],
         initial "No centro da caverna repousa uma pedra de altar de obsidiana com uma urna de bronze flamejante.",
         description "A pedra do altar, as vezes chamada de ~Omphalos~ ou ~o umbigo~, traz uma estranha cruz ou sinal de mais e, segundo a lenda, marca o centro do mundo.^^Ao redor da urna ha relevos de banquetes, bois sendo perseguidos e sacrificados, colheitas de frutas e fabricacao de queijo.",
        article "a",
  has   container open static;

[ DescribePacesPoetically i ;
    if( i < 0 ) {
        i = 0 - i;
    }
    if( i == 0 ) {
        print "zero";
    }
    if( i == 1 ) {
        print "um passo";
        rfalse;
    }
    if( i >= 2 ) {
        EnglishNumber(i);
    }
    print " passos";
    rtrue;
];  

[ PriestTalk ;
    if( priest_cnt == 3 ) {
        "A sacerdotisa já disse o bastante.";
    }
    if( Oracle hasnt general ) {
        "A sacerdotisa permanece em silêncio. Só uma oferenda pode obter a sabedoria de Apolo.";
    }
    give Oracle ~general;
    ++priest_cnt;
    print "A sacerdotisa, oráculo pítia de Loxias, mal parece ouvir ou entender: entra em transe, balançando-se num ritmo sensual, e canta em português,^^";
    if( priest_cnt == 1 ) {
        print " ~Assim como Hefesto, mestre dos metais,^  descobriu o amanhecer dourado do Hélicon,^  assim, em ";
        DescribePacesPoetically(StrongboxX);
        print " e ";
        DescribePacesPoetically(StrongboxY);
        print "^  quando seis arcos tiverem permanecido por sessenta anos,^  até os restos de uma sombra serão lançados.~";
    }
    if( priest_cnt == 2 ) {
        print " ~Como as erupções dos montes sicilianos,^  virão engenhos para arruinar um castelo,^  que nenhuma armadura de bronze pode suportar,^  salvo, talvez, um véu para o pescoço.~";
    }
    if( priest_cnt == 3 ) {
        print " ~Seu ancestral, pilão na mão,^  fez o unguento de que você precisará^  para desafiar a ordem terrena dos druidas:^  cuidado, mortal, atenção.~";
    }
    new_line;
    if( priest_cnt == 1 ) 
        "^Apolo seria o que você chamaria de sujeito irritante, se não fosse também uma divindade assustadoramente poderosa.";
    rtrue;
];

Object  Oracle "Oracle"  
  with  name 'oracle' 'masked' 'priestess' 'pythian' 'loxias' 'of' 'apollo',
        life [;
            Attack, Kiss, ThrowAt: "Como você deveria saber, a Oráculo é inviolável.";
            Ask, Order, Answer: PriestTalk(); rtrue;
        ],
        initial "A Oráculo, sacerdotisa mascarada de Apolo, está aqui atrás de uma pedra de altar de obsidiana, com três côvados cúbicos; ao seu lado há uma urna de bronze com uma chama perpétua.",
        article "a",
  has   animate;

[ FlashFallsOut ;        
    if( photographers_flash in mirrored_device ) {
        print "(Pelo canto do olho, você percebe o flash cair do dispositivo.)^";
        move photographers_flash to Lighthouse;
    }
];

TRoom   Lighthouse "Farol"  
  with  name 'smudge' 'quinquire',
        d_to [; FlashFallsOut(); return Greek_Frieze1; ],
        description [;
            print "Você está no alto de um pináculo de pedra, num Faros antigo, ou farol. Atenciosamente, os construtores deixaram uma escada em espiral para baixo. ";
            if( Sea_Shore has visited ) 
                print "Os penhascos abaixo são familiares, mas é um pouco mais tarde do que quando você chegou à costa. ";

            if( photographers_flash has general ) 
                print "Há muito movimento na baía, e o comércio parece estar se recuperando agora que o Kraken partiu.";
            else
                print "Parece haver pouquíssimo movimento no momento, embora uma mancha no horizonte possa ser uma quinquerreme.";

            print "^^No centro do pináculo há um maravilhoso dispositivo de espelhos de bronze polido, com a extremidade aberta apontada para a baía. ";

            if( photographers_flash has general ) 
                "O Mediterrâneo cintila sob o sol quente da tarde.";
            "O sol está nascendo e o céu está azul e límpido sobre o Mediterrâneo: será um belo dia.";
        ],
        cant_go "Como este é um farol, o pináculo fica muito alto no ar. Entendeu?",
  has   light scored;

Object  -> mirrored_device "dispositivo espelhado"     
  with  name 'device' 'mirrored' 'bronze',
  has   container open scenery;

TRoom   Greek_Frieze1 "Friso Grego"     
  with  u_to Lighthouse,
        description "Um friso marrom, representando caçadores e lanceiros, circunda esta escada escura, que não tem saída além da escada em espiral que leva de volta para cima.",
  has   light;

LagachObj -> Greek_frieze2 "friso grego"  
  with  name 'greek' 'frieze' 'mural',
        description "A faixa decorada do entablamento entre a arquitrave e a cornija, no estilo ático do século V a.C.^^Bem, você perguntou.",
  has   scenery;

Object  port_obj "port wall"     
  with  name 'port',
        door_dir w_to,
        article "a",
  has   scenery;

Object  starboard_obj "starboard wall"   
  with  name 'starboard',
        door_dir e_obj,
        article "a",
  has   scenery;

Object  fore_obj "fore wall"     
  with  name 'fore',
        door_dir n_to,
        article "a",
  has   scenery;

Object  aft_obj "aft wall"       
  with  name 'aft',
        door_dir s_to,
        article "a",
  has   scenery;

Object  some_landlubbers_direction "some landlubber's direction" 
  with  name 'north' 'n//' 'south' 's//' 'east' 'e//' 'west' 'w//',
        before [;
            "Aqui a bordo, uma direção de quem não entende de navegação parece inadequada.";
        ],
  has   proper scenery;

TRoom   Aboard_Ship "A Bordo do Navio"        
  with  name 'rail' 'storm',
        n_to Prow_of_the_Lady_Magdalena,
        s_to Stern,
        u_to Up_the_Mast,
        description "Uma tempestade sacode o convés, mas não traz chuva: você cambaleia de um lado para o outro, agarrado ao corrimão, ao mastro ou ao cordame. Não parece haver mais ninguém a bordo. O barco não avança na estranha névoa vítrea.^^O mastro sobe vertiginosamente.^^Você nem consegue distinguir a água abaixo. Uma grande névoa rosa se espalha pelo céu. Com presságios assim, quem precisa de albatrozes?",
        cant_go "O convés vai da proa à popa, como todos os convés.",
        daemon [;
            if( location has ship_flag ) {
                rfalse;
            }
            StopDaemon(self);
            remove port_obj;
            remove starboard_obj;
            remove aft_obj;
            remove fore_obj;
            remove some_landlubbers_direction;
            move n_obj to compass;
            move s_obj to compass;
            move e_obj to compass;
            move w_obj to compass;
            move ne_obj to compass;
            move nw_obj to compass;
            move se_obj to compass;
            move sw_obj to compass;
            rfalse;
        ],
        each_turn [;
            if( port_obj in compass ) {
                rfalse;
            }
            move n_obj to flagpole;
            move s_obj to flagpole;
            move e_obj to flagpole;
            move w_obj to flagpole;
            move ne_obj to flagpole;
            move nw_obj to flagpole;
            move se_obj to flagpole;
            move sw_obj to flagpole;
            move port_obj to compass;
            move starboard_obj to compass;
            move aft_obj to compass;
            move fore_obj to compass;
            move some_landlubbers_direction to compass;
            StartDaemon(self);
        ],
  has   light ship_flag;

Object  -> mast_and_rigging "mastro e cordame"   
  with  name 'mast' 'rigged' 'rigging',
        before [;
            Enter, Climb: << Go u_obj >>;
        ],
        article "a",
  has   scenery;

TRoom   Up_the_Mast "No Alto do Mastro"        
  with  before [;
            Jump:
                print "Você salta (loucamente) do cesto da gávea ";
                if( british_flag has general ) {
                    print "(rasgando a bandeira ao passar) ";
                }
                deadflag = DIED;
                "para uma morte colorida no convés abaixo.";
            Strike, Point: "Up here?";
        ],
        after [;
            Drop:
                move noun to Aboard_Ship;
                if( noun == medicine_bottle && noun has locked ) {
                    give medicine_bottle ~locked;
                    give medicine_bottle open;
                    "O frasco de remédio cai como uma pedra no convés muito abaixo, onde racha como um ovo.";
                }
                "Caiu de muito alto, sobre o convés.";
        ],
        w_to [;
            print "Você caminha até o mastro da bandeira, que se curva e dobra de modo alarmante, até que de repente...^^Crac! E você está caindo";
            if( british_flag hasnt general ) {
                deadflag = DIED;
                ", despencando de cabeça para baixo no convés duro de madeira e nas inevitáveis ferragens...";
            }
            move british_flag to Aboard_Ship;
            give british_flag ~concealed;
            give british_flag ~general;
            remove flagpole;
            move old_timber_spar to Aboard_Ship;
            move player to Aboard_Ship;
            location = Aboard_Ship;
            Achieved(SCORE_FLAG);
            "... mas com elegância, enquanto a bandeira se abre como um paraquedas, até que de repente se rasga da sua mão e você cai numa pilha ignominiosa.";
        ],
        d_to [;
            if( british_flag has general ) {
                give british_flag ~general;
                print "Você é obrigado a soltar a bandeira no caminho.^^";
            }
            return Aboard_Ship;
        ],
        description "Subir até aqui deve ser uma de suas ideias menos inspiradas. A névoa está por toda parte, confundindo seus sentidos. Duas luas azuladas e pálidas pairam num céu rosa.",
        cant_go "Down might be a better idea.",
  has   light ship_flag;

Object  -> flagpole "mastro da bandeira"   
  with  name 'pole' 'flagpole' 'mast' 'ensign' 'spar',
        before [;
            Take, Turn, Push, Pull: "O mastro da bandeira está firmemente preso ao mastro principal.";
        ],
        initial "Um mastro de bandeira se projeta para bombordo do alto do mastro, frágil demais para suportar qualquer peso. Pende dele a bandeira da Marinha Mercante Britânica (cuja parte inferior você quase consegue alcançar).",
        description "O mastro da bandeira se projeta para bombordo com o vento predominante... ou será?",
  has   static;

Object  -> british_flag "bandeira da Marinha Mercante Britânica" 
  with  name 'flag' 'ensign' 'navy' 'british' 'merchant' 'of' 'tassels',
        before [;
            Remove:
                if( self in comfortable_bed ) "A bandeira parece perfeita para a cama do jeito que está.";
                rfalse;
            Take, Pull:
                if( self in comfortable_bed ) "A bandeira parece perfeita para a cama do jeito que está.";
                if( self notin Up_the_Mast ) rfalse;
                give british_flag general;
                "Você segura as borlas da bandeira com uma mão (embora ela não se solte do mastro).";
            Drop, Remove:
                ! Pequeno erro de lógica: não verifica se a bandeira tem general
                give british_flag ~general;
                "Você solta as borlas da bandeira.";
        ],

        initial "A bandeira esvoaçou e caiu amontoada no convés.",
        description "Tecido escarlate, largo e pesado, entre um lençol de seda e um tapete, com uma cruz e uma Union Jack num canto.",
        devil_hint "Um conselho: nunca é muito confortável enrolar-se na Bandeira.",
  has   concealed;

Object  old_timber_spar "verga velha de madeira"        
  with  name 'old' 'prop' 'timber' 'flagpole' 'spar',
        after [;
            Take:
                if( old_timber_spar hasnt general ) rfalse;
                !!! BUG: isto deve ter sobrado dos jardins. Na prática, não serve para nada.
                give old_timber_spar ~general;
                StartTimer(bean_pole,5);
                rfalse;
        ],
        initial "O mastro quebrado da bandeira, uma simples verga de madeira, está ao lado do mastro.",
        description "Uma velha escora de madeira, antes a verga de um mastro principal.",
        article "uma",
        rod_assoc rod_of_returning,
        devil_hint "Um simples pedaço velho de madeira.",
  has   hidden_rod;

TRoom   Prow_of_the_Lady_Magdalena "Proa do Lady Magdalena"  
  with  name 'lady' 'magdalena' 'mermaid' 'figurine',
        s_to Aboard_Ship,
        description "Você está na proa triangular do navio, adornada por uma figura esculpida e pintada e chamada ~Lady Magdalena~. Não há sinal de água, mas o barco balança demais para estar encalhado. À frente paira a névoa vítrea.",
        cant_go [;
            print "Você só pode ir para a popa.^";
            trigger_quotation(11);
            rtrue;
        ],
  has   light ship_flag;

Object  -> green_branch "ramo verde"   
  with  name 'green' 'branch' 'leafed',
        before [;
            Wave: 
                if( Jemima in location ) 
                    "Jemima, que tem febre do feno, fica extremamente irritada. Portanto, não foi uma ação totalmente desperdiçada.";
                if( location ~= Hollow || parent(corn_crake) == nothing ) 
                    "O pólen faz você espirrar um pouco, mas não dá resultado. (De qualquer modo, valeu a tentativa.)";
                remove corn_crake;
                "O pássaro se assusta tanto com a nuvem de pólen do ramo agitado que salta para o céu, grasnando de ansiedade alada.";
        ],
        initial "Na mão frouxa da Lady Magdalena há um amuleto tradicional de boa sorte dos marinheiros: um ramo de folhas verdes para atrair as gaivotas de uma costa próxima.",
        section T_TAROT,
        angel_hint "Oh, você me assustou por um instante! Estou ficando avoado.",
  has   ;

TRoom   Stern "Popa"    
  with  name 'sand' 'bank' 'mist',
        n_to Aboard_Ship,
        d_to [;
            if( capstan hasnt general ) 
                "Você desce precariamente pela corrente da âncora, mas chega ao fim ainda pendurado muito acima da... água? areia movediça? Concentrando-se com muito cuidado, você se ergue de volta a bordo e ofega aliviado.";
            move player to Souvenirs_Room;
            location = Souvenirs_Room;
            "Você desce pela corrente da âncora, para baixo, para baixo, sob a quilha da Lady Magdalena, até que não há nada além da névoa vítrea e da corrente interminável...^^...E do banco de areia macio, esponjoso e rosado que se aproxima e recebe você com seu calor: você pisa em terra e imediatamente afunda na areia úmida e viva, até ser completamente engolido... e desmaiar.^^No entanto, as tábuas duras do sótão sob suas costas logo o despertam novamente.";
        ],
        description "A popa quadrada do navio aponta para o sul, não para ondas recuando, mas para o que parece um túnel através da névoa densa e vítrea. Ao longe, você mal distingue um estranho banco de areia avermelhado e pálido.",
        cant_go "O barco segue para a proa.",
  has   light ship_flag;

Object  -> capstan "cabrestante"     
  with  name 'capstan' 'anchor' 'chain' 'wheel',
        before [;
            Turn, Push, PushDir:
                print "Você gira o cabrestante com esforço, ";
                if( capstan has general ) 
                    give capstan ~general;
                else {
                    give capstan general;
                    print "un";
                }
                "enrolando a grande corrente da âncora.";
            Climb:
                << Go d_obj >>;
        ],
        initial "O topo da corrente da âncora está enrolado no cabrestante, uma grande roda no convés ao seu lado. A corrente desaparece pela lateral.",
  has   static;
