Object  Oil_Room "Sala do óleo"      
  with  before [;
            Anoint:
                if( noun ~= player || mummy_case has general ) "Isso mal parece valer a pena.";
                give mummy_case general;
                "Você espalha óleo na cabeça, anotando mentalmente que deve lavar o cabelo pela manhã. É o ritual sagrado menos sagrado de que já participou.";
        ],
        n_to The_Birdcage_of_the_Muses,
        description "Esta sala pequena e escura (à noite) é um depósito de suprimentos da Biblioteca, sobretudo de óleo para lâmpadas, armazenado em grandes calhas rasas de cerâmica. Ainda bem que sua tocha é elétrica, pensando bem. De qualquer modo, uma passagem leva de volta ao norte.",
        section T_ALEXANDRIA,
  has   ;

Object  -> oil_filled_troughs "calhas cheias de óleo"       
  with  name 'oil' 'troughs' 'shallow' 'lamp',
        before [;
             Drink, Enter: "Que ideia repugnante!";
        ],
        article "the",
  has   scenery;

Object  Geography_Room "Sala de geografia"  
  with  nw_to The_Birdcage_of_the_Muses,
        description "O salão bastante negligenciado para o estudo preciso da geografia, em oposição às histórias sensacionalistas de viajantes preferidas pela maioria dos escritores deste século descuidado. Ninguém trabalha aqui, e só é possível voltar para noroeste.",
        cant_go "Para garantir que os geógrafos não se percam, a única saída é a noroeste.",
        section T_ALEXANDRIA,
  has   light;

Object  -> spindle_from_the_globe "eixo do globo"       
  with  name 'spindle' 'axis' 'globe' 'earth',
        before [; Pull: << Take self >>; ],
        after [;
            if( spindle_from_the_globe hasnt general ) {
                    give spindle_from_the_globe general;
                    spindle_from_the_globe.description = "Antes, o eixo polar de um globo.";
                    "Ao puxar seu eixo polar, o fuso, a Terra desaba completamente em uma ruína possivelmente simbólica e certamente empoeirada.";
                }
                rfalse;
        ],
        initial "Saindo de um globo terrestre quebrado (marcado com mapas muito provisórios e aproximados) está o fuso, a única coisa que o mantém unido.",
        description "Talvez seja o melhor trabalho de cartografia dos próximos dois mil anos, embora pareça improvável que dure as próximas duas horas.",
        rod_assoc rod_of_ice,
        devil_hint "Não saia balançando isso por aí.",
  has   hidden_rod;

Object  Reading_Corridor "Corredor de leitura"      
  with  s_to Librarians_Office,
        w_to The_Birdcage_of_the_Muses,
         description "Um corredor espaçoso e densamente colunado, com paredes revestidas de prateleiras embutidas onde há incontáveis pergaminhos, amarrados, empoeirados, desintegrando-se e mal catalogados, de modo que só um especialista consegue encontrar o que quer.",
         cant_go "Você vagueia entre as colunas, mas não encontra saída além da passagem a oeste e de um pequeno escritório ao sul.",
        section T_ALEXANDRIA,
  has   light;

Object  -> dusty_scrolls "pergaminhos empoeirados" 
  with  name 'dusty' 'scrolls' 'scroll' 'books' 'book',
         description "Até um único livro pode se estender por dezenas de pergaminhos individuais, e os títulos são difíceis de interpretar; de todo modo, a maioria dos livros é lixo. A classificação decimal de Dewey ainda demorará milênios para ser inventada.",
        article "endless",
  has   scenery;

[ CallimachusLife o ;
    if( action == ##Give ) {
        if( self == Callimachus && noun == tube_with_an_alpha_on || (self == Apollonius && inp1 == tube_with_a_kappa_on) ) {
            "Ele pega o tubo, vê a letra nele, parece exasperado, bate na sua cabeça com o tubo e o empurra de volta para seus braços.";
        }
        if( noun == tube_with_an_alpha_on or tube_with_a_kappa_on ) {
            CDefart(self);
            print " pega o tubo e olha dentro";
            o = child(noun); 
            if( o == nothing ) {
                move noun to location; 
                " e descobre que está vazio. Ele olha para você muito severamente, mas volta ao trabalho, jogando o tubo no chão com impaciência.";
            }
            if( o == scroll_bearing_a_short_poem or scroll_bearing_an_epic_poem ) {
                print " e vê um pergaminho, que ele puxa avidamente.^^";
                if( self == Callimachus && o == scroll_bearing_an_epic_poem || (self == Apollonius && o == scroll_bearing_a_short_poem) ) {
                    remove o;
                    if( parent(Callimachus) == parent(Apollonius) ) {
                        move purple_sash to location;
                        move mystic_scroll to location;
                        move Apollonius to location;
                        Apollonius.initial = "Apollonius e Calímaco agora estão envolvidos em uma briga furiosa e feia, da qual parece improvável que saiam por um bom tempo.";
                        Achieved(SCORE_LIBRARY);
                        "Um olhar basta. Ele desfere um soco violento, e os bibliotecários começam uma briga selvagem de punhos nus.^^Esta sua brincadeira prática, digamos, bastante mesquinha parece ter tido uma consequência interessante, porém.";
                    }
                    remove noun;
                    print "~Arrghhhieee!~, ele diz (intraduzível), fervendo de raiva. Em seguida pragueja repetidamente, mas a única palavra que você consegue distinguir é ~";
                    if( self == Callimachus ) {
                        print "Apollonius";
                        move self to parent(Apollonius);
                    } else {
                        print "Callimachus";
                        move self to parent(Callimachus);
                    }
                    give Callimachus concealed;
                    Apollonius.initial = "Apollonius e Calímaco têm uma discussão furiosa, acalorada e interminável sobre alguma coisa. Parecem muito experientes nessa ocupação.";
                    "~. Ele empurra você para abrir caminho e sai pisando forte.";
                }
                print "~Ahhhh...~, ele diz (intraduzível) enquanto lê. ";
                if( noun == Callimachus ) {
                    print "Finalmente, depois de uma espera muito longa, ";
                } else {
                    print "Mas logo ";
                }
                move noun to location; 
                "ele termina, coloca o pergaminho de volta no tubo com o hábito de um bibliotecário treinado e o deixa cair distraidamente no chão.";
            }
            print " to find ";
            Indefart(o);
            print ", which, to say the least, comes as a surprise. Such a fuss is kicked up that you are quickly thrown out into the street.^";
            PlayerTo(Outside_the_Royal_Museum,1);
            rfalse;
        }
        "Como você poderia subornar homens de saber tão desinteressados quanto os bibliotecários?";
    }
    if( action == ##Order or ##Ask or ##Answer ) {
        "Como um estudioso bárbaro que não conhece grego, você dificilmente pode esperar conversar com alguém como ele.";
    }
    rfalse;
];

Object  -> Callimachus "Callimachus"     
  with  name 'callimachus' 'expert' 'librarian',
        life CallimachusLife,
        initial "O especialista em questão é Calímaco, debruçado sobre um pergaminho e quase inconsciente de sua presença.",
        description "Calímaco é famoso por alguma coisa. Você se pergunta o quê...",
  has   animate proper;

Object  mystic_scroll "pergaminho místico"    
  with  name 'mystic' 'scroll',
         initial "Apollonius parece ter deixado cair um pergaminho místico durante a briga.",
         description "Ele diz que até o maior dos mortais deve escolher entre os três Altos [a próxima palavra está ilegível], de uma vez por todas, mas que há um caminho para cada um. O costumeiro absurdo místico.",
         devil_hint "Não acredite nisso!",
         angel_hint "Nós, na vida após a morte, hum, temos a política de nunca comentar documentos vazados.",
  has   ;

Object  purple_sash "faixa roxa"        
  with  name 'purple' 'sash',
         initial "E a faixa roxa de ombro de Calímaco se soltou.",
         description "Usada sobre o ombro.",
  has   clothing;

Object  Librarians_Office "Escritório do bibliotecário"   
  with  name 'table' 'sand' 'wells' 'sandwells',
        n_to Reading_Corridor,
         description "Um pequeno escritório junto às colunatas ao norte, lar de Apollonius, o bibliotecário-chefe, cujos instrumentos de escrita, mesa e caixas de areia estão espalhados desordenadamente.",
        section T_ALEXANDRIA,
  has   light;

Object  -> Apollonius "Apollonius"       
  with  name 'apollonius' 'head' 'expert' 'librarian',
        life CallimachusLife,
         initial "Apollonius anda de um lado para outro com importância, usando uma faixa roxa e examinando documentos em sua mesa.",
         description "Seu principal objetivo na vida é incomodar Calímaco, seu bibliotecário júnior e o poeta moderno que ele mais despreza.",
  has   animate proper;

Object  Outside_Royal_Palace "Fora do Palácio Real de Alexandre"    
  with  n_to [;
            if( cloak_of_many_colours has worn ) {
                deadflag = DIED;
                "Ou você poderia simplesmente caminhar até eles usando um manto de muitas cores. Faça como quiser.";
            }
            print "^Você entra sorrateiramente no palácio e imediatamente sai do campo de visão dos muitos escrivães e servidores civis que operam a máquina do governo mesmo a esta hora tardia. Em segundos, percebe que está...^";
            return Lost_inside_the_Palace;
        ],

        s_to Outside_the_Theatre,
        description "Um edifício extremamente impressionante, exatamente o que se esperaria do homem que conquistou toda a Ásia Menor numa idade em que a maioria começa a pensar em conseguir uma hipoteca.^^É claro que há guardas, mas estão tentando alcançar a procissão; portanto, se você tiver cuidado para não chamar atenção, provavelmente poderá entrar sorrateiramente ao norte.",
        section T_ALEXANDRIA,
  has   light;

Object  Lost_inside_the_Palace "Perdido dentro do palácio"  
  with  before [;
            Go:
                if( purple_sash hasnt worn ) {
                    move player to Outside_Royal_Palace;
                    location = Outside_Royal_Palace;
                    "O escravo examina você e vê que não traz a marca de um visitante credenciado do palácio. Você é discretamente escoltado para fora.";
                }
                rfalse;
            Drop, Empty: "O escravo segura educadamente seu braço até você desistir.";
            Anoppe:
                if( Lost_inside_the_Palace has general ) {
                    SlaveFindsYou();
                    rtrue;
                }
                rfalse;
        ],
        after [;
            Go:
                while( child(Lost_inside_the_Palace) ~= nothing )
                    remove child(Lost_inside_the_Palace);
                move slave to Lost_inside_the_Palace;
                move player to Lost_inside_the_Palace;
                palace_move3 = palace_move2;
                palace_move2 = palace_move1;
                palace_move1 = noun;
                give Lost_inside_the_Palace ~general;
                if (palace_move3 == ne_obj && palace_move2 == e_obj && palace_move1 == s_obj) {
                    give Lost_inside_the_Palace general;
                }
                if (palace_move1 == s_obj && palace_move2 == s_obj) {
                    location = Outside_Royal_Palace;
                    move player to location;
                }
                ++PalaceCnt;
                if (PalaceCnt == 2) {
                    trigger_quotation(46);
                }
                rfalse;
        ],
        n_to Lost_inside_the_Palace,
        s_to Lost_inside_the_Palace,
        e_to Lost_inside_the_Palace,
        w_to Lost_inside_the_Palace,
        ne_to Lost_inside_the_Palace,
        se_to Lost_inside_the_Palace,
        nw_to Lost_inside_the_Palace,
        sw_to Lost_inside_the_Palace,
        description "Os estudiosos se dividem quanto à origem da lenda do ~labirinto~: alguns sustentam que, para uma cultura primitiva, o palácio de Cnossos era tão complexo que parecia um labirinto, e o rei tão assustador que parecia um Minotauro.^^Outros dizem que os primeiros palácios realmente eram labirintos para proteger altares sagrados.^^E você acha que é porque este é um labirinto de pequenas passagens sinuosas, todas iguais.",
        section T_ALEXANDRIA,
  has   light scored cat_nofollow;

Object  -> slave "escravo" 
  with  name 'slave' 'deaf' 'mute',
!        life SlaveLife,
        initial "Um escravo está impassível junto a uma parede.",
        description "Um escravo assim, um profissional altamente treinado, fica em cada interseção de passagens do palácio. São surdos-mudos, para impedi-los de ouvir segredos de Estado.",
  has   animate;

[ SlaveFindsYou ;       
    print "O escravo daqui, um conselheiro sênior apenas disfarçado de surdo-mudo, reage imediatamente, pega você pelo braço e o conduz por um caminho sinuoso pelo palácio até a...^";
    PlayerTo(Palace_Balustrade);
    rtrue;
];

Object  Palace_Balustrade "Balaustrada do palácio"    
  with  before [;
            Swim, Jump:
                move player to Warehouses_and_Port;
                location = Warehouses_and_Port;
                "Você mergulha da sacada em um movimento belamente gracioso, caindo perfeitamente nas águas geladas e (felizmente) profundas abaixo. Depois luta para chegar à superfície, debatendo-se em pânico, e finalmente sai da água em um movimento desajeitado e ridículo.";
        ],
        description "A magnífica sacada com vista para o porto Real de Alexandria. Daqui a duzentos anos, Júlio César será sitiado aqui e defenderá o palácio com uma pequena força de homens contra um exército inteiro; e perderá o coração para Cleópatra...^^Por enquanto, esta é uma ampla sacada de pedra com balaustrada. A lua brilhante como uma moeda, baixa no céu, reflete-se nas águas negras muito abaixo.",
        cant_go "Parece não haver absolutamente nenhuma maneira de sair da sacada, pois as portas de pedra para o coração do palácio estão firmemente seladas.",
        section T_ALEXANDRIA,
  has   light scored cat_nofollow;

Object  -> astronomical_mounting "suporte astronômico" 
  with  name 'mounting' 'socket' 'astronomical' 'tripod',
        before [;
            Receive:
                if( noun == golden_astrolabe ) {
                    remove astronomical_mounting;
                    move golden_astrolabe to Palace_Balustrade;
                    give golden_astrolabe static;
                    give golden_astrolabe ~moved;
                    golden_astrolabe.initial = "Em seu lugar, há um astrolábio.";
                    move astronomical_mounting to Palace_Balustrade;
                    "Ele se encaixa perfeitamente, como se tivesse sido feito para estar ali.";
                }
                "Não encaixa.";
        ],
        initial "Um impressionante suporte astronômico está sobre um tripé aqui. Mas não há telescópio.",
        article "an",
  has   static;
