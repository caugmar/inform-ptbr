Object  Outside_the_Theatre "Fora do teatro"        
  with  n_to Outside_Royal_Palace,
        s_to Outside_the_Royal_Museum,
        w_to Warehouses_and_Port,
        description "Tragicamente, o Teatro está fechado esta noite, mas as estradas passam pela grande bacia escalonada: ao norte em direção ao Palácio, ao sul até o Museu e a oeste até a frente do porto.",
        section T_ALEXANDRIA,
  has   light;

Object  Outside_the_Royal_Museum "Fora do Museu Real"      
  with  n_to Outside_the_Theatre,
        ne_to Stadium,
        se_to [;
            if( purple_sash has worn ) {
                print "Vendo que você usa a faixa de um bibliotecário, os guardas se afastam para permitir sua entrada.^";
                return The_Birdcage_of_the_Muses;
            }
            if( Austin in location ) {
                print "Os guardas do Museu estão tão ocupados se prostrando diante do Gato sagrado (inacreditavelmente, Austin) que você consegue entrar sorrateiramente.^^Austin, finalmente tendo encontrado donos ainda mais crédulos e pouco exigentes que você, sai calmamente para uma vida de extremo mimo e luxo.^";
                remove Austin;
                StopDaemon(Austin);
                StopDaemon(self);
                return The_Birdcage_of_the_Muses;
            }
            "Os guardas do Museu afastam diplomaticamente os bêbados do Museu.";
        ],
        sw_to Crossroads,
        description "A estrada principal de sudoeste a nordeste se bifurca com uma estrada diretamente ao norte para o Teatro. Apesar do tumulto caleidoscópico, você se impressiona com a sóbria majestade do Museu dos Ptolomeus, cuja bela entrada com pórtico, adornada com relevos, fica a sudeste.",
        daemon [;
            if( game_section ~= T_ALEXANDRIA || location has cat_nofollow || Austin in location ) {
                rfalse;
            }
            move Austin to location; 
            "^Austin passeia majestosamente com você.";
        ],
        section T_ALEXANDRIA,
  has   light;

