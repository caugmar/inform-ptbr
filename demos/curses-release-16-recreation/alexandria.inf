[ SeaBefore ;
    if( action == ##Swim ) "As águas são traiçoeiras apesar da aparência. Melhor não.";
    rfalse;
];

! adding this:
Object  "água do mar"
  with  name 'sea' 'salt' 'water' 'mar' 'sal' 'água',
        before [;
            Drink: "Beber água morna e salgada? Não.";
        ],
        found_in Causeway Island_of_Pharos Jetty Warehouses_and_Port Harbour_Mouth,
  has   scenery;

Object  Causeway "Calçada"      
  with  before SeaBefore,
        n_to Island_of_Pharos,
        se_to Crossroads,
        initial [;
            StartDaemon(self);
            if( Austin in self )
                StartDaemon(Outside_the_Royal_Museum);
            rfalse;
        ],
        description "Uma cálida noite de inverno na antiga cidade de Alexandria, na calçada do Heptastádio que atravessa o porto até a ilha de Faros (ao norte). As águas do Mediterrâneo batem contra a ponte de terra, e toda a cidade (a sudeste) está iluminada por tochas: é uma noite de celebração.",
        number 2,
        daemon [ i;
            if( game_section ~= T_ALEXANDRIA ) rfalse;
            self.number = (self.number + 1) % 12;
            if( location ~= Crossroads or Outside_the_Royal_Museum or Stadium ) rfalse;

            i = Causeway.number;
            if( location == Outside_the_Royal_Museum ) {
                --i;
            }
            if( location == Stadium ) {
                i = i - 2;
            }
            if( i < 4 ) 
                 "^Uma procissão animada e muito barulhenta atravessa o local, e alguns carros alegóricos espetaculares se aproximam rapidamente.";
            if( i == 4 ) 
                 "^A Estrela da Manhã conduz uma enorme procissão pelo festival de Dioniso, repleta de autoridades vestidas como sátiros, atores e cidadãs.";
            if( i == 5 ) 
                 "^Atrás da frente vêm enormes estátuas em carros mecânicos, ladeadas por jarras gigantes transbordando vinho. E os animais estão chegando!";
            if( i == 6 ) 
                "^Yes, 2000 oxen dressed in gold, as many dogs, and the giraffes, the antelopes, the gnus, 
                 parrots, elephants, wildebeest... ostriches pulling carts, a white bear...";
            if( i == 7 ) 
                "^Next the dancers, in a great masque of the life of Alexander the Great, his travels, conquests, 
                 founding of the City, and so on. The delicate matter of how exactly his general Ptolemy took over
                 is omitted, since Ptolemy's son Ptolemy II is now very much in charge.";
            if( i == 8 ) 
                 "^A peça central da procissão: um enorme falo dourado enfeitado com fitas, com sessenta metros de comprimento e uma estrela gigante na ponta. Inexplicavelmente, você é a única pessoa presente que considera isso de gosto duvidoso.";
            if( i == 9 ) 
                 "^Em seguida vem uma procissão de mulheres, cada uma com o traje nacional de uma cidade-estado aliada, de todo o mundo helenístico, do norte da África à Sicília e à Ásia.";
            if( i == 10 ) 
                 "^A procissão termina como começou, com uma grande Estrela da Tarde, antes de se dissolver em uma multidão desordenada de foliões bêbados e sentimentais.";
            if( i > 10 ) 
                 "^A procissão parece continuar para sempre.";
        ],
        section T_ALEXANDRIA,
  has   light;

Object  Island_of_Pharos "Ilha de Faros"      
  with  name 'pharos' 'lighthouse' 'moon' 'circle' 'octagon' 'square' 'defences' 'causeway' 'island' 'harbour' 'faros' 'farol' 'lua' 'círculo' 'octógono' 'quadrado' 'defesas' 'calçada' 'ilha' 'porto',
        before SeaBefore,
        s_to Causeway,
         u_to "Infelizmente, não é possível subir no Faros.",
        d_to rusty_iron_grating,
         description "A ilha de Faros: o farol que deu nome aos demais, uma das Sete Maravilhas do Mundo, brilha no céu nítido sob a lua. Tem 120 metros de altura, um círculo sobre um octógono sobre um quadrado.^^Uma brisa leve sopra pelas defesas costeiras. Neste lugar, setenta e dois estudiosos traduziram pela primeira vez o Velho Testamento para o grego, tremendo sem parar se estivesse tão frio quanto agora. Uma calçada estreita atravessa o porto para o sul.",
         cant_go "A calçada é a única rota terrestre para sair da ilha.",
        each_turn [;
            if( random(5) ~= 1 ) 
                 "^Lá embaixo, uma onda bate na frente marítima e por um instante invade a parte inferior da grade.";
        ],
        daemon [;
            if( random(5) ~= 1 ) 
                rfalse;

            if( smooth_round_stone has general ) {
                Achieved(SCORE_WASH);
                move smooth_round_stone to Warehouses_and_Port;
                move rusty_iron_key to Warehouses_and_Port;
                give smooth_round_stone ~general;
                give smooth_round_stone ~moved;
                give smooth_round_stone ~concealed;
                give rusty_iron_key general;
                rusty_iron_key.initial = "Aquela chave de ferro parece ter sido trazida pela água até aqui...";
                smooth_round_stone.initial = "...e lá está a pedra estranha novamente.";
                if( location == Island_of_Pharos ) 
                    "^Uma onda espirra sob a grade, lançando a pedra estranha para cima; ela quica na grade e é levada pela passagem, para fora de vista.^^Bem, você não achou que seria tão fácil, achou?^";
            } else 
                StopDaemon(self);
        ],
        section T_ALEXANDRIA,
  has   light;

Object  -> rusty_iron_grating "grade de ferro enferrujada"       
  with  name 'rusty' 'iron' 'grating' 'seaweed' 'grate' 'rusted' 'enferrujada' 'ferro' 'grade' 'algas',
        before [;
            Receive:
                if( noun == player ) 
                     "As barras são próximas demais umas das outras.";
                if( noun == smooth_round_stone ) {
                    move noun to Island_of_Pharos;
                    give smooth_round_stone general;
                    give smooth_round_stone concealed;
                    StartDaemon(Island_of_Pharos);
                    rusty_iron_key.initial = "A chave de ferro, fora de alcance abaixo, está de algum modo colada à pedra estranha.";
                     "A pedra estranha cai pela grade e pousa no degrau superior. A chave de ferro misteriosamente se cola ao metal da pedra. Ainda está fora de alcance, porém.";
                }
                if( noun == robot_mouse ) 
                     "O rato robótico tem simplesmente o formato errado.";
                move noun to Jetty;
                 print_ret (The) noun, " cai pela grade e quica na escuridão.";
        ],
        door_to Jetty,
         when_closed "Em uma parede das defesas contra as ondas há uma grade de ferro enferrujada e coberta de algas, firmemente fechada.",
        with_key rusty_iron_key,
        door_dir d_to,
         when_open "Uma grade de ferro enferrujada e coberta de algas está aberta aqui.",
  has   door lockable locked openable static;

Object  -> rusty_iron_key "chave de ferro enferrujada"       
  with  name 'rusty' 'iron' 'key' 'enferrujada' 'ferro' 'chave',
        before [;
            Take:
                 if( rusty_iron_key hasnt general ) "Por mais que você alcance pela grade, ela continua além do alcance.";
                rfalse;
        ],
        sw_to compass,
         initial "Curiosamente, é possível ver dentro da passagem abaixo uma chave que parece servir na grade.",
         angel_hint "Ora, certamente é óbvio em que isso encaixa?",
  has   ;

Object  Jetty "Cais"    
  with  before SeaBefore,
        u_to Island_of_Pharos,
         description "Em um cais de pedra escuro, onde as águas do porto de Alexandria batem insistentes. Degraus toscos sobem para a ilha através da grade.",
        each_turn [;
            if( random(4) ~= 1 ) rfalse;
             if( player in skiff ) "^Uma onda de repente balança o bote.";
             "^Uma onda de repente bate em seus pés, até os joelhos, e sobe pelos degraus em direção à grade.";
        ],
        section T_ALEXANDRIA,
  has   light scored cat_nofollow;

Object  -> skiff "bote" 
  with  name 'skiff' 'boat' 'small' 'bote' 'barco' 'pequeno',
         initial "Um bote (um pequeno veleiro) está amarrado aqui.",
        description "Você poderia velejar para longe facilmente: onde terminaria dependeria das marés e da brisa noturna, pois não faz ideia de como conduzir um leme ou ajustar uma vela.",
  has   container enterable light open static;

Object  -> -> adamantine_heart "coração de adamantino"        
  with  name 'adamantine' 'heart' 'adamant' 'adamantino' 'coração',
        initial "Um coração de adamantino está no bote.",
        description "Um cardioide do tipo preferido por cartões de Dia dos Namorados, não por cirurgiões.^^Ele lembra estranhamente uma das peças simbólicas do Banco Imobiliário: o navio, o chapéu e assim por diante.",
        article "an",
        angel_hint "Deve haver mais alguma coisa em algum lugar sobre esta figura maravilhosa.",
  has   ;

Object  Harbour_Mouth "Boca do porto"    
  with  before [;
            Exit, Swim: "A calma sepulcral do oceano domina você, e só é possível observar e velejar.";
        ],
        description "Enquanto o bote passa pela entrada do Porto Real, sob a grande luz de Faros, você tem uma última visão da civilização de Alexandria se afastando: à frente estendem-se o vasto Mediterrâneo, calmo como óleo, e o luar sobre as águas.",
        cant_go "O bote não está sob seu controle.",
        each_turn [;
            if( Harbour_Mouth has general ) {
                print "^As velas enfunam e depois afrouxam...^";
                move skiff to Drifting;
                location = Drifting;
                << Look >>;
            } else
                give Harbour_Mouth general;
        ],
        section T_ALEXANDRIA,
  has   light cat_nofollow;

Object  Drifting "À deriva"      
  with  name 'curious' 'fish' 'zephyr' 'sea',
        before [;
            Exit, Swim: "A calma sepulcral do oceano domina você, e só é possível observar e velejar.";
        ],
        description "Você deriva no amplo e tranquilo mar Lunar. Peixes curiosos, com olhos amarelo-esverdeados brilhando sob as ondulações prateadas, passam por sua esteira: a brisa noturna está quase parada, mas você continua à deriva. Minutos passam como horas no paraíso.",
        cant_go "Você sente apenas uma calma semelhante à de uma droga.",
        each_turn [;
            print "^A luz se intensifica até virar dia. O bote deriva, deriva sobre...^";
            move skiff to Garden_Stream;
            location = Garden_Stream;
            << Look >>;
        ],
        section T_ALEXANDRIA,
  has   light cat_nofollow;

Object  Crossroads "Encruzilhada"  
  with  name 'procession' 'tower' 'procissão' 'torre',
        before [;
            Go:
                if( noun == ne_obj && cloak_of_many_colours has worn ) {
                    print "A procissão alegremente acomoda mais um lunático vestido de modo extravagante.^";
                    rfalse;
                }
                if( noun == nw_obj or sw_obj or se_obj ) {
                    rfalse;
                }
                "É impossível atravessar a enorme procissão que lota as grandes ruas de Alexandria. É melhor apenas apreciar o espetáculo.";
        ],
        ne_to Outside_the_Royal_Museum,
        se_to A_Tower,
        nw_to Causeway,
        sw_to Necropolis,
        description "A grande encruzilhada no coração de Alexandria, em forma de clâmide, a maior cidade do mundo civilizado. A estrada noroeste-sudeste vai da calçada até a torre; a estrada principal segue a sudoeste do portão da Necrópole e a nordeste até os grandes edifícios públicos da cidade.",
        section T_ALEXANDRIA,
  has   light;

Object  Necropolis "Necrópole"  
  with  s_to XIIth_Dynasty_Pyramid,
        ne_to Crossroads,
        d_to nothing,
        description "Um vale espaçoso, sombrio, magnífico e iluminado pela lua, cheio de túmulos, alguns recém-construídos, logo fora das muralhas de Alexandria (a nordeste). Já é antigo. A maioria das pequenas pirâmides em forma de cupinzeiro foi invadida repetidas vezes: de fato, a entrada de uma pirâmide está escancarada ao sul.",
        cant_go "Este não é lugar para vagar depois de escurecer.",
        section T_ALEXANDRIA,
  has   light;

Object  -> birds_of_prey "aves de rapina" 
  with  name 'birds' 'of' 'prey' 'aves' 'rapina',
        initial "Aves de rapina circulam alto no céu noturno, suas garras brilhando ao luar.",
        article "some",
  has   static;

Object  unexciting_tombstone "lápide sem graça"      
  with  name 'tomb' 'tombstone' 'stone' 'unexcitin' 'face' 'socket' 'steps' 'mouth',
        before [;
            Receive:
                if( noun ~= gleaming_amber_gem ) "Não parece encaixar.";
                if( unexciting_tombstone has open ) "O quê?";
                unexciting_tombstone.description = "Uma gema de âmbar brilha na boca de seu rosto.";
                give unexciting_tombstone open;
                trigger_quotation(25);
                move gleaming_amber_gem to unexciting_tombstone;
                "O âmbar se encaixa perfeitamente na boca do rosto de pedra, e algo se move sob seus pés... você cai para trás, agitando os braços. Quando se levanta, vê um pequeno lance de degraus descendo. Você abriu o túmulo!";
        ],
        door_to The_Height_of_Fashion,
        when_closed "Você está perto da lápide para a qual as aves de rapina foram atraídas de modo tão inexplicável.",
        door_dir d_to,
        when_open "Você está perto da lápide, que se tornou bem mais interessante agora que surgiu um lance de degraus para baixo.",
        description "Ela traz apenas uma palavra de epitáfio: ~GALITA~. Abaixo há um rosto curioso, com uma cavidade vazia e aberta no lugar da boca.",
  has   door static;

class   Cloak
  with  angel_hint "Tem certeza de que não está do avesso?",
        before [;
            Turn, SwitchOn:
                if( noun has worn ) "Não enquanto você estiver usando isso.";
                if( noun notin player ) "Você precisa estar segurando isso.";
                if( noun == cloak_of_many_colours ) {
                    move grey_cloak to player;
                    remove cloak_of_many_colours;
                    itobj = grey_cloak;
                } else {
                    move cloak_of_many_colours to player;
                    remove grey_cloak;
                    itobj = cloak_of_many_colours;
                }
                "Você vira o manto do avesso.";
        ],
  has   clothing;

Cloak   cloak_of_many_colours "manto de muitas cores"    
  with  name 'of' 'many' 'colours' 'cloak' 'coat' 'chlamys',
        initial "Um manto de muitas cores está dobrado sobre ele.",
        description "Um belo manto forrado de cinza e incrustado de safiras, ondulado por tecidos de arco-íris vindos das rotas comerciais do mundo.";

Cloak   grey_cloak "manto cinzento"  
  with  name 'grey' 'cloak' 'coat' 'chlamys',
        description "Um belo manto cinzento, incrustado de safiras e forrado com tecidos de arco-íris vindos das rotas comerciais do mundo.";

Object  XIIth_Dynasty_Pyramid "Pirâmide da XII Dinastia"    
  with  before [;
            Smell:
                "Por que você só sente cheiros intensos em lugares desagradáveis? O odor é repulsivo, de um jeito que lembra cupins e mel.";
        ],
        n_to Necropolis,
        description "Saqueado, mal iluminado, apertado e vazio, este túmulo rudimentar e irregular está para as Grandes Pirâmides de Gizé (construídas apenas um século antes) como o caramanchão de seu jardim está para o Castelo de Windsor. Há apenas inscrições pintadas sem graça, um odor desagradável e uma passagem para o norte.",
        section T_ALEXANDRIA,
  has   light cat_nofollow;

LagachObj  -> painted_writings "inscrições pintadas"   
  with  name 'painted' 'paintings' 'writing' 'writings',
        description "Um dos chamados Textos das Pirâmides que compõem o chamado ~Livro dos Mortos~. Esta passagem dramática parece dedicada a sábios preparando seus corpos para ressurgir na vida após a morte, ungindo-se com óleo. Um motivo interessante de dez traços, disposto assim^^   III IIIIII I^^, chama a atenção.",
        article "some",
  has   scenery;

Object  The_Height_of_Fashion "O auge da moda"    
  with  name 'table' 'panelling' 'doorway' 'door',
        before [;
            Sleep:
                if( player in wooden_couch ) {
                    print "As pesadas esteiras trançadas são tão confortáveis que você desliza para...^";
                    The_Spirit_World.number = 1;
                    PlayerTo(The_Spirit_World);
                    rtrue;
                }
                rfalse;
        ],
        w_to [;
            if( player notin location ) "Primeiro, levante-se.";
            print "Para sua ligeira surpresa, as esfinges não fazem esforço para impedi-lo.^";
            return This_Is_The_Death;
        ],
        u_to Necropolis,
        description "Uma sala perfeitamente cortada em granito cor-de-rosa, com quatro metros de largura, pintada de amarelo e marrom para imitar painéis de alabastro. Este é o que há de mais moderno em apartamentos funerários.^^Há um divã para visitantes, uma mesa, um lance de degraus para cima e uma porta a oeste, ladeada por duas esfinges de pedra.",
        section T_ALEXANDRIA,
  has   scored cat_nofollow;

Object  -> sphinxes "esfinges"   
  with  name 'sphinx' 'sphinxes' 'stone' 'statue' 'statues' 'esfinge' 'esfinges' 'pedra' 'estátua' 'estátuas',
        initial "As esfinges parecem encarar você ameaçadoramente.",
        description "Nenhum túmulo estaria completo sem uma delas.",
        article "two",
  has   static;

Object  -> wooden_couch "divã de madeira"   
  with  name 'wood' 'wooden' 'couch' 'bed' 'weave' 'matting' 'madeira' 'divã' 'cama' 'trançado' 'esteira',
        description "Um divã de madeira de aparência confortável, coberto por esteiras trançadas.",
  has   enterable scenery supporter;

Object  stone_nose_of_a_sphinx "nariz de pedra de uma esfinge"  
  with  name 'stone' 'nose',
        before [;
            Push, Pull: "É feito de pedra, você sabe.";
            Turn:
                if( player notin location ) "Você não consegue alcançar a partir do divã.";
                if( marble_wall has open ) give marble_wall ~open;
                else give marble_wall open;
                Achieved(SCORE_SPHINX);
                "Você torce o nariz e, antes que ele volte ao lugar, ouve-se um estrondo de pedra vindo de baixo.";
        ],
        initial "É preciso dizer que uma das esfinges tem um nariz bastante proeminente.",
        description "Esplêndido.",
  has   static;

Object  The_Spirit_World "O mundo espiritual"      
  with  name 'table' 'panelling' 'doorway' 'door' 'mesa' 'painéis' 'porta',
        before [;
            Go:
                if( noun == w_obj ) rfalse;
                if( The_Spirit_World.number == 4 ) 
                    "De algum modo, você não consegue sair do túmulo. Seu espírito ainda está ancorado ao corpo, adormecido dois mil anos atrás.";
                    "O túmulo está selado, aparentemente para sempre.";
            Take, Drop, Inv, Empty, Remove, Insert:
                "Você está além das posses mundanas.";
            Sleep:
                if( player in spirit_wooden_couch ) {
                    if( The_Spirit_World.number == 4 ) {
                        "O feitiço do túmulo foi quebrado, e você não pode dormir.";
                    }
                    print "As pesadas esteiras trançadas atraem você cada vez mais para...^";
                    The_Spirit_World.number = The_Spirit_World.number + 1;
                    PlayerTo(The_Spirit_World);
                    rtrue;
                }
                rfalse;
        ],
        after [ i;
            Look:
                i = The_Spirit_World.number;
                if( i == 1 ) "^O túmulo parece mais antigo agora, esmagado sob séculos.";
                if( i == 2 ) "^O túmulo agora sufoca de calor, com mil anos de idade.";
                if( i == 3 ) "^O túmulo está belamente bem preservado, mas parece bastante antigo.";
                if( i == 4 ) {
                    print "^A esta altura, o túmulo pode ter dois mil anos.^";
                    if( Napoleonic_officers in The_Spirit_World ) 
                        "^E finalmente ele foi aberto.";
                }
        ],
        w_to [;
            print "Os espíritos das esfinges rondam a porta, com as patas erguidas, e então avançam contra você. Suas garras rasgam sua pele, arrancando uma camada e desembrulhando você de um modo curiosamente indolor... e você desperta...^";
            if( The_Spirit_World.number == 1 ) {
                move player to wooden_couch;
                location = The_Height_of_Fashion;
            } else {
                The_Spirit_World.number = The_Spirit_World.number - 1;
                move player to spirit_wooden_couch;
                remove Napoleonic_officers;
            }
            << Look >>;
        ],
        description "Uma sala perfeitamente cortada em granito cor-de-rosa, com quatro metros de largura, pintada de amarelo e marrom para simular painéis de alabastro, ao pé de um lance de degraus que leva apenas a uma parede selada.",
        number 1,
        each_turn [;
            if( The_Spirit_World.number < 4 ) rfalse;

            ++SpiritCnt;
            if( SpiritCnt == 2 ) print "^A entrada do túmulo estremece.^";
            if( SpiritCnt == 3 ) print "^O ruído aumenta, e poeira cai das rachaduras na alvenaria.^";
            if( SpiritCnt == 4 ) {
                print "^A entrada explode aberta em uma chuva de reboco! A luz entra, queimando seus olhos. Há uma grande comoção. Dois oficiais franceses napoleônicos descem as escadas com lanternas nas mãos, admirando o pátio. Eles parecem não ver você.^";
                move Napoleonic_officers to The_Spirit_World;
            }
            if( SpiritCnt == 5 ) 
                print "^Os oficiais ficam fascinados pelo modo como o túmulo parece quase intocado, e ainda assim o divã parece ter sido usado.^";
            if( SpiritCnt == 6 ) 
                print "^Os oficiais olham pela passagem e descobrem que ela está selada.^";
            if( SpiritCnt == 7 ) 
                print "^Os oficiais sentam-se ao lado das esfinges, acariciando os bigodes em perplexidade cômica. Enquanto fazem isso, um bate a cabeça em um nariz de pedra.^";
            if( SpiritCnt == 8 ) 
                print "^O outro oficial se diverte muito com essa palhaçada. (Você realmente começa a perceber como os vivos podem ser entediantes.)^";
            if( SpiritCnt == 9 ) {
                print "^O primeiro oficial torce carinhosamente o nariz da esfinge. De repente, ouve-se um grande estrondo de pedra vindo da passagem abaixo, e eles descem correndo para investigar!^";
                remove Napoleonic_officers;
                give sphinxes general;
                move stone_nose_of_a_sphinx to The_Height_of_Fashion;
            }
        ],
        section T_SPIRIT_WORLD,
  has   light scored;

Object  -> spirit_sphinxes "esfinges"   
  with  name 'sphinx' 'sphinxes' 'stone' 'statue' 'statues',
        initial "Esfinges de pedra guardam a porta oeste, encarando você ameaçadoramente.",
        description "Nenhum túmulo estaria completo sem uma delas.",
  has   static;

Object  -> spirit_wooden_couch "divã de madeira"   
  with  name 'wood' 'wooden' 'couch' 'bed' 'weave' 'matting',
        initial "As esteiras trançadas do divã agora estão um tanto desarrumadas.",
        description "Um divã de madeira de aparência confortável, coberto por esteiras trançadas.",
  has   enterable scenery supporter;

Object  Napoleonic_officers "oficiais napoleônicos"        
  with  name 'napoleoni' 'officers' 'soldiers' 'officer' 'soldier' 'lanterns',
        life [;
            Kiss, Attack: "Seu corpo passa através deles.";
            Order, Ask, Answer: "Eles não ouvem nada.";
        ],
        initial "Dois oficiais napoleônicos permanecem maravilhados enquanto a luz de suas lanternas ilumina as riquezas do túmulo.",
        description "Os oficiais usam os uniformes da ocupação do delta do Nilo pelo imperador em 1798 e carregam belas lanternas de latão.",
        article "two",
  has   animate;

Object  This_Is_The_Death "Isto é a morte"    
  with  name 'painted' 'scenes' 'glass' 'ornaments',
        e_to The_Height_of_Fashion,
        w_to marble_wall,
        u_to The_Height_of_Fashion,
        d_to marble_wall,
        description "A passagem, descendo do leste para o oeste, é escavada no mármore, revestida de cenas pintadas das comédias elegantes de Menandro e decorada com ornamentos de vidro colorido alexandrino.^^A expressão ~Você não pode levar isso consigo~ não parece popular por aqui.",
        cant_go "Apenas uma passagem de leste a oeste.",
        section T_ALEXANDRIA,
  has   cat_nofollow;

Object  -> model_of_ugly_animal "modelo de um animal tão feio que você não suporta olhar"        
  with  name 'model' 'animal' 'ugly' 'monkey',
        initial "Apesar da decoração de bom gosto, o modelo de animal mais horrivelmente feio que você já viu está em uma pequena prateleira aqui.",
        description "Você simplesmente não suporta olhar. Talvez seja um macaco... pelo menos tem uma cauda... Não. Não, você precisa desviar o olhar.",
        short_name [;
            if( self hasnt general ) rfalse;
            print "modelo de um macaco de aparência travessa, que se contorce ao ganhar vida";
            rtrue;
        ],
        devil_hint "Exquisito. Simplesmente encantador.",
        angel_hint "Ora essa.",
  has   ;

Object  -> marble_wall "parede de mármore"     
  with  name 'marble' 'wall',
        door_to Quite_an_Undertaking,
         when_closed "Infelizmente, a passagem desce apenas até uma parede sólida de mármore.",
        door_dir d_to,
         when_open "A passagem se abre para a câmara funerária abaixo.",
  has   door static;

Object  Quite_an_Undertaking "Um empreendimento e tanto"      
  with  before [;
            Exit:
                if( player in mummy_case ) {
                    print "(That's a relief.)^";
                    rfalse;
                }
                rfalse;
            Go:
                if( player in mummy_case ) {
                print "(Você está tão distraído que o bom senso assume o controle e você sai do caixão de múmia.)^";
                    << Exit >>;
                }
                if( noun == n_obj or ne_obj ) {
                    if( second_socket hasnt general ) {
                        move quarterstaff to Quite_an_Undertaking;
                        give second_socket general;
                        "A passagem parece interminável, e você é obrigado a recuar antes que o ar acabe. Ao fazê-lo, tropeça em algo, praguejando baixinho.";
                    }
                    "A passagem parece interminável e você recua.";
                }
                rfalse;
            Close:
                rfalse;
            default: 
                if( player notin mummy_case )
                    rfalse;
                print "(Você está tão distraído que o bom senso assume o controle e você sai do caixão de múmia.)^";
                move player to parent(mummy_case);
                location = parent(player);
        ],
        e_to This_Is_The_Death,
        u_to This_Is_The_Death,
        description "Uma câmara funerária realmente luxuosa, muito abaixo do pátio de entrada.^^Um canal quadrado de um metro de largura segue ligeiramente a leste do norte, em uma passagem aparentemente interminável e baixa.^^Na parede oeste há três cavidades curiosas, acima de uma pintura de um sacerdote do faraó semimítico Sosóstris, em trajes cinzentos completos e portando o cetro.",
        cant_go "A passagem sobe abruptamente para leste.",
        section T_ALEXANDRIA,
  has   scored cat_nofollow;

Object  -> painting_of_the_priest "pintura do sacerdote"       
  with  name 'painting' 'of' 'priest' 'sosostris',
         description "Desenhada no estranho estilo preferido pelos egípcios, que acreditavam em ângulos ideais em vez de desenhos precisos. O cetro, com apenas metade do tamanho dos grandes que você viu no Museu Britânico, parece estranhamente familiar.^^Tão perto da parede, você nota palavras escritas acima das três cavidades.",
  has   scenery;

Object  -> mummy_case "caixão de múmia"       
  with  name 'mummy' 'case' 'lid' 'sarcophagus' 'coffin',
        before [;
            Open:
                if( self hasnt open ) "A tampa deve pesar uma tonelada. Você não consegue movê-la.";
                "O caixão já está aberto.";
            Close:
                if( noun == self && noun has open && player in self ) {
                    if( MummyWarning == false ) {
                        MummyWarning = true;
                        "Essa parece uma decisão terrivelmente... definitiva. Esta é uma chance de reconsiderar.";
                    }
                    print "A tampa cai sobre você com um som realmente definitivo.^^^   *** Você tem...^^^Mas algo mais está acontecendo. O equilíbrio delicado do caixão foi alterado, e ele desliza pela passagem quadrada, sem parar, sem parar...^^E nem isso é o fim, pois de repente você bate em amortecedores em uma das extremidades. Que fuga afortunada, você pensa... por um momento...^";
                    PlayerTo(Buried_Alive);
                    rtrue;
                }
                if( self has open ) "Não faça isso. Depois de fechado, ele nunca mais abriria.";
                "O caixão, para dizer o mínimo, já está fechado.";
            Enter:
                if( mummy_case hasnt open ) "Está fechado.";
                print "(Você não consegue evitar a sensação de que alguém planejou tudo isso... e não foi você.)^^";
                rfalse;
        ],
        initial "Um belo caixão de múmia, ou sarcófago, dourado e azul, repousa pesadamente aqui.",
        description "Dourado, azul-pavão, suavemente curvo, imensamente pesado, belo. E definitivo, e morto.",
  has   enterable static container;

class   TombSocket
  with  description [;
            print "Above ", (the) self, " is the single word ~";
            EtruscanInt(self.number);
            "~.";
        ],
        number 1,
        before [;
            Receive:
                if( noun == model_golden_sceptre ) {
                    model_golden_sceptre.number = self;
                    if( self == first_socket ) {
                        model_golden_sceptre.initial = "O cetro se projeta da primeira cavidade como uma alça.";
                    }
                    if( self == second_socket ) {
                        model_golden_sceptre.initial = "O cetro se projeta da segunda cavidade como uma alça.";
                    }
                    if( self == third_socket ) {
                        model_golden_sceptre.initial = "O cetro se projeta da terceira cavidade como uma alça.";
                    }
                    move model_golden_sceptre to Quite_an_Undertaking;
                    give model_golden_sceptre ~moved;
                    "Ele se encaixa perfeitamente (não é mesmo?).";
                } else 
                    "Não parece se encaixar.";
        ],
        article "the",
  has   scenery;

TombSocket -> first_socket "first socket"   
  with  name 'first' 'socket' 'sockets' 'words';

TombSocket  -> second_socket "second socket" 
  with  name 'second' 'socket' 'sockets' 'words';

TombSocket  -> third_socket "third socket"   
  with  name 'third' 'socket' 'sockets' 'words';

Object  Buried_Alive "Enterrado vivo"      
  with  before [;
            Look, Wait, Inv, Sleep: rfalse;
            Go:
                if( mummy_case hasnt general || noun ~= u_obj )
                    "Não há para onde ir.";
                if( self has general )
                    "^Seu espírito, depois de já ter enganado a morte uma vez, é sobrecarregado por sua vida dupla e não se difundirá novamente.";
                give self general;
                Achieved(SCORE_AFTERLIFE);
                move adamantine_skull to player;
                print "^Seu espírito se ergue, preparado como estava para a vida após a morte, e se difunde através do ouro maciço do caixão por pura força de vontade, finalmente começando a se recompor. Você cambaleia, confuso, por cavernas escuras até finalmente chegar à luz, segurando algo sólido...^";
                rfalse;
            default: "Há pouquíssimo espaço, e o ar está acabando.";
        ],
        u_to Sarcophagus,
        description "Você está deitado no caixão de múmia, com os braços cruzados, o rosto contraído, ficando rapidamente sem ar e com quase nenhum espaço para se mover. A tampa do caixão é cerca de dez vezes mais pesada que você, e seu selo é muito firme.",
        number 5,
        each_turn [ i;
            i = Buried_Alive.number - 1;
            Buried_Alive.number = i;
            if( i == 0 ) {
                deadflag = DIED;
                "^O ar acaba e você morre. Poucos cadáveres são tão atenciosos a ponto de se enterrarem antecipadamente; espero que esse pensamento sirva de consolo.";
            }
            if( i == 3 ) "^Você começa a sufocar e ofegar.";
            if( i == 1 ) "^O ar está desesperadamente rarefeito agora, e você luta sem esperança.";
        ],
        section T_ALEXANDRIA,
  has   light cat_nofollow;

