Object  -> gambling_sailor "marinheiro jogador"     
  with  name 'sailor' 'gambling' 'gambler' 'grizzled',
        before [;
            Gamble: << Drop inscribed_die >>;
        ],
        life [;
            Order, Ask, Answer: "Você não consegue entender seu discurso gutural, mas o dado parece ser sua única fascinação.";
            Kiss: "Sim, gente como você pode ser encontrada nas docas da maioria dos portos.";

            ! Bug: I'm pretty sure Graham meant ##Attack here
            Answer: "Ele é mais corpulento que você.";
        ],
        initial "Um marinheiro grisalho está sentado a uma mesa à beira do porto.",
        each_turn [ n;
            if( gambling_sailor has general ) {
                n = random(5);
                if( n < 3 ) {
                    print "^O marinheiro pega o dado e joga um ~";
                    n = random(6);
                    if( gambling_sailor has lucky || inscribed_die has lucky ) {
                        n = 6;
                    }
                    EtruscanInt(n);
                    print "~, ";
                    if( n > inscribed_die.number ) {
                        print "e sorri.^";
                    }
                    if( n < inscribed_die.number ) {
                        print "e suspira.^";
                    }
                    if( n == inscribed_die.number ) {
                        print "e dá de ombros.^";
                    }
                    inscribed_die.number = n;
                    give gambling_sailor ~general;
                } else {
                    "^O marinheiro encara o dado pensativamente.";
                }
            } else
                "^O marinheiro cantarola uma canção do mar.";
        ],
  has   animate;

[ EtruscanInt i ;       
    switch( i ) {
        1: print "thu";
        2: print "zal";
        3: print "si";
        4: print "ca";
        5: print "mach";
        6: print "huth";
    }
    rtrue;
];

Object  -> inscribed_die "dado inscrito" 
  with  name 'inscribed' 'die' 'dice' 'cube',
        before [ i;
            Take:
                "O marinheiro o cobre com a mão. Mas ele parece do tipo que nunca recusa um jogo.";
            Examine:
                print "Cada lado tem uma palavra inscrita. A palavra no topo é ~";
                EtruscanInt(self.number);
                "~.";
            Drop, ThrowAt, Gamble:
                i = random(6);
                if( inscribed_die has lucky ) {
                    i = 6;
                }
                give gambling_sailor general;
                inscribed_die.number = i;
                print "Você joga um ~";
                EtruscanInt(i);
                "~, seja lá o que isso signifique.";
        ],
        initial "Um dado de seis lados com inscrições está sobre a mesa diante dele.",
        description "Os lados que você consegue ver estão marcados com palavras curtas.",
        article "an",
        number 3,
  has   static;

Object  The_Birdcage_of_the_Muses "A gaiola das musas"    
  with  name 'little' 'door' 'books',
        s_to Oil_Room,
        e_to Reading_Corridor,
        se_to Geography_Room,
        nw_to Outside_the_Royal_Museum,
        description "A célebre Biblioteca de Alexandria, a melhor do mundo inteiro, possui centenas de milhares de livros: é onde os Ptolomeus governantes mantêm quase presos estudiosos fanáticos e briguentos enquanto produzem comentários rivais sobre os poemas antigos, daí o apelido.^^Há uma portinha ao sul; um corredor empoeirado a sudeste; uma passagem a leste e uma entrada grandiosa a noroeste.",
        number 0,
        each_turn [ i;
            i = The_Birdcage_of_the_Muses.number;
            if( i == 3 ) {
                print "^Um menino mensageiro de túnica branca simples entra sorrateiramente na biblioteca e coloca alguns tubos no nicho de pombos. Tão ressentido está por perder a festa lá fora que não nota você e sai correndo imediatamente.^";
                move tube_with_an_alpha_on to pigeonhole;
                move tube_with_a_kappa_on to pigeonhole;
            }
            if( i < 4 )
                The_Birdcage_of_the_Muses.number = i + 1;
        ],
        section T_ALEXANDRIA,
  has   light scored;

Object  -> pigeonhole "nicho de pombos"       
  with  name 'pigeon' 'hole' 'pigeonhol',
         initial "Há um nicho de pombos instalado em uma parede.",
         description "Um depósito para pergaminhos.",
  has   container open static;

Object  tube_with_an_alpha_on "tubo com um alfa"    
  with  name 'alpha' 'with' 'tube' 'cylinder',
         description "Um tubo oco e aberto nas extremidades, marcado com um Alfa maiúsculo grego.",
        parse_name TubeParse,
         angel_hint "Certamente isto é endereçado a alguém?",
  has   container open;

[ TubeParse i j w len cnt;
     if( parser_action==##TheSame ) {   
          if( (parser_one.&name)-->0 == (parser_two.&name)-->0 ) 
              return -1;
          return -2;
     }
     len = (self.#name)/2;

     for( w = NextWord() : w : w = NextWord() ) {
         j = false;
         for( i=0: i < len : i++ ) {
             if( w == 'tubes' )
                 parser_action = ##PluralFound;
             else if( w == self.&name-->i )
                 j = true;
         }
         if( j == false )
             return cnt;
         else
             cnt++;
     }
     return cnt;
];

[ ScrollParse i j w len cnt;
     if( parser_action==##TheSame ) {   
          if( (parser_one.&name)-->0 == (parser_two.&name)-->0 ) 
              return -1;
          return -2;
     }
     len = (self.#name)/2;

     for( w = NextWord() : w : w = NextWord() ) {
         j = false;
         for( i=0: i < len : i++ ) {
             if( w == 'scrolls' )
                 parser_action = ##PluralFound;
             else if( w == self.&name-->i )
                 j = true;
         }
         if( j == false )
             return cnt;
         else
             cnt++;
     }
     return cnt;
];

