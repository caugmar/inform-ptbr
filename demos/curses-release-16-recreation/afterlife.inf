Array demon_topics -->
    2 'premonition' 'dream'
        "~Na premonição, é vital obter o mascote para usá-lo mais tarde.~"
    2 'torch' 'battery'
        "~Não adianta procurar pilhas novas para a lanterna no chão do sótão, porque não há nenhuma.~"
    3 'aunt' 'jemima' 'gloves'
        "~Sua tia Jemima não é o tipo de mulher que se distrai com música ou presentes frívolos, pode acreditar.~"
    3 'romance' 'novel' 'marie'
        "~Romances, é claro, invariavelmente são escritos por pessoas usando seus nomes verdadeiros, sem disfarce algum.~"
    3 'daisy' 'daisychain' 'daisies'
        "~O fato sobre as margaridas é que elas são iguais o ano inteiro, sem mudar com o calendário.~"
    'medicine'
        "~Frascos de remédio modernos podem até resistir a quedas de grande altura. Eu tentaria o calor, se fosse você.~"
    'demijohn'
        "~Você consegue segurar facilmente o garrafão com as mãos nuas.~"
    'bottle'
        "~A resposta é a mesma, qualquer que seja a garrafa que você quis dizer. Isso conta como sua dica, receio. Não é muito justo, mas eu sou um demônio.~"
    'heaven'
        "O demônio reconhece a pergunta, mas não consegue falar do Céu."
    'hell'
        "~Inferno? Ah, este não é o seu tormento eterno, é o meu, tendo de responder a todas estas perguntas miseráveis. Não, o próprio Inferno é um lugar maravilhoso, e também tem uma excelente academia. Espero vê-lo por lá.~"
    2 'card' 'postcard'
        "~Não se preocupe, não há nada escrito ali. Não é preciso olhar o problema sob uma nova luz.~"
    3 'ghost' 'sir' 'joshua'
        "~A história nunca se repete, então não adianta procurá-lo no livro.~"
    2 'prayer' 'isaac'
        "~As coisas realmente interessantes estão no começo da vida profissional dele.~"
    4 'museum' 'arcana' 'doktor' 'stein'
        "~Esqueça, não há como voltar do museu, e o remédio do Doutor Stein não tem antídoto.~"
    2 'merlyn' 'merlin'
        "~Merlyn não entra realmente nisso. Tente trabalhar em outra coisa.~"
    'hat'
        "~Literalmente, o chapéu de verdade de Merlyn. Feltro verde e pontudo, eu não duvidaria.~"
    'book'
        "~A resposta é a mesma, qualquer que seja o livro que você quis dizer. Isso conta como sua dica, receio. Não é muito justo, mas eu sou um demônio.~"
    'ebenezer'
        "~Ebenezer? Ele é absolutamente central nisso. Concentre-se nele, sem dúvida.~"
    3 'projector' 'slide' 'cards'
        "~O problema das fotos de férias é que, quando alguém liga o velho projetor de slides, um tempo entediante está nas cartas para todos.~"
    2 'rod' 'rods'
        "~Você precisará estar bem acordado e atento para descobrir o que fazer com elas. Encontrá-las é fácil: basta ficar de olho em coisas curtas e gordas.~"
    2 'tarot' 'sosostris'
        "~Clarividentes são especialistas em detectar baralhos marcados, então não adianta trapacear.~"
    2 'boat' 'hollow'
        "~Flebas oferece um serviço muito mal divulgado, receio. Não tenho tempo para ele.~"
    3 'mouse' 'robot' 'hole'
        "~Quando o rato estiver no buraco, esqueça; ele não poderia ouvi-lo nem se você falasse com o buraco. Mas há um método alternativo.~"
    'key'
        "~A culpa é sua por deixar a chave entrar nos alicerces: nada consegue entrar lá para recuperá-la.~"
    2 'radio' 'wireless'
        "~Maravilhosa, maravilhosa engenhoca. Começa no momento em que você a liga, e depois só há clássicos de ouro maciço. Dá para se concentrar de verdade quando isso está tocando.~"
    2 'fireplace' 'chimney'
        "~O quê, a velha lareira bloqueada que não leva a lugar nenhum? Você precisa carregar bastante equipamento para descer por ela; não se preocupe se estiver escuro no fundo, afinal não há nada que possa fazer quanto a isso.~"
    2 'sandstone' 'recess'
        "~O nicho de arenito provavelmente é intransponível. É melhor tentar apenas quando estiver bem acordado.~"
    2 'austin' 'cat'
        "~Austin é um demônio perfeito, não é? Ela, quero dizer. Não serve para nada além de atrapalhar, é claro. Entra nas paredes justo quando você não quer, mas pelo menos Jemima a acalma.~"
    3 'smoke' 'detector' 'alarm'
        "~Detectores de fumaça como o seu são especialmente preparados para não disparar com feixes acidentais de luz.~"
    'ship'
        "~É claro que o navio é grande e desajeitado demais para caber na garrafa.~"
    'flag'
        "~Pobre consolo.~"
    2 'alison' 'bed'
        "~Um bom cobertor talvez seja uma cobertura simples e sem cor, sem nenhum emblema.~"
    'revolving'
        "~O detalhe da porta giratória é que você só pode girá-la quando já está dentro dela.~"
    2 'cabinet' 'glass'
        "~Vidro inquebrável.~" 'matchbook'
        "~Uma pista vital, e útil por si só.~"
    'curses'
        "~O melhor jogo de computador de todos os tempos. Tenho orgulho de fazer parte dele.~"
    'tera'
        "O demônio cora. ~Não foi culpa minha! Meu parceiro fez uma bagunça.~"
    "";

Array angel_topics --> 3 'heaven' 'yourself' 'herself' "~Céu? Ah, este não é o seu paraíso eterno, é o meu, podendo servir ao responder a todas estas perguntas deliciosas. Não, o próprio Céu é um lugar maravilhoso e também tem uma excelente academia. Espero vê-lo por lá.~" 2 'hell' 'demon' "O anjo reconhece a pergunta, mas não consegue falar do Inferno." 'rods' "~As hastes certamente se encaixam em algum lugar de tudo isso.~" 'maze' "~Se ao menos você pudesse ter estado lá quando o labirinto foi traçado!~" 'master' "~O jogo mestre é como um ponto no infinito para nós mortais,~ diz o anjo melancolicamente." 3 'infinity' 'lemniscus' 'arc' "~Tudo depende de encaixar as hastes em algum lugar.~" 3 'andromeda' 'princess' 'maiden' "~Como ela deve desejar soltar os cabelos agora, em vez de ficar acorrentada àquela rocha,~ diz o anjo com tristeza. ~Mas, em respeito aos desejos dela, não posso ajudá-lo a resgatá-la.~" 'mural' "~Você deve ter uma sorte incrível para encontrá-lo, posso dizer.~" 'folly' "~Ah sim, todos devemos lamentar a tolice humana,~ diz o anjo, entendendo tudo completamente errado." 'zeus' "~Zeus não era um deus verdadeiro, é claro,~ insiste previsivelmente o anjo, ~apenas uma manifestação das leis da física para um grego antigo, uma espécie de símbolo de como o universo funcionava fundamentalmente.~" 2 'bomb' 'lighthouse' "O anjo mantém um silêncio obstinado." 'sacrifice' "~É claro que essa haste é perigosa demais para ser usada, e a Igreja já não aprova mártires.~" 'luck' "~Será que existe mesmo algo como sorte ou livre-arbítrio? É uma área teológica cinzenta,~ diz o anjo com fina casuística." 'fire' "~Certamente um problema espinhoso.~" 5 'mascot' 'old' 'evans' 'moon' 'racing' "~O velho Evans nunca daria o mascote por vontade própria.~" 2 'ugly' 'idol' "~É preciso refletir sobre uma feiura dessas.~" 3 'gold' 'golden' 'watch' "~É hipnoticamente fascinante, não acha?~" 4 'squirrel' 'loose' 'board' 'summerhou' "~Esquilos adoram nozes, mas não se pode confiar neles nem um pouco.~" 'spade' "~Imagine o que isso faria com um gramado decente! Ah, fico arrepiado só de pensar.~" 2 'croquet' 'lawn' "~Para que serviria um gramado de croqué, senão para jogar croqué? Embora, pensando bem, haja outra coisa lá embaixo.~" 2 'anoppe' 'eppona' "~Ah yes, a code word understood by certain of Alexander the Great's slaves. But you'd have to be in the right place at the right time.~" 2 'tombstone' 'tomb' "~A boca é a chave, ou melhor, a fechadura.~" 2 'sphinx' 'sphinxes' "~Tenha cuidado. As esfinges são apenas de pedra, mas poderiam facilmente causar pesadelos.~" 2 'couch' 'couches' "~Alguns desses leitos funerários são muito confortáveis.~" 5 'skiff' 'yacht' 'boat' 'coffin' 'mummy' "~Uma viagem só de ida, mas é a vida.~" 2 'adamantine' 'knight' "~Once fired with life, the knight will only be yours to command when he has discharged his chivalric duty.~" 2 'hand' 'head' "~Some of those ancient knights were rather loose, but perhaps that's better than being screwed up.~" 2 'library' 'portico' "~A Grande Biblioteca não é para arruaceiros de passagem, sabe,~ says diz o anjo em tom de reprovação. ~Além disso, os guardas entendem bem demais seu dever para com o Deus Gato para deixá-lo passar.~" 3 'librarian' 'apollonius' 'callimachus' "~Eles estão sempre se engalfinhando. Estremeço só de pensar no que aconteceria se uma briga de verdade começasse.~" 2 'alexandria' 'processio' "~Ah, arranje uma fantasia e junte-se à festa!~" 3 'quarterst' 'quarter' 'staff' "~The green wood may one day make a really good staff, but it could take ages. Better leave it with someone for safe keeping.~" 'high' "~Algumas escolhas são inevitáveis e permanentes, pelo menos neste mundo.~" 'oubliette' "~Cuidado com a armadilha, está bem! Talvez queira tomar precauções com a abertura.~" 3 'amber' 'gem' 'gemstone' "~Deixe-me ver.~" 2 'statues' 'gods' "~Você compreende que, na minha posição, não posso comentar imagens esculpidas de deuses pagãos. É melhor tentar algum dicionário.~" 4 'oracle' 'priestess' 'delphic' 'altar' "~Aquela mulher não para de falar quando você a provoca. Mas apenas se sacrificar algo. A propósito, vai juntar-se a nós no próximo Domingo da Colheita?~" 2 'oil' 'trough' "~Ah, eu me arrepio ao pensar no modo como costumavam derramar óleo sobre si mesmos, chamavam isso de unção.~" 2 'homer' 'poet' "~O velho fofoqueiro Homero sempre me lembra Peter Falk. Enfim, basta dar-lhe as respostas. Não deve ser difícil, com o que você veste e carrega.~" 3 'summer' 'house' 'summerhou' "~Receio que entrar pela frente apenas assuste os pássaros.~" 3 'contraption' 'panel' 'grid' "~Descubra o que puder sobre seu ancestral que o construiu: o túmulo dele não fica longe. Depois reflita o melhor que puder sobre o problema.~" 'ozone' "~Bem, se você sabe qual é o odor, isso é o principal.~" "";

[ AngelDevilConsultTopic tbl w ndx i len flag ;
    ndx = 0;
    while( 1 == 1 ) {
        len = 1;
        flag = false;
        if( tbl-->ndx == -1 ) {
            rfalse;
        }
        if( tbl-->ndx < 20 && tbl-->ndx >= 0 ) {
            len = tbl-->ndx;
            ++ndx;
        }
        i = 0;
        while( i < len ) {
            if (w == tbl-->ndx) {
                flag = true;
            }
            ++i;
            ++ndx;
        }
        if( flag == true ) {
            return tbl-->ndx;
        }
        ++ndx;
    }
    rtrue;
];

[ DemonQuestion w topic ;
    topic = AngelDevilConsultTopic(demon_topics,w);
    if( topic ~= 0 ) {
        print (string) topic;
        new_line;
        rtrue;
    }
    if( AngelDevilConsultTopic(angel_topics,w) ~= 0 ) {
        "~Essa é uma pergunta que você deveria fazer ao meu colega no Outro Lugar,~ diz o demônio suavemente.
         ~Tente outra coisa.~";
    }
    print "~Não tenho autoridade para responder isso,~ diz o demônio, lançando um olhar nervoso para trás.
           ~Tente outra coisa.~^";
    rfalse;
];

[ AngelQuestion w topic ;
    topic = AngelDevilConsultTopic(angel_topics,w);
    if( topic ~= 0 ) {
        print (string) topic;
        new_line;
        rtrue;
    }
    if( AngelDevilConsultTopic(demon_topics,w) ~= 0 ) {
        "~Essa é uma pergunta que você deveria fazer ao meu colega no Outro Lugar,~ diz o anjo suavemente.
         ~Tente outra coisa.~^";
    }
    print "~Não tenho autoridade para responder isso,~ diz o anjo com um sorriso beatífico voltado para cima.
           ~Tente outra coisa.~^";
    rfalse;
];


Object Hellish_Place "Lugar Infernal"
  with  name 'desk',
        after [ cnt;
            Look:
                new_line;
                if( demon has general ) {
                    "~Já pensou no que queria perguntar?~ diz o demônio.";
                }
                cnt = demon.number;
                if( cnt > 0 ) {
                    --cnt;
                    demon.number = cnt;
                    if( cnt > 0 ) {
                        give demon general;
                    }
                }
                if( cnt == 0 ) {
                    "~Suma, pirralho! Vou vê-lo... muito mais tarde...~ diz o demônio com um sorriso memorável.";
                }
                if( cnt == 1 ) {
                    "~Está bem, sapo, você tem uma, apenas uma, chance restante,~ diz o demônio com um sorriso memorável.";
                }
                if( cnt == 2 ) {
                    "~Então, restam duas chances,~ diz o demônio com um sorriso memorável.";
                }
                "~Boa tarde,~ diz o demônio com um sorriso memorável. ~Como recompensa por sua ganância descarada, permita-me recebê-lo em nosso pequeno serviço de informações. Tentamos ser tão úteis quanto possível a exploradores perdidos ou incapazes de descobrir como resolver seus problemas, esse tipo de coisa. Basta dizer o que quer saber ou mostrar algo para eu ver. Você recebe as três dicas habituais.~";
        ],
        n_to Cellar_West,
        u_to Cellar_West,
        description "O Inferno, você sempre imaginou, conteria poços ardentes e sulfurosos e muitos cavalheiros com caudas bifurcadas. Você acertou quanto à última parte. Um demônio está sentado atrás de uma mesa à prova de chamas no fim das escadas. Há alguns gritos perturbadores mais adiante, mas nada com que se preocupar. Não nesta vida, pelo menos.",
        cant_go [;
            trigger_quotation(37);
            "Essa direção não é para os vivos.";
        ],
        each_turn [;
            switch( random(10) ) {
                1: "^Há um ruído horrível de moagem ao longe.";
                2: "^Um clarão queima seus olhos enquanto as chamas sulfurosas resmungam.";
                3: "^Você quase, mas não completamente, distingue o som de gritos.";
                4: "^Trovões e relâmpagos podem ser ouvidos das profundezas ardentes.";
            }
        ],
        section T_AFTERLIFE,
  has   light;

Object -> demon "demon"
  with  name 'devil' 'demon' 'demonic' 'gentleman',
        life [ i;
            Ask, Answer:
                if( HellishAsk() ~= 0 ) rtrue;
                if( DemonQuestion(special_word) ~= 0 ) give demon ~general;
                rtrue;
            Order: "Não se dá ordens a um personagem desses.";
            Give, Show:
                if( HellishAsk() ~= 0 ) rtrue;
                print "O demônio olha preguiçosamente para ", (the) noun, " e se anima a dizer: ~";
                give demon ~general;
                if( noun has edible ) {
                    remove noun;
                    print "Hmm... delicioso!~ Preguiça e gula... dois pecados capitais em um minuto. O chefe dele ficará satisfeito. ~";
                }
                i = noun.devil_hint;
                if( i == -1 || i == nothing ) {
                    if( noun.angel_hint ~= "" )
                        "Eu sei para que serve, mas minha contraparte não.~";
                    "Eu sei exatamente para que isso serve.~";
                }
                print_ret (string) i, "~";
        ],
        description "Se você fosse filmar suas aventuras até agora, contrataria Donald Sutherland para interpretar este cavalheiro.",
        number 4,
  has   animate scenery;

Object Heavenly_Place "Lugar Celestial"
  with  name 'furniture' 'cloud',
        before [;
            Strike: "As nuvens são fofas demais.";
        ],
        after [ i;
            Look:
                new_line;
                if( angel has general ) {
                    "~Use todo o tempo de que precisar,~ diz o anjo gentilmente.";
                }
                i = angel.number;
                if( i > 0 ) {
                    --i;
                    angel.number = i;
                    if( i > 0 ) {
                        give angel general;
                    }
                }
                if( i == 0 ) {
                    "~Receio não poder mais ser útil a você! Até outra vida,~ diz o anjo com um sorriso memorável.";
                }
                if( i == 1 ) {
                    "~Você tem uma pergunta restante,~ diz o anjo com um sorriso memorável.";
                }
                if( i == 2 ) {
                    "~Restam duas perguntas inteiras,~ diz o anjo com um sorriso memorável.";
                }
                "~Bom dia,~ diz o anjo com um sorriso memorável. ~Como recompensa por seu ato de fé, permita-me recebê-lo em nosso pequeno serviço de informações. Tentamos ser tão úteis quanto possível a exploradores perdidos ou incapazes de descobrir como resolver seus problemas. Há algo sobre o qual gostaria de receber uma dica, ou algo que gostaria de me mostrar? Você tem direito a três dicas ao todo, conforme a prática padrão.~";
        ],
        s_to Up_the_Beanstalk,
        description "O Céu, você sempre imaginou, seria um mundo de pilares de mármore, nuvens fofas, harpas e damas angelicais com expressões serenas. Você acertou quanto à última parte. Um anjo está sentado aqui atrás de móveis novos de escritório, ao lado de uma placa azul de Informações Turísticas. Uma ponte de nuvens se estende para o sul pelo céu até o pé de feijão. Há canto coral acontecendo em algum lugar, mas não alto o bastante para você ouvir direito. Não nesta vida, pelo menos.",
        cant_go [;
            trigger_quotation(27);
            "Essa direção não é para os vivos.";
        ],
        each_turn [;
            switch( random(10) ) {
                1: "^Anjos com harpas passam flutuando, falando de você de modo bondoso.";
                2: "^Bebês passam flutuando, apenas contando os dedos dos pés.";
                3: "^A luz do sol, dourada e polida, toca o topo das nuvens aqui.";
                4: "^O coro invisível quase se torna audível por um momento.";
            }
        ],
        section T_AFTERLIFE,
  has   light;

Object -> angel "angel"
  with  name 'angel' 'lady' 'angelic',
        life [ i;
            Answer, Ask:
                if( AngelHints() ~= 0 ) rtrue;
                if( AngelQuestion(special_word) ~= 0 )
                    give demon ~general;   !! Bug, I think. Should be angel
                rtrue;
            Order: "Não se dá ordens a um personagem desses.";
            Give, Show:
                if( AngelHints() ~= 0 ) rtrue;
                print "O anjo olha atentamente para ", (the) noun, " e se anima a dizer: ~";
                give angel ~general;
                i = noun.angel_hint;
                if( i == -1 || i == nothing ) {
                    if( noun.devil_hint ~= "" )
                        "Suponho que você poderia perguntar, hum, àquele cavalheiro com cauda.~";
                    "Receio não poder ajudar você com isso.~";
                }
                print_ret (string) i, "~";
        ],
        description "Se você fosse filmar suas aventuras até agora, contrataria Dame Judi Dench para interpretar esta dama.",
        number 4,
  has   animate scenery;

[ HellishAsk ;
    if( demon hasnt general ) {
        if( demon.number == 0 ) {
            "~Não restam dicas, otário.~";
        }
        "~Segundo o Regulamento 3, parágrafo 15, cláusula (i)(f), só é permitida uma dica por visita ao domínio infernal. Você terá de ir embora e voltar se quiser outra. Sinto muito.~";
    }
    rfalse;
];

[ AngelHints ;
    if( angel hasnt general ) {
        if( angel.number == 0 ) {
            "~Não restam dicas, infelizmente.~";
        }
        "~Segundo o Regulamento 3, parágrafo 15, cláusula (i)(f), só é permitida uma dica por visita ao domínio sagrado. Você terá de ir embora e voltar se quiser outra. Sinto muito.~";
    }
    rfalse;
];
