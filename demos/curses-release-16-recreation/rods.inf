[ discover_rod r ;
    give r ~unidentifed_rod;
    r.&name-->3 = r.rod_word;
    r.list_together = "Rods";
    rtrue;
];

[ ListingRods enhanced ;
    if( rod_identity == 1 ) {
        if( enhanced == true ) {
            print "as Varas Superiores de ";
        } else {
            print "as Varas de ";
        }
        c_style = c_style | (8 + 4096);
        if( c_style & 1 ~= 0 ) {
            c_style = c_style - 1;
        }
        if( c_style & 2 ~= 0 ) {
            c_style = c_style - 2;
        }
    }
    rfalse;
];

[ ListingHRods;
    return ListingRods(true);
];

Class   Rod
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
         list_together "varas de mogno sem marcas",
        before [;
            Examine:
                if( self has unidentifed_rod )
                    "Uma vara de mogno sem marcas, de proposito obscuro. Ou quase sem marcas: uma pequena placa de prata 
                     permanece em branco numa das pontas.";
                if( self has high_rod )
                    rfalse;
                print "A placa de prata nesta vara de mogno a identifica como ", (the) self, ".";
                if( noun has charged ) "  Ela esta completamente carregada.";
                new_line;
                rtrue;
        ],
!        u_to rod_display_before,
        short_name [;
            if( self has unidentifed_rod ) {
                print "vara de mogno sem marcas";
                rtrue; 
            }
            if( self has high_rod )
                print "Superior ";
            print "Vara de ";
            rfalse;
        ],
        parse_name [ i j w len cnt;
            if( parser_action == ##TheSame ) {
                if( parser_one has unidentifed_rod && parser_two has unidentifed_rod ) {
                    return -1;
                }
                return -2;
            }
            len = (self.#name)/2;

            for( w = NextWord() : w : w = NextWord() ) {
                j = false;
                for( i=0: i < len : i++ ) {
                    if( w == 'rods' )
                        parser_action = ##PluralFound;
                    else if( w == self.&name-->i ) {
                        if( self hasnt unidentifed_rod && w == 'featureless' )
                            j == false;
                        else
                            j = true;
                    }
                }
                if( j == false )
                    return cnt;
                else
                    cnt++;
            }
            return cnt;
        ],
        article [;
            if( self has unidentifed_rod )
                print "a";
            else
                print "the";
            return;
        ],
  has   rod_attr;

Class HighRod
  class Rod
  with  rod_action [;
            "Voce e derrubado pelo poder de uma das Varas Superiores, mas ela e poderosa demais 
             para um mortal como voce.";
        ],
        before [;
            Take:
                if( noun has moved ) rfalse;
                if( noun hasnt general ) {
                    if( old_gardeners__gloves has worn ) {
                        "Ela esta incandescente! Mesmo com as luvas, voce nao pode tocar o adamantino.";
                    }
                    "Ela esta incandescente, e voce nao pode tocar a superficie!";
                }
                if( HighRodWarn == 0 ) {
                    HighRodWarn = 1;
                    "Aviso (uma unica vez!): as tres Varas Superiores parecem estar equilibradas com extrema delicadeza na borda do poco.";
                }
                Achieved(SCORE_HIGHROD);
        ],

        description [;
            print "Uma vara de adamantino, com uma ";
            if( self == rod_of_life ) print "mao esculpida";
            if( self == rod_of_love ) print "coracao esculpido";
            if( self == rod_of_death ) print "caveira esculpida";
            " numa ponta, e com seu titulo inscrito.";
        ],
        after [;
            Take:
                if( HighRodBalance == true ) rfalse;

                remove rod_of_life;
                give rod_of_life moved;
                give rod_of_life ~concealed;
                give rod_of_life scored;
                remove rod_of_death;
                give rod_of_death moved;
                give rod_of_death ~concealed;
                give rod_of_death scored;
                remove rod_of_love;
                give rod_of_love moved;
                give rod_of_love ~concealed;
                give rod_of_love scored;
                move noun to player;

                !! Likely a bug: prevents it from being scored
                give noun ~scored;
                HighRodBalance = true;
                 "(Escolha interessante.)^^Ao pega-la, voce desequilibra tudo e as outras duas Varas Superiores chacoalham 
                  pelo corredor de cristal rumo ao submundo.";
        ],
        list_together ListingHRods,
  has   high_rod;
            

Rod     rod_of_fire "Fire"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'fire',
        rod_action [;
            if( second == player ) {
                deadflag = DIED;
                 "Oh, nao. Como o Louco Isaac antes de voce, voce entrou em combustao espontanea!";
            }
            if( second == Austin ) {
                trigger_quotation(6);
                "Voce realmente nao quer vaporizar Austin.";
            }
            if( second == adamantine_statue ) {
                if( adamantine_skull hasnt general || adamantine_heart hasnt general || adamantine_hand hasnt general ) {
                    "Os ossos se sacodem e chacoalham, mas parecem incapazes de se unir para formar vida.";
                }
                remove adamantine_statue;
                move adamantine_knight to West_Side_Chapel;
                Achieved(SCORE_KNIGHT);
                himobj = adamantine_knight;
                "O cavaleiro de adamantino salta, revigorado pelo fogo em seus olhos esqueleticos, com uma nova faisca no 
                 ventre! Ele faz uma reverencia solene, no estilo elaborado de um artista de mimica.";
            }
            if( second == adamantine_knight )
                "O adamantino e a prova de fogo.";
            if( second == loose_board )
                "A madeira parece ter sido tratada de algum modo e e a prova de fogo.";
            if( second has animate )
                "Pelo amor de Deus, voce so esta procurando um mapa velho. Assassinato parece um pouco extremo.";
            if( second == wall_of_thorns_object ) {
                if( wall_of_thorns_object has open ) 
                    "A parede se contorce, incomodada, para evitar mais devastacao.";
                give wall_of_thorns_object open;
                  "O fogo salta da vara para o coracao da parede de espinhos, que grita enquanto queima, 
                  revelando um grande buraco entre as chamas selvagens. Voce vislumbra um grande Templo,
                  antes que a parede se regenere. Mas ela nao consegue se recuperar totalmente, deixando uma abertura
                  carbonizada ao sul. Voce provavelmente conseguiria passar por ela.";
            }
            if( second == medicine_bottle ) {
                print "O ponto de fusao deste vidro e muito alto e, incrivelmente, ele resiste ao raio de fogo.^";
                GoodTry();
                rfalse;
            }
            if( second == complicated_looking_bomb or timer_detonator ) {
                deadflag = DIED;
                "(Talvez previsivelmente) a bomba explode!";
            }
            if( second has scenery || second has static ) {
                deadflag = DIED;
                "Voce provoca um grande incendio e perece nele!";
            }
            remove second;
            print "Um raio de fogo salta da vara e consome ", (the) second, " completamente!";
        ],
        angel_hint "Isto e bastante perigoso, temo. Use apenas em materia vegetal.",
  has   unidentifed_rod;

[  RodOfReturningAction i loc ;
    if( second ~= player ) "Nada evidente acontece.";
    if( location == Inside_the_Orb ) {
        move golden_orb to player;
        print "Embora nada pareca acontecer com voce, toda a esfera dourada se contrai graciosamente, comprimindo-se 
            ate caber confortavelmente na palma da sua mao. Voce pisca.^";
        location = LocationSave;
        move player to ContainerSave;
        <<Look>>;
    }
    FlashFallsOut();
    print "Voce e envolvido por uma nuvem de luzes brancas giratorias, como insetos. Quando o enxame desaparece, 
        voce se ve transportado...^";
    if( game_section == T_ANCIENT_BRITAIN ) {
        loc = Infinity_Symbol;
        remove rod_of_returning2;
    } else {
        i = random(4);
        if( deterministic_transportation == 1 ) {
            i = 1;
        }
        loc = Attic;
        if( i == 2 ) {
            loc = Old_Furniture;
        }
        if( i == 3 ) {
            loc = Old_Winery;
        }
        if( i == 4 ) {
            loc = Over_the_East_Wing;
        }
    }
    PlayerTo(loc);
    rtrue;
];

Rod     rod_of_returning "Returning"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'returning',
        rod_action RodOfReturningAction,
        devil_hint "Bem, isso nao e muito util, nao e? Eu faria greve se fosse voce.",
  has   unidentifed_rod;

Rod     rod_of_stalking "Stalking"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'stalking',
        rod_action [ i;
            if( second == adamantine_knight ) 
                "O cavaleiro salta no lugar (caindo ruidosamente).";
            if( second == potted_shrub ) {
                potted_shrub.initial = "Um arbusto florido, alegre com flores vermelhas, e cuidado numa grande tina 
                    redonda sob a parede aqui.";
                "O arbusto explode em flores, coberto por dezenas de delicadas luas vermelhas.";
            }
            if( second == marble_rose ) 
                "O marmore se sacode, como se tentasse crescer, mas cai de volta, morto.";
            if( second == small_thorny_tree ) {
                if( parent(fig) ~= nothing ) {
                    "A arvore tentou muito, mas no fim nao conseguiu dar um figo.";
                }
                move fig to player;
                "A arvore se esforca especialmente e consegue produzir outro figo, que amadurece e cai... 
                 voce salta para a frente e pega a fruta antes que ela se espatife no chao.";
            }
            if( second == player ) 
                "Seu cabelo fica momentaneamente em pe, como se quisesse sair da sua cabeca, mas felizmente 
                 ele desiste.";
            if( second == plane_tree && location == Family_Tree ) 
                "A arvore treme e estremece, mas felizmente permanece intacta.";
            if( second == wall_of_thorns_object ) 
                "Vuuush!^^A parede de espinhos cresce mais seis metros e entao desaba sobre si mesma, acomodando-se 
                 como uma fera. Ela esta mais espessa e desagradavel do que nunca.";
            if( second ~= runner_bean_plant || runner_bean_plant has open ) 
                "Nada evidente acontece.";

            give runner_bean_plant open;
            print "^Aviso: algo extremamente previsivel esta prestes a acontecer. Quando achar que ja se recompos 
                 e conseguir suportar, pressione ENTER. ", '>';
            buffer->1 = 0;
            DrawStatusLine();
            @aread buffer parse -> i;
            new_line;
            "De repente, um enorme pe de feijao brota do chao, exatamente como num conto de fadas, subindo
             ate o alto do ceu! Voce boceja convulsivamente.";
        ],
        devil_hint "Ele nao tem aplicacao horticultural.",
  has   unidentifed_rod;

Rod     rod_of_infinity "Infinity"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque' 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'infinity',
        rod_action [ t;
            if( second == adamantine_knight ) 
                "Oh, o cavaleiro ja esteve mais perto do infinito do que voce jamais poderia leva-lo.";
            if( second == player ) 
                "Voce nao adquire nenhum sentido especial do infinito.";
            if( location ~= Infinity_Symbol || second ~= lemniscus ) 
                "Nada evidente acontece.";
            t = circular_arc.number;
            trigger_quotation(30);
            if( t < 9 ) 
                "Voce sente o ar se carregar de excitacao, e o simbolo brilha dourado por um instante, mas 
                 entao o poder escoa para uma das cavidades vazias do arco.";
            if (noun has general) 
                "Nada acontece desta vez.";
            print "O ar se carrega de excitacao, e o simbolo brilha dourado, entao comeca a girar, cada vez mais 
                 rapido, transformando-se numa luz dourada perolada que banha voce com magia pura. ";
            if (spherical_opening hasnt general)
                "Mas ainda esta fraco demais! Voce meio que ouve, meio que imagina um sussurro de druidas...";
            print "Everything becomes a daze and then you find yourself...^";
            give noun general;
            StartMasterGame();
            rtrue;
        ],
        angel_hint "Bem, onde voce poderia ter visto o infinito antes?",
  has   unidentifed_rod;

Rod     rod_of_husbandry "Husbandry"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'husbandry',
        rod_action [;
            if( second == player ) "Voce se sente subitamente obediente e por um instante imagina um biscoito para caes.";
            if( second == Austin ) "Pobre Austin, ele e indomesticavel demais. Isso nao faz efeito.";
            if( second == irate_squirrel_friend ) 
                "Guiado por algum sexto sentido animal, o esquilo salta graciosamente para fora do caminho.";
            if( second ~= herd_of_goats ) "Nada evidente acontece.";

            give herd_of_goats general;
            trigger_quotation(24);
            "As cabras subitamente olham para voce com admiracao, embora logo retomem seu antigo interesse em comer 
             a grama.";
        ],
        angel_hint "Talvez voce devesse procurar ~criacao de animais~ num dicionario.",
  has   unidentifed_rod;

Rod     rod_of_bronze "Bronze"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'bronze',
        rod_action [;
            if( second == player ) "Voce adquire um bronzeado repentino, mas ele logo desaparece.";
            if( second == Austin ) "Austin ja e ruivo, o que e bem proximo.";
            if( second == adamantine_knight ) "Ele ignora o efeito. (O adamantino nao e impressionante o bastante para voce?)";
            if( second == metal_wall ) {
                give metal_wall open;
                "Imediatamente, o bronze se pole ate brilhar como um espelho.";
            }
            if( second ~= bronze_mural ) "Nada evidente acontece.";
            if( bronze_mural has open ) "Nada mais acontece.";

            give bronze_mural open;
            "Com um horrivel ruido de esforco e estalos, o mural desliza um pouco para o lado, abrindo uma passagem 
             escura para baixo, que nao pode ter sido usada por seculos.";
        ],
        angel_hint "O bronze e a chave aqui. Voce viu algum outro bronze em algum lugar?",
  has   unidentifed_rod;

Rod     rod_of_sacrifice "Sacrifice"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'sacrifice',
        rod_action [;
            if( second == herd_of_goats ) {
                if( herd_of_goats hasnt general ) {
                    "As cabras se aglomeram demais para que se possa mirar em uma delas com precisao.";
                }
                "Ainda obedientes a sua vontade, as cabras se separam e uma fica sozinha. Usando esta Vara, voce a 
                 vaporiza instantaneamente, e as outras voltam satisfeitas.^^Voce acha que ha uma
                 moral sobre o uso e o abuso do poder?";
            }
            if( second == Austin ) {
                trigger_quotation(6);
                "Voce realmente nao quer sacrificar Austin.";
            }
            if( second == adamantine_knight ) 
                "Seria uma pena, depois de toda aquela cirurgia.";
            if( second has moved ) {
                remove second;
                print_ret "Voce decide que consegue viver sem ", (the) second, ", que voce aniquila com a Vara.";
            }
            if( location == Inside_the_Orb && second == array_of_oblong_crystals ) {
                if( Inside_the_Orb hasnt general ) {
                    deadflag = CHECKMATED;
                     "As pecas pretas fazem uma ruptura precipitada em suas defesas, sacrificando uma peca em vao e sofrendo 
                      uma derrota rapida.^^A Rainha Branca se ergue do tabuleiro, com um sorriso de anjo vingador,
                      e agita uma espada larga de luz ardente pelo seu corpo...";
                }
                move golden_orb to player;
                give golden_orb general;
                Achieved(SCORE_ORB);
                 golden_orb.description = "Um tesouro em todos os sentidos, o orbe pulsa com radiancia dourada.";
                 print "As pecas brancas avancam: primeiro um bispo, depois um cavalo e sacrificado, limpando a 
                     parede de peoes que cerca o rei preto para permitir um xeque-mate deslumbrante!^^Voce
                     desaparece do orbe tao estranhamente quanto entrou, impressionado por ele quase pulsar em sua palma.^";
                move player to ContainerSave;
                location = LocationSave;
                << Look >>;
            }
            if( second == player ) {
                deadflag = DIED;
                 "Voce sente uma nobre onda de orgulho enquanto seu corpo e incinerado pela Vara. Ao menos morreu por uma 
                  causa terrivelmente importante, embora exatamente qual parece ter escapado da sua memoria.";
            }
            "Nada evidente acontece.";
        ],
        angel_hint "Perigoso demais. A era dos martires na igreja ja acabou ha muito tempo, sabia?",
  has   unidentifed_rod;

Rod     rod_of_luck "Luck"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'luck',
        rod_action [;
            if( second == player ) {
                if( big_electricians_switch has on ) {
                    "Voce nao sente diferenca. Talvez a sorte nao exista.";
                }
                give noun general;
                "Voce se sente otimista e sortudo. Pensando bem, voce se sente assim na maior parte do tempo.";
            }
            if( second == Austin ) "Austin ja e sortudo demais.";
            if( second == adamantine_knight ) "Reunido depois de todos esses anos... quanta sorte se pode ter?";
            if( second == gambling_sailor ) {
                give gambling_sailor lucky;
                "O marinheiro estremece de repente.";
            }
            if( second == inscribed_die ) {
                give inscribed_die lucky;
                "O dado chacoalha um pouco e entao para.";
            }
            "Nada evidente acontece.";
        ],
        angel_hint "Bem, se e que existe algo chamado sorte, talvez isto ajude.",
  has   unidentifed_rod;

Rod     rod_of_ice "Ice"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque' 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'ice',
        rod_action [;
            if( second == player )
                "Voce sente um calafrio repentino.";
            if( second has animate ) 
                print_ret "Por um breve instante, ", (the) second, " congela.";
            if( second has high_rod ) {
                if( second has general ) {
                    "Ja esta frio.";
                }
                give second general;
                "Ha um enorme silvo de vapor, criando nevoas que giram furiosamente; quando elas se dissipam, resta uma vara aparentemente fria.";
            }
            "Nada evidente acontece.";
        ],
        angel_hint "Use apenas em momentos acalorados, quando as coisas estiverem delicadamente equilibradas.",
  has   unidentifed_rod;

Rod     rod_of_language "Language"
  with  name 'rod' 'of' 'language',
        list_together ListingRods,
        rod_action [;
            if( second == player ) {
                KnowLanguages = true;
                "Nada evidente acontece. Voce xinga eloquentemente em celta.";
            }
            if( second == surly_shopkeeper ) 
                "Boa ideia. Agora o quiosqueiro tambem sabe um pouco de celta. Infelizmente, seu orgulho nacional 
                 e forte demais. Voce tera de tentar outra coisa - tem carta branca para resolver este 
                 problema.";
            "Nada evidente acontece.";
        ],
  has   ;

Rod     rod_of_returning2 "Returning"
  with  name 'rod' 'of' 'returning',
        list_together ListingRods,
        rod_action RodOfReturningAction,
  has   ;

HighRod     rod_of_life "Life"
  with  name 'life' 'high' 'rod' 'of',
         initial "As Varas Superiores da Vida, do Amor e da Morte se apoiam numa piramide no alto da encosta ingreme, equilibradas com delicadeza.",
         angel_hint "Espantoso! Uma das tres Varas Superiores!";

HighRod     rod_of_death "Death"
  with  name 'death' 'high' 'rod' 'of',
         angel_hint "Espantoso! Uma das tres Varas Superiores!",
  has   concealed;

HighRod     rod_of_love "Love"
  with  name 'love' 'high' 'rod' 'of',
         angel_hint "Espantoso! Uma das tres Varas Superiores!",
  has   concealed;
