[ discover_rod r ;
    give r ~unidentifed_rod;
    r.&name-->3 = r.rod_word;
    r.list_together = "Varas";
    rtrue;
];

[ ListingRods enhanced ;
    if( rod_identity == 1 ) {
        if( enhanced == true ) {
            print "as Varas Superiores de ";
        } else {
            print "as Varas de ";
        }
        c_style = c_style | (8 + 4096);
        if( c_style & 1 ~= 0 ) {
            c_style = c_style - 1;
        }
        if( c_style & 2 ~= 0 ) {
            c_style = c_style - 2;
        }
    }
    rfalse;
];

[ ListingHRods;
    return ListingRods(true);
];

Class   Rod
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
         list_together "varas de mogno sem marcas",
        before [;
            Examine:
                if( self has unidentifed_rod )
                    "Uma vara de mogno sem marcas, de propósito obscuro. Ou quase sem marcas: uma pequena placa de prata 
                     permanece em branco numa das pontas.";
                if( self has high_rod )
                    rfalse;
                print "A placa de prata nesta vara de mogno a identifica como ", (the) self, ".";
                if( noun has charged ) "  Ela está completamente carregada.";
                new_line;
                rtrue;
        ],
!        u_to rod_display_before,
        short_name [;
            if( self has unidentifed_rod ) {
                print "vara de mogno sem marcas";
                rtrue; 
            }
            if( self has high_rod )
                print "Superior ";
            print "Vara de ";
            rfalse;
        ],
        parse_name [ i j w len cnt;
            if( parser_action == ##TheSame ) {
                if( parser_one has unidentifed_rod && parser_two has unidentifed_rod ) {
                    return -1;
                }
                return -2;
            }
            len = (self.#name)/2;

            for( w = NextWord() : w : w = NextWord() ) {
                j = false;
                for( i=0: i < len : i++ ) {
                    if( w == 'rods' )
                        parser_action = ##PluralFound;
                    else if( w == self.&name-->i ) {
                        if( self hasnt unidentifed_rod && w == 'featureless' )
                            j == false;
                        else
                            j = true;
                    }
                }
                if( j == false )
                    return cnt;
                else
                    cnt++;
            }
            return cnt;
        ],
        article [;
            if( self has unidentifed_rod )
                print "a";
            else
                print "a";
            return;
        ],
  has   rod_attr;

Class HighRod
  class Rod
  with  rod_action [;
            "Você é derrubado pelo poder de uma das Varas Superiores, mas ela é poderosa demais
             para um mortal como você.";
        ],
        before [;
            Take:
                if( noun has moved ) rfalse;
                if( noun hasnt general ) {
                    if( old_gardeners__gloves has worn ) {
                        "Ela está incandescente! Mesmo com as luvas, você não pode tocar o adamantino.";
                    }
                    "Ela está incandescente, e você não pode tocar a superfície!";
                }
                if( HighRodWarn == 0 ) {
                    HighRodWarn = 1;
                    "Aviso (uma única vez!): as três Varas Superiores parecem estar equilibradas com extrema delicadeza na borda do poço.";
                }
                Achieved(SCORE_HIGHROD);
        ],

        description [;
            print "Uma vara de adamantino, com uma ";
            if( self == rod_of_life ) print "mão esculpida";
            if( self == rod_of_love ) print "coração esculpido";
            if( self == rod_of_death ) print "caveira esculpida";
            " numa ponta, e com seu título inscrito.";
        ],
        after [;
            Take:
                if( HighRodBalance == true ) rfalse;

                remove rod_of_life;
                give rod_of_life moved;
                give rod_of_life ~concealed;
                give rod_of_life scored;
                remove rod_of_death;
                give rod_of_death moved;
                give rod_of_death ~concealed;
                give rod_of_death scored;
                remove rod_of_love;
                give rod_of_love moved;
                give rod_of_love ~concealed;
                give rod_of_love scored;
                move noun to player;

                !! Likely a bug: prevents it from being scored
                give noun ~scored;
                HighRodBalance = true;
                  "(Escolha interessante.)^^Ao pegá-la, você desequilibra tudo e as outras duas Varas Superiores chacoalham 
                  pelo corredor de cristal rumo ao submundo.";
        ],
        list_together ListingHRods,
  has   high_rod;
            

Rod     rod_of_fire "Fogo"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'fire',
        rod_action [;
            if( second == player ) {
                deadflag = DIED;
                 "Oh, não. Como o Louco Isaac antes de você, você entrou em combustão espontânea!";
            }
            if( second == Austin ) {
                trigger_quotation(6);
                "Você realmente não quer vaporizar Austin.";
            }
            if( second == adamantine_statue ) {
                if( adamantine_skull hasnt general || adamantine_heart hasnt general || adamantine_hand hasnt general ) {
                "Os ossos se sacodem e chacoalham, mas parecem incapazes de se unir para formar vida.";
                }
                remove adamantine_statue;
                move adamantine_knight to West_Side_Chapel;
                Achieved(SCORE_KNIGHT);
                himobj = adamantine_knight;
                "O cavaleiro de adamantino salta, revigorado pelo fogo em seus olhos esqueléticos, com uma nova faísca no
                 ventre! Ele faz uma reverência solene, no estilo elaborado de um artista de mímica.";
            }
            if( second == adamantine_knight )
                "O adamantino é à prova de fogo.";
            if( second == loose_board )
                "A madeira parece ter sido tratada de algum modo e é à prova de fogo.";
            if( second has animate )
                "Pelo amor de Deus, você só está procurando um mapa velho. Assassinato parece um pouco extremo.";
            if( second == wall_of_thorns_object ) {
                if( wall_of_thorns_object has open ) 
                    "A parede se contorce, incomodada, para evitar mais devastação.";
                give wall_of_thorns_object open;
                  "O fogo salta da vara para o coração da parede de espinhos, que grita enquanto queima,
                  revelando um grande buraco entre as chamas selvagens. Você vislumbra um grande Templo,
                  antes que a parede se regenere. Mas ela não consegue se recuperar totalmente, deixando uma abertura
                  carbonizada ao sul. Você provavelmente conseguiria passar por ela.";
            }
            if( second == medicine_bottle ) {
                print "O ponto de fusão deste vidro é muito alto e, incrivelmente, ele resiste ao raio de fogo.^";
                GoodTry();
                rfalse;
            }
            if( second == complicated_looking_bomb or timer_detonator ) {
                deadflag = DIED;
                "(Talvez previsivelmente) a bomba explode!";
            }
            if( second has scenery || second has static ) {
                deadflag = DIED;
                 "Você provoca um grande incêndio e perece nele!";
            }
            remove second;
            print "Um raio de fogo salta da vara e consome ", (the) second, " completamente!";
        ],
         angel_hint "Isto é bastante perigoso, temo. Use apenas em matéria vegetal.",
  has   unidentifed_rod;

[  RodOfReturningAction i loc ;
    if( second ~= player ) "Nada evidente acontece.";
    if( location == Inside_the_Orb ) {
        move golden_orb to player;
        print "Embora nada pareça acontecer com você, toda a esfera dourada se contrai graciosamente, comprimindo-se
            até caber confortavelmente na palma da sua mão. Você pisca.^";
        location = LocationSave;
        move player to ContainerSave;
        <<Look>>;
    }
    FlashFallsOut();
    print "Você é envolvido por uma nuvem de luzes brancas giratórias, como insetos. Quando o enxame desaparece,
        você se vê transportado...^";
    if( game_section == T_ANCIENT_BRITAIN ) {
        loc = Infinity_Symbol;
        remove rod_of_returning2;
    } else {
        i = random(4);
        if( deterministic_transportation == 1 ) {
            i = 1;
        }
        loc = Attic;
        if( i == 2 ) {
            loc = Old_Furniture;
        }
        if( i == 3 ) {
            loc = Old_Winery;
        }
        if( i == 4 ) {
            loc = Over_the_East_Wing;
        }
    }
    PlayerTo(loc);
    rtrue;
];

Rod     rod_of_returning "Retorno"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'returning',
        rod_action RodOfReturningAction,
         devil_hint "Bem, isso não é muito útil, não é? Eu faria greve se fosse você.",
  has   unidentifed_rod;

Rod     rod_of_stalking "Perseguição"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'stalking',
        rod_action [ i;
            if( second == adamantine_knight ) 
                "O cavaleiro salta no lugar (caindo ruidosamente).";
            if( second == potted_shrub ) {
                potted_shrub.initial = "Um arbusto florido, alegre com flores vermelhas, é cuidado numa grande tina
                    redonda sob a parede aqui.";
                "O arbusto explode em flores, coberto por dezenas de delicadas luas vermelhas.";
            }
            if( second == marble_rose ) 
                "O mármore se sacode, como se tentasse crescer, mas cai de volta, morto.";
            if( second == small_thorny_tree ) {
                if( parent(fig) ~= nothing ) {
                    "A árvore tentou muito, mas no fim não conseguiu dar um figo.";
                }
                move fig to player;
                "A árvore se esforça especialmente e consegue produzir outro figo, que amadurece e cai...
                 você salta para a frente e pega a fruta antes que ela se espatife no chão.";
            }
            if( second == player ) 
                "Seu cabelo fica momentaneamente em pé, como se quisesse sair da sua cabeça, mas felizmente
                 ele desiste.";
            if( second == plane_tree && location == Family_Tree ) 
                "A árvore treme e estremece, mas felizmente permanece intacta.";
            if( second == wall_of_thorns_object ) 
                "Vuuush!^^A parede de espinhos cresce mais seis metros e então desaba sobre si mesma, acomodando-se
                 como uma fera. Ela está mais espessa e desagradável do que nunca.";
            if( second ~= runner_bean_plant || runner_bean_plant has open ) 
                "Nada evidente acontece.";

            give runner_bean_plant open;
            print "^Aviso: algo extremamente previsível está prestes a acontecer. Quando achar que já se recompôs
                 e conseguir suportar, pressione ENTER. ", '>';
            buffer->1 = 0;
            DrawStatusLine();
            @aread buffer parse -> i;
            new_line;
            "De repente, um enorme pé de feijão brota do chão, exatamente como num conto de fadas, subindo
             até o alto do céu! Você boceja convulsivamente.";
        ],
        devil_hint "Ele não tem aplicação horticultural.",
  has   unidentifed_rod;

Rod     rod_of_infinity "Infinito"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque' 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'infinity',
        rod_action [ t;
            if( second == adamantine_knight ) 
                "Oh, o cavaleiro já esteve mais perto do infinito do que você jamais poderia levá-lo.";
            if( second == player ) 
                "Você não adquire nenhum sentido especial do infinito.";
            if( location ~= Infinity_Symbol || second ~= lemniscus ) 
                "Nada evidente acontece.";
            t = circular_arc.number;
            trigger_quotation(30);
            if( t < 9 ) 
                "Você sente o ar se carregar de excitação, e o símbolo brilha dourado por um instante, mas
                 então o poder escoa para uma das cavidades vazias do arco.";
            if (noun has general) 
                "Nada acontece desta vez.";
            print "O ar se carrega de excitação, e o símbolo brilha dourado, então começa a girar, cada vez mais
                 rápido, transformando-se numa luz dourada perolada que banha você com magia pura. ";
            if (spherical_opening hasnt general)
                "Mas ainda está fraco demais! Você meio que ouve, meio que imagina um sussurro de druidas...";
            print "Tudo fica enevoado e então você se encontra...^";
            give noun general;
            StartMasterGame();
            rtrue;
        ],
        angel_hint "Bem, onde você poderia ter visto o infinito antes?",
  has   unidentifed_rod;

Rod     rod_of_husbandry "Criação de animais"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'husbandry',
        rod_action [;
            if( second == player ) "Você se sente subitamente obediente e por um instante imagina um biscoito para cães.";
            if( second == Austin ) "Pobre Austin, ele é indomesticável demais. Isso não faz efeito.";
            if( second == irate_squirrel_friend ) 
                "Guiado por algum sexto sentido animal, o esquilo salta graciosamente para fora do caminho.";
            if( second ~= herd_of_goats ) "Nada evidente acontece.";

            give herd_of_goats general;
            trigger_quotation(24);
            "As cabras subitamente olham para você com admiração, embora logo retomem seu antigo interesse em comer
             a grama.";
        ],
        angel_hint "Talvez você devesse procurar ~criação de animais~ num dicionário.",
  has   unidentifed_rod;

Rod     rod_of_bronze "Bronze"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'bronze',
        rod_action [;
            if( second == player ) "Você adquire um bronzeado repentino, mas ele logo desaparece.";
            if( second == Austin ) "Austin já é ruivo, o que é bem próximo.";
            if( second == adamantine_knight ) "Ele ignora o efeito. (O adamantino não é impressionante o bastante para você?)";
            if( second == metal_wall ) {
                give metal_wall open;
                "Imediatamente, o bronze se pole até brilhar como um espelho.";
            }
            if( second ~= bronze_mural ) "Nada evidente acontece.";
            if( bronze_mural has open ) "Nada mais acontece.";

            give bronze_mural open;
            "Com um horrível ruído de esforço e estalos, o mural desliza um pouco para o lado, abrindo uma passagem
             escura para baixo, que não pode ter sido usada por séculos.";
        ],
        angel_hint "O bronze é a chave aqui. Você viu algum outro bronze em algum lugar?",
  has   unidentifed_rod;

Rod     rod_of_sacrifice "Sacrifício"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'sacrifice',
        rod_action [;
            if( second == herd_of_goats ) {
                if( herd_of_goats hasnt general ) {
                    "As cabras se aglomeram demais para que se possa mirar em uma delas com precisão.";
                }
                "Ainda obedientes à sua vontade, as cabras se separam e uma fica sozinha. Usando esta Vara, você a
                 vaporiza instantaneamente, e as outras voltam satisfeitas.^^Você acha que há uma
                 moral sobre o uso e o abuso do poder?";
            }
            if( second == Austin ) {
                trigger_quotation(6);
                "Você realmente não quer sacrificar Austin.";
            }
            if( second == adamantine_knight ) 
                "Seria uma pena, depois de toda aquela cirurgia.";
            if( second has moved ) {
                remove second;
                print_ret "Você decide que consegue viver sem ", (the) second, ", que você aniquila com a Vara.";
            }
            if( location == Inside_the_Orb && second == array_of_oblong_crystals ) {
                if( Inside_the_Orb hasnt general ) {
                    deadflag = CHECKMATED;
                     "As peças pretas fazem uma ruptura precipitada em suas defesas, sacrificando uma peça em vão e sofrendo
                      uma derrota rápida.^^A Rainha Branca se ergue do tabuleiro, com um sorriso de anjo vingador,
                      e agita uma espada larga de luz ardente pelo seu corpo...";
                }
                move golden_orb to player;
                give golden_orb general;
                Achieved(SCORE_ORB);
                 golden_orb.description = "Um tesouro em todos os sentidos, o orbe pulsa com radiância dourada.";
                 print "As peças brancas avançam: primeiro um bispo, depois um cavalo é sacrificado, limpando a
                     parede de peões que cerca o rei preto para permitir um xeque-mate deslumbrante!^^Você
                     desaparece do orbe tão estranhamente quanto entrou, impressionado por ele quase pulsar em sua palma.^";
                move player to ContainerSave;
                location = LocationSave;
                << Look >>;
            }
            if( second == player ) {
                deadflag = DIED;
                  "Você sente uma nobre onda de orgulho enquanto seu corpo é incinerado pela Vara. Ao menos morreu por uma
                   causa terrivelmente importante, embora exatamente qual parece ter escapado da sua memória.";
            }
            "Nada evidente acontece.";
        ],
        angel_hint "Perigoso demais. A era dos mártires na igreja já acabou há muito tempo, sabia?",
  has   unidentifed_rod;

Rod     rod_of_luck "Sorte"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'luck',
        rod_action [;
            if( second == player ) {
                if( big_electricians_switch has on ) {
                    "Você não sente diferença. Talvez a sorte não exista.";
                }
                give noun general;
                "Você se sente otimista e sortudo. Pensando bem, você se sente assim na maior parte do tempo.";
            }
            if( second == Austin ) "Austin já é sortudo demais.";
            if( second == adamantine_knight ) "Reunido depois de todos esses anos... quanta sorte se pode ter?";
            if( second == gambling_sailor ) {
                give gambling_sailor lucky;
                "O marinheiro estremece de repente.";
            }
            if( second == inscribed_die ) {
                give inscribed_die lucky;
                "O dado chacoalha um pouco e então para.";
            }
            "Nada evidente acontece.";
        ],
        angel_hint "Bem, se é que existe algo chamado sorte, talvez isto ajude.",
  has   unidentifed_rod;

Rod     rod_of_ice "Gelo"
  with  name 'rod' 'of' 'mahogany' 'featureless' 'plaque' 'rod' 'of' 'mahogany' 'featureless' 'plaque',
        rod_word 'ice',
        rod_action [;
            if( second == player )
                "Você sente um calafrio repentino.";
            if( second has animate ) 
                print_ret "Por um breve instante, ", (the) second, " congela.";
            if( second has high_rod ) {
                if( second has general ) {
                    "Já está frio.";
                }
                give second general;
                "Há um enorme silvo de vapor, criando névoas que giram furiosamente; quando elas se dissipam, resta uma vara aparentemente fria.";
            }
            "Nada evidente acontece.";
        ],
        angel_hint "Use apenas em momentos acalorados, quando as coisas estiverem delicadamente equilibradas.",
  has   unidentifed_rod;

Rod     rod_of_language "Linguagem"
  with  name 'rod' 'of' 'language',
        list_together ListingRods,
        rod_action [;
            if( second == player ) {
                KnowLanguages = true;
                "Nada evidente acontece. Você xinga eloquentemente em celta.";
            }
            if( second == surly_shopkeeper ) 
                "Boa ideia. Agora o quiosqueiro também sabe um pouco de celta. Infelizmente, seu orgulho nacional
                 é forte demais. Você terá de tentar outra coisa - tem carta branca para resolver este
                 problema.";
            "Nada evidente acontece.";
        ],
  has   ;

Rod     rod_of_returning2 "Retorno"
  with  name 'rod' 'of' 'returning',
        list_together ListingRods,
        rod_action RodOfReturningAction,
  has   ;

HighRod     rod_of_life "Vida"
  with  name 'life' 'high' 'rod' 'of',
         initial "As Varas Superiores da Vida, do Amor e da Morte se apoiam numa pirâmide no alto da encosta íngreme, equilibradas com delicadeza.",
         angel_hint "Espantoso! Uma das três Varas Superiores!";

HighRod     rod_of_death "Morte"
  with  name 'death' 'high' 'rod' 'of',
         angel_hint "Espantoso! Uma das três Varas Superiores!",
  has   concealed;

HighRod     rod_of_love "Amor"
  with  name 'love' 'high' 'rod' 'of',
         angel_hint "Espantoso! Uma das três Varas Superiores!",
  has   concealed;
